{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Pure Feeling</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#15111c}#root{position:relative;width:100%;height:100%;overflow:hidden}canvas{display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"20\">\n<canvas id=\"art\" class=\"clip\" data-start=\"0\" data-duration=\"20\" width=\"1920\" height=\"1080\" aria-label=\"A psychedelic motion design showreel of kinetic typography, optical tunnels, sculptural ribbons and kaleidoscopic flowers.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n/* EDITABLE ART DIRECTION\n   Five four-second movements; circular wipes connect their geometry.\n   All artwork is procedural. Change these colors, words or scene functions.\n   Every frame is a pure function of timeline time, including reverse seeks. */\nconst canvas=document.getElementById('art');\nconst ctx=canvas.getContext('2d');\nconst W=1920,H=1080,CX=960,CY=540,TAU=Math.PI*2;\nconst P={ink:'#15111c',pink:'#ff57ae',lime:'#d9ff43',blue:'#333cff',violet:'#8240ed',cream:'#fff4df',orange:'#ff753e'};\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst mix=(a,b,p)=>a+(b-a)*p;\nconst smooth=v=>{v=clamp(v);return v*v*(3-2*v)};\nconst out=v=>1-Math.pow(1-clamp(v),4);\nconst mod=(a,b)=>((a%b)+b)%b;\nfunction background(color){ctx.fillStyle=color;ctx.fillRect(0,0,W,H)}\nfunction circle(x,y,r,color){if(r<=0)return;ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fillStyle=color;ctx.fill()}\nfunction star(x,y,r,points,rotation,color,inner=.33){\n ctx.save();ctx.translate(x,y);ctx.rotate(rotation);ctx.beginPath();\n for(let i=0;i<points*2;i++){const a=i*Math.PI/points;const d=i%2?r*inner:r;const px=Math.cos(a)*d,py=Math.sin(a)*d;i?ctx.lineTo(px,py):ctx.moveTo(px,py)}\n ctx.closePath();ctx.fillStyle=color;ctx.fill();ctx.restore();\n}\nfunction text(word,x,y,size,fill,stroke=null,width=0,maxWidth=1680){\n ctx.save();ctx.textAlign='center';ctx.textBaseline='middle';ctx.font=`900 ${size}px sans-serif`;\n const measured=ctx.measureText(word).width;\n if(measured>maxWidth)ctx.font=`900 ${size*maxWidth/measured}px sans-serif`;\n ctx.lineJoin='round';if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=width;ctx.strokeText(word,x,y)}ctx.fillStyle=fill;ctx.fillText(word,x,y);ctx.restore();\n}\nfunction scallopPath(radius,phase,waves=12,amount=.07){\n ctx.beginPath();for(let i=0;i<=192;i++){const a=i/192*TAU;const r=radius*(1+amount*Math.sin(waves*a+phase));const x=Math.cos(a)*r,y=Math.sin(a)*r;i?ctx.lineTo(x,y):ctx.moveTo(x,y)}ctx.closePath();\n}\nfunction halftone(t,color){\n ctx.save();ctx.fillStyle=color;\n for(let row=0;row<12;row++)for(let col=0;col<7;col++){\n  const x=90+col*27,y=90+row*27;const r=2+1.5*Math.sin(row*.5+col*.6+t);\n  ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fill();ctx.beginPath();ctx.arc(W-x,H-y,r,0,TAU);ctx.fill();\n }ctx.restore();\n}\n\n/* 00–04: poster typography and a breathing, scalloped aperture. */\nfunction ignition(t){\n background(P.pink);\n ctx.save();ctx.translate(CX+65*Math.sin(t*.85),CY);ctx.rotate(t*.11);\n for(let i=17;i>=0;i--){\n  const radius=70+i*70+22*Math.sin(t*2.5-i*.4);\n  scallopPath(radius,t*2.1-i*.23,10,.055);\n  ctx.fillStyle=[P.pink,P.orange,P.pink,P.lime][i%4];ctx.fill();\n }\n ctx.restore();\n // Black circular outlines hold the poster together as its surface breathes.\n ctx.save();ctx.translate(CX,CY);ctx.rotate(-t*.13);ctx.strokeStyle=P.ink;ctx.lineWidth=4;\n for(let i=0;i<4;i++){ctx.beginPath();ctx.ellipse(0,0,540+i*75,335+i*65,t*.15+i*.4,0,TAU);ctx.stroke()}ctx.restore();\n const words=['MAKE','IT','MOVE'];\n words.forEach((word,i)=>{\n  const enter=out((t-i*.16)/.65);\n  const y=[266,534,806][i]+(1-enter)*125;\n  const drift=Math.sin(t*2.1+i*1.7)*(i===1?30:17);\n  ctx.save();ctx.translate(CX+drift,y);ctx.rotate(Math.sin(t*1.1+i)*.025);\n  ctx.scale(.91+.09*enter,.78+.22*enter);ctx.globalAlpha=enter;\n  text(word,10,12,i===1?260:282,P.cream);\n  text(word,0,0,i===1?260:282,P.ink);ctx.restore();\n });\n star(255,238,102,12,t*.75,P.ink,.35);\n star(1660,824,122,12,-t*.65,P.blue,.36);\n circle(1648,252,47,P.cream);circle(1648,252,23,P.ink);\n halftone(t,'rgba(21,17,28,.32)');\n}\n\n/* 04–08: a continuous plunge through an optical tunnel. */\nfunction tunnel(t){\n background(P.ink);\n const cx=CX+115*Math.sin(t*.9),cy=CY+85*Math.sin(t*1.16);\n ctx.save();ctx.translate(cx,cy);ctx.rotate(t*.24);ctx.scale(1.15,.92);\n const travel=mod(t*.83,1);\n for(let i=27;i>=0;i--){\n  const r=19*Math.exp((i+travel)/4.35);\n  const phase=t*2.5-i*.17;\n  ctx.beginPath();\n  for(let j=0;j<=180;j++){\n   const a=j/180*TAU;const d=r*(1+.085*Math.sin(a*8+phase)+.035*Math.cos(a*3-phase));\n   const x=Math.cos(a)*d,y=Math.sin(a)*d;j?ctx.lineTo(x,y):ctx.moveTo(x,y);\n  }\n  for(let j=180;j>=0;j--){\n   const a=j/180*TAU;const d=r*.835*(1+.085*Math.sin(a*8+phase)+.035*Math.cos(a*3-phase));ctx.lineTo(Math.cos(a)*d,Math.sin(a)*d);\n  }\n  ctx.closePath();ctx.fillStyle=[P.lime,P.violet,P.cream,P.pink][i%4];ctx.fill('evenodd');\n  // Stitched radial accents expose the tunnel's changing twist.\n  if(i%2===0){ctx.strokeStyle=P.ink;ctx.lineWidth=Math.max(1,r*.007);\n   for(let j=0;j<16;j++){const a=j/16*TAU+.06*Math.sin(t+i*.2);ctx.beginPath();ctx.moveTo(Math.cos(a)*r*.84,Math.sin(a)*r*.84);ctx.lineTo(Math.cos(a)*r,Math.sin(a)*r);ctx.stroke()}\n  }\n }\n star(0,0,37+5*Math.sin(t*4),8,-t*1.4,P.cream,.25);ctx.restore();\n}\n\n/* 08–12: a striped torus, projected and depth sorted in Canvas 2D. */\nfunction rotate3(x,y,z,ax,ay,az){\n let a=y*Math.cos(ax)-z*Math.sin(ax),b=y*Math.sin(ax)+z*Math.cos(ax);y=a;z=b;\n a=x*Math.cos(ay)+z*Math.sin(ay);b=-x*Math.sin(ay)+z*Math.cos(ay);x=a;z=b;\n a=x*Math.cos(az)-y*Math.sin(az);b=x*Math.sin(az)+y*Math.cos(az);return[a,b,z];\n}\nfunction shade(hex,light){\n const n=parseInt(hex.slice(1),16);return `rgb(${Math.round((n>>16)*light)},${Math.round(((n>>8)&255)*light)},${Math.round((n&255)*light)})`;\n}\nfunction sculpture(t){\n background(P.cream);\n ctx.save();ctx.translate(CX,CY);ctx.rotate(-.28+t*.09);ctx.strokeStyle=P.ink;ctx.lineWidth=2;\n for(let i=0;i<3;i++){ctx.beginPath();ctx.ellipse(0,0,680+i*38,238+i*54,i*.32,0,TAU);ctx.stroke()}ctx.restore();\n ctx.save();ctx.globalAlpha=.12;ctx.fillStyle=P.ink;ctx.beginPath();ctx.ellipse(CX,922,360+30*Math.sin(t),45,0,0,TAU);ctx.fill();ctx.restore();\n const orbit=t*.8;\n circle(CX+Math.cos(orbit)*690,CY+Math.sin(orbit)*278,38,P.blue);\n circle(CX+Math.cos(orbit+Math.PI)*650,CY+Math.sin(orbit+Math.PI)*310,54,P.pink);\n star(270,815,80,8,t*.4,P.ink,.27);\n const nu=80,nv=24,vertices=[],faces=[];\n const ax=.65+Math.sin(t*.7)*.35,ay=t*.55-.55,az=-.3+t*.22;\n for(let i=0;i<=nu;i++){\n  const u=i/nu*TAU;const row=[];\n  for(let j=0;j<=nv;j++){\n   const v=j/nv*TAU;\n   const major=282+20*Math.cos(u*3-t*1.5);\n   const minor=110+16*Math.sin(u*2+t*1.4);\n   const twist=v+u*.7+t*.4;\n   let x=(major+minor*Math.cos(twist))*Math.cos(u);\n   let y=(major+minor*Math.cos(twist))*Math.sin(u);\n   let z=minor*Math.sin(twist)+55*Math.sin(u*3+t);\n   [x,y,z]=rotate3(x,y,z,ax,ay,az);\n   const perspective=1450/(1450+z),scale=1.25+.045*Math.sin(t*2);\n   row.push({x:CX+x*perspective*scale,y:CY-12+y*perspective*scale,z});\n  }vertices.push(row);\n }\n const bands=[P.ink,P.lime,P.lime,P.pink,P.pink,P.cream,P.blue,P.blue,P.orange,P.orange,P.cream,P.ink];\n for(let i=0;i<nu;i++)for(let j=0;j<nv;j++){\n  const a=vertices[i][j],b=vertices[i+1][j],c=vertices[i+1][j+1],d=vertices[i][j+1];\n  const light=.67+.33*(.5+.5*Math.cos(j/nv*TAU+i/nu*TAU*.7+t*.4-.7));\n  faces.push({p:[a,b,c,d],z:(a.z+b.z+c.z+d.z)/4,color:shade(bands[j%bands.length],light)});\n }\n faces.sort((a,b)=>b.z-a.z);\n for(const face of faces){ctx.beginPath();face.p.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.closePath();ctx.fillStyle=face.color;ctx.strokeStyle=face.color;ctx.lineWidth=.7;ctx.fill();ctx.stroke()}\n // A spare foreground orbit gives the sculpture another depth plane.\n ctx.save();ctx.translate(CX,CY);ctx.rotate(.28);ctx.strokeStyle=P.ink;ctx.lineWidth=3;ctx.beginPath();ctx.ellipse(0,0,710,355,0,.1,Math.PI*.93);ctx.stroke();ctx.restore();\n}\n\n/* 12–16: a warped checkerboard and oversized, elastic letterforms. */\nfunction checkerPoint(x,y,t){\n const dx=x-CX,dy=y-CY,r=Math.hypot(dx,dy);\n const wave=1+.105*Math.sin(r*.009-t*2.6);\n return{x:CX+dx*wave+47*Math.sin(dy*.009+t*1.8),y:CY+dy*wave+40*Math.cos(dx*.008-t*2)};\n}\nfunction opArt(t){\n background(P.violet);ctx.save();ctx.translate(CX,CY);ctx.rotate(.055*Math.sin(t*.9));ctx.translate(-CX,-CY);\n const step=142;\n for(let row=-3;row<12;row++)for(let col=-3;col<18;col++){\n  const x=col*step-70,y=row*step-70;\n  const points=[checkerPoint(x,y,t),checkerPoint(x+step,y,t),checkerPoint(x+step,y+step,t),checkerPoint(x,y+step,t)];\n  ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.closePath();ctx.fillStyle=(row+col)%2===0?P.cream:P.violet;ctx.fill();ctx.strokeStyle=ctx.fillStyle;ctx.lineWidth=1;ctx.stroke();\n }ctx.restore();\n const enter=out(t/.7);\n ctx.save();ctx.translate(CX,CY);ctx.rotate(-.055+Math.sin(t*1.2)*.025);\n const breathing=1+.025*Math.sin(t*3);ctx.scale(breathing,breathing);\n ctx.globalAlpha=enter;\n text('LOSE',-24*Math.sin(t*1.7),-151-(1-enter)*140,350,P.lime,P.ink,23,1520);\n text('CONTROL',24*Math.sin(t*1.7),168+(1-enter)*140,258,P.lime,P.ink,23,1630);\n ctx.restore();\n star(240,190,87,10,t*.8,P.ink,.25);\n star(1690,885,108,10,-t*.8,P.orange,.25);\n circle(1680,195,52,P.ink);circle(1680,195,25,P.lime);\n}\n\n/* 16–20: a kaleidoscopic bloom opens into the final typographic lockup. */\nfunction bloom(t){\n background(P.ink);\n ctx.save();ctx.translate(CX,CY);ctx.rotate(t*.16);\n for(let layer=5;layer>=0;layer--){\n  const count=16,reach=220+layer*102+36*Math.sin(t*2-layer*.55);\n  for(let i=0;i<count;i++){\n   const a=i/count*TAU+(layer%2?.10:-.10)+Math.sin(t*1.4+layer)*.07;\n   ctx.save();ctx.rotate(a);ctx.beginPath();\n   ctx.moveTo(52,0);\n   ctx.bezierCurveTo(reach*.32,-95-layer*9,reach*.92,-178-layer*14,reach,0);\n   ctx.bezierCurveTo(reach*.89,145+layer*13,reach*.27,77+layer*9,52,0);\n   ctx.fillStyle=[P.pink,P.blue,P.lime,P.orange,P.violet,P.cream][mod(i+layer,6)];ctx.fill();\n   ctx.strokeStyle=P.ink;ctx.lineWidth=4;ctx.stroke();\n   ctx.beginPath();ctx.moveTo(82,0);ctx.bezierCurveTo(reach*.45,-34,reach*.75,28,reach*.9,0);ctx.strokeStyle='rgba(21,17,28,.55)';ctx.lineWidth=3;ctx.stroke();ctx.restore();\n  }\n }\n for(let i=4;i>=0;i--){circle(0,0,58+i*28+6*Math.sin(t*3+i),i%2?P.ink:P.lime)}\n star(0,0,44,8,-t*1.5,P.ink,.25);ctx.restore();\n const opening=smooth((t-1.65)/1.05);\n if(opening>0){\n  const r=opening*1250;\n  ctx.save();ctx.beginPath();ctx.arc(CX,CY,r,0,TAU);ctx.clip();background(P.lime);\n  // The same flower geometry survives as a few bold edge arcs.\n  ctx.save();ctx.translate(CX,CY);ctx.rotate(t*.12);\n  for(let i=0;i<8;i++){ctx.save();ctx.rotate(i/8*TAU);ctx.beginPath();ctx.ellipse(1040+22*Math.sin(t*2+i),0,250,420,0,0,TAU);ctx.fillStyle=i%2?P.blue:P.pink;ctx.fill();ctx.restore()}ctx.restore();\n  const reveal=out((t-2.12)/.62);\n  ctx.save();ctx.translate(CX,CY);ctx.scale(.82+.18*reveal,.82+.18*reveal);ctx.globalAlpha=reveal;\n  text('FEEL',0,-147+(1-reveal)*65,325,P.ink,null,0,1500);\n  text('EVERYTHING',0,150+(1-reveal)*85,203,P.ink,null,0,1650);\n  ctx.restore();\n  star(255,200,70,8,t*.65,P.ink,.24);star(1670,870,82,8,-t*.65,P.ink,.24);\n  ctx.restore();\n }\n}\n\nconst scenes=[ignition,tunnel,sculpture,opArt,bloom];\nfunction draw(time){\n const t=clamp(time,0,20),index=Math.min(4,Math.floor(t/4)),local=t-index*4;\n ctx.setTransform(1,0,0,1,0,0);ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';ctx.clearRect(0,0,W,H);\n const transition=.55;\n if(index>0&&local<transition){\n  scenes[index-1](4+local);\n  const p=smooth(local/transition);\n  const x=[0,1090,790,1080,890][index],y=[0,480,590,500,550][index];\n  const maxRadius=Math.hypot(Math.max(x,W-x),Math.max(y,H-y))+50;\n  const radius=p*maxRadius;\n  ctx.save();ctx.beginPath();ctx.arc(x,y,radius,0,TAU);ctx.clip();scenes[index](local);ctx.restore();\n  if(radius>0&&p<.99){ctx.beginPath();ctx.arc(x,y,radius,0,TAU);ctx.strokeStyle=index%2?P.lime:P.cream;ctx.lineWidth=14*(1-p)+2;ctx.stroke()}\n }else{scenes[index](local)}\n}\nconst playhead={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{t:20,duration:20,ease:'none',onUpdate:()=>draw(playhead.t)},0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\ndraw(0);\n</script>\n</body>\n</html>","width":1920,"height":1080,"duration_seconds":20,"assumptions":["Creative choice: a 16:9 psychedelic showreel with acid lime, pink, violet, kinetic typography, an optical tunnel, a procedural torus and a kaleidoscopic finale.","All artwork is original procedural Canvas code. No external assets or named fonts are used; GSAP is supplied locally by the harness.","Silent animation; no soundtrack was supplied or requested. This output has not been rendered or visually reviewed."],"missing_inputs":[],"summary":"Complete editable 20-second HyperFrames animation with five visual movements, circular transitions and one deterministic paused GSAP timeline."}