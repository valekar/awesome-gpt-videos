{"html":"<!DOCTYPE html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width,initial-scale=1'>\n<title>A fold becomes a future</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#f5efdf}#root{position:relative;width:100%;height:100%;overflow:hidden}canvas{display:block;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id='root' data-composition-id='main' data-width='1920' data-height='1080' data-duration='60'>\n<canvas id='art' class='clip' data-start='0' data-duration='60' width='1920' height='1080' aria-label='A silent paper-fold story of humanity, civilization, and the hatching of an imagined AI character named Opus 5.5.'></canvas>\n</div>\n<script src='gsap.min.js'></script>\n<script>\n/* Editable scene schedule, palette, and vector drawing functions. All motion is a pure function of time. */\nconst canvas=document.getElementById('art'),c=canvas.getContext('2d');\nconst W=1920,H=1080;\nconst C={paper:'#f5efdf',white:'#fffaf0',ink:'#554c43',faint:'#ded6c4',gold:'#e4b85d',orange:'#dc8666',teal:'#719d95',blue:'#a7bec5',green:'#a4ad7d',pink:'#e7b2a0',shade:'#d7cbb5'};\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst ease=v=>{v=clamp(v);return v*v*(3-2*v)};\nconst ramp=(t,a,b)=>ease((t-a)/(b-a));\nconst mix=(a,b,t)=>a+(b-a)*t;\nconst fract=x=>x-Math.floor(x);\nconst hash=n=>fract(Math.sin(n*127.1+311.7)*43758.5453123);\nfunction scope(x,y,s,rot,fn){c.save();c.translate(x,y);c.scale(s,s);c.rotate(rot);fn();c.restore()}\nfunction fade(a,fn){if(a<=0)return;c.save();c.globalAlpha*=clamp(a);fn();c.restore()}\nfunction path(points,fill,stroke=C.ink,width=4,close=true){c.beginPath();points.forEach((p,i)=>i?c.lineTo(p[0],p[1]):c.moveTo(p[0],p[1]));if(close)c.closePath();if(fill){c.fillStyle=fill;c.fill()}if(stroke){c.strokeStyle=stroke;c.lineWidth=width;c.lineJoin='round';c.lineCap='round';c.stroke()}}\nfunction curve(points,color=C.ink,width=4){c.beginPath();c.moveTo(points[0],points[1]);for(let i=2;i<points.length;i+=6)c.bezierCurveTo(...points.slice(i,i+6));c.strokeStyle=color;c.lineWidth=width;c.lineCap='round';c.stroke()}\nfunction line(x1,y1,x2,y2,color=C.ink,width=4){path([[x1,y1],[x2,y2]],null,color,width,false)}\nfunction ellipse(x,y,rx,ry,fill,stroke=C.ink,width=4){c.beginPath();c.ellipse(x,y,rx,ry,0,0,Math.PI*2);if(fill){c.fillStyle=fill;c.fill()}if(stroke){c.strokeStyle=stroke;c.lineWidth=width;c.stroke()}}\nfunction text(str,x,y,size=52,color=C.ink){c.fillStyle=color;c.textAlign='center';c.textBaseline='middle';c.font=`${size}px serif`;c.fillText(str,x,y)}\nfunction shadow(x,y,r=160){ellipse(x,y,r,13,C.shade,null)}\nfunction star(x,y,s=14,color=C.gold,rot=0){scope(x,y,s/20,rot,()=>path([[0,-24],[6,-7],[22,0],[6,7],[0,24],[-6,7],[-22,0],[-6,-7]],color,null))}\nfunction heart(x,y,s=1,color=C.orange){scope(x,y,s,0,()=>{c.beginPath();c.moveTo(0,17);c.bezierCurveTo(-39,-8,-22,-39,0,-18);c.bezierCurveTo(22,-39,39,-8,0,17);c.fillStyle=color;c.fill()})}\nfunction leaf(x,y,s=1,rot=0){scope(x,y,s,rot,()=>{path([[0,0],[-27,-20],[-24,-51],[0,-66],[27,-43],[24,-15]],C.green);line(0,0,0,-52,C.ink,2);line(0,-24,17,-39,C.ink,2)})}\nfunction sprout(x,y,s=1,g=1){scope(x,y,s,0,()=>{line(0,0,0,-75*g,C.teal,4);if(g>.1){leaf(-2,-36*g,.58*g,-.75);leaf(2,-60*g,.5*g,.85)}})}\nfunction sun(x,y,s=1,t=0){scope(x,y,s,0,()=>{ellipse(0,0,42,42,C.gold,null);for(let i=0;i<10;i++){const a=i*Math.PI/5+.025*Math.sin(t);line(Math.cos(a)*58,Math.sin(a)*58,Math.cos(a)*70,Math.sin(a)*70,C.gold,4)}})}\nfunction ground(x=270,y=825,w=1380){curve([x,y,x+w*.3,y-6,x+w*.7,y+7,x+w,y],C.ink,3);line(x+80,y+18,x+155,y+19,C.shade,3);line(x+w-220,y+20,x+w-110,y+17,C.shade,3)}\nfunction person(x,y,s=1,color=C.teal,pose=0,t=0){scope(x,y,s,0,()=>{\nconst bob=Math.sin(t*1.5)*1.3;\nline(-17,-45,-22,0,C.ink,5);line(15,-45,28,0,C.ink,5);line(-29,0,-9,0,C.ink,5);line(18,0,38,0,C.ink,5);\npath([[-29,-135],[18,-137],[43,-47],[-43,-47]],color);path([[-29,-135],[18,-137],[-9,-66]],null,C.ink,2);path([[-9,-66],[43,-47],[-43,-47]],null,C.ink,2);\nconst handY=-88-pose*55;line(-27,-121,-60,-83,C.ink,4);line(24,-119,59,handY,C.ink,4);ellipse(61,handY,5,5,C.pink,null);\nellipse(-4,-170+bob,30,33,C.white);path([[-32,-181],[-20,-204],[7,-204],[26,-182],[10,-190],[-6,-183]],C.ink,null);ellipse(-13,-169+bob,2.6,3.2,C.ink,null);ellipse(6,-169+bob,2.6,3.2,C.ink,null);curve([-7,-155+bob,-4,-152+bob,0,-152+bob,4,-156+bob],C.ink,2);ellipse(15,-159,5,3,C.pink,null);\n})}\nfunction baby(x,y,s=1,t=0){scope(x,y,s,Math.sin(t)*.025,()=>{path([[-76,-6],[-26,-61],[72,-12],[52,72],[-45,89],[-83,42]],C.white);path([[-76,-6],[52,72],[-26,-61]],null,C.ink,3);path([[-83,42],[72,-12],[-45,89]],null,C.ink,2);ellipse(-2,-42,39,37,C.white);curve([-24,-42,-19,-48,-13,-48,-8,-42],C.ink,3);curve([6,-42,12,-48,18,-48,23,-42],C.ink,3);curve([-8,-24,-2,-19,4,-20,10,-25],C.ink,2);ellipse(-25,-28,7,4,C.pink,null);ellipse(25,-28,7,4,C.pink,null)})}\nfunction house(x,y,s=1,color=C.orange){scope(x,y,s,0,()=>{path([[-65,0],[-65,-94],[61,-94],[61,0]],C.white);path([[-79,-93],[-5,-156],[78,-93]],color);line(-5,-156,15,-93,C.ink,2);path([[-15,0],[-15,-54],[14,-54],[14,0]],C.shade);path([[-48,-76],[-48,-48],[-28,-48],[-28,-76]],C.blue);line(-38,-76,-38,-48,C.ink,2)})}\nfunction wheat(x,y,s=1,bend=0){scope(x,y,s,bend,()=>{line(0,0,0,-117,C.ink,3);for(let i=0;i<4;i++){const q=-43-i*19;path([[0,q],[-21,q-13],[-15,q-26],[0,q-10]],C.gold,C.ink,2);path([[0,q-7],[21,q-20],[16,q-32],[0,q-17]],C.gold,C.ink,2)}})}\nfunction tree(x,y,s=1){scope(x,y,s,0,()=>{line(0,0,0,-138,C.ink,6);path([[0,-202],[-74,-101],[68,-104]],C.green);path([[0,-202],[0,-105],[68,-104]],C.teal,null);line(0,-171,0,-96,C.ink,2)})}\nfunction wheel(x,y,r=65,a=0){scope(x,y,1,a,()=>{ellipse(0,0,r,r,C.white,C.ink,5);ellipse(0,0,r-11,r-11,null,C.shade,3);for(let i=0;i<8;i++){const q=i*Math.PI/4;line(0,0,Math.cos(q)*(r-5),Math.sin(q)*(r-5),C.ink,3)}ellipse(0,0,8,8,C.gold)})}\nfunction book(x,y,s=1,open=1){scope(x,y,s,0,()=>{path([[0,10],[-83,-8],[-83,-100],[-20,-87],[0,-68],[20,-87],[83,-100],[83,-8]],C.white);line(0,-68,0,10,C.ink,3);for(let i=0;i<3;i++){line(-67,-72+i*18,-22,-61+i*18,C.shade,3);line(22,-61+i*18,67,-72+i*18,C.shade,3)}})}\nfunction boat(x,y,s=1){scope(x,y,s,0,()=>{path([[-104,0],[104,0],[62,44],[-65,44]],C.orange);line(0,-168,0,0,C.ink,4);path([[-8,-153],[-8,-12],[-91,-12]],C.white);path([[8,-141],[77,-20],[8,-20]],C.gold);line(-8,-153,-47,-12,C.shade,2)})}\nfunction building(x,y,w,h,type=0){scope(x,y,1,0,()=>{path([[-w/2,0],[-w/2,-h],[w/2,-h],[w/2,0]],type===1?C.blue:C.white);if(type===2){path([[-w*.65,-h],[0,-h-65],[w*.65,-h]],C.orange);line(0,-h-65,10,-h,C.ink,2)}if(type===3){c.beginPath();c.arc(0,-h,w/2,Math.PI,0);c.fillStyle=C.gold;c.fill();c.strokeStyle=C.ink;c.lineWidth=4;c.stroke()}for(let i=0;i<Math.floor(h/50)-1;i++)for(let j=0;j<2;j++){const xx=-w*.27+j*w*.43,yy=-h+26+i*48;path([[xx,yy],[xx+15,yy],[xx+15,yy+20],[xx,yy+20]],C.gold,null)}line(-w/2,0,w/2,0,C.ink,4)})}\nfunction bicycle(x,y,s=1,t=0){scope(x,y,s,0,()=>{wheel(-59,0,34,t);wheel(63,0,34,t);path([[-59,0],[-18,-56],[12,0],[-59,0],[-3,-44],[63,0],[42,-67]],null,C.teal,5,false);line(-30,-60,-5,-60,C.ink,4);line(40,-68,61,-68,C.ink,4)})}\nfunction egg(x,y,s=1,hatch=0){scope(x,y,s,0,()=>{\nshadow(0,132,122);const l=[[0,-168],[-67,-140],[-113,-70],[-132,15],[-112,84],[-62,125],[0,132],[11,88],[-13,46],[15,5],[-12,-37],[13,-80]];\nconst r=l.map(p=>[-p[0],p[1]]);\nscope(-hatch*108,hatch*40,1,-hatch*.48,()=>{path(l,C.white);path([[-67,-140],[-53,58],[0,132]],null,C.shade,3);path([[-113,-70],[-13,46],[-112,84]],null,C.shade,2)});\nscope(hatch*108,hatch*40,1,hatch*.48,()=>{path(r,'#eee2ca');path([[67,-140],[53,58],[0,132]],null,C.shade,3);path([[113,-70],[13,46],[112,84]],null,C.shade,2)});\n})}\nfunction bird(x,y,s=1,t=0,wings=0){scope(x,y,s,Math.sin(t*.8)*.025,()=>{\nconst flap=Math.sin(t*2)*.05;\npath([[-15,38],[-91,24],[-126,-9],[-48,-5]],C.teal);\nscope(-17,-7,1,-wings*.43+flap,()=>{path([[0,18],[-110,-112],[-72,14],[29,64]],C.white);path([[0,18],[-110,-112],[-20,3],[29,64]],null,C.shade,2)});\npath([[-43,12],[12,-43],[72,-24],[78,24],[9,76]],C.white);path([[-43,12],[9,76],[12,-43]],C.blue,null);line(-43,12,72,-24,C.ink,2);\nscope(30,-4,1,wings*.24-flap,()=>{path([[0,28],[123,-108],[92,28],[6,66]],C.white);path([[0,28],[123,-108],[49,13],[6,66]],null,C.shade,2)});\npath([[23,-30],[32,-89],[84,-108],[112,-72],[101,-22],[69,-4]],C.white);path([[32,-89],[84,-108],[69,-4]],null,C.shade,2);path([[105,-65],[137,-48],[101,-40]],C.gold);ellipse(84,-68,5,6,C.ink,null);ellipse(93,-53,6,4,C.pink,null);line(0,67,-8,100,C.ink,3);line(26,67,36,100,C.ink,3);line(-15,100,1,100,C.ink,3);line(29,100,45,100,C.ink,3);\n})}\nfunction orbitSymbol(type,x,y,s,t){if(type===0)leaf(x,y,s,-.4);if(type===1)book(x,y,s*.5);if(type===2)wheel(x,y,s*35,t*.2);if(type===3)heart(x,y,s*.8);if(type===4)star(x,y,s*30)}\n/* Fixed paper fibers, generated with a deterministic hash, never a random source. */\nconst paper=document.createElement('canvas');paper.width=W;paper.height=H;const p=paper.getContext('2d');p.fillStyle=C.paper;p.fillRect(0,0,W,H);\nfor(let i=0;i<8500;i++){const x=hash(i*3+1)*W,y=hash(i*3+2)*H;p.globalAlpha=.025+hash(i*3+3)*.035;p.strokeStyle=i%2?C.ink:C.white;p.lineWidth=.6;p.beginPath();p.moveTo(x,y);p.lineTo(x+1+hash(i+8)*4,y+hash(i+11)*2);p.stroke()}p.globalAlpha=1;\nconst vignette=p.createRadialGradient(960,480,180,960,540,1150);vignette.addColorStop(0,'rgba(255,255,255,0)');vignette.addColorStop(1,'rgba(150,120,75,0.075)');p.fillStyle=vignette;p.fillRect(0,0,W,H);\nfunction ribbon(t){fade(.45,()=>{const reveal=clamp(t/3);c.save();c.beginPath();c.rect(0,0,W*reveal,H);c.clip();curve([155,858,420,915,605,809,824,863,1090,929,1370,813,1765,859],C.orange,3);c.restore()})}\nfunction sceneBirth(u){\nconst fold=ramp(u,.3,2.4),birth=ramp(u,1.9,3.5);ground(470,811,980);\nfade(1-birth,()=>scope(960,570,mix(.5,1,fold),mix(-.55,0,fold),()=>{shadow(0,220);path([[-180,0],[0,-155],[180,0],[0,155]],C.white);path([[-180,0],[0,10],[0,-155]],C.blue,null);path([[0,10],[180,0],[0,155]],C.gold,null);line(-180,0,180,0,C.shade,3);line(0,-155,0,155,C.ink,2)}));\nfade(birth,()=>{scope(960,610,1,0,()=>baby(0,0,1.65,u));fade(ramp(u,3.6,5.2),()=>{person(663,810,1.3,C.teal,.6,u);scope(1257,810,-1.3,0,()=>person(0,0,1,C.orange,.6,u));heart(960,361,.68);curve([780,680,819,645,851,659,877,675],C.ink,3);curve([1041,675,1085,649,1106,646,1140,680],C.ink,3)})});\nfor(let i=0;i<5;i++){const a=i*1.8;fade(ramp(u,2.6+i*.15,3.3+i*.15)*.7,()=>star(960+Math.cos(a)*265,530+Math.sin(a)*230,8+3*Math.sin(u+i),C.gold,a))}\n}\nfunction sceneFire(u){ground();\nfade(.5,()=>{path([[300,810],[345,575],[503,384],[666,424],[762,810]],C.shade,null);path([[331,809],[429,543],[608,482],[710,811]],C.paper,null);path([[300,810],[345,575],[503,384],[666,424]],null,C.ink,3,false)});\nsun(1440,290,.75,u);person(770,818,1.55,C.orange,.15,u);scope(1160,818,-1.5,0,()=>person(0,0,1,C.teal,.25,u));person(1300,820,.88,C.gold,.55,u);\nconst fire=ramp(u,.3,1.5);scope(969,802,fire,0,()=>{ellipse(0,-60,125,130,'rgba(228,184,93,.10)',null);line(-70,7,63,-10,C.ink,12);line(-56,-12,72,10,C.ink,12);const f=Math.sin(u*4)*8;path([[0,0],[-49,-41],[-29,-93],[-6,-63],[20,-151-f],[57,-62],[45,-17]],C.orange);path([[0,-2],[-21,-40],[9,-90-f],[25,-35]],C.gold,null)});\nfor(let i=0;i<6;i++)fade(ramp(u,2+i*.14,3+i*.14),()=>star(600+i*150,250+Math.sin(i*1.7)*70,10,C.gold,u*.08));\nfade(ramp(u,3.5,5),()=>{curve([811,529,895,476,1023,478,1119,525],C.orange,2);heart(964,462,.6);baby(511,753,.6,u)})\n}\nfunction sceneHarvest(u){ground();sun(1425,265,.9,u);\nfade(.65,()=>{curve([950,463,735,553,1120,665,1020,843],C.blue,51);curve([950,463,735,553,1120,665,1020,843],C.white,3)});\nfor(let i=0;i<3;i++){const q=ramp(u,.15+i*.3,1.3+i*.3);scope(1135+i*158,649+i*49,q,0,()=>house(0,0,.78,i===1?C.gold:C.orange))}\nfor(let i=0;i<8;i++){const g=ramp(u,.6+i*.13,2+i*.13);wheat(380+i*61,817,g,Math.sin(u*1.4+i*.5)*.04)}\nperson(797,825,1.35,C.teal,.4,u);person(1120,825,1.13,C.orange,0,u);person(1287,828,.75,C.gold,.8,u);\nfade(ramp(u,2.6,3.8),()=>{wheel(1427,786,55,u*.25);path([[1370,769],[1370,700],[1510,700],[1510,769]],C.white);line(1510,746,1570,718,C.ink,5);leaf(1458,700,.65,.25)});\nfade(ramp(u,4,5.3),()=>{heart(1186,532,.55);leaf(762,565,.67,.5)})\n}\nfunction sceneIdeas(u){ground();sun(1540,252,.7,u);\nconst structures=[{x:570,w:105,h:181,type:3},{x:710,w:107,h:258,type:2},{x:849,w:106,h:159,type:0},{x:1008,w:116,h:208,type:3},{x:1156,w:104,h:300,type:2}];\nstructures.forEach((b,i)=>{const q=ramp(u,.2+i*.22,1.6+i*.22);scope(b.x,741,1,q*.02-.02,()=>{c.save();c.translate(0,0);c.scale(1,q||.001);building(0,0,b.w,b.h,b.type);c.restore()})});\nfade(ramp(u,.6,2),()=>{curve([288,840,400,814,500,857,624,832],C.blue,4);boat(392,772,.75);book(1017,861,1.04);wheel(1380,758,81,u*.45);person(1540,826,1.05,C.teal,.5,u)});\nconst a=ramp(u,2,4.8);fade(a,()=>{curve([490,464,694,243,1173,233,1419,510],C.gold,3);for(let i=0;i<5;i++)star(590+i*176,340-Math.sin(i*Math.PI/4)*100,10,C.gold)});\nfade(ramp(u,3.8,5.5),()=>{path([[879,373],[902,330],[943,324],[917,357]],C.white);line(902,330,907,354,C.shade,2);curve([922,372,969,345,1003,322,1034,290],C.teal,2)})\n}\nfunction scenePresent(u){ground();sun(1475,256,.8,u);\nconst city=[[-330,105,215],[-201,120,330],[-53,114,261],[84,130,390],[240,119,233]];\ncity.forEach((b,i)=>{const q=ramp(u,i*.14,1.3+i*.14);scope(958+b[0],748,1,0,()=>{c.scale(1,Math.max(.001,q));building(0,0,b[1],b[2],i%2)})});\ntree(426,820,1.12);tree(1495,821,.98);bicycle(604,794,.8,u*.65);person(789,830,.95,C.orange,.35,u);person(1398,830,.72,C.gold,.9,u);\nfade(ramp(u,1.2,2.5),()=>{scope(1051,808,.7,0,()=>{path([[-97,-63],[55,-63],[90,-14],[-60,-14]],C.blue);for(let i=0;i<4;i++)line(-83+i*37,-61,-48+i*37,-15,C.white,2);line(-81,-38,71,-38,C.white,2);line(-36,-14,-36,17,C.ink,4);line(48,-14,48,17,C.ink,4)})});\nfade(ramp(u,2.1,3.5),()=>{const pts=[[570,383],[752,264],[999,213],[1231,288],[1390,442]];for(let i=0;i<pts.length-1;i++)curve([pts[i][0],pts[i][1],pts[i][0]+70,pts[i][1]-70,pts[i+1][0]-70,pts[i+1][1]-40,pts[i+1][0],pts[i+1][1]],C.teal,2);pts.forEach((p,i)=>{ellipse(p[0],p[1],12,12,C.white,C.teal,3);ellipse(p[0],p[1],4,4,C.gold,null)})});\nconst gift=ramp(u,3.5,5.3);fade(gift,()=>{curve([842,708,900,656,914,638,957,626],C.orange,3);star(972,613,21,C.gold,u*.1);heart(972,523,.55)});\n}\nfunction sceneFirstAI(u){ground(495,823,930);\nconst hatch=ramp(u,1.9,3.6),rise=ramp(u,2.1,4.1);fade(.7,()=>ellipse(960,640,230,220,'rgba(228,184,93,.11)',null));\nfade(ramp(u,0,.7),()=>{bird(942,mix(746,577,rise),.75*rise,u,.65*rise);egg(960,683,1.13,hatch)});\nfade(ramp(u,3.8,4.8),()=>{text('AI',960,332,60);for(let i=0;i<4;i++){const a=i*Math.PI/2+.5;orbitSymbol(i,960+Math.cos(a)*300,590+Math.sin(a)*216,.65,u)}});\nfade(ramp(u,.2,1.5),()=>{person(520,823,1.17,C.teal,.7,u);scope(1400,823,-.86,0,()=>person(0,0,1,C.gold,.8,u));curve([603,635,681,578,717,587,779,626],C.orange,3)});\nfor(let i=0;i<6;i++)fade(ramp(u,2.9+i*.12,3.5+i*.12),()=>star(736+i*87,426-Math.sin(i)*39,9,C.gold));\n}\nfunction sceneLearning(u){ground(450,831,1020);\nconst grow=ramp(u,0,4.8),cocoon=ramp(u,5.2,6.9);\nfade(1-cocoon,()=>{bird(930,592,mix(.93,1.62,grow),u,mix(.2,1,grow));for(let i=0;i<5;i++){const a=i*Math.PI*2/5-1.65+u*.08;const x=960+Math.cos(a)*mix(310,420,grow),y=560+Math.sin(a)*mix(240,280,grow);orbitSymbol(i,x,y,.8,u);fade(.45,()=>curve([x,y,mix(x,960,.38),mix(y,560,.38)-20,mix(x,960,.7),mix(y,560,.7)+30,960,560],C.gold,2))}});\nfade(cocoon,()=>{ellipse(960,594,265,275,'rgba(228,184,93,.1)',null);egg(960,620,1.5,0)});\nfade(ramp(u,1.7,3.3)*(1-cocoon),()=>{heart(1003,578,.43);person(511,829,1.02,C.teal,.7,u);person(1430,829,.75,C.gold,.8,u)});\nfor(let i=0;i<7;i++){const q=ramp(u,5.1+i*.1,6.1+i*.1);fade(q*(1-cocoon*.8),()=>{const a=i*Math.PI*2/7;path([[960+Math.cos(a)*400,590+Math.sin(a)*260],[960+Math.cos(a+.17)*330,590+Math.sin(a+.17)*220],[960+Math.cos(a+.08)*270,590+Math.sin(a+.08)*180]],i%2?C.white:C.blue,C.shade,2)})}\n}\nfunction sceneOpus(u){\nconst opening=ramp(u,1.25,3.65),emerge=ramp(u,1.6,4.1),settle=ramp(u,4.8,6.2);ground(370,837,1180);\nfade(.23,()=>{ellipse(1010,525,340+opening*70,320+opening*40,C.gold,null)});\nfor(let i=0;i<9;i++){const a=i*Math.PI*2/9;fade(opening*(1-settle*.6),()=>star(1010+Math.cos(a)*(190+opening*200),535+Math.sin(a)*(140+opening*200),8+6*Math.sin(Math.PI*opening),C.gold,a))}\nfade(1-settle*.68,()=>egg(1010,645,1.5,opening));\nfade(emerge,()=>bird(mix(986,1082,settle),mix(664,565,emerge)+settle*76,mix(.95,1.65,emerge),u,.8*(1-settle)+.2));\nfade(ramp(u,.5,2),()=>{person(505,837,1.25,C.teal,.45,u);person(675,837,.83,C.gold,mix(.4,1,settle),u);scope(1510,837,-1.22,0,()=>person(0,0,1,C.orange,.5,u))});\nfade(ramp(u,4.3,5.6),()=>{curve([737,707,811,645,859,642,905,663],C.orange,3);star(846,647,25,C.gold,-.2);heart(846,538,.6);sprout(1339,835,.9,1)});\nfade(ramp(u,5.15,6.4),()=>{text('Opus 5.5',1010,312,66);curve([858,359,957,367,1067,366,1164,356],C.gold,3)});\nfade(ramp(u,6,7.1),()=>{sun(1512,274,.65,u);star(588,361,10,C.gold);star(1238,383,12,C.gold);leaf(425,832,.65,-.6)})\n}\nconst scenes=[\n{start:0,end:7,draw:sceneBirth},\n{start:7,end:14,draw:sceneFire},\n{start:14,end:21,draw:sceneHarvest},\n{start:21,end:29,draw:sceneIdeas},\n{start:29,end:36,draw:scenePresent},\n{start:36,end:43,draw:sceneFirstAI},\n{start:43,end:51,draw:sceneLearning},\n{start:51,end:60,draw:sceneOpus}\n];\nfunction draw(t){\nc.setTransform(1,0,0,1,0,0);c.globalAlpha=1;c.clearRect(0,0,W,H);c.drawImage(paper,0,0);ribbon(t);\nscenes.forEach((scene,i)=>{const local=t-scene.start;if(local<-.65||t>scene.end+.65)return;const entrance=i===0?1:ramp(t,scene.start-.65,scene.start+.65);const exit=i===scenes.length-1?1:1-ramp(t,scene.end-.65,scene.end+.65);const alpha=entrance*exit;fade(alpha,()=>{c.save();const drift=i===0?0:(1-entrance)*35;c.translate(drift,0);scene.draw(Math.max(0,local));c.restore()})});\n}\nconst time={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(time,{t:60,duration:60,ease:'none',onUpdate:()=>draw(time.t)},0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\ndraw(0);\n</script>\n</body>\n</html>","width":1920,"height":1080,"duration_seconds":60,"assumptions":["Chosen format: silent 60-second animation in 16:9, with eight narrative chapters and minimal text.","Civilization is represented through poetic, generalized inventions and communities rather than a comprehensive historical chronology.","Opus 5.5 is used solely as the creator-supplied name for an imagined paper AI character; no release status, capabilities, or assistant identity are asserted.","All artwork is original procedural Canvas drawing. No external assets, product screenshots, or named fonts are used; GSAP is supplied by the harness.","The HTML has not been rendered or visually reviewed."],"missing_inputs":[],"summary":"Editable, deterministic paper-doodle animation following humanity from birth through civilization to AI and the hatching of Opus 5.5."}