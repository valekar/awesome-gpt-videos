  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>AllInvestView — A clearer picture</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#091713;font-family:Arial,Helvetica,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden;color:#f5f5e9;--mint:#bdfb9a;--muted:#a3b6ac;--orange:#ffab76}.clip{position:absolute;inset:0}.scene{position:absolute;inset:0;opacity:0;overflow:hidden}.s1{opacity:1}h1,h2,p{margin:0}h1,h2{font-weight:600;letter-spacing:-6px;line-height:1.02}.accent{color:var(--mint)}.sub{font-size:32px;line-height:1.4;color:var(--muted);letter-spacing:-.5px}.reveal{opacity:0}.eyebrow{font-size:27px;letter-spacing:4px;text-transform:uppercase;color:var(--mint)}.pill{border:1px solid #bdfb9a55;border-radius:100px;padding:17px 30px;font-size:29px;color:var(--mint);background:#bdfb9a09}.grid{position:absolute;inset:-250px;background-image:linear-gradient(#bdfb9a08 1px,transparent 1px),linear-gradient(90deg,#bdfb9a08 1px,transparent 1px);background-size:90px 90px;transform:rotate(-12deg)}.halo{position:absolute;width:1200px;height:1200px;border:1px solid #bdfb9a16;border-radius:50%;left:360px;top:-60px}.halo:before,.halo:after{content:'';position:absolute;border:1px solid #bdfb9a12;border-radius:50%;inset:100px}.halo:after{inset:220px}.vignette{position:absolute;inset:0;background:radial-gradient(ellipse at center,transparent 15%,#091713d9 85%)}.brand{font-weight:600;letter-spacing:-3px}.asset{position:absolute;width:280px;height:120px;display:flex;align-items:center;gap:20px;padding:24px;border-radius:25px;border:1px solid #bdfb9a38;background:#14271f;box-shadow:0 22px 60px #0003;font-size:32px}.asset svg{width:58px;height:58px;stroke:var(--mint);fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;flex:none}.hero-copy{position:absolute;left:120px;top:338px;width:1680px;text-align:center}.hero-copy h1{font-size:124px}.hero-copy .sub{margin-top:29px}.hero-line{display:block}.s2 .copy{position:absolute;left:120px;top:250px;width:650px}.s2 h2{font-size:106px;margin-top:28px}.s2 .sub{margin-top:30px;max-width:570px}.product-art{position:absolute;left:780px;top:240px;width:1080px;height:650px;display:flex;align-items:center;justify-content:center;transform-origin:center}.product-art:before{content:'';position:absolute;width:780px;height:780px;border-radius:50%;background:radial-gradient(circle,#bdfb9a26,transparent 65%);z-index:-1}.product-art img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 35px 40px #0005)}.s2 .pill{position:absolute;left:124px;top:820px}.s3 h2{font-size:106px;position:absolute;left:120px;top:115px}.s3 .sub{position:absolute;left:124px;top:258px}.flow{position:absolute;left:120px;top:375px;width:1680px;height:510px}.flow svg.wires{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.method{position:absolute;left:0;width:520px;height:112px;border:1px solid #c4dfce35;border-radius:24px;background:#14271f;display:flex;align-items:center;padding:0 34px;gap:28px;font-size:36px}.method-icon{height:52px;width:52px;display:grid;place-items:center;color:var(--mint);font-size:40px}.method:nth-of-type(1){top:0}.method:nth-of-type(2){top:180px}.method:nth-of-type(3){top:360px}.hub{position:absolute;right:0;top:50px;width:640px;height:390px;border-radius:42px;background:#bdfb9a;color:#112219;padding:54px;box-shadow:0 0 110px #bdfb9a14}.hub .brand{font-size:58px}.hub .hub-title{font-size:47px;line-height:1.1;letter-spacing:-2px;margin-top:53px}.hub .hub-bottom{font-size:27px;margin-top:24px;color:#35503c}.s4 .copy{position:absolute;left:120px;top:160px;width:710px}.s4 h2{font-size:105px;margin-top:28px}.s4 .sub{margin-top:34px;max-width:640px}.analytics{position:absolute;left:930px;top:135px;width:790px;height:790px}.analytics svg{width:100%;height:100%;overflow:visible}.analytics .center{position:absolute;left:235px;top:305px;width:320px;text-align:center;font-size:39px;line-height:1.15;letter-spacing:-1px}.feature-row{position:absolute;left:120px;bottom:160px;display:flex;gap:16px;flex-wrap:wrap;width:830px}.feature-row .pill{font-size:26px;padding:15px 24px}.s5 h2{position:absolute;top:110px;left:120px;font-size:101px}.feature-card{position:absolute;top:335px;width:800px;height:565px;background:#14271f;border:1px solid #bdfb9a36;border-radius:40px;padding:44px;overflow:hidden}.dividend-card{left:120px}.tax-card{left:1000px}.feature-card h3{font-size:47px;letter-spacing:-1.5px;margin:0}.feature-card p{font-size:29px;color:var(--muted);margin-top:15px}.calendar{position:absolute;left:48px;right:48px;top:210px;display:grid;grid-template-columns:repeat(7,1fr);gap:13px}.day{height:65px;border-radius:13px;background:#21382c;border:1px solid #bdfb9a0a;position:relative}.day.hit{background:#bdfb9a;color:#14271f}.day.hit:after{content:'↓';font-size:43px;position:absolute;inset:6px;text-align:center}.document{position:absolute;left:202px;top:220px;width:390px;height:430px;background:#f1f3df;border-radius:22px;padding:33px;transform:rotate(-7deg);color:#14271f;box-shadow:0 20px 40px #0003}.doc-title{font-size:31px;font-weight:bold;letter-spacing:-1px}.doc-line{height:9px;border-radius:9px;background:#17332420;margin-top:28px}.doc-line.short{width:60%}.doc-stamp{position:absolute;right:35px;top:150px;border:2px solid #36583c;border-radius:50%;width:78px;height:78px;display:grid;place-items:center;font-size:40px;color:#36583c}.export{position:absolute;right:45px;bottom:37px;padding:16px 25px;background:#bdfb9a;border-radius:30px;color:#14271f;font-size:26px}.wipe{position:absolute;left:930px;top:510px;width:60px;height:60px;border-radius:50%;background:#bdfb9a;transform:scale(0)}.s6{color:#10271c;text-align:center}.s6 .brand{position:absolute;left:120px;right:120px;top:185px;font-size:91px}.s6 h2{position:absolute;left:120px;right:120px;top:355px;font-size:137px;line-height:1.02;letter-spacing:-7px}.cta{position:absolute;left:700px;top:726px;width:520px;height:100px;border-radius:60px;background:#10271c;color:#e9f4df;display:flex;align-items:center;justify-content:center;gap:35px;font-size:36px}.url{position:absolute;left:120px;right:120px;top:866px;font-size:31px;letter-spacing:-.6px}.end-ring{position:absolute;left:310px;top:-110px;width:1300px;height:1300px;border:1px solid #10271c20;border-radius:50%;pointer-events:none}.end-ring:after{content:'';position:absolute;inset:65px;border:1px solid #10271c15;border-radius:50%}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"30\">\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n<symbol id=\"stocks\" viewBox=\"0 0 64 64\"><path d=\"M10 49V15M10 49h45M17 39l11-12 10 6 16-18M43 15h11v11\"/></symbol>\n<symbol id=\"etf\" viewBox=\"0 0 64 64\"><rect x=\"10\" y=\"10\" width=\"18\" height=\"18\" rx=\"4\"/><rect x=\"36\" y=\"10\" width=\"18\" height=\"18\" rx=\"4\"/><rect x=\"10\" y=\"36\" width=\"18\" height=\"18\" rx=\"4\"/><rect x=\"36\" y=\"36\" width=\"18\" height=\"18\" rx=\"4\"/></symbol>\n<symbol id=\"bond\" viewBox=\"0 0 64 64\"><rect x=\"13\" y=\"8\" width=\"38\" height=\"47\" rx=\"5\"/><path d=\"M23 20h18M23 29h18M24 55v6l8-4 8 4v-6\"/><circle cx=\"32\" cy=\"42\" r=\"6\"/></symbol>\n<symbol id=\"options\" viewBox=\"0 0 64 64\"><path d=\"M9 44h17l13-25h16M9 20h16l14 24h16\"/><path d=\"m48 12 8 7-8 7M48 37l8 7-8 7\"/></symbol>\n<symbol id=\"crypto\" viewBox=\"0 0 64 64\"><path d=\"m32 6 19 26-19 12-19-12zM13 39l19 19 19-19M32 6v38\"/></symbol>\n<symbol id=\"property\" viewBox=\"0 0 64 64\"><path d=\"m8 29 24-20 24 20M15 24v31h34V24M27 55V36h11v19\"/></symbol>\n</defs></svg>\n<div class=\"clip\" data-start=\"0\" data-duration=\"30\" data-track-index=\"0\"><div class=\"grid\"></div><div id=\"ambient\" class=\"halo\"></div><div class=\"vignette\"></div></div>\n<div class=\"clip\" data-start=\"0\" data-duration=\"30\" data-track-index=\"1\">\n<section class=\"scene s1\">\n<div class=\"asset a1\" style=\"left:180px;top:130px;transform:rotate(-9deg)\"><svg><use href=\"#stocks\"/></svg>Stocks</div>\n<div class=\"asset a2\" style=\"left:820px;top:80px;transform:rotate(5deg)\"><svg><use href=\"#etf\"/></svg>ETFs</div>\n<div class=\"asset a3\" style=\"left:1440px;top:158px;transform:rotate(10deg)\"><svg><use href=\"#bond\"/></svg>Bonds</div>\n<div class=\"asset a4\" style=\"left:190px;top:805px;transform:rotate(7deg)\"><svg><use href=\"#options\"/></svg>Options</div>\n<div class=\"asset a5\" style=\"left:817px;top:867px;transform:rotate(-6deg)\"><svg><use href=\"#crypto\"/></svg>Crypto</div>\n<div class=\"asset a6\" style=\"left:1450px;top:797px;transform:rotate(-8deg)\"><svg><use href=\"#property\"/></svg>Real estate</div>\n<div class=\"hero-copy\"><h1><span class=\"hero-line reveal\">Your investments.</span><span class=\"hero-line accent reveal\">A clearer picture.</span></h1><p class=\"sub reveal\">Bring it all into view.</p></div>\n</section>\n<section class=\"scene s2\">\n<div class=\"copy\"><p class=\"eyebrow reveal\">AllInvestView</p><h2 class=\"reveal\">The whole<br>portfolio.<br><span class=\"accent\">Together.</span></h2><p class=\"sub reveal\">Track different asset classes<br>in one dashboard.</p></div>\n<div class=\"product-art reveal\"><img src=\"https://www.allinvestview.com/static/tablets_v2_compressed.png\" alt=\"Official AllInvestView promotional image showing its portfolio dashboard on multiple devices\" loading=\"eager\" decoding=\"sync\"></div>\n<div class=\"pill reveal\">Multiple assets. One perspective.</div>\n</section>\n<section class=\"scene s3\">\n<h2 class=\"reveal\">Bring your portfolio <span class=\"accent\">in.</span></h2><p class=\"sub reveal\">Choose how you connect.</p>\n<div class=\"flow\">\n<svg class=\"wires\" viewBox=\"0 0 1680 510\" fill=\"none\"><g stroke=\"#bdfb9a20\" stroke-width=\"3\"><path d=\"M520 56H710Q760 56 760 106V255H1040\"/><path d=\"M520 236H1040\"/><path d=\"M520 416H710Q760 416 760 366V255H1040\"/></g><g class=\"flow-strokes\" stroke=\"#bdfb9a\" stroke-width=\"4\" stroke-linecap=\"round\"><path d=\"M520 56H710Q760 56 760 106V255H1040\"/><path d=\"M520 236H1040\"/><path d=\"M520 416H710Q760 416 760 366V255H1040\"/></g></svg>\n<div class=\"method reveal\"><span class=\"method-icon\">⇄</span>Broker sync</div><div class=\"method reveal\"><span class=\"method-icon\">↥</span>CSV import</div><div class=\"method reveal\"><span class=\"method-icon\">＋</span>Manual entry</div>\n<div class=\"hub reveal\"><div class=\"brand\">AllInvestView</div><div class=\"hub-title\">One connected<br>portfolio view.</div><p class=\"hub-bottom\">Read-only broker connections</p></div>\n</div>\n</section>\n<section class=\"scene s4\">\n<div class=\"copy\"><p class=\"eyebrow reveal\">Explore the detail</p><h2 class=\"reveal\">See beyond<br><span class=\"accent\">the balance.</span></h2><p class=\"sub reveal\">Explore performance, exposure<br>and portfolio risk.</p></div>\n<div class=\"analytics reveal\"><svg viewBox=\"0 0 790 790\" fill=\"none\"><circle cx=\"395\" cy=\"395\" r=\"360\" stroke=\"#bdfb9a20\"/><circle cx=\"395\" cy=\"395\" r=\"290\" stroke=\"#bdfb9a18\" stroke-dasharray=\"3 13\"/><circle cx=\"395\" cy=\"395\" r=\"225\" stroke=\"#bdfb9a20\"/><g id=\"orbit\"><circle cx=\"395\" cy=\"395\" r=\"325\" stroke=\"#bdfb9a\" stroke-width=\"11\" stroke-dasharray=\"420 1622\" transform=\"rotate(-90 395 395)\"/><circle cx=\"395\" cy=\"395\" r=\"258\" stroke=\"#ffab76\" stroke-width=\"8\" stroke-dasharray=\"300 1322\" transform=\"rotate(45 395 395)\"/><circle cx=\"395\" cy=\"395\" r=\"193\" stroke=\"#91c9ff\" stroke-width=\"5\" stroke-dasharray=\"250 963\" transform=\"rotate(155 395 395)\"/></g><g id=\"analytic-nodes\" fill=\"#bdfb9a\"><circle cx=\"395\" cy=\"35\" r=\"12\"/><circle cx=\"755\" cy=\"395\" r=\"12\"/><circle cx=\"395\" cy=\"755\" r=\"12\"/><circle cx=\"35\" cy=\"395\" r=\"12\"/></g></svg><div class=\"center\">More context.<br><span class=\"accent\">More clarity.</span></div></div>\n<div class=\"feature-row\"><span class=\"pill reveal\">Benchmark comparison</span><span class=\"pill reveal\">Correlation</span><span class=\"pill reveal\">Monte Carlo simulation</span></div>\n</section>\n<section class=\"scene s5\">\n<h2 class=\"reveal\">Keep the details <span class=\"accent\">in sight.</span></h2>\n<div class=\"feature-card dividend-card reveal\"><h3>Dividend tracking</h3><p>See upcoming payment dates.</p><div class=\"calendar\" aria-hidden=\"true\"></div></div>\n<div class=\"feature-card tax-card reveal\"><h3>Tax reporting</h3><p>Bring your records together.</p><div class=\"document\"><div class=\"doc-title\">Tax report</div><div class=\"doc-line\"></div><div class=\"doc-line short\"></div><div class=\"doc-line\"></div><div class=\"doc-line short\"></div><div class=\"doc-line\"></div><div class=\"doc-stamp\">✓</div></div><div class=\"export\">PDF · Excel · CSV</div></div>\n</section>\n<div class=\"wipe\"></div>\n<section class=\"scene s6\"><div class=\"end-ring\"></div><div class=\"brand reveal\">AllInvestView</div><h2 class=\"reveal\">All together.<br>Clearly.</h2><div class=\"cta reveal\">Start free <span>↗</span></div><p class=\"url reveal\">allinvestview.com</p></section>\n</div>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n(function(){\n'use strict';\n// Editable choreography: all times are seconds. No independent animation clocks.\nconst calendar=document.querySelector('.calendar');\nfor(let i=0;i<21;i++){const day=document.createElement('div');day.className='day'+([2,9,12,17].includes(i)?' hit':'');calendar.appendChild(day);}\nconst wires=Array.from(document.querySelectorAll('.flow-strokes path'));\nwires.forEach(path=>{const length=path.getTotalLength();path.style.strokeDasharray=length;path.style.strokeDashoffset=length;});\nconst tl=gsap.timeline({paused:true});\nconst enter=(selector,time,stagger=.1,offset=40,duration=.7)=>tl.fromTo(selector,{opacity:0,y:offset},{opacity:1,y:0,duration,stagger,ease:'power3.out',immediateRender:false},time);\nconst show=(selector,time)=>tl.to(selector,{opacity:1,duration:.25,ease:'none'},time);\nconst leave=(selector,time)=>tl.to(selector,{opacity:0,duration:.3,ease:'power2.in'},time);\ntl.to('#ambient',{rotation:25,duration:30,ease:'none'},0);\nenter('.s1 .hero-line',.18,.22,55,.9);enter('.s1 .sub',.95);\ntl.fromTo('.asset',{opacity:0,scale:.72},{opacity:1,scale:1,duration:.85,stagger:.09,ease:'back.out(1.2)',immediateRender:false},.3);\ntl.to('.a1,.a3,.a5',{y:-20,duration:2.4,ease:'sine.inOut'},1.2);tl.to('.a2,.a4,.a6',{y:19,duration:2.4,ease:'sine.inOut'},1.2);\ntl.to('.asset',{x:(i)=>[780,140,-650,760,140,-660][i],y:(i)=>[350,400,330,-300,-370,-300][i],scale:.2,opacity:0,duration:.6,stagger:.035,ease:'power3.in'},3.48);\nleave('.s1 .hero-copy',3.75);leave('.s1',4.1);\nshow('.s2',4.35);enter('.s2 .eyebrow',4.45);enter('.s2 h2',4.62);enter('.s2 .sub',4.95);enter('.s2 .pill',5.2);\ntl.fromTo('.product-art',{opacity:0,x:160,rotation:4,scale:.9},{opacity:1,x:0,rotation:0,scale:1,duration:1.2,ease:'power3.out',immediateRender:false},4.65);\ntl.to('.product-art',{y:-14,scale:1.035,duration:3.1,ease:'sine.inOut'},6);leave('.s2',9.5);\nshow('.s3',9.8);enter('.s3 h2',9.9);enter('.s3 > .sub',10.15);enter('.method',10.4,.16,35,.6);enter('.hub',10.9,0,45,.8);\ntl.to(wires,{strokeDashoffset:0,duration:1.2,stagger:.14,ease:'power2.inOut'},10.85);\ntl.fromTo('.hub',{boxShadow:'0 0 0px #bdfb9a00'},{boxShadow:'0 0 95px #bdfb9a25',duration:1.3,ease:'sine.out',immediateRender:false},12);leave('.s3',14.05);\nshow('.s4',14.35);enter('.s4 .eyebrow',14.45);enter('.s4 h2',14.65);enter('.s4 .sub',15.05);enter('.analytics',14.8,0,0,.95);\ntl.fromTo('.analytics',{scale:.76,rotation:-18},{scale:1,rotation:0,duration:1.3,ease:'power3.out',immediateRender:false},14.65);\ntl.fromTo('#orbit',{svgOrigin:'395 395',rotation:-45},{svgOrigin:'395 395',rotation:55,duration:5.1,ease:'power1.inOut',immediateRender:false},14.9);\nenter('.s4 .pill',16.1,.28,22,.6);leave('.s4',20.05);\nshow('.s5',20.35);enter('.s5 h2',20.45);enter('.feature-card',20.7,.18,80,.9);\ntl.fromTo('.day',{opacity:0,scale:.5},{opacity:1,scale:1,duration:.4,stagger:.025,ease:'power2.out',immediateRender:false},21.35);\ntl.fromTo('.day.hit',{backgroundColor:'#21382c',color:'#bdfb9a'},{backgroundColor:'#bdfb9a',color:'#14271f',duration:.5,stagger:.2,immediateRender:false},22.15);\ntl.fromTo('.document',{y:130,rotation:8},{y:0,rotation:-7,duration:.95,ease:'power3.out',immediateRender:false},21.35);\ntl.fromTo('.doc-stamp',{scale:1.8,opacity:0,rotation:-25},{scale:1,opacity:1,rotation:0,duration:.4,ease:'back.out(1.5)',immediateRender:false},22.3);\ntl.fromTo('.export',{y:25,opacity:0},{y:0,opacity:1,duration:.5,immediateRender:false},22.65);\ntl.to('.wipe',{scale:65,duration:.85,ease:'power3.inOut'},24.45);leave('.s5',24.85);\nshow('.s6',25.15);enter('.s6 .brand',25.25,0,30,.65);enter('.s6 h2',25.5,0,60,.85);enter('.s6 .cta',26.25,0,30,.65);enter('.s6 .url',26.55,0,20,.6);\ntl.fromTo('.end-ring',{scale:.8,opacity:0},{scale:1,opacity:1,duration:2.5,ease:'power2.out',immediateRender:false},25.15);\n// Register only the completed, paused composition timeline.\nwindow.__timelines=window.__timelines||{};window.__timelines['main']=tl;\n})();\n</script>\n</body>\n</html>",
