{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Cats in a Starry Night</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#101e36}button{font:inherit;cursor:pointer}button:focus-visible{outline:3px solid #fff5bb;outline-offset:5px}#root{position:relative;width:100%;height:100%;overflow:hidden;color:#fff1c7;font-family:Georgia,serif;background:#152c50;isolation:isolate}.clip{position:absolute;inset:0}.scene canvas{position:absolute;inset:0;width:100%;height:100%}#world{touch-action:none;cursor:crosshair}.vignette{pointer-events:none;background:radial-gradient(ellipse at 50% 43%,transparent 35%,#07172b77 100%),linear-gradient(#07172b55,transparent 26%,transparent 72%,#07172bba)}.hud{pointer-events:none}.heading{position:absolute;left:4.5%;top:5%;text-shadow:0 2px 18px #102343}.heading h1{font-size:clamp(26px,3.3vw,55px);font-weight:normal;line-height:1.04;margin:0 0 12px;letter-spacing:-.035em}.heading p{font-family:system-ui,sans-serif;font-size:clamp(13px,1.35vw,23px);margin:0;color:#e0e1cf}.counter{position:absolute;right:4.5%;top:5%;display:flex;align-items:center;gap:15px;padding:15px 22px;border:1px solid #d4d8a84d;background:#11243e9c;border-radius:999px;font-family:system-ui,sans-serif}.counter strong{font-size:clamp(21px,2.1vw,36px);font-weight:500}.counter span{font-size:clamp(12px,1.15vw,20px);color:#e4dfc4}.cat-icon{width:30px;height:32px}.intro{position:absolute;left:0;right:0;top:25%;text-align:center;pointer-events:none;text-shadow:0 4px 35px #09213c}.intro h2{font-size:clamp(44px,7.8vw,128px);font-weight:normal;letter-spacing:-.055em;line-height:.92;margin:0}.intro p{font-family:system-ui,sans-serif;font-size:clamp(15px,1.65vw,27px);margin:26px 0 0;color:#eee5be}.bottom{position:absolute;bottom:5%;left:50%;transform:translateX(-50%);text-align:center;min-width:38%;pointer-events:none}.pill{pointer-events:auto;border:1px solid #ffe7a899;border-radius:999px;color:#182b3e;background:#f2d998;padding:16px 30px;font-family:system-ui,sans-serif;font-size:clamp(14px,1.45vw,24px);font-weight:600;box-shadow:0 7px 35px #07152a55}.pill:hover{background:#fff0bd}.controls{font-family:system-ui,sans-serif;font-size:clamp(11px,1.1vw,18px);color:#d5dbd6;margin-top:15px;white-space:nowrap}.message{position:absolute;left:22%;right:22%;bottom:20%;text-align:center;font-family:system-ui,sans-serif;font-size:clamp(16px,1.7vw,28px);text-shadow:0 2px 12px #061727;pointer-events:none}.touch{position:absolute;bottom:5%;display:flex;gap:8px;pointer-events:auto}.touch.left{left:4.5%}.touch.right{right:4.5%}.touch button{width:clamp(32px,3.5vw,60px);height:clamp(32px,3.5vw,60px);color:#efe6bb;background:#112841bd;border:1px solid #ced3b755;border-radius:50%;font-family:system-ui,sans-serif;font-size:clamp(16px,1.7vw,28px)}.touch button:hover{background:#375171}.ending{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;background:#0a1a31c9;pointer-events:auto}.ending h2{font-size:clamp(36px,5.5vw,88px);font-weight:normal;letter-spacing:-.04em;line-height:1.1;margin:0 0 25px}.ending p{font:clamp(15px,1.6vw,26px) system-ui,sans-serif;margin:0 0 35px}.ending[hidden]{display:none}.error{position:absolute;inset:25%;font:28px system-ui,sans-serif;text-align:center;line-height:1.5}.error[hidden]{display:none}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1600\" data-height=\"900\" data-duration=\"36\">\n<div class=\"clip scene\" data-start=\"0\" data-duration=\"36\"><canvas id=\"sky\" width=\"1600\" height=\"900\" aria-hidden=\"true\"></canvas><canvas id=\"world\" width=\"1600\" height=\"900\" tabindex=\"0\" aria-label=\"Walk through a three-dimensional painted town and find five cats. Use W A S D to move, arrow keys to turn, drag to look, and click a cat or press E to spot it.\"></canvas><canvas id=\"marks\" width=\"1600\" height=\"900\" aria-hidden=\"true\" style=\"pointer-events:none\"></canvas></div>\n<div class=\"clip vignette\" data-start=\"0\" data-duration=\"36\"></div>\n<div class=\"clip hud\" data-start=\"0\" data-duration=\"36\">\n<header class=\"heading\"><h1>Cats in a<br>Starry Night</h1><p>Five little souls in a painted town.</p></header>\n<div class=\"counter\"><svg class=\"cat-icon\" viewBox=\"0 0 32 36\" aria-hidden=\"true\"><path d=\"M5 14L5 3L13 10Q17 8 21 10L28 3L28 18Q31 31 17 33Q2 33 4 19Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M10 20h2m9 0h2m-7 5 2 2 2-2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><strong id=\"count\">0 / 5</strong><span>cats found</span></div>\n<div class=\"intro\" id=\"intro\"><h2>Step inside<br>the brushstrokes.</h2><p>A small adventure beneath a very big sky.</p></div>\n<div class=\"message\" id=\"message\" role=\"status\" aria-live=\"polite\"></div>\n<div class=\"bottom\"><button class=\"pill\" id=\"enter\">Enter the painting</button><div class=\"controls\" id=\"help\">WASD walk · ← → turn · drag to look · click a cat</div></div>\n<div class=\"touch left\" aria-label=\"Walking controls\"><button data-move=\"left\" aria-label=\"Step left\">←</button><button data-move=\"forward\" aria-label=\"Walk forward\">↑</button><button data-move=\"back\" aria-label=\"Walk backward\">↓</button><button data-move=\"right\" aria-label=\"Step right\">→</button></div>\n<div class=\"touch right\"><button data-move=\"turnleft\" aria-label=\"Turn left\">↶</button><button data-move=\"turnright\" aria-label=\"Turn right\">↷</button></div>\n</div>\n<div class=\"clip\" data-start=\"0\" data-duration=\"36\" style=\"pointer-events:none\"><div class=\"ending\" id=\"ending\" hidden><h2>Five cats.<br>One beautiful night.</h2><p>You found every quiet little resident.</p><button class=\"pill\" id=\"again\">Wander again</button></div><div class=\"error\" id=\"error\" hidden>This painted town needs a browser with WebGL enabled.</div></div>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n'use strict';\n// EDITABLE WORLD: positions are in metres. Positive Z is the town entrance.\nconst W=1600,H=900,DURATION=36;\nconst CAT_DATA=[\n {x:-3.8,z:8,yaw:0.25,color:'#c8a46c',name:'Ochre'},\n {x:4,z:-1,yaw:-0.35,color:'#e2d6b1',name:'Pearl'},\n {x:-3.8,z:-11,yaw:0.35,color:'#536578',name:'Indigo'},\n {x:10,z:-15.4,yaw:-0.8,color:'#bd7849',name:'Ember'},\n {x:0,z:-21.5,yaw:0,color:'#ddd5bb',name:'Moon'}\n];\nconst TOUR=[\n [0,0.6,19,-0.08,0.14], [6,0.2,13,-0.24,0.10],\n [12,0,4,0.35,0.08], [19,0,-6,-0.36,0.10],\n [26,0.8,-15,0.80,0.14], [33,0,-19,0,0.24], [36,0,-19,0,0.24]\n];\nconst sky=document.getElementById('sky'),sctx=sky.getContext('2d');\nconst canvas=document.getElementById('world'),marks=document.getElementById('marks'),mctx=marks.getContext('2d');\nconst gl=canvas.getContext('webgl',{alpha:true,antialias:true,premultipliedAlpha:false});\nconst ui={intro:document.getElementById('intro'),count:document.getElementById('count'),message:document.getElementById('message'),enter:document.getElementById('enter'),ending:document.getElementById('ending')};\nconst clock={t:0};\nconst state={manual:false,cam:{x:0.6,y:1.75,z:19,yaw:-0.08,pitch:0.14},found:new Set(),message:'',drag:null};\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst hash=n=>{const v=Math.sin(n*127.1+311.7)*43758.5453;return v-Math.floor(v)};\nconst rgb=h=>[parseInt(h.slice(1,3),16)/255,parseInt(h.slice(3,5),16)/255,parseInt(h.slice(5,7),16)/255];\nconst art=document.createElement('canvas');art.width=W;art.height=H;\nconst p=art.getContext('2d');\nfunction makeSky(){\n const g=p.createLinearGradient(0,0,0,H);g.addColorStop(0,'#163459');g.addColorStop(.54,'#2a5079');g.addColorStop(1,'#56717a');p.fillStyle=g;p.fillRect(0,0,W,H);\n // A deterministic field of short, curved impasto strokes.\n const palette=['#2d527c','#37658b','#21456e','#578292','#3d7094','#1c3960','#70999a'];\n p.lineCap='round';\n for(let i=0;i<15500;i++){\n  const x=hash(i*3+1)*W,y=hash(i*3+2)*650;\n  const dx=x-660,dy=(y-300)*1.5,r=Math.hypot(dx,dy);\n  const angle=Math.atan2(dy,dx)+1.5+Math.sin(r*.012)*.35;\n  const len=8+hash(i*3+3)*17;\n  p.strokeStyle=palette[i%palette.length];p.globalAlpha=.25+hash(i+78)*.45;p.lineWidth=1.4+hash(i+93)*2.5;\n  p.beginPath();p.moveTo(x,y);p.quadraticCurveTo(x+Math.cos(angle)*len*.55,y+Math.sin(angle)*len*.35,x+Math.cos(angle+.18)*len,y+Math.sin(angle+.18)*len*.65);p.stroke();\n }\n p.globalAlpha=1;\n // Broad, curling ribbons carry the characteristic sky silhouette.\n for(let k=0;k<25;k++){\n  p.beginPath();\n  for(let j=0;j<=220;j++){\n   const a=j/220*8.1,r=17+a*25+k*2.9;\n   const x=625+Math.cos(a)*r*1.9,y=285+Math.sin(a)*r*.60+k*2;\n   if(j===0)p.moveTo(x,y);else p.lineTo(x,y);\n  }\n  p.strokeStyle=['#75a1ad','#4e819b','#a0b6a5','#386989','#8ca9a7'][k%5];p.globalAlpha=.36;p.lineWidth=2.6;p.stroke();\n }\n p.globalAlpha=1;\n const stars=[[108,95,16],[320,177,20],[485,75,15],[885,135,21],[1090,86,16],[1195,284,14],[1455,108,42],[1002,352,13],[216,356,17],[1380,390,13]];\n stars.forEach(([x,y,r],i)=>{\n  const glow=p.createRadialGradient(x,y,0,x,y,r*3.2);glow.addColorStop(0,'#f4db85');glow.addColorStop(.22,'#e6ce79aa');glow.addColorStop(1,'#d4c27200');p.fillStyle=glow;p.fillRect(x-r*3.3,y-r*3.3,r*6.6,r*6.6);\n  for(let ring=0;ring<5;ring++)for(let j=0;j<28;j++){\n   const a=j/28*Math.PI*2,rr=r+ring*5+Math.sin(j*2+i)*2;\n   p.beginPath();p.ellipse(x,y,rr,rr*.9,0,a,a+.12);p.strokeStyle=['#f9df8e','#b8bc86','#e3ce86','#879f91','#b3b88c'][ring];p.lineWidth=2.7;p.stroke();\n  }\n  p.fillStyle='#f3dfa0';p.beginPath();p.arc(x,y,r*.68,0,Math.PI*2);p.fill();\n });\n // A crescent cut into the large upper-right moon.\n p.fillStyle='#315779';p.beginPath();p.arc(1470,95,32,0,Math.PI*2);p.fill();\n for(let layer=0;layer<4;layer++){\n  p.beginPath();p.moveTo(0,H);\n  for(let x=0;x<=W;x+=7){const y=560+layer*29+Math.sin(x*.005+layer*.9)*35+Math.sin(x*.014+layer)*12;p.lineTo(x,y)}\n  p.lineTo(W,H);p.closePath();p.fillStyle=['#315b72','#294b64','#24425b','#20384d'][layer];p.fill();\n  for(let row=0;row<10;row++){\n   p.beginPath();for(let x=0;x<=W;x+=8){const y=569+layer*29+row*5+Math.sin(x*.005+layer*.9)*35+Math.sin(x*.014+layer)*12;if(x===0)p.moveTo(x,y);else p.lineTo(x,y)}\n   p.strokeStyle=layer%2?'#56747166':'#75908a44';p.lineWidth=2;p.stroke();\n  }\n }\n}\nmakeSky();\nlet vertices=[],obstacles=[],xf=null;\nfunction transformed(v){if(!xf)return v;const c=Math.cos(xf.yaw),s=Math.sin(xf.yaw);return[xf.x+v[0]*c+v[2]*s,v[1],xf.z-v[0]*s+v[2]*c]}\nfunction tri(a,b,c,color,id=0){\n a=transformed(a);b=transformed(b);c=transformed(c);\n const u=b.map((v,i)=>v-a[i]),v=c.map((v,i)=>v-a[i]);\n let n=[u[1]*v[2]-u[2]*v[1],u[2]*v[0]-u[0]*v[2],u[0]*v[1]-u[1]*v[0]];\n const len=Math.hypot(...n)||1;n=n.map(q=>q/len);const col=typeof color==='string'?rgb(color):color;\n for(const q of[a,b,c])vertices.push(...q,...n,...col,id);\n}\nfunction quad(a,b,c,d,color,id=0){tri(a,b,c,color,id);tri(a,c,d,color,id)}\nfunction box(x,y,z,w,h,d,col,id=0){\n const a=[x-w/2,y,z-d/2],b=[x+w/2,y,z-d/2],c=[x+w/2,y,z+d/2],d0=[x-w/2,y,z+d/2];\n const A=[a[0],y+h,a[2]],B=[b[0],y+h,b[2]],C=[c[0],y+h,c[2]],D=[d0[0],y+h,d0[2]];\n quad(d0,c,C,D,col,id);quad(b,a,A,B,col,id);quad(a,d0,D,A,col,id);quad(c,b,B,C,col,id);quad(A,D,C,B,col,id);\n}\nfunction sphere(x,y,z,rx,ry,rz,col,id=0,segs=12,rings=9){\n const point=(j,k)=>{const a=j/rings*Math.PI,b=k/segs*Math.PI*2;return[x+Math.sin(a)*Math.cos(b)*rx,y+Math.cos(a)*ry,z+Math.sin(a)*Math.sin(b)*rz]};\n for(let j=0;j<rings;j++)for(let k=0;k<segs;k++)quad(point(j,k),point(j+1,k),point(j+1,k+1),point(j,k+1),col,id);\n}\nfunction tube(a,b,r,col,id=0){\n const dir=b.map((v,i)=>v-a[i]),len=Math.hypot(...dir),n=dir.map(v=>v/len);\n let u=Math.abs(n[1])<.9?[n[2],0,-n[0]]:[0,n[2],-n[1]];const ul=Math.hypot(...u);u=u.map(v=>v/ul);\n const v=[n[1]*u[2]-n[2]*u[1],n[2]*u[0]-n[0]*u[2],n[0]*u[1]-n[1]*u[0]];\n const point=(p,k)=>p.map((q,i)=>q+r*(u[i]*Math.cos(k*Math.PI/4)+v[i]*Math.sin(k*Math.PI/4)));\n for(let k=0;k<8;k++)quad(point(a,k),point(b,k),point(b,k+1),point(a,k+1),col,id);\n}\nfunction house(x,z,w,d,h,col,roof){\n box(x,0,z,w,h,d,col);obstacles.push({x0:x-w/2,x1:x+w/2,z0:z-d/2,z1:z+d/2,y:h+1.8});\n const a=[x-w/2-.17,h,z-d/2-.15],b=[x+w/2+.17,h,z-d/2-.15],c=[x+w/2+.17,h,z+d/2+.15],d0=[x-w/2-.17,h,z+d/2+.15],e=[x,h+1.7,z-d/2-.15],f=[x,h+1.7,z+d/2+.15];\n quad(a,e,f,d0,roof);quad(e,b,c,f,roof);tri(d0,f,c,col);tri(b,e,a,col);\n box(x+w*.25,h+.4,z-.6,.44,1.6,.54,'#334152');\n for(let floor=0;floor<2;floor++)for(let side=-1;side<=1;side+=2)for(let j=-1;j<=1;j++){\n  const yy=1+floor*1.6;if(yy+.65>h)continue;\n  const zz=z+side*(d/2+.02),xx=x+j*w*.27;\n  box(xx,yy,zz,.67,.88,.07,'#152c43');box(xx,yy+.08,zz+side*.045,.43,.65,.045,(j+floor+Math.round(z))%3===0?'#66848a':'#e2bc68');\n }\n for(let side=-1;side<=1;side+=2)for(let floor=0;floor<2;floor++){\n  const yy=1+floor*1.6;if(yy+.7>h)continue;\n  box(x+side*(w/2+.025),yy,z,.08,.86,.64,'#11293e');box(x+side*(w/2+.075),yy+.09,z,.05,.63,.43,'#dbb660');\n }\n box(x,0,z+d/2+.065,.8,1.7,.08,'#1b2c35');\n}\nfunction cypress(x,z,h){\n box(x,0,z,.42,h*.4,.4,'#172e32');\n for(let j=0;j<9;j++){const u=j/8;sphere(x+Math.sin(j*1.7)*.18,h*(.2+u*.69),z,(1-u*.82)*1.5,h*.18,(1-u*.82)*1.12,j%2?'#203d3b':'#1a3336',0,10,7)}\n obstacles.push({x0:x-1.1,x1:x+1.1,z0:z-1,z1:z+1,y:h});\n}\nfunction cat(c,i){\n xf=c;const id=i+1,col=c.color;\n sphere(0,.35,0,.27,.37,.25,col,id);sphere(0,.76,.035,.255,.23,.23,col,id);\n sphere(-.15,.1,.13,.12,.10,.21,col,id);sphere(.15,.1,.13,.12,.10,.21,col,id);\n for(const side of[-1,1]){\n  const a=[side*.07,.88,.13],b=[side*.24,.84,.08],tip=[side*.21,1.12,.02],back=[side*.16,.86,-.13];\n  tri(a,b,tip,col,id);tri(b,back,tip,col,id);tri(back,a,tip,col,id);tri([side*.12,.9,.14],[side*.21,.89,.11],[side*.20,1.04,.06],'#ad8174',id);\n  sphere(side*.105,.79,.234,.063,.051,.026,'#e2d68b',id,8,6);sphere(side*.105,.79,.258,.018,.036,.012,'#11252e',id,8,5);\n  for(let k=0;k<3;k++)tube([side*.08,.65,.24],[side*(.3+k*.025),.65+(k-1)*.035,.26],.006,'#d8d5ad',id);\n }\n sphere(0,.68,.26,.034,.025,.017,'#bc8a7e',id,8,5);\n let prev=[.22,.26,-.08];for(let j=1;j<=12;j++){const a=j/12*Math.PI*1.12,q=[.24+Math.sin(a)*.43,.29+(1-Math.cos(a))*.34,-.09];tube(prev,q,.065,col,id);prev=q}\n if(i===0||i===3)for(let k=0;k<3;k++)box(0,.29+k*.11,.242,.38,.025,.012,'#775e48',id);\n xf=null;\n}\nfunction makeTown(){\n box(0,-.15,-4,140,.12,140,'#314a50');\n box(0,-.015,-5,6.8,.025,65,'#6f775e');\n for(const z of[5,-5,-15.4])box(0,-.01,z,34,.027,3.6,'#69745f');\n const cols=['#526a68','#7c8168','#909071','#5b716b'];\n for(let row=0;row<108;row++)for(let col=0;col<9;col++){\n  const x=-3.1+col*.75+(row%2)*.23,z=22-row*.49;\n  box(x,.015,z,.54+hash(row*12+col)*.13,.016,.30,cols[(row+col)%4]);\n }\n for(let i=0;i<75;i++){\n  const x=-17+i*.46;for(const z of[5,-5,-15.4])for(let row=0;row<4;row++)if(Math.abs(x)>3.5)box(x,.016,z-1.3+row*.75,.31,.018,.51,cols[(i+row)%4]);\n }\n const walls=['#7d8b81','#84948b','#b1a17c','#687e83','#a39476','#728a8a','#879789','#9b9e84'];\n for(let side=-1;side<=1;side+=2)for(let j=0;j<4;j++){\n  const z=10-j*10.2;house(side*7.2,z,4.9,5.5,3.5+(j%3)*.5,walls[j+(side===1?4:0)],j%2?'#5d625b':'#64675b');\n  house(side*14.6,z-1,4.8,5.4,3.1+(j%2)*.7,walls[(j+2)%8],'#4a5a58');\n }\n // Church at the far end of the main lane.\n house(0,-28,4.6,6,4.4,'#84978f','#485a62');box(0,0,-25.1,1.8,8,1.9,'#84948a');\n const top=[0,13,-25.1],corners=[[-1,8,-26.1],[1,8,-26.1],[1,8,-24.1],[-1,8,-24.1]];for(let i=0;i<4;i++)tri(corners[i],corners[(i+1)%4],top,'#334e5c');\n box(0,5.7,-24.1,.65,1.1,.035,'#293f4b');box(0,1,-24.08,.6,1.1,.03,'#d6b96c');\n cypress(-11,13,18);cypress(-16,-12,9);cypress(17,-21,10);cypress(12,-29,8);\n for(let i=0;i<16;i++){\n  const x=-35+i*4.5,z=-38-hash(i)*12;\n  house(x,z,3.3,3.5,2.3+hash(i+9)*2,'#667f7d','#485b61');\n }\n CAT_DATA.forEach(cat);\n}\nlet progr