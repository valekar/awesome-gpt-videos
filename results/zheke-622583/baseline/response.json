{
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Make It Move</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#eeeae1}#root{position:relative;width:100%;height:100%;overflow:hidden}canvas{position:absolute;inset:0;width:100%;height:100%;display:block}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"18\">\n<canvas id=\"art\" class=\"clip\" data-start=\"0\" data-duration=\"18\" width=\"1920\" height=\"1080\" aria-label=\"Make it move. Kinetic typography and rotating striped sculptures.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n/* Editable art direction. All motion is computed from the timeline time. */\nconst CONFIG={width:1920,height:1080,duration:18,paper:'#eeeae1',ink:'#191919',lime:'#d5fc45',violet:'#af96ed',purple:'#7656ba'};\nconst canvas=document.getElementById('art');\nconst ctx=canvas.getContext('2d');\nconst W=CONFIG.width,H=CONFIG.height,TAU=Math.PI*2;\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,p)=>a+(b-a)*p;\nconst smooth=v=>{v=clamp(v);return v*v*(3-2*v)};\nconst out=v=>1-Math.pow(1-clamp(v),4);\nconst back=v=>{v=clamp(v)-1;return 1+2.70158*v*v*v+1.70158*v*v};\nconst phase=(t,a,b)=>clamp((t-a)/(b-a));\nfunction background(color){ctx.fillStyle=color;ctx.fillRect(0,0,W,H)}\nfunction ellipse(x,y,rx,ry,color){ctx.beginPath();ctx.ellipse(x,y,Math.max(.01,rx),Math.max(.01,ry),0,0,TAU);ctx.fillStyle=color;ctx.fill()}\nfunction text(word,x,y,size,color,align='left'){ctx.font=`900 ${size}px sans-serif`;ctx.textAlign=align;ctx.textBaseline='alphabetic';ctx.fillStyle=color;ctx.fillText(word,x,y)}\nfunction rotate(v,ax,ay,az){let [x,y,z]=v;let c=Math.cos(ax),s=Math.sin(ax);[y,z]=[y*c-z*s,y*s+z*c];c=Math.cos(ay);s=Math.sin(ay);[x,z]=[x*c+z*s,-x*s+z*c];c=Math.cos(az);s=Math.sin(az);return [x*c-y*s,x*s+y*c,z]}\nfunction rgb(hex){return [parseInt(hex.slice(1,3),16),parseInt(hex.slice(3,5),16),parseInt(hex.slice(5,7),16)]}\nfunction shade(color,light){const a=rgb(color);return `rgb(${a.map(v=>Math.round(clamp(v*light,0,255))).join(',')})`}\n/* A true projected torus, assembled from editable vector surface patches. */\nfunction sculpture(cx,cy,R,r,ax,ay,az,scale,colors){\n const U=80,V=20,grid=[],faces=[];\n for(let i=0;i<=U;i++){\n  const u=i/U*TAU,row=[];\n  for(let j=0;j<=V;j++){\n   const v=j/V*TAU;\n   const p=rotate([(R+r*Math.cos(v))*Math.cos(u),(R+r*Math.cos(v))*Math.sin(u),r*Math.sin(v)],ax,ay,az);\n   const f=1500/(1500-p[2]);\n   row.push([cx+p[0]*scale*f,cy+p[1]*scale*f,p[2]]);\n  }\n  grid.push(row);\n }\n for(let i=0;i<U;i++)for(let j=0;j<V;j++){\n  const u=(i+.5)/U*TAU,v=(j+.5)/V*TAU;\n  const n=rotate([Math.cos(v)*Math.cos(u),Math.cos(v)*Math.sin(u),Math.sin(v)],ax,ay,az);\n  const light=clamp(.69+.31*(-.35*n[0]-.55*n[1]+.76*n[2]),.35,1.06);\n  const points=[grid[i][j],grid[i+1][j],grid[i+1][j+1],grid[i][j+1]];\n  faces.push({points,z:points.reduce((a,p)=>a+p[2],0)/4,color:shade(colors[Math.floor(i/5)%colors.length],light)});\n }\n faces.sort((a,b)=>a.z-b.z);\n ctx.lineJoin='round';ctx.lineWidth=.7;\n for(const f of faces){ctx.beginPath();ctx.moveTo(f.points[0][0],f.points[0][1]);for(let k=1;k<4;k++)ctx.lineTo(f.points[k][0],f.points[k][1]);ctx.closePath();ctx.fillStyle=f.color;ctx.strokeStyle=f.color;ctx.fill();ctx.stroke()}\n}\nfunction shadow(x,y,w,alpha){const g=ctx.createRadialGradient(x,y,0,x,y,w);g.addColorStop(0,`rgba(25,25,25,${alpha})`);g.addColorStop(1,'rgba(25,25,25,0)');ctx.save();ctx.translate(x,y);ctx.scale(1,.16);ctx.fillStyle=g;ctx.translate(-x,-y);ctx.fillRect(x-w,y-w,w*2,w*2);ctx.restore()}\nfunction orbit(x,y,rx,ry,angle,color,width=2){ctx.save();ctx.translate(x,y);ctx.rotate(angle);ctx.beginPath();ctx.ellipse(0,0,rx,ry,0,0,TAU);ctx.strokeStyle=color;ctx.lineWidth=width;ctx.stroke();ctx.restore()}\nfunction sceneMake(t){\n background(CONFIG.paper);\n const enter=out(t/1.25),spin=t*.47;\n ctx.save();ctx.globalAlpha=.42;\n orbit(1400,535,460,460,0,'#bcb8af',1.4);\n orbit(1400,535,495,200,-.45,'#bcb8af',1.4);\n ctx.restore();\n shadow(1410,925,350,.18);\n sculpture(1410,515,245,107,.78+Math.sin(t*.7)*.22,spin,-.32,lerp(.72,1.14,enter),[CONFIG.violet,CONFIG.lime]);\n ctx.save();ctx.globalAlpha=1-smooth(t/1.2);ctx.font='900 305px sans-serif';ctx.lineWidth=1.5;ctx.strokeStyle='#b7b3aa';ctx.strokeText('MAKE',118,655);ctx.restore();\n const letters='MAKE',positions=[120,392,625,865];\n for(let i=0;i<4;i++){\n  const p=back((t-.12-i*.095)/.95);\n  ctx.save();ctx.beginPath();ctx.rect(90,220,1160,470);ctx.clip();\n  ctx.translate(positions[i],655+(1-p)*410);\n  ctx.rotate((1-p)*-.1);\n  text(letters[i],0,0,305,CONFIG.ink);ctx.restore();\n }\n const a=-1.8+t*.8;\n ellipse(1400+460*Math.cos(a),535+460*Math.sin(a),17,17,CONFIG.ink);\n ctx.save();ctx.translate(150,855);ctx.rotate(t*.55);ctx.strokeStyle=CONFIG.ink;ctx.lineWidth=10;ctx.beginPath();ctx.moveTo(-27,0);ctx.lineTo(27,0);ctx.moveTo(0,-27);ctx.lineTo(0,27);ctx.stroke();ctx.restore();\n const line=out((t-.6)/1.1);ctx.fillStyle=CONFIG.ink;ctx.fillRect(120,935,880*line,5);\n}\nfunction sceneIt(t){\n background(CONFIG.violet);\n const reveal=out(t/1.3),rotation=t*.46;\n /* A field of elastic rings opens into the central sculpture. */\n ctx.save();ctx.translate(960,540);ctx.rotate(-.25+Math.sin(t*.3)*.1);\n for(let i=12;i>=0;i--){\n  const p=i/12,breath=Math.sin(t*1.2-i*.3)*20;\n  ctx.beginPath();ctx.ellipse(0,0,220+p*970+breath,115+p*500+breath*.3,0,0,TAU);\n  ctx.strokeStyle=i%3===0?'rgba(25,25,25,.35)':'rgba(25,25,25,.14)';ctx.lineWidth=i%3===0?2:1.2;ctx.stroke();\n }\n ctx.restore();\n shadow(970,928,450,.15);\n sculpture(960,540,278,111,1.03+Math.sin(t*.6)*.26,rotation,.3+rotation*.22,lerp(1.5,1.03,reveal),[CONFIG.ink,CONFIG.paper]);\n ctx.save();ctx.translate(960,700);ctx.scale(1,lerp(.1,1,back(t/1.05)));text('IT',0,0,443,CONFIG.lime,'center');ctx.restore();\n const x=960+590*Math.cos(t*.9+.5),y=540+300*Math.sin(t*.9+.5);\n ellipse(x,y,29,29,CONFIG.lime);\n ellipse(1920-x,1080-y,11,11,CONFIG.ink);\n}\nfunction sceneMove(t){\n background(CONFIG.lime);\n const p=out(t/.85);\n ctx.save();ctx.globalAlpha=.13;\n for(let i=0;i<8;i++){\n  ctx.beginPath();ctx.moveTo(-100,95+i*136);ctx.bezierCurveTo(560,95+i*136+100*Math.sin(t*.8+i*.3),1250,95+i*136-120,2020,95+i*136+40);ctx.strokeStyle=CONFIG.ink;ctx.lineWidth=2;ctx.stroke();\n }\n ctx.restore();\n const lift=Math.sin(t*2.1)*14*Math.exp(-t*.25);\n ctx.save();ctx.translate(122,675+(1-p)*250+lift);ctx.rotate((1-p)*-.15);ctx.scale(1,1+(1-p)*.25);text('M',0,0,350,CONFIG.ink);ctx.restore();\n sculpture(707,538+lift,122,55,1.02+t*.19,t*.8,-.2,lerp(.3,1.15,back(t/.95)),[CONFIG.ink,CONFIG.purple]);\n ctx.save();ctx.translate(908,675+(1-out((t-.12)/.85))*310-lift*.5);ctx.rotate((1-out((t-.12)/.85))*.16);text('V',0,0,350,CONFIG.ink);ctx.restore();\n ctx.save();ctx.translate(1200,675+(1-out((t-.21)/.85))*350+lift*.3);text('E',0,0,350,CONFIG.ink);ctx.restore();\n /* A large moving punctuation mark becomes the next transition's origin. */\n const dotP=back((t-.5)/.9);\n ellipse(1580,648,39*Math.max(.01,dotP),39*Math.max(.01,dotP),CONFIG.ink);\n const stretch=1+Math.sin(t*2.1)*.15;\n ctx.save();ctx.translate(960,868);ctx.scale(stretch,1/stretch);\n ctx.strokeStyle=CONFIG.ink;ctx.lineWidth=12;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(-233,0);ctx.lineTo(233,0);ctx.moveTo(196,-36);ctx.lineTo(233,0);ctx.lineTo(196,36);ctx.stroke();ctx.restore();\n}\nfunction sceneFinal(t){\n background(CONFIG.paper);\n const p=out(t/1.05),settle=smooth((t-1.3)/1.9);\n shadow(1480,925,340,.16);\n sculpture(1475,530,211,93,.7+t*.24,1.7+t*.35,-.25+t*.11,lerp(1.8,1.07,p),[CONFIG.violet,CONFIG.lime]);\n ctx.save();ctx.beginPath();ctx.rect(90,170,1160,570);ctx.clip();\n text('MAKE',120,414+(1-p)*310,248,CONFIG.ink);\n text('IT MOVE.',120,674+(1-out((t-.14)/1.05))*370,226,CONFIG.ink);\n ctx.restore();\n ctx.fillStyle=CONFIG.ink;ctx.fillRect(125,795,Math.max(0,1030*out((t-.55)/1.15)),6);\n /* The final orbit slows into a held, readable composition. */\n const a=-1.7+lerp(t*.6,1.8,settle);\n const x=1475+346*Math.cos(a),y=530+346*Math.sin(a);\n ellipse(x,y,14,14,CONFIG.ink);\n ctx.save();ctx.globalAlpha=.24;orbit(1475,530,346,346,0,CONFIG.ink,1.5);ctx.restore();\n}\n/* Oversized circular wipes preserve continuous motion between palettes. */\nfunction iris(next,local,progress,cx,cy){\n if(progress<=0)return;\n ctx.save();ctx.beginPath();ctx.arc(cx,cy,2400*smooth(progress),0,TAU);ctx.clip();next(local);ctx.restore();\n}\nfunction draw(time){\n const t=clamp(time,0,CONFIG.duration);\n ctx.setTransform(1,0,0,1,0,0);ctx.globalAlpha=1;ctx.clearRect(0,0,W,H);\n if(t<5.25){sceneMake(t);if(t>=4.55)iris(sceneIt,t-4.55,phase(t,4.55,5.25),1410,515)}\n else if(t<10){sceneIt(t-4.55);if(t>=9.25)iris(sceneMove,t-9.25,phase(t,9.25,10),960,540)}\n else if(t<14.25){sceneMove(t-9.25);if(t>=13.5)iris(sceneFinal,t-13.5,phase(t,13.5,14.25),1580,648)}\n else sceneFinal(t-13.5);\n}\nconst playhead={time:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{time:CONFIG.duration,duration:CONFIG.duration,ease:'none',onUpdate:()=>draw(playhead.time)},0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\ndraw(0);\n</script>\n</body>\n</html>",
