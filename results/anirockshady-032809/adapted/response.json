{"html":"<!DOCTYPE html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width,initial-scale=1'>\n<title>Gradient descent</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#191f21}#root{position:relative;width:100%;height:100%;overflow:hidden}canvas{position:absolute;inset:0;width:100%;height:100%;display:block}#background{background:#191f21}\n</style>\n</head>\n<body>\n<div id='root' data-composition-id='main' data-width='720' data-height='1280' data-duration='56.966667'>\n<canvas id='background' class='clip' data-start='0' data-duration='56.966667' width='720' height='1280'></canvas>\n<canvas id='terrain' class='clip' data-start='0' data-duration='56.966667' width='720' height='1280'></canvas>\n<canvas id='editorial' class='clip' data-start='0' data-duration='56.966667' width='720' height='1280'></canvas>\n</div>\n<script src='gsap.min.js'></script>\n<script>\n'use strict';\n/* Editable inferred reconstruction. No reference pixels are used.\n   All geometry, colors, camera poses and trajectories below are new approximations.\n   Time is supplied exclusively by the single paused HyperFrames timeline. */\nconst WIDTH=720, HEIGHT=1280, DURATION=56.966667;\nconst ORANGE='#f05b30', CYAN='#48d5ce', WHITE='#eeefea', GRAY='#a5abad';\nconst bg=document.getElementById('background').getContext('2d');\nconst ctx=document.getElementById('editorial').getContext('2d');\nconst gl=document.getElementById('terrain').getContext('webgl',{alpha:true,antialias:true,premultipliedAlpha:false,preserveDrawingBuffer:true});\nif(!gl)throw new Error('This composition requires WebGL.');\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst mix=(a,b,p)=>a+(b-a)*p;\nconst smooth=v=>{v=clamp(v);return v*v*(3-2*v)};\nfunction ramp(t,a,b){return smooth((t-a)/(b-a))}\nfunction envelope(t,a,b,fade=.35){return ramp(t,a,a+fade)*(1-ramp(t,b-fade,b))}\nfunction appear(t,a,d=.4){return ramp(t,a,a+d)}\nfunction heightAt(x,z){\n const crest=Math.exp(-((x+.90)**2+(z+.75)**2)/.30);\n const trough=Math.exp(-((x-.60)**2+(z-.35)**2)/.40);\n return .07*(x*x+z*z)+.91*crest-.48*trough;\n}\nfunction point(x,z,lift=0){return [x,heightAt(x,z)+lift,z]}\nconst poseKeys=[\n {t:0,yaw:.83,elev:.55,scale:190,cx:360,cy:900,brightness:1},\n {t:1.5,yaw:.83,elev:.55,scale:190,cx:360,cy:900,brightness:1},\n {t:2.15,yaw:.72,elev:.55,scale:190,cx:360,cy:812,brightness:.80},\n {t:2.85,yaw:.58,elev:.55,scale:190,cx:360,cy:790,brightness:.20},\n {t:9.5,yaw:.43,elev:.55,scale:190,cx:360,cy:790,brightness:.20},\n {t:10.3,yaw:.33,elev:.55,scale:198,cx:360,cy:737,brightness:.24},\n {t:11.0,yaw:.10,elev:.55,scale:205,cx:360,cy:715,brightness:1},\n {t:16.5,yaw:.04,elev:.55,scale:205,cx:360,cy:715,brightness:1},\n {t:17.1,yaw:-.10,elev:.55,scale:208,cx:360,cy:684,brightness:1},\n {t:20,yaw:-.18,elev:.55,scale:210,cx:360,cy:680,brightness:1},\n {t:30,yaw:-.36,elev:.54,scale:210,cx:360,cy:678,brightness:1},\n {t:33,yaw:-.40,elev:.54,scale:210,cx:360,cy:678,brightness:1},\n {t:34,yaw:-.25,elev:.48,scale:253,cx:280,cy:682,brightness:1},\n {t:41.8,yaw:-.31,elev:.48,scale:253,cx:280,cy:682,brightness:1},\n {t:43.4,yaw:-.58,elev:.43,scale:203,cx:352,cy:734,brightness:1},\n {t:44.3,yaw:-.59,elev:.43,scale:179,cx:360,cy:778,brightness:.19},\n {t:50.35,yaw:-.61,elev:.43,scale:179,cx:360,cy:778,brightness:.19},\n {t:51.3,yaw:-.57,elev:.40,scale:207,cx:360,cy:780,brightness:1},\n {t:DURATION,yaw:-.53,elev:.40,scale:207,cx:360,cy:780,brightness:1}\n];\nfunction poseAt(t){\n let a=poseKeys[0],b=a;\n for(let i=1;i<poseKeys.length;i++){b=poseKeys[i];if(t<=b.t)break;a=b}\n const p=a===b?0:smooth((t-a.t)/(b.t-a.t));\n const result={};for(const key of ['yaw','elev','scale','cx','cy','brightness'])result[key]=mix(a[key],b[key],p);\n return result;\n}\nfunction project(p,camera){\n const ca=Math.cos(camera.yaw),sa=Math.sin(camera.yaw),se=Math.sin(camera.elev),ce=Math.cos(camera.elev);\n const lateral=ca*p[0]-sa*p[2],depth=sa*p[0]+ca*p[2];\n return [camera.cx+camera.scale*lateral,camera.cy+camera.scale*(se*depth-ce*p[1])];\n}\nconst vertexSource=`\nattribute vec3 aPosition;\nattribute vec3 aNormal;\nuniform float uYaw;\nuniform float uElevation;\nuniform float uScale;\nuniform vec2 uOrigin;\nuniform float uRadius;\nuniform vec3 uCenter;\nuniform float uMode;\nvarying vec3 vPosition;\nvarying vec3 vNormal;\nvoid main(){\n vec3 p=aPosition;\n if(uMode>0.5)p=p*uRadius+uCenter;\n vPosition=p;vNormal=aNormal;\n float c=cos(uYaw),s=sin(uYaw),e=sin(uElevation),f=cos(uElevation);\n float lateral=c*p.x-s*p.z;\n float forward=s*p.x+c*p.z;\n float py=e*forward-f*p.y;\n float depth=f*forward+e*p.y;\n vec2 screen=uOrigin+uScale*vec2(lateral,py);\n gl_Position=vec4(screen.x/360.0-1.0,1.0-screen.y/640.0,-depth*.10,1.0);\n}`;\nconst fragmentSource=`\nprecision highp float;\nvarying vec3 vPosition;\nvarying vec3 vNormal;\nuniform float uMode;\nuniform vec3 uColor;\nuniform float uBrightness;\nvoid main(){\n vec3 n=normalize(vNormal);\n vec3 light=normalize(vec3(-.35,1.0,.5));\n float diffuse=.66+.34*max(dot(n,light),0.0);\n vec3 color;\n if(uMode<.5){\n  vec2 crest=vPosition.xz-vec2(-.90,-.75);\n  vec2 trough=vPosition.xz-vec2(.60,.35);\n  float hot=exp(-dot(crest,crest)/.47);\n  float cool=exp(-dot(trough,trough)/.30);\n  float rim=pow(clamp(max(abs(vPosition.x),abs(vPosition.z))/1.8,0.0,1.0),5.0);\n  color=mix(vec3(.46,.49,.50),vec3(.77,.43,.36),rim*.65);\n  color=mix(color,vec3(1.0,.30,.075),hot*.97);\n  color=mix(color,vec3(.12,.95,.91),cool*.98);\n  float gx=pow(abs(cos(vPosition.x*42.0)),28.0);\n  float gz=pow(abs(cos(vPosition.z*42.0)),28.0);\n  color*=diffuse;\n  color+=vec3(.035)*max(gx,gz)*(1.0-hot*.65);\n  color+=vec3(.0,.13,.12)*cool;\n }else{\n  color=uColor*diffuse;\n  float shine=pow(max(dot(n,normalize(vec3(-.35,.85,.55))),0.0),18.0);\n  color+=vec3(.30)*shine;\n }\n gl_FragColor=vec4(color*uBrightness,1.0);\n}`;\nfunction shader(type,source){const s=gl.createShader(type);gl.shaderSource(s,source);gl.compileShader(s);if(!gl.getShaderParameter(s,gl.COMPILE_STATUS))throw new Error(gl.getShaderInfoLog(s));return s}\nconst program=gl.createProgram();gl.attachShader(program,shader(gl.VERTEX_SHADER,vertexSource));gl.attachShader(program,shader(gl.FRAGMENT_SHADER,fragmentSource));gl.linkProgram(program);if(!gl.getProgramParameter(program,gl.LINK_STATUS))throw new Error(gl.getProgramInfoLog(program));gl.useProgram(program);\nconst U={};for(const name of ['Yaw','Elevation','Scale','Origin','Radius','Center','Mode','Color','Brightness'])U[name]=gl.getUniformLocation(program,'u'+name);\nconst positionLocation=gl.getAttribLocation(program,'aPosition'),normalLocation=gl.getAttribLocation(program,'aNormal');\nfunction geometry(positions,normals,indices){\n function buffer(data,target){let b=gl.createBuffer();gl.bindBuffer(target,b);gl.bufferData(target,data,gl.STATIC_DRAW);return b}\n return {positions:buffer(new Float32Array(positions),gl.ARRAY_BUFFER),normals:buffer(new Float32Array(normals),gl.ARRAY_BUFFER),indices:buffer(new Uint16Array(indices),gl.ELEMENT_ARRAY_BUFFER),count:indices.length};\n}\nfunction terrainGeometry(){\n const p=[],n=[],indices=[],N=140;\n for(let j=0;j<=N;j++)for(let i=0;i<=N;i++){\n  const x=-1.8+3.6*i/N,z=-1.8+3.6*j/N,e=.002;\n  const dx=(heightAt(x+e,z)-heightAt(x-e,z))/(2*e),dz=(heightAt(x,z+e)-heightAt(x,z-e))/(2*e),d=Math.hypot(dx,1,dz);\n  p.push(x,heightAt(x,z),z);n.push(-dx/d,1/d,-dz/d);\n }\n for(let j=0;j<N;j++)for(let i=0;i<N;i++){const k=j*(N+1)+i;indices.push(k,k+1,k+N+1,k+1,k+N+2,k+N+1)}\n return geometry(p,n,indices);\n}\nfunction sphereGeometry(){\n const p=[],n=[],indices=[],rows=14,cols=24;\n for(let j=0;j<=rows;j++)for(let i=0;i<=cols;i++){\n  const a=Math.PI*j/rows,b=2*Math.PI*i/cols,x=Math.sin(a)*Math.cos(b),y=Math.cos(a),z=Math.sin(a)*Math.sin(b);\n  p.push(x,y,z);n.push(x,y,z);\n }\n for(let j=0;j<rows;j++)for(let i=0;i<cols;i++){const k=j*(cols+1)+i;indices.push(k,k+1,k+cols+1,k+1,k+cols+2,k+cols+1)}\n return geometry(p,n,indices);\n}\nconst terrainMesh=terrainGeometry(),sphereMesh=sphereGeometry();\nfunction bind(mesh){\n gl.bindBuffer(gl.ARRAY_BUFFER,mesh.positions);gl.enableVertexAttribArray(positionLocation);gl.vertexAttribPointer(positionLocation,3,gl.FLOAT,false,0,0);\n gl.bindBuffer(gl.ARRAY_BUFFER,mesh.normals);gl.enableVertexAttribArray(normalLocation);gl.vertexAttribPointer(normalLocation,3,gl.FLOAT,false,0,0);\n gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,mesh.indices);\n}\nfunction sphere(p,r,color){gl.uniform1f(U.Mode,1);gl.uniform1f(U.Radius,r);gl.uniform3fv(U.Center,p);gl.uniform3fv(U.Color,color);gl.drawElements(gl.TRIANGLES,sphereMesh.count,gl.UNSIGNED_SHORT,0)}\nconst orangeRGB=[1,.31,.07],cyanRGB=[.13,.92,.88],whiteRGB=[.98,1,.99];\nfunction route(u,lift=.025){u=clamp(u);return point(mix(-.9,.60,u),mix(-.75,.35,u)+.13*Math.sin(Math.PI*u),lift)}\nconst readouts=[\n [19.7,2,'2.48'],[21,4,'1.43'],[22,7,'1.09'],[23,10,'0.89'],[24,13,'0.62'],[25,16,'0.28'],[26,19,'0.07'],[27,22,'0.02'],[28,24,'0.00'],[28.67,26,'0.00'],[29,27,'0.00'],[30,30,'0.00']\n];\nfunction descentState(t){\n let index=0;for(let i=0;i<readouts.length;i++)if(t>=readouts[i][0])index=i;\n const a=readouts[index],b=readouts[Math.min(index+1,readouts.length-1)];\n const fraction=a===b?0:clamp((t-a[0])/(b[0]-a[0]));\n return {step:a[1],loss:a[2],progress:mix(a[1],b[1],fraction)/30};\n}\nfunction routeAmount(stepFraction){return 1-Math.pow(1-clamp(stepFraction),2.25)}\nconst cyanKeys=[\n [35.4,-.75,.42,.06],[36,.34,.17,.20],[37,.54,.14,.08],[38,.52,-.03,.36],\n [39,.57,.14,.16],[40,.55,.25,.31],[41,.51,.04,.40],[42,.54,.13,.17],[43.5,.56,.23,.11]\n];\nfunction cyanPosition(t){\n let a=cyanKeys[0],b=a;for(let i=1;i<cyanKeys.length;i++){b=cyanKeys[i];if(t<=b[0])break;a=b}\n const u=a===b?0:clamp((t-a[0])/(b[0]-a[0]));\n return point(mix(a[1],b[1],u),mix(a[2],b[2],u),mix(a[3],b[3],u));\n}\nfunction renderTerrain(t,camera){\n gl.viewport(0,0,WIDTH,HEIGHT);gl.clearColor(0,0,0,0);gl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT);gl.enable(gl.DEPTH_TEST);gl.depthFunc(gl.LEQUAL);gl.disable(gl.CULL_FACE);\n gl.useProgram(program);gl.uniform1f(U.Yaw,camera.yaw);gl.uniform1f(U.Elevation,camera.elev);gl.uniform1f(U.Scale,camera.scale);gl.uniform2f(U.Origin,camera.cx,camera.cy);gl.uniform1f(U.Brightness,camera.brightness);\n gl.uniform1f(U.Mode,0);bind(terrainMesh);gl.drawElements(gl.TRIANGLES,terrainMesh.count,gl.UNSIGNED_SHORT,0);bind(sphereMesh);\n if(t<19.7){sphere(route(0,.065),.067,whiteRGB)}\n else if(t<33.5){\n  const state=descentState(t),amount=routeAmount(state.progress);\n  for(let i=1;i<=30;i++){if(i/30<=state.progress)sphere(route(routeAmount(i/30),.025),.024,orangeRGB)}\n  sphere(route(amount,.065),.063,whiteRGB);\n }else if(t<43.8){\n  const p=ramp(t,34.2,41),orangeU=mix(.13,.98,1-Math.pow(1-p,3));\n  const start=[-.80,.54],end=[.59,.35];\n  function compareRoute(u,lift){return point(mix(start[0],end[0],u),mix(start[1],end[1],u)-.22*Math.sin(Math.PI*u),lift)}\n  const whiteU=.04+.19*ramp(t,35,43);\n  for(let i=0;i<20;i++){let u=i/20;if(u<orangeU)sphere(compareRoute(u,.025),.024,orangeRGB)}\n  if(t>=35){for(let i=0;i<9;i++){let u=i*.035;if(u<whiteU)sphere(compareRoute(u,.025),.018,whiteRGB)}sphere(compareRoute(whiteU,.055),.064,whiteRGB)}\n  sphere(compareRoute(orangeU,.082),.093,orangeRGB);\n  if(t>=35.4){\n   const current=cyanPosition(t);\n   for(let i=0;i<cyanKeys.length;i++)if(cyanKeys[i][0]<t&&cyanKeys[i][0]>t-2.2)sphere(point(cyanKeys[i][1],cyanKeys[i][2],cyanKeys[i][3]),.020,cyanRGB);\n   const previous=cyanPosition(Math.max(35.4,t-.75));\n   for(let i=1;i<7;i++){let a=i/7;sphere([mix(previous[0],current[0],a),mix(previous[1],current[1],a),mix(previous[2],current[2],a)],.016,cyanRGB)}\n   sphere(current,.062,cyanRGB);\n  }\n }else{\n  for(let i=1;i<=30;i++)sphere(route(routeAmount(i/30),.027),.024,orangeRGB);\n }\n}\nfunction background(){\n bg.fillStyle='#1b2224';bg.fillRect(0,0,WIDTH,HEIGHT);\n let g=bg.createRadialGradient(695,55,0,690,40,900);g.addColorStop(0,'rgba(110,60,47,.48)');g.addColorStop(.6,'rgba(81,50,44,.15)');g.addColorStop(1,'rgba(0,0,0,0)');bg.fillStyle=g;bg.fillRect(0,0,WIDTH,HEIGHT);\n g=bg.createRadialGradient(50,1135,0,45,1120,840);g.addColorStop(0,'rgba(11,87,78,.25)');g.addColorStop(1,'rgba(0,0,0,0)');bg.fillStyle=g;bg.fillRect(0,0,WIDTH,HEIGHT);\n g=bg.createLinearGradient(0,0,650,1200);g.addColorStop(0,'rgba(0,0,0,0)');g.addColorStop(1,'rgba(0,0,0,.25)');bg.fillStyle=g;bg.fillRect(0,0,WIDTH,HEIGHT);\n}\nfunction text(lines,x,y,size=28,color=WHITE,family='sans-serif',lineHeight=size*1.28,style=''){\n const list=Array.isArray(lines)?lines:[lines];ctx.fillStyle=color;ctx.font=`${style} ${size}px ${family}`;ctx.textBaseline='top';ctx.textAlign='left';for(let i=0;i<list.length;i++)ctx.fillText(list[i],x,y+i*lineHeight);\n}\nfunction fitted(line,x,y,size,maxWidth,color=WHITE,family='serif',style=''){\n ctx.font=`${style} ${size}px ${family}`;const w=ctx.measureText(line).width;text(line,x,y,w>maxWidth?size*maxWidth/w:size,color,family,size*1.25,style);\n}\nfunction layer(alpha,fn){if(alpha<=0)return;ctx.save();ctx.globalAlpha=clamp(alpha);fn();ctx.restore()}\nfunction roundedRect(x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath()}\nfunction pill(label,x,y,color,size=18){\n ctx.font=`${size}px sans-serif`;const width=ctx.measureText(label).width+20;\n roundedRect(x,y,width,32,12);ctx.fillStyle='rgba(19,27,29,.88)';ctx.fill();ctx.strokeStyle=color;ctx.lineWidth=1.3;ctx.stroke();text(label,x+10,y+6,size,WHITE);return width;\n}\nfunction leader(x1,y1,x2,y2,color){ctx.strokeStyle=color;ctx.lineWidth=1.2;ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();ctx.fillStyle=color;ctx.beginPath();ctx.arc(x2,y2,3,0,Math.PI*2);ctx.fill()}\nfunction arrow(x1,y1,x2,y2,color){\n const a=Math.atan2(y2-y1,x2-x1),head=21;\n ctx.strokeStyle=color;ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2-Math.cos(a)*head*.65,y2-Math.sin(a)*head*.65);ctx.stroke();\n ctx.fillStyle=color;ctx.beginPath();ctx.moveTo(x2,y2);ctx.lineTo(x2-head*Math.cos(a-.37),y2-head*Math.sin(a-.37));ctx.lineTo(x2-head*Math.cos(a+.37),y2-head*Math.sin(a+.37));ctx.closePath();ctx.fill();\n}\nfunction accentEntry(title,description,x,y,color,titleSize=29,descriptionSize=20,width=575){\n ctx.fillStyle=color;ctx.fillRect(x,y,4,description.length>1?75:65);\n fitted(title,x+21,y-2,titleSize,width-24,WHITE,'serif');text(description,x+21,y+34,descriptionSize,GRAY,'sans-serif',25);\n}\nfunction header(t){\n const alpha=appear(t,1.75,.3);\n layer(alpha,()=>{text('Why am I learning this?',73,85,20,GRAY);ctx.textAlign='right';ctx.font='20px sans-serif';ctx.fillStyle=GRAY;ctx.fillText('Part 4',647,85);ctx.textAlign='left'});\n}\nfunction opening(t){\n layer(1-ramp(t,1.35,1.95),()=>{\n  text('Why am I learning this?',73,180,25,GRAY);\n  const g=ctx.createLinearGradient(73,0,435,0);g.addColorStop(0,'#f05026');g.addColorStop(.48,'#df8662');g.addColorStop(.76,'#a1a896');g.addColorStop(1,'#4accc1');\n  text(['Gradient','descent'],73,227,96,g,'serif',114);\n  fitted('how every model you train actually learns',73,506,34,575,WHITE,'serif','italic');\n });\n}\nfunction classification(t){\n const a=envelope(t,2.45,9.85,.36);\n layer(a,()=>{\n  text(['What kind of algorithm is','it?'],73,161,51,WHITE,'serif',57);\n  fitted('Not supervised. Not unsupervised.',73,286,38,577,WHITE,'serif','italic');\n  layer(appear(t,3.65),()=>text(['It is an optimisation algorithm:','first-order and iterative.'],73,369,29,WHITE,'sans-serif',37));\n  layer(appear(t,4.65),()=>text(['It makes no predictions itself. It tunes the','parameters of the models that do.'],73,463,26,GRAY,'sans-serif',33));\n  layer(appear(t,5.55),()=>{text('It trains all three families:',73,644,24,GRAY);accentEntry('Supervised',['neural networks, linear and logistic regression'],73,701,ORANGE,30,20)});\n  layer(appear(t,6.20),()=>accentEntry('Unsupervised',['autoencoders, t-SNE, matrix factorisation'],73,800,CYAN,30,20));\n  layer(appear(t,6.65),()=>accentEntry('Reinforcement',['policy-gradient methods'],73,899,'#cbd4d2',30,20));\n });\n}\nfunction landscape(t,camera){\n layer(envelope(t,10.55,16.85,.35),()=>{\n  fitted('Meet the loss landscape.',73,162,51,576);\n  const peak=project(route(0,.075),camera),trough=project(point(.6,.35,.015),camera);\n  layer(appear(t,11.45),()=>{const x=84,y=250,w=pill('Crest: high loss',x,y,ORANGE);leader(x+w*.55,y+35,peak[0]-4,peak[1]-20,ORANGE)});\n  layer(appear(t,12.25),()=>{\n   const x=430,y=889;pill('Trough: lowest loss',x,y,CYAN);leader(x+40,y-4,trough[0]+5,Math.min(864,trough[1]+10),CYAN);\n  });\n  layer(appear(t,12.60),()=>text(['Every point on this surface is one setting','of the model’s parameters.'],73,949,28,WHITE,'sans-serif',35));\n  layer(appear(t,13.55),()=>text(['Height is how wrong the model is. Training','means finding the lowest point.'],73,1033,28,CYAN,'sans-serif',35));\n });\n}\nfunction lossValue(u){\n const nodes=[[0,3.1],[.067,2.48],[.133,1.43],[.233,1.09],[.333,.89],[.433,.62],[.533,.28],[.633,.07],[.733,.02],[.8,0],[1,0]];\n let a=nodes[0],b=a;for(let i=1;i<nodes.length;i++){b=nodes[i];if(u<=b[0])break;a=b}return mix(a[1],b[1],a===b?0:clamp((u-a[0])/(b[0]-a[0])));\n}\nfunction chart(progress){\n const x=73,y=953,w=574,h=90;\n ctx.strokeStyle='rgba(172,186,185,.25)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(x,y+h);ctx.lineTo(x+w,y+h);ctx.stroke();\n const g=ctx.createLinearGradient(x,0,x+w,0);g.addColorStop(0,ORANGE);g.addColorStop(.62,'#e68565');g.addColorStop(.86,'#b9bca9');g.addColorStop(1,CYAN);\n ctx.strokeStyle=g;ctx.lineWidth=3;ctx.lineJoin='round';ctx.lineCap='round';ctx.beginPath();\n for(let i=0;i<=240;i++){const u=progress*i/240,px=x+w*u,py=y+h-h*lossValue(u)/3.1;i?ctx.lineTo(px,py):ctx.moveTo(px,py)}ctx.stroke();\n}\nfunction descent(t,camera){\n const a=envelope(t,16.75,32.95,.3);\n layer(a,()=>{\n  fitted('Follow the slope downhill.',73,162,52,574);\n  layer(appear(t,17.45),()=>text('θ ← θ − η ∇L(θ)',73,250,41,WHITE,'serif',48,'italic'));\n  const peak=project(route(0,.07),camera);\n  layer(envelope(t,16.9,19.75,.2),()=>{\n   arrow(peak[0]-10,peak[1]-8,peak[0]-34,peak[1]-88,CYAN);\n   layer(appear(t,17.6),()=>{pill('Cyan arrow: + gradient, uphill',73,927,CYAN);text(['The gradient points uphill, toward more','error. So step the other way.'],73,1091,28,WHITE,'sans-serif',36)});\n   layer(appear(t,18.5),()=>{arrow(peak[0]+12,peak[1]+22,peak[0]+37,peak[1]+92,ORANGE);pill('Orange arrow: − gradient, downhill',73,983,ORANGE)});\n  });\n  layer(appear(t,19.65,.25),()=>{\n   const state=descentState(t),p=routeAmount(state.progress),ball=project(route(p,.06),camera);\n   if(p<.985){const next=project(route(Math.min(1,p+.07),.025),camera);const dx=next[0]-ball[0],dy=next[1]-ball[1],d=Math.hypot(dx,dy)||1;arrow(ball[0]+dx/d*26,ball[1]+dy/d*26,ball[0]+dx/d*61,ball[1]+dy/d*61,ORANGE)}\n   text('Step '+state.step+' of 30',73,913,25,GRAY);\n   ctx.font='bold 25px sans-serif';ctx.fillStyle=WHITE;ctx.textAlign='right';ctx.fillText('Loss '+state.loss,647,913);ctx.textAlign='left';\n   chart(state.progress);\n   if(t<25.8)text(['Each step: measure the slope, move a little','downhill, repeat.'],73,1099,28,WHITE,'sans-serif',36);\n   else if(t<30.7)text(['Steps shrink on their own as the ground','flattens out.'],73,1099,28,WHITE,'sans-serif',36);\n   else text(['Trough reached. Lowest loss, trained','model.'],73,1099,28,ORANGE,'sans-serif',36);\n  });\n });\n}\nfunction learningRate(t){\n layer(envelope(t,33.65,43.85,.35),()=>{\n  fitted('The learning rate, η',73,162,52,574);\n  text('Same start. Only the step size changes.',73,247,27,GRAY);\n  const rows=[['η = 0.05','too small: crawls',WHITE,34.65],['η = 1.30','too large: zig-zags',CYAN,35.05],['η = 0.60','just right',ORANGE,35.45]];\n  for(let i=0;i<rows.length;i++){\n   const row=rows[i];layer(appear(t,row[3]),()=>{const y=1002+i*51;ctx.fillStyle=row[2];ctx.beginPath();ctx.arc(84,y+12,10,0,Math.PI*2);ctx.fill();text(row[0],108,y,24,WHITE);text(row[1],260,y,24,i===0?GRAY:row[2])});\n  }\n  layer(appear(t,41.65),()=>text(['Tuning η is half the craft of training a','model.'],73,1180,28,WHITE,'sans-serif',35));\n });\n}\nconst useCases=[\n ['Deep neural networks',['Backpropagation computes the gradient; SGD or Adam','takes the step.'],ORANGE,44.5],\n ['Large language models',['Billions of parameters, all tuned by the same descent.'],CYAN,44.8],\n ['Regression at scale',['Linear and logistic models on data too large for','closed-form solutions.'],ORANGE,45.35],\n ['Recommender systems',['Matrix factorisation learns user and item vectors.'],CYAN,45.7],\n ['Vision and speech',['Image classifiers, detectors and speech recognisers.'],ORANGE,46.05],\n ['Embeddings',['word2vec vectors and t-SNE maps.'],CYAN,46.45]\n];\nfunction uses(t){\n layer(envelope(t,43.85,50.8,.35),()=>{\n  text('Where it runs',73,162,52,WHITE,'serif');\n  for(let i=0;i<useCases.length;i++){let row=useCases[i];layer(appear(t,row[3]),()=>accentEntry(row[0],row[1],73,292+i*118,row[2],31,20))}\n  layer(appear(t,46.9,.7),()=>text(['Common variants: batch, stochastic (SGD),','mini-batch, momentum, Adam.'],73,1092,25,GRAY,'sans-serif',34));\n });\n}\nfunction conclusion(t){\n layer(appear(t,50.8,.45),()=>{\n  fitted('So why am I learning this?',73,162,52,574);\n  layer(appear(t,51.55,.45),()=>{\n   const g=ctx.createLinearGradient(73,0,637,0);g.addColorStop(0,ORANGE);g.addColorStop(.45,'#e18460');g.addColorStop(.7,'#a8b4a0');g.addColorStop(1,CYAN);\n   fitted('Every model you train is a ball',73,262,41,574,g,'serif','italic');\n   text('rolling downhill.',73,312,41,ORANGE,'serif',50,'italic');\n  });\n  layer(appear(t,52.55,.45),()=>text(['Loss is the hill. The gradient is the slope. η is','the stride.'],73,387,28,GRAY,'sans-serif',36));\n });\n}\nfunction progress(t){\n ctx.fillStyle='rgba(179,196,190,.21)';ctx.fillRect(0,1274,720,6);\n const g=ctx.createLinearGradient(0,0,720,0);g.addColorStop(0,ORANGE);g.addColorStop(.49,'#ed896a');g.addColorStop(.78,'#b5c6b6');g.addColorStop(1,CYAN);ctx.fillStyle=g;ctx.fillRect(0,1274,720*clamp(t/DURATION),6);\n}\nfunction draw(t){\n t=clamp(t,0,DURATION);const camera=poseAt(t);renderTerrain(t,camera);ctx.clearRect(0,0,WIDTH,HEIGHT);\n header(t);opening(t);classification(t);landscape(t,camera);descent(t,camera);learningRate(t);uses(t);conclusion(t);progress(t);\n}\nbackground();\nconst time={value:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(time,{value:DURATION,duration:DURATION,ease:'none',onUpdate:()=>draw(time.value)},0);\ndraw(0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\n</script>\n</body>\n</html>","width":720,"height":1280,"duration_seconds":56.966667,"assumptions":["Reconstructed from the supplied visual evidence; terrain equations, materials, camera interpolation, fades and continuous trajectories are inferred.","Generic serif and sans-serif fonts approximate the unknown reference typography.","Displayed step and loss values follow the supplied reference labels; the geometry is illustrative rather than a recovered optimizer.","Silent composition, intended for capture at 30 fps. No closing fade is added.","Editable source only; rendering, browser/GPU verification and matched-time visual review have not been performed."],"missing_inputs":[],"summary":"Complete seekable portrait HyperFrames animation with procedural WebGL terrain, depth-tested spheres and paths, classification, loss chart, learning-rate comparison, use cases and concluding metaphor."}