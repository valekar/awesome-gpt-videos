{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Gradient descent</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#191f21}#root{position:relative;width:100%;height:100%;overflow:hidden}canvas{position:absolute;inset:0;width:100%;height:100%;display:block}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"720\" data-height=\"1280\" data-duration=\"56.966667\" data-fps=\"30\">\n<canvas id=\"background\" class=\"clip\" data-start=\"0\" data-duration=\"56.966667\" width=\"720\" height=\"1280\"></canvas>\n<canvas id=\"terrain\" class=\"clip\" data-start=\"0\" data-duration=\"56.966667\" width=\"720\" height=\"1280\"></canvas>\n<canvas id=\"editorial\" class=\"clip\" data-start=\"0\" data-duration=\"56.966667\" width=\"720\" height=\"1280\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n'use strict';\n/* Original, editable reconstruction from supplied visual evidence.\n   No reference images or recovered scene code are used.\n   Terrain, projected poses, lighting and between-sample motion are inferred.\n   Source only: no rendering or matched-time validation is claimed. */\nconst WIDTH=720,HEIGHT=1280,DURATION=56.966667;\nconst ORANGE='#ef5b30',CYAN='#49cec8',WHITE='#eeefea',GRAY='#a5abad';\nconst bg=document.getElementById('background').getContext('2d');\nconst ink=document.getElementById('editorial').getContext('2d');\nconst gl=document.getElementById('terrain').getContext('webgl',{alpha:true,antialias:true,premultipliedAlpha:false,preserveDrawingBuffer:true});\nif(!gl)throw new Error('WebGL is required for this composition.');\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst mix=(a,b,p)=>a+(b-a)*p;\nconst smooth=v=>{v=clamp(v);return v*v*(3-2*v)};\nconst ramp=(t,a,b)=>smooth((t-a)/(b-a));\nconst appear=(t,a,d=.4)=>ramp(t,a,a+d);\nconst envelope=(t,a,b,d=.35)=>ramp(t,a,a+d)*(1-ramp(t,b-d,b));\nconst CREST=[-.90,-.75],BASIN=[.50,.35],EXTENT=1.8;\nfunction heightAt(x,z){\n const hot=Math.exp(-((x-CREST[0])**2+(z-CREST[1])**2)/.30);\n const cool=Math.exp(-((x-BASIN[0])**2+(z-BASIN[1])**2)/.40);\n return .07*(x*x+z*z)+.91*hot-.56*cool;\n}\nfunction point(x,z,lift=0){return [x,heightAt(x,z)+lift,z]}\nfunction route(u,lift=.025){\n u=clamp(u,0,1.16);\n return point(mix(CREST[0],BASIN[0],u),mix(CREST[1],BASIN[1],u)+.13*Math.sin(Math.PI*u),lift);\n}\nfunction routeAmount(f){return 1-Math.pow(1-clamp(f),2.25)}\n\n/* Each pose exposes its framing and three vertical silhouette anchors.\n   The anchors fit the projection, rather than moving editorial text.\n   Perspective and height-field depth remain shared by every object. */\nconst opening={yaw:.75,sx:200,cx:363,perspective:.045,rear:[-1.8,-1.8,590],front:[1.8,1.8,1059],peak:630,brightness:1};\nconst introduction={yaw:.50,sx:230,cx:380,perspective:.042,rear:[-1.8,-1.8,385],front:[1.8,1.8,842],peak:425,brightness:1};\nconst downhill={yaw:.106,sx:200,cx:358,perspective:.052,rear:[-1.8,-1.8,425],front:[0,1.8,810],peak:426,brightness:1};\nconst comparison={yaw:-.25,sx:270,cx:315,perspective:.045,rear:[1.8,-1.8,335],front:[-1.8,1.8,935],peak:411,brightness:1};\nconst ending={yaw:-.80,sx:198,cx:360,perspective:.018,rear:[1.8,-1.8,495],front:[-1.8,1.8,965],peak:610,brightness:1};\nconst poseDescriptions=[\n {t:0,...opening},{t:1.5,...opening},\n {t:2.15,...opening,yaw:.68,sx:205,cx:360,rear:[-1.8,-1.8,492],front:[1.8,1.8,951],peak:541,brightness:.76},\n {t:2.85,...opening,yaw:.60,sx:207,cx:360,rear:[-1.8,-1.8,453],front:[1.8,1.8,878],peak:498,brightness:.235},\n {t:9.5,...opening,yaw:.50,sx:207,cx:360,rear:[-1.8,-1.8,453],front:[1.8,1.8,878],peak:498,brightness:.235},\n {t:10.3,...introduction,peak:435,brightness:.27},\n {t:11,...introduction},\n {t:16.5,...introduction,yaw:.43,sx:225,cx:370},\n {t:17.1,...downhill},{t:20,...downhill},\n {t:30,...downhill,yaw:.05,sx:202,cx:369,peak:425,front:[0,1.8,806]},\n {t:33,...downhill,yaw:.03,sx:202,cx:373,peak:425,front:[0,1.8,806]},\n {t:34,...comparison},\n {t:41.8,...comparison,yaw:-.31},\n {t:43.4,...comparison,yaw:-.76,sx:215,cx:360,perspective:.025,rear:[1.8,-1.8,465],front:[-1.8,1.8,866],peak:510},\n {t:44.3,...ending,sx:180,rear:[1.8,-1.8,600],front:[-1.8,1.8,960],peak:640,brightness:.245},\n {t:50.35,...ending,yaw:-.82,sx:180,rear:[1.8,-1.8,600],front:[-1.8,1.8,960],peak:640,brightness:.245},\n {t:51.3,...ending},{t:DURATION,...ending,yaw:-.79}\n];\nfunction solve3(matrix,values){\n const a=matrix.map((row,i)=>[...row,values[i]]);\n for(let c=0;c<3;c++){\n  let pivot=c;for(let r=c+1;r<3;r++)if(Math.abs(a[r][c])>Math.abs(a[pivot][c]))pivot=r;\n  [a[c],a[pivot]]=[a[pivot],a[c]];\n  const d=a[c][c];if(Math.abs(d)<1e-9)throw new Error('Degenerate terrain pose.');\n  for(let k=c;k<4;k++)a[c][k]/=d;\n  for(let r=0;r<3;r++)if(r!==c){const f=a[r][c];for(let k=c;k<4;k++)a[r][k]-=f*a[c][k]}\n }\n return a.map(row=>row[3]);\n}\nfunction fitPose(description){\n const c={...description,depthScale:95,heightScale:200,cy:760};\n const anchors=[description.rear,description.front,[CREST[0],CREST[1],description.peak]];\n for(let iteration=0;iteration<10;iteration++){\n  const length=Math.hypot(c.depthScale,c.heightScale),ce=c.heightScale/length,se=c.depthScale/length;\n  const matrix=anchors.map(a=>{\n   const forward=Math.sin(c.yaw)*a[0]+Math.cos(c.yaw)*a[1],h=heightAt(a[0],a[1]);\n   const q=1/(1-c.perspective*(ce*forward+se*h));\n   return [1,q*forward,-q*h];\n  });\n  [c.cy,c.depthScale,c.heightScale]=solve3(matrix,anchors.map(a=>a[2]));\n }\n return c;\n}\nconst poseKeys=poseDescriptions.map(fitPose);\nfunction poseAt(t){\n let a=poseKeys[0],b=a;\n for(let i=1;i<poseKeys.length;i++){b=poseKeys[i];if(t<=b.t)break;a=b}\n const p=a===b?0:smooth((t-a.t)/(b.t-a.t));\n const c={};for(const key of ['yaw','sx','cx','cy','depthScale','heightScale','perspective','brightness'])c[key]=mix(a[key],b[key],p);\n return c;\n}\nfunction project(p,c){\n const ca=Math.cos(c.yaw),sa=Math.sin(c.yaw),lateral=ca*p[0]-sa*p[2],forward=sa*p[0]+ca*p[2];\n const length=Math.hypot(c.depthScale,c.heightScale),ce=c.heightScale/length,se=c.depthScale/length;\n const depth=ce*forward+se*p[1],q=1/(1-c.perspective*depth);\n return [c.cx+c.sx*lateral*q,c.cy+(c.depthScale*forward-c.heightScale*p[1])*q];\n}\n\nconst vertexSource=`\nattribute vec3 aPosition;\nattribute vec3 aNormal;\nuniform float uYaw;\nuniform float uScaleX;\nuniform float uDepthScale;\nuniform float uHeightScale;\nuniform float uPerspective;\nuniform vec2 uOrigin;\nuniform float uRadius;\nuniform vec3 uCenter;\nuniform vec3 uEnd;\nuniform float uMode;\nvarying vec3 vPosition;\nvarying vec3 vNormal;\nvoid main(){\n vec3 p=aPosition;\n vec3 n=aNormal;\n if(uMode>.5&&uMode<1.5){p=p*uRadius+uCenter;}\n else if(uMode>1.5){\n  vec3 delta=uEnd-uCenter;\n  float length=max(length(delta),.0001);\n  vec3 axis=delta/length;\n  vec3 reference=abs(axis.y)>.95?vec3(1.,0.,0.):vec3(0.,1.,0.);\n  vec3 side=normalize(cross(reference,axis));\n  vec3 other=normalize(cross(axis,side));\n  p=uCenter+axis*(aPosition.y*length)+uRadius*(side*aPosition.x+other*aPosition.z);\n  n=normalize(side*aNormal.x+axis*aNormal.y+other*aNormal.z);\n }\n vPosition=p;vNormal=n;\n float c=cos(uYaw),s=sin(uYaw);\n float lateral=c*p.x-s*p.z,forward=s*p.x+c*p.z;\n float length=sqrt(uDepthScale*uDepthScale+uHeightScale*uHeightScale);\n float ce=uHeightScale/length,se=uDepthScale/length;\n float depth=ce*forward+se*p.y;\n float q=1./(1.-uPerspective*depth);\n vec2 screen=uOrigin+vec2(uScaleX*lateral,uDepthScale*forward-uHeightScale*p.y)*q;\n float w=1./q;\n gl_Position=vec4((screen.x/360.-1.)*w,(1.-screen.y/640.)*w,-depth*.085*w,w);\n}`;\nconst fragmentSource=`\nprecision highp float;\nvarying vec3 vPosition;\nvarying vec3 vNormal;\nuniform float uMode;\nuniform vec3 uColor;\nuniform float uBrightness;\nuniform float uOpacity;\nvoid main(){\n vec3 n=normalize(vNormal);\n vec3 light=normalize(vec3(-.35,1.,.35));\n vec3 color;\n if(uMode<.5){\n  vec2 crest=vPosition.xz-vec2(-.90,-.75);\n  vec2 basin=vPosition.xz-vec2(.50,.35);\n  float hot=exp(-dot(crest,crest)/.49);\n  float core=exp(-dot(crest,crest)/.095);\n  float cool=exp(-dot(basin,basin)/.47);\n  float inner=exp(-dot(basin,basin)/.19);\n  float rim=pow(clamp(max(abs(vPosition.x),abs(vPosition.z))/1.8,0.,1.),5.);\n  float diffuse=.84+.16*max(dot(n,light),0.);\n  color=mix(vec3(.565,.585,.590),vec3(.87,.50,.425),rim*.57);\n  color=mix(color,vec3(1.,.33,.105),hot*.94);\n  color=mix(color,vec3(1.,.57,.17),core*.48);\n  color=mix(color,vec3(.18,.88,.84),cool*.64);\n  color=color*diffuse+inner*vec3(.035,.255,.23);\n  vec2 grid=abs(fract((vPosition.xz+1.8)*17.)-.5);\n  float line=1.-smoothstep(.012,.035,min(grid.x,grid.y));\n  color+=line*vec3(.018)*(1.-hot*.65)*(1.-inner*.5);\n  if(!gl_FrontFacing){\n   color=mix(vec3(.08,.19,.195),vec3(.09,.39,.375),cool*.8);\n   color+=inner*vec3(.005,.065,.06);\n  }\n }else{\n  float diffuse=.81+.19*max(dot(n,light),0.);\n  float shine=pow(max(dot(n,normalize(vec3(-.35,.85,.55))),0.),20.);\n  color=uColor*diffuse+vec3(.28)*shine;\n  if(uColor.r>.9&&uColor.g>.9)color=mix(color,uColor,.52);\n }\n color=mix(vec3(.105,.123,.126),color,uBrightness);\n gl_FragColor=vec4(color,uOpacity);\n}`;\nfunction shader(type,source){\n const s=gl.createShader(type);gl.shaderSource(s,source);gl.compileShader(s);\n if(!gl.getShaderParameter(s,gl.COMPILE_STATUS))throw new Error(gl.getShaderInfoLog(s));return s;\n}\nconst program=gl.createProgram();\ngl.attachShader(program,shader(gl.VERTEX_SHADER,vertexSource));\ngl.attachShader(program,shader(gl.FRAGMENT_SHADER,fragmentSource));\ngl.linkProgram(program);\nif(!gl.getProgramParameter(program,gl.LINK_STATUS))throw new Error(gl.getProgramInfoLog(program));\ngl.useProgram(program);\nconst U={};\nfor(const name of ['Yaw','ScaleX','DepthScale','HeightScale','Perspective','Origin','Radius','Center','End','Mode','Color','Brightness','Opacity'])U[name]=gl.getUniformLocation(program,'u'+name);\nconst positionLocation=gl.getAttribLocation(program,'aPosition'),normalLocation=gl.getAttribLocation(program,'aNormal');\nfunction geometry(positions,normals,indices){\n function buffer(data,target){const b=gl.createBuffer();gl.bindBuffer(target,b);gl.bufferData(target,data,gl.STATIC_DRAW);return b}\n return {positions:buffer(new Float32Array(positions),gl.ARRAY_BUFFER),normals:buffer(new Float32Array(normals),gl.ARRAY_BUFFER),indices:buffer(new Uint16Array(indices),gl.ELEMENT_ARRAY_BUFFER),count:indices.length};\n}\nfunction terrainGeometry(){\n const p=[],n=[],indices=[],N=160;\n for(let j=0;j<=N;j++)for(let i=0;i<=N;i++){\n  const x=-EXTENT+2*EXTENT*i/N,z=-EXTENT+2*EXTENT*j/N,e=.002;\n  const dx=(heightAt(x+e,z)-heightAt(x-e,z))/(2*e),dz=(heightAt(x,z+e)-heightAt(x,z-e))/(2*e),length=Math.hypot(dx,1,dz);\n  p.push(x,heightAt(x,z),z);n.push(-dx/length,1/length,-dz/length);\n }\n for(let j=0;j<N;j++)for(let i=0;i<N;i++){\n  const k=j*(N+1)+i;\n  indices.push(k,k+N+1,k+1,k+1,k+N+1,k+N+2);\n }\n return geometry(p,n,indices);\n}\nfunction sphereGeometry(){\n const p=[],n=[],indices=[],rows=18,cols=28;\n for(let j=0;j<=rows;j++)for(let i=0;i<=cols;i++){\n  const a=Math.PI*j/rows,b=2*Math.PI*i/cols,x=Math.sin(a)*Math.cos(b),y=Math.cos(a),z=Math.sin(a)*Math.sin(b);\n  p.push(x,y,z);n.push(x,y,z);\n }\n for(let j=0;j<rows;j++)for(let i=0;i<cols;i++){\n  const k=j*(cols+1)+i;indices.push(k,k+1,k+cols+1,k+1,k+cols+2,k+cols+1);\n }\n return geometry(p,n,indices);\n}\nfunction arrowGeometry(){\n const p=[],n=[],indices=[],N=20;\n function rings(y0,r0,y1,r1,slope){\n  const offset=p.length/3;\n  for(let row=0;row<2;row++)for(let i=0;i<=N;i++){\n   const a=i/N*Math.PI*2,c=Math.cos(a),s=Math.sin(a),r=row?r1:r0;\n   p.push(c*r,row?y1:y0,s*r);\n   const d=Math.hypot(1,slope);n.push(c/d,slope/d,s/d);\n  }\n  for(let i=0;i<N;i++){const k=offset+i;indices.push(k,k+N+1,k+1,k+1,k+N+1,k+N+2)}\n }\n rings(0,.17,.67,.17,0);rings(.67,1,1,0,1);\n return geometry(p,n,indices);\n}\nconst terrainMesh=terrainGeometry(),sphereMesh=sphereGeometry(),arrowMesh=arrowGeometry();\nfunction bind(mesh){\n gl.bindBuffer(gl.ARRAY_BUFFER,mesh.positions);gl.enableVertexAttribArray(positionLocation);gl.vertexAttribPointer(positionLocation,3,gl.FLOAT,false,0,0);\n gl.bindBuffer(gl.ARRAY_BUFFER,mesh.normals);gl.enableVertexAttribArray(normalLocation);gl.vertexAttribPointer(normalLocation,3,gl.FLOAT,false,0,0);\n gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,mesh.indices);\n}\nconst orangeRGB=[1,.34,.095],cyanRGB=[.16,.91,.87],whiteRGB=[.99,1,.975];\nfunction sphere(p,r,color,opacity=1){\n if(opacity<=0)return;\n gl.uniform1f(U.Mode,1);gl.uniform1f(U.Radius,r);gl.uniform3fv(U.Center,p);gl.uniform3fv(U.Color,color);gl.uniform1f(U.Opacity,opacity);\n gl.drawElements(gl.TRIANGLES,sphereMesh.count,gl.UNSIGNED_SHORT,0);\n}\nfunction worldArrow(start,end,color,opacity=1,radius=.043){\n if(opacity<=0)return;\n bind(arrowMesh);gl.uniform1f(U.Mode,2);gl.uniform1f(U.Radius,radius);gl.uniform3fv(U.Center,start);gl.uniform3fv(U.End,end);gl.uniform3fv(U.Color,color);gl.uniform1f(U.Opacity,opacity);\n gl.drawElements(gl.TRIANGLES,arrowMesh.count,gl.UNSIGNED_SHORT,0);\n}\nconst readouts=[\n [19.7,2,'2.48'],[21,4,'1.43'],[22,7,'1.09'],[23,10,'0.89'],[24,13,'0.62'],[25,16,'0.28'],[26,19,'0.07'],[27,22,'0.02'],[28,24,'0.00'],[28.67,26,'0.00'],[29,27,'0.00'],[30,30,'0.00']\n];\nfunction descentState(t){\n let index=0;for(let i=0;i<readouts.length;i++)if(t>=readouts[i][0])index=i;\n const a=readouts[index],b=readouts[Math.min(index+1,readouts.length-1)],p=a===b?0:clamp((t-a[0])/(b[0]-a[0]));\n return {step:a[1],loss:a[2],progress:mix(a[1],b[1],p)/30};\n}\n\n/* Screen-space sample constraints are converted into fresh surface geometry.\n   These are inferred poses, not a recovered oscillation or numerical optimizer.\n   No periodic motion is added to the cyan comparison. */\nfunction surfacePointForScreen(target,camera,lift,hint){\n let best=hint.slice(),bestScore=Infinity;\n function score(x,z){const p=project(point(x,z,lift),camera);return (p[0]-target[0])**2+(p[1]-target[1])**2+.025*((x-hint[0])**2+(z-hint[1])**2)}\n for(let j=0;j<=28;j++)for(let i=0;i<=28;i++){\n  const x=-1.72+3.44*i/28,z=-1.72+3.44*j/28,s=score(x,z);\n  if(s<bestScore){bestScore=s;best=[x,z]}\n }\n let x=best[0],z=best[1];\n for(let iteration=0;iteration<14;iteration++){\n  const p=project(point(x,z,lift),camera),e=.0005,px=project(point(x+e,z,lift),camera),pz=project(point(x,z+e,lift),camera);\n  const a=(px[0]-p[0])/e,b=(pz[0]-p[0])/e,c=(px[1]-p[1])/e,d=(pz[1]-p[1])/e,det=a*d-b*c;\n  if(Math.abs(det)<1e-6)break;\n  const ex=p[0]-target[0],ey=p[1]-target[1];\n  x=clamp(x-clamp((d*ex-b*ey)/det,-.15,.15),-1.74,1.74);\n  z=clamp(z-clamp((-c*ex+a*ey)/det,-.15,.15),-1.74,1.74);\n  const s=score(x,z);if(s<bestScore){bestScore=s;best=[x,z]}\n }\n return best;\n}\nconst rateSpecs={\n white:{radius:.057,lift:.053,color:whiteRGB,hint:[-.82,1.1],samples:[[35,155,864],[36,160,866],[37,171,865],[38,182,865],[39,194,866],[40,202,864],[41,209,865],[42,215,862]]},\n orange:{radius:.087,lift:.080,color:orangeRGB,hint:[.52,.17],samples:[[34,151,842],[35,160,829],[36,274,811],[37,493,858],[38,492,858],[39,489,857],[40,487,858],[41,486,857],[42,486,857]]},\n cyan:{radius:.052,lift:.050,color:cyanRGB,hint:[.35,.04],samples:[[35.4,296,821],[36,404,715],[37,445,741],[38,426,658],[39,424,716],[40,410,690],[41,413,669],[42,403,710]]}\n};\nfor(const spec of Object.values(rateSpecs)){\n spec.keys=spec.samples.map(s=>{\n  const hint=spec===rateSpecs.orange&&s[0]<36.5?[-.80,1.0]:spec.hint;\n  const p=surfacePointForScreen([s[1],s[2]],poseAt(s[0]),spec.lift,hint);\n  return [s[0],p[0],p[1]];\n });\n}\nfunction ratePoint(spec,t,lift=spec.lift){\n let a=spec.keys[0],b=a;\n for(let i=1;i<spec.keys.length;i++){b=spec.keys[i];if(t<=b[0])break;a=b}\n const u=a===b?0:smooth((t-a[0])/(b[0]-a[0]));\n return point(mix(a[1],b[1],u),mix(a[2],b[2],u),lift);\n}\nfunction rateTrail(spec,t,from,interval,radius,opacity){\n const end=Math.min(t,spec.keys[spec.keys.length-1][0]);\n for(let s=from;s<end-.10;s+=interval)sphere(ratePoint(spec,s,.022),radius,spec.color,opacity);\n}\nfunction completedRoute(opacity=1){for(let i=1;i<=30;i++)sphere(route(routeAmount(i/30),.026),.024,orangeRGB,opacity)}\nfunction renderTerrain(t,camera){\n gl.viewport(0,0,WIDTH,HEIGHT);gl.clearColor(0,0,0,0);gl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT);\n gl.enable(gl.DEPTH_TEST);gl.depthFunc(gl.LEQUAL);gl.depthMask(true);gl.disable(gl.CULL_FACE);\n gl.enable(gl.BLEND);gl.blendFunc(gl.SRC_ALPHA,gl.ONE_MINUS_SRC_ALPHA);gl.useProgram(program);\n gl.uniform1f(U.Yaw,camera.yaw);gl.uniform1f(U.ScaleX,camera.sx);gl.uniform1f(U.DepthScale,camera.depthScale);gl.uniform1f(U.HeightScale,camera.heightScale);gl.uniform1f(U.Perspective,camera.perspective);\n gl.uniform2f(U.Origin,camera.cx,camera.cy);gl.uniform1f(U.Brightness,camera.brightness);gl.uniform1f(U.Opacity,1);\n gl.uniform1f(U.Mode,0);bind(terrainMesh);gl.drawElements(gl.TRIANGLES,terrainMesh.count,gl.UNSIGNED_SHORT,0);\n bind(sphereMesh);\n if(t<19.7){sphere(route(0,.065),.065,whiteRGB)}\n else if(t<33.55){\n  const state=descentState(t),p=routeAmount(state.progress);\n  for(let i=1;i<=30;i++)if(i/30<=state.progress)sphere(route(routeAmount(i/30),.025),.024,orangeRGB);\n  sphere(route(p,.061),.060,whiteRGB);\n }else if(t<43.85){\n  const alpha=appear(t,33.6,.35)*(1-ramp(t,43.55,43.85));\n  if(t<34)completedRoute(1-appear(t,33.6,.35));\n  const orange=rateSpecs.orange,white=rateSpecs.white,cyan=rateSpecs.cyan;\n  rateTrail(orange,t,34,.22,.023,alpha);sphere(ratePoint(orange,t),orange.radius,orange.color,alpha);\n  if(t>=35){rateTrail(white,t,35,.8,.017,alpha);sphere(ratePoint(white,t),white.radius,white.color,alpha)}\n  if(t>=35.4){rateTrail(cyan,t,Math.max(35.4,t-2.1),.29,.016,alpha);sphere(ratePoint(cyan,t),cyan.radius,cyan.color,alpha)}\n  if(t>43.55)completedRoute(appear(t,43.55,.30));\n }else completedRoute();\n /* All arrows are actual depth-tested geometry, including the final arrow.\n    The near wall and foreground rim naturally mask the endpoint and arrow. */\n if(t>=16.9&&t<19.75){\n  const a=envelope(t,16.9,19.75,.2),p=route(0,.065);\n  worldArrow([p[0]-.025,p[1]+.045,p[2]-.025],[p[0]-.10,p[1]+.36,p[2]-.22],cyanRGB,a,.040);\n  worldArrow(route(.035,.055),route(.17,.045),orangeRGB,a*appear(t,18.5,.3),.042);\n }\n if(t>=19.7&&t<33){\n  const state=descentState(t),p=routeAmount(state.progress);\n  worldArrow(route(p+.035,.032),route(p+.145,.032),orangeRGB,1,.042);\n }\n}\n\nfunction background(){\n bg.fillStyle='#1c2325';bg.fillRect(0,0,WIDTH,HEIGHT);\n let g=bg.createRadialGradient(695,55,0,690,40,900);g.addColorStop(0,'rgba(110,60,47,.48)');g.addColorStop(.6,'rgba(81,50,44,.15)');g.addColorStop(1,'rgba(0,0,0,0)');bg.fillStyle=g;bg.fillRect(0,0,WIDTH,HEIGHT);\n g=bg.createRadialGradient(50,1135,0,45,1120,840);g.addColorStop(0,'rgba(11,87,78,.25)');g.addColorStop(1,'rgba(0,0,0,0)');bg.fillStyle=g;bg.fillRect(0,0,WIDTH,HEIGHT);\n g=bg.createLinearGradient(0,0,650,1200);g.addColorStop(0,'rgba(0,0,0,0)');g.addColorStop(1,'rgba(0,0,0,.25)');bg.fillStyle=g;bg.fillRect(0,0,WIDTH,HEIGHT);\n}\nfunction text(lines,x,y,size=28,color=WHITE,family='sans-serif',lineHeight=size*1.28,style=''){\n const list=Array.isArray(lines)?lines:[lines];ink.fillStyle=color;ink.font=`${style} ${size}px ${family}`;ink.textBaseline='top';ink.textAlign='left';\n for(let i=0;i<list.length;i++)ink.fillText(list[i],x,y+i*lineHeight);\n}\nfunction fitted(line,x,y,size,width,color=WHITE,family='serif',style=''){\n ink.font=`${style} ${size}px ${family}`;const measured=ink.measureText(line).width;\n text(line,x,y,measured>width?size*width/measured:size,color,family,size*1.25,style);\n}\nfunction layer(alpha,fn){if(alpha<=0)return;ink.save();ink.globalAlpha*=clamp(alpha);fn();ink.restore()}\nfunction roundedRect(x,y,w,h,r){ink.beginPath();ink.moveTo(x+r,y);ink.arcTo(x+w,y,x+w,y+h,r);ink.arcTo(x+w,y+h,x,y+h,r);ink.arcTo(x,y+h,x,y,r);ink.arcTo(x,y,x+w,y,r);ink.closePath()}\nfunction pill(label,x,y,color,size=18){\n ink.font=`${size}px sans-serif`;const width=ink.measureText(label).width+20;\n roundedRect(x,y,width,32,12);ink.fillStyle='rgba(19,27,29,.85)';ink.fill();ink.strokeStyle=color;ink.lineWidth=1.2;ink.stroke();text(label,x+10,y+6,size,WHITE);return width;\n}\nfunction leader(x1,y1,x2,y2,color){\n ink.strokeStyle=color;ink.lineWidth=1.2;ink.beginPath();ink.moveTo(x1,y1);ink.lineTo(x2,y2);ink.stroke();ink.fillStyle=color;ink.beginPath();ink.arc(x2,y2,2.5,0,Math.PI*2);ink.fill();\n}\nfunction accentEntry(title,description,x,y,color,titleSize=29,descriptionSize=20,width=575,titleColor=WHITE){\n ink.fillStyle=color;ink.fillRect(x,y,4,description.length>1?75:65);\n fitted(title,x+21,y-2,titleSize,width-24,titleColor,'serif');text(description,x+21,y+34,descriptionSize,GRAY,'sans-serif',25);\n}\nfunction header(t){\n layer(appear(t,1.75,.3),()=>{\n  text('Why am I learning this?',73,85,20,GRAY);ink.textAlign='right';ink.font='20px sans-serif';ink.fillStyle=GRAY;ink.fillText('Part 4',647,85);ink.textAlign='left';\n });\n}\nfunction openingText(t){\n layer(1-ramp(t,1.35,1.95),()=>{\n  text('Why am I learning this?',73,180,25,GRAY);\n  const g=ink.createLinearGradient(73,0,435,0);g.addColorStop(0,'#f05026');g.addColorStop(.48,'#df8662');g.addColorStop(.76,'#a1a896');g.addColorStop(1,'#4accc1');\n  text(['Gradient','descent'],73,227,96,g,'serif',114);\n  fitted('how every model you train actually learns',73,506,34,575,WHITE,'serif','italic');\n });\n}\nfunction classification(t){\n layer(envelope(t,2.45,9.85,.36),()=>{\n  text(['What kind of algorithm is','it?'],73,161,51,WHITE,'serif',57);\n  fitted('Not supervised. Not unsupervised.',73,286,38,577,WHITE,'serif','italic');\n  layer(appear(t,3.65),()=>text(['It is an optimisation algorithm:','first-order and iterative.'],73,369,29,WHITE,'sans-serif',37));\n  layer(appear(t,4.65),()=>text(['It makes no predictions itself. It tunes the','parameters of the models that do.'],73,463,26,GRAY,'sans-serif',33));\n  layer(appear(t,5.55),()=>{\n   text('It trains all three families:',73,644,24,GRAY);\n   accentEntry('Supervised',['neural networks, linear and logistic regression'],73,701,ORANGE,30,20,575,ORANGE);\n  });\n  layer(appear(t,6.20),()=>accentEntry('Unsupervised',['autoencoders, t-SNE, matrix factorisation'],73,800,CYAN,30,20,575,CYAN));\n  layer(appear(t,6.65),()=>accentEntry('Reinforcement',['policy-gradient methods'],73,899,'#cbd4d2',30,20,575,'#cbd4d2'));\n });\n}\nfunction landscapeText(t,camera){\n layer(envelope(t,10.55,16.85,.35),()=>{\n  fitted('Meet the loss landscape.',73,162,51,576);\n  const peak=project(route(0,.075),camera),trough=project(point(BASIN[0],BASIN[1],.015),camera);\n  layer(appear(t,11.45),()=>{const x=84,y=250,w=pill('Crest: high loss',x,y,ORANGE);leader(x+w*.55,y+35,peak[0]-4,peak[1]-20,ORANGE)});\n  layer(appear(t,12.25),()=>{const x=430,y=889;pill('Trough: lowest loss',x,y,CYAN);leader(x+40,y-4,trough[0]+5,Math.min(864,trough[1]+10),CYAN)});\n  layer(appear(t,12.60),()=>text(['Every point on this surface is one setting','of the model’s parameters.'],73,949,28,WHITE,'sans-serif',35));\n  layer(appear(t,13.55),()=>text(['Height is how wrong the model is. Training','means finding the lowest point.'],73,1033,28,CYAN,'sans-serif',35));\n });\n}\n\n/* Shape-preserving cubic interpolation keeps the sampled loss values and\n   removes angular joints without adding overshoot or a negative loss. */\nconst lossNodes=[[0,3.1],[2/30,2.48],[4/30,1.43],[7/30,1.09],[10/30,.89],[13/30,.62],[16/30,.28],[19/30,.07],[22/30,.02],[24/30,0],[1,0]];\nconst lossSecants=lossNodes.slice(0,-1).map((a,i)=>(lossNodes[i+1][1]-a[1])/(lossNodes[i+1][0]-a[0]));\nconst lossTangents=lossNodes.map((a,i)=>{\n if(i===0)return lossSecants[0];if(i===lossNodes.length-1)return 0;\n const left=lossSecants[i-1],right=lossSecants[i];if(left*right<=0)return 0;\n const h0=a[0]-lossNodes[i-1][0],h1=lossNodes[i+1][0]-a[0],w0=2*h1+h0,w1=h1+2*h0;\n return (w0+w1)/(w0/left+w1/right);\n});\nfunction lossValue(u){\n u=clamp(u);let i=0;while(i<lossNodes.length-2&&u>lossNodes[i+1][0])i++;\n const a=lossNodes[i],b=lossNodes[i+1],h=b[0]-a[0],s=clamp((u-a[0])/h),s2=s*s,s3=s2*s;\n return Math.max(0,(2*s3-3*s2+1)*a[1]+(s3-2*s2+s)*h*lossTangents[i]+(-2*s3+3*s2)*b[1]+(s3-s2)*h*lossTangents[i+1]);\n}\nfunction chart(progress){\n const x=73,y=953,w=574,h=90;\n ink.strokeStyle='rgba(172,186,185,.25)';ink.lineWidth=1;ink.beginPath();ink.moveTo(x,y+h);ink.lineTo(x+w,y+h);ink.stroke();\n const g=ink.createLinearGradient(x,0,x+w,0);g.addColorStop(0,ORANGE);g.addColorStop(.62,'#e68565');g.addColorStop(.86,'#b9bca9');g.addColorStop(1,CYAN);\n ink.strokeStyle=g;ink.lineWidth=3;ink.lineJoin='round';ink.lineCap='round';ink.beginPath();\n for(let i=0;i<=280;i++){const u=progress*i/280,px=x+w*u,py=y+h-h*lossValue(u)/3.1;i?ink.lineTo(px,py):ink.moveTo(px,py)}ink.stroke();\n}\nfunction descentText(t){\n layer(envelope(t,16.75,32.95,.3),()=>{\n  fitted('Follow the slope downhill.',73,162,52,574);\n  layer(appear(t,17.45),()=>text('θ ← θ − η ∇L(θ)',73,250,41,WHITE,'serif',48,'italic'));\n  layer(envelope(t,16.9,19.75,.2),()=>{\n   layer(appear(t,17.6),()=>{pill('Cyan arrow: + gradient, uphill',73,927,CYAN);text(['The gradient points uphill, toward more','error. So step the other way.'],73,1091,28,WHITE,'sans-serif',36)});\n   layer(appear(t,18.5),()=>pill('Orange arrow: − gradient, downhill',73,983,ORANGE));\n  });\n  layer(appear(t,19.65,.25),()=>{\n   const state=descentState(t);\n   text('Step '+state.step+' of 30',73,913,25,GRAY);\n   ink.font='500 25px sans-serif';ink.fillStyle=WHITE;ink.textAlign='right';ink.fillText('Loss '+state.loss,647,913);ink.textAlign='left';\n   chart(state.progress);\n   if(t<25.8)text(['Each step: measure the slope, move a little','downhill, repeat.'],73,1099,28,WHITE,'sans-serif',36);\n   else if(t<30.7)text(['Steps shrink on their own as the ground','flattens out.'],73,1099,28,WHITE,'sans-serif',36);\n   else text(['Trough reached. Lowest loss, trained','model.'],73,1099,28,ORANGE,'sans-serif',36);\n  });\n });\n}\nfunction learningRate(t){\n layer(envelope(t,33.65,43.85,.35),()=>{\n  fitted('The learning rate, η',73,162,52,574);text('Same start. Only the step size changes.',73,247,27,GRAY);\n  const rows=[['η = 0.05','too small: crawls',WHITE,34.55,.30],['η = 1.30','too large: zig-zags',CYAN,34.65,.33],['η = 0.60','just right',ORANGE,35.10,.50]];\n  for(let i=0;i<rows.length;i++){\n   const row=rows[i];layer(appear(t,row[3],row[4]),()=>{\n    const y=1002+i*51;ink.fillStyle=row[2];ink.beginPath();ink.arc(84,y+12,10,0,Math.PI*2);ink.fill();\n    text(row[0],108,y,24,WHITE);text(row[1],260,y,24,i===0?GRAY:row[2]);\n   });\n  }\n  layer(appear(t,41.65),()=>text(['Tuning η is half the craft of training a','model.'],73,1180,28,WHITE,'sans-serif',35));\n });\n}\nconst useCases=[\n ['Deep neural networks',['Backpropagation computes the gradient; SGD or Adam','takes the step.'],ORANGE,44.50,.40],\n ['Large language models',['Billions of parameters, all tuned by the same descent.'],CYAN,44.70,.30],\n ['Regression at scale',['Linear and logistic models on data too large for','closed-form solutions.'],ORANGE,45.20,.45],\n ['Recommender systems',['Matrix factorisation learns user and item vectors.'],CYAN,45.50,.45],\n ['Vision and speech',['Image classifiers, detectors and speech recognisers.'],ORANGE,45.85,.50],\n ['Embeddings',['word2vec vectors and t-SNE maps.'],CYAN,46.35,.45]\n];\nfunction uses(t){\n layer(envelope(t,43.85,50.8,.35),()=>{\n  text('Where it runs',73,162,52,WHITE,'serif');\n  for(let i=0;i<useCases.length;i++){\n   const row=useCases[i];layer(appear(t,row[3],row[4]),()=>accentEntry(row[0],row[1],73,292+i*118,row[2],30,20));\n  }\n  layer(appear(t,46.85,.7),()=>text(['Common variants: batch, stochastic (SGD),','mini-batch, momentum, Adam.'],73,1092,25,GRAY,'sans-serif',34));\n });\n}\nfunction conclusion(t){\n layer(appear(t,50.8,.20),()=>{\n  fitted('So why am I learning this?',73,162,52,574);\n  layer(appear(t,51.55,.45),()=>{\n   const g=ink.createLinearGradient(73,0,637,0);g.addColorStop(0,ORANGE);g.addColorStop(.45,'#e18460');g.addColorStop(.7,'#a8b4a0');g.addColorStop(1,CYAN);\n   fitted('Every model you train is a ball',73,262,41,574,g,'serif','italic');text('rolling downhill.',73,312,41,ORANGE,'serif',50,'italic');\n  });\n  layer(appear(t,52.55,.45),()=>text(['Loss is the hill. The gradient is the slope. η is','the stride.'],73,387,28,GRAY,'sans-serif',36));\n });\n}\nfunction progressLine(t){\n ink.fillStyle='rgba(179,196,190,.21)';ink.fillRect(0,1274,720,6);\n const g=ink.createLinearGradient(0,0,720,0);g.addColorStop(0,ORANGE);g.addColorStop(.49,'#ed896a');g.addColorStop(.78,'#b5c6b6');g.addColorStop(1,CYAN);\n ink.fillStyle=g;ink.fillRect(0,1274,720*clamp(t/DURATION),6);\n}\nfunction draw(t){\n t=clamp(t,0,DURATION);const camera=poseAt(t);\n renderTerrain(t,camera);ink.clearRect(0,0,WIDTH,HEIGHT);\n header(t);openingText(t);classification(t);landscapeText(t,camera);descentText(t);learningRate(t);uses(t);conclusion(t);progressLine(t);\n}\nbackground();\nconst time={value:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(time,{value:DURATION,duration:DURATION,ease:'none',onUpdate:()=>draw(time.value)},0);\ndraw(0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\n</script>\n</body>\n</html>","width":720,"height":1280,"duration_seconds":56.966667,"assumptions":["Terrain geometry, projection anchors, lighting and interpolation between supplied samples are inferred approximations.","Generic system serif and sans-serif fonts approximate the reference typography; supplied font files are unused.","The composition targets 30 fps and contains no audio, consistent with the supplied metadata.","Source has not been rendered, GPU-tested or visually reviewed."],"missing_inputs":[],"summary":"Revised the full sequence with anchored terrain framing, softer lighting, depth-tested spheres and arrows, separated learning-rate paths, restored accent colors, smoother loss curves and adjusted reveals."}