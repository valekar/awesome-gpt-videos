{
  "html": "<!DOCTYPE html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width,initial-scale=1'>\n<title>Jade River</title>\n<style>\n*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;background:#111c25;overflow:hidden}body{font-family:monospace}#root{position:relative;width:100%;height:100%;background:#111c25}canvas{display:block;width:100%;height:100%;object-fit:contain;image-rendering:pixelated;outline:none}canvas:focus-visible{outline:4px solid #f2d17d;outline-offset:-4px}\n</style>\n</head>\n<body>\n<div id='root' data-composition-id='main' data-width='1280' data-height='960' data-duration='30'>\n<canvas id='game' class='clip' data-start='0' data-duration='30' width='640' height='480' tabindex='0' role='application' aria-label='Jade River strategy game. Select a province on the map. R recruits, F fortifies, E sends an envoy, M marches, Space ends the season, and N starts a new campaign. Capture five provinces to unite the realm.'></canvas>\n</div>\n<script src='gsap.min.js'></script>\n<script>\n'use strict';\n// Edit this data to change the campaign. All places and people are fictional.\nconst C={ink:'#15242c',edge:'#0c151c',paper:'#d7c69b',light:'#f1dfaf',muted:'#a99b7d',gold:'#efc76b',jade:'#78bc87',red:'#da8064',blue:'#82adbf',water:'#3c7786'};\nconst clans={you:{name:'JADE',land:'#68825b',flag:'#8cd39a'},sun:{name:'SUN',land:'#9a7959',flag:'#e68a69'},ash:{name:'ASH',land:'#71868a',flag:'#9fc3d0'},none:{name:'FREE',land:'#999364',flag:'#e3cc8b'}};\nconst regions=[\n{name:'Cloud Pass',owner:'ash',troops:450,fort:22,loyalty:67,at:[63,55],poly:[[0,0],[120,0],[132,65],[102,113],[0,95]],near:[1,3,4]},\n{name:'Iron Gate',owner:'sun',troops:700,fort:35,loyalty:76,at:[187,54],poly:[[120,0],[249,0],[240,91],[176,110],[132,65]],near:[0,2,4]},\n{name:'Amber Coast',owner:'sun',troops:520,fort:20,loyalty:64,at:[324,51],poly:[[249,0],[399,0],[399,95],[316,118],[240,91]],near:[1,4,5]},\n{name:'Pinewatch',owner:'you',troops:410,fort:24,loyalty:83,at:[64,143],poly:[[0,95],[102,113],[150,172],[82,200],[0,175]],near:[0,4,6]},\n{name:'Jade Ford',owner:'you',troops:620,fort:30,loyalty:91,at:[185,145],poly:[[102,113],[132,65],[176,110],[240,91],[265,166],[189,206],[150,172]],near:[0,1,2,3,5,6,7]},\n{name:'Red Cliffs',owner:'sun',troops:360,fort:22,loyalty:61,at:[328,140],poly:[[240,91],[316,118],[399,95],[399,185],[327,206],[265,166]],near:[2,4,7]},\n{name:'Willow Vale',owner:'none',troops:240,fort:12,loyalty:52,at:[117,207],poly:[[0,175],[82,200],[150,172],[189,206],[205,236],[0,236]],near:[3,4,7]},\n{name:'Southbank',owner:'ash',troops:360,fort:18,loyalty:62,at:[287,209],poly:[[189,206],[265,166],[327,206],[399,185],[399,236],[205,236]],near:[4,5,6]}\n];\nconst seasons=['SPRING','SUMMER','AUTUMN','WINTER'];\nconst actions=[['R','RECRUIT'],['F','FORTIFY'],['E','ENVOY'],['M','MARCH'],['SPACE','SEASON']];\nconst canvas=document.getElementById('game');\nconst g=canvas.getContext('2d');\ng.imageSmoothingEnabled=false;\nconst clock={t:0};\nlet manual=null;\nfunction fresh(){return {turn:1,gold:860,rice:1420,selected:4,provinces:regions.map(p=>({...p})),message:'The river divides the realm. Recruit at Jade Ford, then march east to secure the crossing.'};}\nfunction copy(s){return {...s,provinces:s.provinces.map(p=>({...p}))};}\nfunction owned(s){return s.provinces.filter(p=>p.owner==='you');}\nfunction snapshot(t){\n const s=fresh();\n if(t>=4){s.message='A strong army begins with a full granary. Recruit 220 troops for 140 gold and 110 rice.';}\n if(t>=5){s.gold-=140;s.rice-=110;s.provinces[4].troops+=220;s.message='220 recruits have joined Jade Ford. The eastern crossing is now within reach.';}\n if(t>=10){s.selected=5;s.message='Red Cliffs guards the river. March from neighboring Jade Ford to challenge the Sun garrison.';}\n if(t>=11){s.gold-=90;s.rice-=80;s.provinces[4].troops-=546;s.message='546 soldiers march east under Lord Ren. Hold the bridge and break the opposing line.';}\n if(t>=14){s.message='The armies meet at the crossing. Your vanguard advances beneath the jade banner.';}\n if(t>=23){s.provinces[5].owner='you';s.provinces[5].troops=348;s.provinces[5].loyalty=60;s.message='Victory at Red Cliffs. The crossing is ours; 348 soldiers remain to hold the province.';}\n if(t>=26){s.turn=2;s.gold+=210;s.rice+=330;s.provinces.forEach(p=>{if(p.owner==='you')p.troops+=35;});s.message='Summer brings fresh taxes and supplies. Three provinces stand united. Choose your next move.';}\n return s;\n}\nfunction rect(x,y,w,h,c){g.fillStyle=c;g.fillRect(Math.round(x),Math.round(y),Math.round(w),Math.round(h));}\nfunction txt(v,x,y,size=10,color=C.ink,align='left'){g.font='bold '+size+'px monospace';g.textAlign=align;g.textBaseline='alphabetic';g.fillStyle=color;g.fillText(String(v),Math.round(x),Math.round(y));}\nfunction panel(x,y,w,h,fill=C.paper){rect(x,y,w,h,C.edge);rect(x+2,y+2,w-4,h-4,fill);rect(x+3,y+3,w-6,1,C.light);rect(x+3,y+3,1,h-6,C.light);rect(x+w-4,y+4,1,h-7,C.muted);rect(x+4,y+h-4,w-7,1,C.muted);}\nfunction line(x1,y1,x2,y2,c,width=1){g.beginPath();g.strokeStyle=c;g.lineWidth=width;g.moveTo(Math.round(x1),Math.round(y1));g.lineTo(Math.round(x2),Math.round(y2));g.stroke();}\nfunction path(points,fill,stroke){g.beginPath();points.forEach((p,i)=>i?g.lineTo(p[0],p[1]):g.moveTo(p[0],p[1]));g.closePath();if(fill){g.fillStyle=fill;g.fill();}if(stroke){g.strokeStyle=stroke;g.lineWidth=2;g.stroke();}}\nfunction wrap(v,x,y,max=92,size=10,color=C.ink){let row='',n=0;for(const word of v.split(' ')){if((row+word).length>max){txt(row,x,y+n*12,size,color);n++;row='';}row+=(row?' ':'')+word;}txt(row,x,y+n*12,size,color);}\nfunction soldier(x,y,color,face=1,step=0){x=Math.round(x);y=Math.round(y);rect(x-3,y,7,2,C.edge);rect(x-2,y-3,5,4,'#d8ac78');rect(x-3,y-5,7,3,color);rect(x-4,y+2,9,6,color);rect(x-2,y+8,2,4,C.edge);rect(x+2,y+8-(step%2),2,4,C.edge);rect(x+face*5,y-4,1,11,'#e8dfbf');rect(x+face*5-1,y-5,3,2,'#f6efd9');}\nfunction castle(x,y,owner,selected,t){\n x=Math.round(x);y=Math.round(y);const c=clans[owner].flag;\n if(selected){const a=manual?1:0.75+0.25*Math.sin(t*4);g.globalAlpha=a;rect(x-15,y-15,30,2,C.gold);rect(x-15,y+14,30,2,C.gold);rect(x-15,y-15,2,31,C.gold);rect(x+13,y-15,2,31,C.gold);g.globalAlpha=1;}\n rect(x-10,y+7,22,3,'#384638');rect(x-9,y-3,20,11,'#dad0ac');rect(x-10,y-7,5,6,C.ink);rect(x-2,y-7,5,6,C.ink);rect(x+6,y-7,5,6,C.ink);rect(x-9,y-4,20,3,'#b8b390');rect(x-2,y+2,5,6,C.ink);rect(x-6,y-3,2,3,C.ink);rect(x+6,y-3,2,3,C.ink);rect(x,y-20,1,13,C.ink);rect(x+1,y-20,11,7,c);rect(x+8,y-13,4,2,c);\n}\nfunction mountain(x,y){path([[x-9,y+8],[x-3,y-5],[x+1,y],[x+5,y-8],[x+14,y+8]],'#586453');path([[x-3,y-5],[x-6,y+1],[x-1,y-1]],'#b5b699');path([[x+5,y-8],[x+2,y-2],[x+8,y-3]],'#d1c8a4');}\nfunction tree(x,y){rect(x,y+4,2,5,'#495745');rect(x-4,y,10,5,'#3e6650');rect(x-2,y-4,6,5,'#3e6650');rect(x,y-6,2,3,'#71936a');}\nconst portrait=[\n'.....kkkkkk.....','....kkkkkkkk....','...kkbbbbbbkk...','...kbbbbbbbbk...','...kbbbbbbbbk...','...kssssssssk...','...kssksksssk...','...kssssssssk...','....ssssssss....','....ssmmmmss....','.....smmmms.....','.....kmmmmk.....','....ggkkkkgg....','...gggyyygggg...','..gggggygggggg..','.ggggggyggggggg.','.ggggggyggggggg.','.gggkkkykkkgggg.','..gggggygggggg..','..kkkkkkkkkkkk..'];\nfunction face(x,y){const colors={k:C.ink,b:'#253d43',s:'#d5ab78',m:'#704c39',g:'#426a56',y:C.gold};rect(x-3,y-3,54,66,'#b6a57f');for(let j=0;j<portrait.length;j++)for(let i=0;i<portrait[j].length;i++){const c=colors[portrait[j][i]];if(c)rect(x+i*3,y+j*3,3,3,c);}}\nfunction map(s,t){\n panel(12,60,426,266,'#84916d');\n g.save();g.translate(27,84);\n rect(-9,-11,417,251,C.water);\n for(let y=-4;y<244;y+=16)for(let x=-5;x<408;x+=24){rect(x+(y%32?7:0),y,8,1,'#60929b');}\n s.provinces.forEach(p=>path(p.poly,clans[p.owner].land,'#354e42'));\n for(let i=0;i<22;i++){const x=15+(i*71)%365,y=13+(i*43)%210;rect(x,y,2,1,'#acaa77');rect(x+4,y+3,1,1,'#465e45');}\n [[24,23],[43,18],[95,25],[149,22],[164,17],[216,31],[286,23],[352,86],[21,170],[210,186]].forEach(p=>mountain(p[0],p[1]));\n [[25,111],[39,118],[93,152],[107,157],[218,130],[224,142],[361,154],[371,162],[53,213],[198,221]].forEach(p=>tree(p[0],p[1]));\n // A stepped river and a bridge form the campaign's geographic focal point.\n const river=[[249,0],[244,38],[240,91],[253,131],[265,166],[292,185],[327,206],[354,236]];\n g.beginPath();river.forEach((p,i)=>i?g.lineTo(...p):g.moveTo(...p));g.strokeStyle='#254d5b';g.lineWidth=9;g.stroke();g.strokeStyle='#67a0a5';g.lineWidth=5;g.stroke();\n g.setLineDash([3,5]);[[3,4],[4,5],[4,6],[5,7],[0,3],[1,4],[2,5]].forEach(pair=>{const a=regions[pair[0]].at,b=regions[pair[1]].at;line(a[0],a[1],b[0],b[1],'#c8b67f');});g.setLineDash([]);\n rect(246,133,22,11,'#6d573d');for(let i=0;i<6;i++)rect(247+i*4,133,2,11,'#c5a976');rect(245,132,25,2,'#423f31');rect(245,143,25,2,'#423f31');\n s.provinces.forEach((p,i)=>{const [x,y]=p.at;castle(x,y-7,p.owner,i===s.selected,t);const w=p.name.length*6+8;rect(x-w/2,y+10,w,13,'#24392e');txt(p.name,x,y+20,10,'#f2e2b6','center');rect(x-22,y+24,44,11,'#2d4235');txt(p.troops,x,y+32,8,clans[p.owner].flag,'center');});\n if(!manual&&t>=11&&t<14){const p=(t-11)/3;const x=185+(328-185)*p,y=138-13*Math.sin(p*Math.PI);soldier(x,y,'#91d099',1,Math.floor(p*18));soldier(x-12,y+7,'#91d099',1,Math.floor(p*18)+1);soldier(x-24,y,'#91d099',1,Math.floor(p*18));}\n g.restore();\n txt('THE RIVER PROVINCES',24,75,9,C.light);\n const leg=[['you','JADE'],['sun','SUN'],['ash','ASH']];leg.forEach((v,i)=>{rect(282+i*48,67,6,6,clans[v[0]].flag);txt(v[1],292+i*48,73,7,C.ink);});\n}\nfunction sidebar(s){\n panel(446,60,182,266);\n txt('YOUR DOMAIN',459,79,11);\n line(458,85,615,85,'#a69672');\n face(460,96);txt('LORD REN',518,108,12);txt('COMMAND 78',518,125,9);txt('WISDOM  71',518,139,9);txt('JADE CLAN',518,153,9,'#41654c');\n line(458,166,615,166,'#a69672');\n const p=s.provinces[s.selected];txt(p.name,459,185,14);txt(clans[p.owner].name+' TERRITORY',459,201,9,p.owner==='you'?'#42694d':'#805d43');\n txt('GARRISON',459,221,9);txt(p.troops,614,221,12,C.ink,'right');txt('FORTIFICATION',459,239,9);txt(p.fort,614,239,11,C.ink,'right');txt('LOYALTY',459,257,9);txt(p.loyalty+' / 100',614,257,10,C.ink,'right');\n line(458,267,615,267,'#a69672');\n const n=owned(s).length;txt('UNITE THE REALM',459,284,10);for(let i=0;i<5;i++){rect(459+i*25,293,19,9,i<n?'#4d7956':'#aa9c79');rect(460+i*25,294,17,2,i<n?'#89b77e':'#bdb08e');}txt(n+' / 5',613,302,10,C.ink,'right');txt(n>=5?'THE REALM IS UNITED':'CAPTURE FIVE PROVINCES',459,317,8,n>=5?'#42694d':C.ink);\n}\nfunction enabled(s,i){const p=s.provinces[s.selected];if(i===0)return p.owner==='you'&&s.gold>=140&&s.rice>=110;if(i===1)return p.owner==='you'&&s.gold>=100&&p.fort<80;if(i===2)return p.owner!=='you'&&s.gold>=(p.owner==='none'?180:100);if(i===3){if(s.gold<90||s.rice<80)return false;return p.owner==='you'?p.near.some(j=>s.provinces[j].owner!=='you'):p.near.some(j=>s.provinces[j].owner==='you');}return true;}\nfunction bottom(s,t){\n panel(12,334,616,134);\n const p=s.provinces[s.selected];txt('COUNCIL OF WAR',25,353,13);txt('SELECTED: '+p.name.toUpperCase(),614,352,10,C.ink,'right');\n const stats=[['GOLD',s.gold,28],['RICE',s.rice,166],['ARMY',owned(s).reduce((a,p)=>a+p.troops,0),310],['PROVINCES',owned(s).length,467]];\n stats.forEach(([label,v,x],i)=>{if(i===0){rect(x,362,8,8,'#a57935');rect(x+2,363,5,5,C.gold);}else if(i===1){rect(x,363,8,7,'#82915e');rect(x+2,360,4,5,'#e5d2a0');}else if(i===2){rect(x+2,361,3,9,'#6c7975');rect(x,361,7,2,C.ink);}else{rect(x,362,8,8,'#54755b');rect(x+1,363,6,2,'#b6cf9c');}txt(label,x+14,369,8);txt(v,x+51+(i===3?16:0),370,11);});\n rect(24,381,592,38,'#b8aa87');rect(25,382,590,36,'#c9b995');rect(25,382,3,36,'#59735a');wrap(s.message,35,396,94,10);\n actions.forEach((a,i)=>{const x=24+i*120,ok=enabled(s,i);let active=!manual&&((i===0&&t>=4&&t<8)||(i===3&&t>=10&&t<14)||(i===4&&t>=25&&t<28));panel(x,430,112,26,active?'#426b54':ok?'#d5c59b':'#b6aa8d');if(active){rect(x,430,112,2,C.gold);rect(x,454,112,2,C.gold);}txt('['+a[0]+'] '+a[1],x+56,447,9,active?C.light:ok?C.ink:'#756e5c','center');});\n}\nfunction battle(t){\n const p=Math.max(0,Math.min(1,(t-14)/9));\n panel(18,66,414,254,C.ink);txt('BATTLE AT RED CLIFFS',225,86,14,C.light,'center');\n txt('JADE VANGUARD',34,108,10,C.jade);txt('SUN GARRISON',416,108,10,C.red,'right');\n const wear=Math.max(0,Math.min(1,(p-.2)/.65));txt(Math.round(546-198*wear),34,126,16,C.light);txt(Math.round(360*(1-wear)),416,126,16,C.light,'right');\n g.save();g.beginPath();g.rect(28,137,394,146);g.clip();rect(28,137,394,146,'#88935f');\n for(let i=0;i<70;i++){const x=30+(i*47)%390,y=141+(i*29)%137;rect(x,y,2,1,'#657b4f');}\n rect(202,137,45,146,'#315e6e');rect(207,137,35,146,'#57929a');for(let y=142;y<280;y+=12)rect(213+Math.round(Math.sin(y)*5),y,16,1,'#90b7b0');\n rect(185,196,80,34,'#624e38');for(let x=186;x<265;x+=6)rect(x,198,4,29,'#ba9d68');rect(182,194,86,4,'#393b2e');rect(182,228,86,4,'#393b2e');\n const march=Math.min(1,p/.55)*59;const retreat=Math.max(0,(p-.63)/.37)*80;\n for(let i=0;i<12;i++){const row=Math.floor(i/4),col=i%4;const step=Math.floor(p*36)+i;soldier(55+col*19+march,165+row*33,'#80bf89',1,step);if(i<Math.ceil(12*(1-wear)))soldier(391-col*19-march*.8+retreat,165+row*33,'#cf795d',-1,step);}\n if(p>.2&&p<.7)for(let i=0;i<5;i++){const a=((p*3+i*.17)%1);const x=118+a*210,y=177-i*4-Math.sin(a*Math.PI)*28;rect(x,y,8,1,'#f3dd9a');rect(x+7,y-1,2,3,'#f3dd9a');}\n if(p>.43&&p<.72){const r=Math.floor(p*24)%3;line(213-r*3,210-r*2,229+r*3,201-r*2,C.gold,2);line(213-r*3,201-r*2,229+r*3,210-r*2,C.gold,2);}\n rect(46,143,1,29,C.ink);rect(47,143,25,14,C.jade);rect(370+retreat,143,1,29,C.ink);rect(371+retreat,143,25,14,C.red);\n g.restore();\n let label=p<.28?'THE VANGUARD ADVANCES':p<.6?'FIGHT FOR THE CROSSING':p<.86?'THE SUN GARRISON RETREATS':'VICTORY — THE CROSSING IS OURS';\n txt(label,225,305,p>.86?11:10,p>.86?C.gold:C.light,'center');rect(31,313,388,2,'#52675c');rect(31,313,388*p,2,C.gold);\n}\nfunction draw(s,t){\n rect(0,0,640,480,C.ink);for(let y=0;y<480;y+=4)rect(0,y,640,1,'#172832');\n panel(12,12,616,40,'#263c40');txt('JADE RIVER',25,32,19,C.light);txt('A WARLORD CHRONICLE',26,44,7,'#aab799');\n txt(seasons[(s.turn-1)%4]+' · YEAR '+(1+Math.floor((s.turn-1)/4)),375,35,11,C.light,'center');\n panel(512,21,104,22,'#9f986d');txt(manual?'NEW CAMPAIGN':'TAKE COMMAND',564,36,9,C.ink,'center');\n map(s,t);sidebar(s);bottom(s,t);if(!manual&&t>=14&&t<23)battle(t);\n if(!manual&&t>=5&&t<8){const a=1-(t-5)/3;g.globalAlpha=Math.min(1,a*2);txt('+220 RECRUITS',212,191-Math.round((t-5)*5),11,C.light,'center');g.globalAlpha=1;}\n}\nfunction announce(s,message){const n=owned(s).length;s.message=n>=5?'The realm is united under the jade banner. Victory! Start a new campaign to play again.':n===0?'Our final province has fallen. Start a new campaign and rebuild the realm.':message;}\nfunction doAction(s,i){\n const p=s.provinces[s.selected];\n if(i===0){if(p.owner!=='you'){s.message='Recruitment requires a province under your command.';return;}if(s.gold<140||s.rice<110){s.message='Recruitment needs 140 gold and 110 rice. End the season to collect supplies.';return;}s.gold-=140;s.rice-=110;p.troops+=220;p.loyalty=Math.min(100,p.loyalty+2);announce(s,'220 recruits have joined '+p.name+'. The quartermaster used 140 gold and 110 rice.');}\n if(i===1){if(p.owner!=='you'){s.message='Select one of your provinces before improving its defenses.';return;}if(p.fort>=80){s.message='The walls of '+p.name+' are already at maximum strength.';return;}if(s.gold<100){s.message='The builders need 100 gold to strengthen these walls.';return;}s.gold-=100;p.fort=Math.min(80,p.fort+15);announce(s,'The walls of '+p.name+' gain 15 fortification. Strong walls protect against rival attacks.');}\n if(i===2){if(p.owner==='you'){s.message='Select a free or rival province to send an envoy.';return;}const cost=p.owner==='none'?180:100;if(s.gold<cost){s.message='The envoy requires '+cost+' gold for this mission.';return;}s.gold-=cost;if(p.owner==='none'){p.owner='you';p.loyalty=70;announce(s,p.name+' accepts your protection. Its garrison joins the jade banner.');}else{p.troops=Math.max(60,p.troops-80);p.loyalty=Math.max(20,p.loyalty-12);announce(s,'Your envoy persuades 80 rival troops to leave '+p.name+'. The garrison weakens.');}}\n if(i===3){\n  if(s.gold<90||s.rice<80){s.message='A march needs 90 gold and 80 rice. Collect more supplies next season.';return;}\n  let from,to;\n  if(p.owner==='you'){from=p;to=p.near.map(j=>s.provinces[j]).filter(q=>q.owner!=='you').sort((a,b)=>(a.troops+a.fort*2)-(b.troops+b.fort*2))[0];}\n  else{to=p;from=p.near.map(j=>s.provinces[j]).filter(q=>q.owner==='you').sort((a,b)=>b.troops-a.troops)[0];}\n  if(!from||!to){s.message='Marches need a shared border between your province and a rival or free province.';return;}\n  if(from.troops<180){s.message='The army at '+from.name+' is too small. Recruit before marching.';return;}\n  const sent=Math.floor(from.troops*.65),defense=to.troops+to.fort*2;s.gold-=90;s.rice-=80;from.troops-=sent;\n  if(sent+90>defense){const losses=Math.floor(to.troops*.55);to.troops=Math.max(80,sent-losses);to.owner='you';to.loyalty=60;s.selected=s.provinces.indexOf(to);announce(s,'Victory! '+to.name+' joins your domain. '+to.troops+' soldiers hold the captured province.');}\n  else{from.troops+=Math.floor(sent*.3);to.troops=Math.max(60,to.troops-Math.floor(sent*.45));announce(s,'The march on '+to.name+' is repelled. Survivors return to '+from.name+'. Recruit or send an envoy.');}\n }\n if(i===4){\n  s.turn++;let income=0,supply=0;const before=owned(s).length;\n  s.provinces.forEach(q=>{if(q.owner==='you'){income+=70;supply+=110;q.troops+=35;q.loyalty=Math.min(100,q.loyalty+3);}else if(q.owner!=='none')q.troops+=25;});s.gold+=income;s.rice+=supply;\n  let report='Taxes bring '+income+' gold and '+supply+' rice. Each friendly garrison gains 35 troops.';\n  const rivals=s.provinces.filter(q=>q.owner!=='you'&&q.owner!=='none').sort((a,b)=>b.troops-a.troops);\n  for(const rival of rivals){const target=rival.near.map(j=>s.provinces[j]).filter(q=>q.owner==='you').sort((a,b)=>(a.troops+a.fort*2)-(b.troops+b.fort*2))[0];if(target){const sent=Math.floor(rival.troops*.6);if(sent>target.troops+target.fort*2){rival.troops-=sent;target.owner=rival.owner;target.troops=Math.max(60,sent-Math.floor(target.troops*.6));target.loyalty=45;report='Rival forces capture '+target.name+'. Your taxes still bring '+income+' gold and '+supply+' rice.';break;}}}\n  if(!before)report='Your court has lost its last province. Begin a new campaign.';announce(s,report);\n }\n}\nfunction point(e){const r=canvas.getBoundingClientRect(),scale=Math.min(r.width/640,r.height/480);return {x:(e.clientX-r.left-(r.width-640*scale)/2)/scale,y:(e.clientY-r.top-(r.height-480*scale)/2)/scale};}\nfunction contains(x,y,poly){let hit=false;for(let i=0,j=poly.length-1;i<poly.length;j=i++){const a=poly[i],b=poly[j];if((a[1]>y)!==(b[1]>y)&&x<(b[0]-a[0])*(y-a[1])/(b[1]-a[1])+a[0])hit=!hit;}return hit;}\nfunction takeCommand(){timeline.pause();if(!manual){manual=copy(snapshot(clock.t));manual.message='You have command. Select a province, then recruit, fortify, negotiate or march. Unite five provinces.';}return manual;}\nfunction restart(){timeline.pause();manual=fresh();manual.message='A new campaign begins. Select a province; unite five beneath the jade banner.';draw(manual,clock.t);}\ncanvas.addEventListener('pointerdown',e=>{canvas.focus();const q=point(e);if(q.x>=512&&q.x<=616&&q.y>=21&&q.y<=43){if(manual)restart();else draw(takeCommand(),clock.t);return;}if(q.y>=430&&q.y<=456){const i=Math.floor((q.x-24)/120);if(i>=0&&i<5&&q.x<24+i*120+112){const s=takeCommand();doAction(s,i);draw(s,clock.t);return;}}if(q.x>=27&&q.x<=426&&q.y>=84&&q.y<=320){const s=takeCommand();for(let i=0;i<regions.length;i++)if(contains(q.x-27,q.y-84,regions[i].poly)){s.selected=i;const p=s.provinces[i];s.message=p.owner==='you'?p.name+' awaits your orders. Recruit costs 140 gold / 110 rice; fortify costs 100 gold.':p.owner==='none'?p.name+' is independent. An envoy can secure its allegiance for 180 gold.':p.name+' belongs to the '+clans[p.owner].name+' clan. March from an adjacent province or send an envoy.';break;}draw(s,clock.t);}});\ncanvas.addEventListener('pointermove',e=>{const q=point(e);canvas.style.cursor=(q.x>=512&&q.y>=21&&q.y<=43)||(q.y>=430&&q.y<=456)||(q.x>=27&&q.x<=426&&q.y>=84&&q.y<=320)?'pointer':'default';});\ncanvas.addEventListener('keydown',e=>{const k=e.key.toLowerCase();if(k==='n'){e.preventDefault();restart();return;}const keys={r:0,f:1,e:2,m:3,' ':4};if(Object.prototype.hasOwnProperty.call(keys,k)){e.preventDefault();const s=takeCommand();doAction(s,keys[k]);draw(s,clock.t);}else if(/^[1-8]$/.test(k)){e.preventDefault();const s=takeCommand();s.selected=Number(k)-1;s.message=s.provinces[s.selected].name+' selected. Choose your next order.';draw(s,clock.t);}});\n// The attract sequence is recomputed from time on every seek. User input\n// pauses it and enters the turn-based campaign; no independent clocks run.\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(clock,{t:30,duration:30,ease:'none',onUpdate:()=>{manual=null;draw(snapshot(clock.t),clock.t);}});\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\ndraw(snapshot(0),0);\n</script>\n</body>\n</html>",
