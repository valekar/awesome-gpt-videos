{
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Quetzal — Form, Flow, Flight</title>\n<style>\n*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#101715}#root{position:relative;width:100%;height:100%;overflow:hidden}canvas{position:absolute;inset:0;width:100%;height:100%;display:block}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"15\">\n<canvas id=\"art\" class=\"clip\" data-start=\"0\" data-duration=\"15\" width=\"1920\" height=\"1080\" role=\"img\" aria-label=\"An original Quetzal motion design showreel: colorful feathers transform through form, flow and flight.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n(() => {\n'use strict';\nconst canvas=document.getElementById('art');\nconst c=canvas.getContext('2d');\nconst W=1920,H=1080,TAU=Math.PI*2;\n// Editable creative controls. All geometry and motion are computed from time.\nconst P={ink:'#101715',paper:'#F3F1E7',lime:'#DBFF50',jade:'#00BD89',blue:'#2344F5',pink:'#FF639F',orange:'#FF743E'};\nconst starts=[0,3.05,6.15,9.25,12.2];\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst mix=(a,b,t)=>a+(b-a)*t;\nconst smooth=v=>{v=clamp(v);return v*v*(3-2*v)};\nconst out=v=>1-Math.pow(1-clamp(v),4);\nconst back=v=>{v=clamp(v)-1;return 1+2.70158*v*v*v+1.70158*v*v};\nfunction bg(color){c.fillStyle=color;c.fillRect(0,0,W,H)}\nfunction circle(x,y,r,color){if(r<=0)return;c.beginPath();c.arc(x,y,r,0,TAU);c.fillStyle=color;c.fill()}\nfunction line(x1,y1,x2,y2,color,width=2){c.beginPath();c.moveTo(x1,y1);c.lineTo(x2,y2);c.strokeStyle=color;c.lineWidth=width;c.stroke()}\nfunction text(s,x,y,size,color,maxWidth,align='left'){\n c.save();c.font=`900 ${size}px Arial, Helvetica, sans-serif`;c.textAlign=align;c.textBaseline='alphabetic';c.fillStyle=color;\n const width=c.measureText(s).width;const scale=maxWidth?Math.min(1,maxWidth/width):1;\n c.translate(x,y);c.scale(scale,1);c.fillText(s,0,0);c.restore();\n}\nfunction spaced(s,x,y,size,color,tracking=7){\n c.save();c.font=`700 ${size}px Arial, Helvetica, sans-serif`;c.fillStyle=color;\n const widths=[...s].map(ch=>c.measureText(ch).width);let at=x-(widths.reduce((a,b)=>a+b,0)+(s.length-1)*tracking)/2;\n [...s].forEach((ch,i)=>{c.fillText(ch,at,y);at+=widths[i]+tracking});c.restore();\n}\nfunction petal(length,width,color){\n c.beginPath();c.moveTo(0,0);c.bezierCurveTo(length*.25,-width*.78,length*.83,-width*.57,length,0);\n c.bezierCurveTo(length*.8,width*.57,length*.2,width*.52,0,0);c.fillStyle=color;c.fill();\n}\nfunction ring(x,y,r,width,color,start=0,end=TAU){\n if(r<=0)return;c.beginPath();c.arc(x,y,r,start,end);c.strokeStyle=color;c.lineWidth=width;c.stroke();\n}\nfunction star(x,y,r,rotation,color){\n c.save();c.translate(x,y);c.rotate(rotation);c.beginPath();\n for(let i=0;i<16;i++){const a=i*TAU/16,rr=i%2?r*.43:r;i?c.lineTo(Math.cos(a)*rr,Math.sin(a)*rr):c.moveTo(Math.cos(a)*rr,Math.sin(a)*rr)}\n c.closePath();c.fillStyle=color;c.fill();c.restore();\n}\n// Original abstract bird mark: seven articulated feathers per wing and flowing tail.\nfunction bird(x,y,s,t,opening=1){\n c.save();c.translate(x,y);c.scale(s,s);\n const colors=[P.lime,P.jade,P.paper,P.blue,P.pink,P.orange,P.jade];\n for(let side of [-1,1]){\n  c.save();c.scale(side,1);\n  for(let i=6;i>=0;i--){\n   const fan=mix(.06,-1.10+i*.185,opening)+Math.sin(t*2.1+i*.42)*.025*opening;\n   c.save();c.translate(0,48+i*9);c.rotate(fan);petal((475-i*25)*opening+30,88-i*4,colors[i]);c.restore();\n  }c.restore();\n }\n for(let j=0;j<3;j++){\n  c.beginPath();c.moveTo(-22+j*24,92);\n  c.bezierCurveTo(-80+j*60,220,155+j*42,245,70+j*64,400);\n  c.strokeStyle=[P.jade,P.lime,P.pink][j];c.lineWidth=22-j*4;c.lineCap='round';c.stroke();\n }\n c.save();c.rotate(-.1);c.fillStyle=P.jade;c.beginPath();c.ellipse(0,56,46,99,0,0,TAU);c.fill();\n c.fillStyle=P.paper;c.beginPath();c.ellipse(8,85,22,57,0,0,TAU);c.fill();c.restore();\n circle(0,-39,48,P.jade);circle(15,-47,6,P.ink);\n c.beginPath();c.moveTo(41,-46);c.lineTo(83,-30);c.lineTo(41,-20);c.closePath();c.fillStyle=P.orange;c.fill();\n for(let j=0;j<3;j++){c.save();c.translate(-21+j*16,-72);c.rotate(-1.9+j*.2);petal(68-j*9,21,P.lime);c.restore()}\n c.restore();\n}\nfunction revealWord(word,x,y,size,width,t,color,stagger=.055){\n c.save();c.font=`900 ${size}px Arial, Helvetica, sans-serif`;const glyphs=[...word];\n const full=c.measureText(word).width,scale=Math.min(1,width/full);c.translate(x,y);c.scale(scale,1);\n c.beginPath();c.rect(-25,-size*1.12,full+50,size*1.22);c.clip();let xx=0;\n glyphs.forEach((ch,i)=>{const p=out((t-i*stagger)/.6);c.save();c.translate(xx,(1-p)*size*1.2);c.rotate((1-p)*.12);c.fillStyle=color;c.fillText(ch,0,0);c.restore();xx+=c.measureText(ch).width});c.restore();\n}\nfunction intro(t){\n bg(P.ink);\n const enter=out(t/.9),open=out((t-.12)/1.15);\n // Expanding rings establish the wing's radial motion.\n c.save();c.globalAlpha=.28*(1-smooth((t-1.3)/1));\n for(let i=0;i<4;i++)ring(960,390,Math.max(1,(t*.7+i*.22)*250),2,P.jade);\n c.restore();\n c.save();c.translate(960,410);c.rotate((1-enter)*-.65);c.scale(.12+.88*enter,.12+.88*enter);c.translate(-960,-410);\n bird(960,340,.92,t,open);c.restore();\n const p=out((t-.55)/.8);c.save();c.globalAlpha=p;\n revealWord('QUETZAL',257,954,235,1406,t-.55,P.paper,.045);c.restore();\n const dash=out((t-1.4)/.7);line(258,1000,258+1404*dash,1000,P.jade,5);\n // One precise accent crosses behind the lockup.\n star(1570,215,40*enter,t*.7,P.lime);\n}\nfunction form(t){\n bg(P.paper);\n const p=out(t/.7);\n revealWord('FORM',105,645,310,850,t-.06,P.ink,.07);\n line(115,701,115+790*out((t-.5)/.8),701,P.ink,4);\n // Four graphic cells build on staggered beats, then share one rotation.\n const cells=[{x:1225,y:337,col:P.blue},{x:1590,y:337,col:P.jade},{x:1225,y:702,col:P.orange},{x:1590,y:702,col:P.ink}];\n cells.forEach((cell,i)=>{\n  const e=back((t-.12-i*.12)/.7);if(e<=0)return;\n  c.save();c.translate(cell.x,cell.y);c.scale(e,e);c.rotate((1-out((t-i*.12)/.9))*.6);\n  if(i===0){\n   circle(0,0,164,P.blue);circle(0,0,91,P.paper);circle(Math.cos(t*1.3)*107,Math.sin(t*1.3)*107,36,P.orange);\n  }else if(i===1){\n   c.rotate(t*.22);for(let j=0;j<8;j++){c.save();c.rotate(j*TAU/8);petal(162,65,j%2?P.jade:P.ink);c.restore()}circle(0,0,31,P.lime);\n  }else if(i===2){\n   c.rotate(-.22+Math.sin(t)*.08);for(let j=0;j<5;j++){c.save();c.translate(-135+j*54,0);c.rotate(-.5);c.fillStyle=j%2?P.pink:P.orange;c.fillRect(-17,-143,34,286);c.restore()}\n  }else{\n   c.rotate(-t*.25);star(0,0,171,0,P.ink);circle(0,0,56,P.lime);\n  }c.restore();\n });\n // A small feather supplies continuity with the opening mark.\n c.save();c.translate(130,233);c.rotate(-.23);c.scale(p,p);petal(285,90,P.jade);c.restore();\n}\nfunction flow(t){\n bg(P.lime);\n revealWord('FLOW',103,337,292,1260,t-.05,P.ink,.07);\n // Parallel cubic ribbons share a moving field; every point is a function of t.\n const entry=out(t/.8);const phase=t*1.55;\n c.save();c.beginPath();c.rect(0,388,W,H-388);c.clip();\n for(let k=13;k>=0;k--){\n  const y=526+k*32;\n  c.beginPath();\n  for(let x=-160;x<=W+160;x+=20){\n   const norm=x/W;\n   const wave=Math.sin(norm*TAU*.9-phase+k*.075)*105+Math.sin(norm*TAU*1.65+phase*.55)*30;\n   const yy=y+wave*entry+(1-entry)*(H+400);\n   x===-160?c.moveTo(x,yy):c.lineTo(x,yy);\n  }\n  c.strokeStyle=k%5===0?P.blue:P.ink;c.lineWidth=14;c.lineCap='round';c.stroke();\n }c.restore();\n const bx=mix(1500,1670,smooth(t/3.1)),by=260+Math.sin(t*2)*30;\n circle(bx,by,96*back((t-.35)/.7),P.paper);\n c.save();c.translate(bx,by);c.rotate(-t*.75);star(0,0,48*out((t-.55)/.5),0,P.blue);c.restore();\n // The colored segment travels along the same ribbon field.\n const lead=clamp((t-.65)/2.3)*W;\n circle(lead,790+Math.sin(lead/W*TAU*.9-phase+.45)*105,24,P.pink);\n}\nfunction flight(t){\n bg(P.blue);\n // A continuous fan of enlarged feathers sweeps across the composition.\n const entry=out(t/.85);\n for(let side of [-1,1]){\n  for(let i=12;i>=0;i--){\n   const a=-1.17+i*.105;\n   c.save();c.translate(960,540);c.scale(side,1);c.rotate(a+(1-entry)*1.4+Math.sin(t*.8)*.06);\n   c.translate(110+(1-entry)*450,0);\n   const length=720-i*25;\n   petal(length,105-i*3,[P.jade,P.lime,P.paper,P.pink][i%4]);c.restore();\n  }\n }\n // A crisp central plate allows the type to read through the moving wings.\n c.save();c.translate(960,545);c.rotate(-.045);c.fillStyle=P.blue;c.fillRect(-834,-148,1668,302);c.restore();\n c.save();c.translate(960,545);c.rotate(-.045);\n const word='FLIGHT';c.font='900 262px Arial, Helvetica, sans-serif';const ww=c.measureText(word).width;\n revealWord(word,-ww/2,93,262,1500,t-.28,P.paper,.055);c.restore();\n // Twin tail strokes lead the eye toward the final circular transition.\n const tail=out((t-.6)/1.2);\n c.save();c.beginPath();c.rect(0,740,1920*tail,340);c.clip();\n for(let j=0;j<3;j++){\n  c.beginPath();c.moveTo(-100,950+j*28);c.bezierCurveTo(450,640+j*20,1270,1140-j*40,2020,830+j*24);\n  c.strokeStyle=[P.pink,P.lime,P.jade][j];c.lineWidth=14-j*3;c.stroke();\n }c.restore();\n}\nfunction finale(t){\n bg(P.ink);\n const enter=out(t/.75),settle=smooth((t-.8)/.9);\n const markScale=mix(.56,.48,settle);\n bird(960,mix(253,265,settle),markScale,t+12,enter);\n revealWord('QUETZAL',245,775,240,1430,t-.13,P.paper,.045);\n const rule=out((t-.7)/.7);line(255,829,255+1410*rule,829,P.jade,4);\n c.save();c.globalAlpha=out((t-1.05)/.65);spaced('FORM. FLOW. FLIGHT.',960,917,43,P.lime,8);c.restore();\n // Motion resolves into a clean, readable closing hold.\n}\nconst scenes=[intro,form,flow,flight,finale];\nfunction draw(time){\n const t=clamp(time,0,15);c.setTransform(1,0,0,1,0,0);c.globalAlpha=1;c.globalCompositeOperation='source-over';c.lineCap='butt';\n let index=0;for(let i=1;i<starts.length;i++)if(t>=starts[i])index=i;\n const local=t-starts[index];\n if(index>0&&local<.52){\n  scenes[index-1](t-starts[index-1]);\n  const origins=[[960,540],[1540,340],[360,700],[960,540],[960,330]];\n  const origin=origins[index];const radius=2300*out(local/.52);\n  c.save();c.beginPath();c.arc(origin[0],origin[1],Math.max(.01,radius),0,TAU);c.clip();scenes[index](local);c.restore();\n }else scenes[index](local);\n}\nconst playhead={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{t:15,duration:15,ease:'none',onUpdate:()=>draw(playhead.t)},0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\ndraw(0);\n})();\n</script>\n</body>\n</html>",
