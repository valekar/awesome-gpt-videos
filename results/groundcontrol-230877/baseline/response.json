{
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Japan, Summer 2026 — A Pencil Study of Heat</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#f3eddd}#root{position:relative;width:100%;height:100%;overflow:hidden}canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}audio{position:absolute;width:0;height:0;pointer-events:none}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"180\">\n<canvas id=\"art\" class=\"clip\" data-start=\"0\" data-duration=\"180\" data-track-index=\"0\" width=\"1920\" height=\"1080\" aria-label=\"A three-minute illustrated exploration of Japan's summer 2026 heat, with original synthesized music.\"></canvas>\n<audio id=\"score\" class=\"clip\" data-start=\"0\" data-duration=\"180\" data-track-index=\"1\" preload=\"auto\"></audio>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n'use strict';\n/* EDITABLE RESEARCH LEDGER — researched 2026-10-18.\n   National summer anomalies, ranks, baseline and long-term trend:\n   https://www.data.jma.go.jp/cpdinfo/temp/sum_jpn.html\n   Regional summer conditions:\n   https://www.data.jma.go.jp/cpd/longfcst/seasonal/202608/202608s.html\n   Circulation, warming and cumulative >=40°C station observations:\n   https://www.jma.go.jp/jma/press/2609/01c/kentoukai20260901.html\n   July heat mechanisms and 2025 cumulative >=40°C observations:\n   https://www.jma.go.jp/jma/press/2608/03b/japan_hot20260803.html\n   All drawings and musical phrases below are original. Maps and atmospheric\n   diagrams are schematic, not geospatial datasets or weather simulations.\n*/\nconst W=1920,H=1080,DURATION=180;\nconst C={paper:'#f3eddd',ink:'#363b37',muted:'#65685e',red:'#bc4735',orange:'#dc8953',gold:'#dfb45c',cyan:'#528b91',blue:'#345c70'};\nconst canvas=document.getElementById('art'),ctx=canvas.getContext('2d');\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst ease=v=>{v=clamp(v);return v*v*(3-2*v)};\nconst hash=n=>{const a=Math.sin(n*127.1+311.7)*43758.5453123;return a-Math.floor(a)};\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst TAU=Math.PI*2;\nconst DATA=[{year:2010,value:1.08},{year:2023,value:1.76},{year:2024,value:1.76},{year:2025,value:2.36},{year:2026,value:1.02}];\nconst scenes=[\n {title:'Japan, under the sun.',kicker:'SUMMER 2026',body:'A pencil study of heat, weather and a changing climate.',source:''},\n {title:'A summer above normal.',kicker:'THE NATIONAL PICTURE',body:'June–August 2026 averaged 1.02°C above the 1991–2020 summer baseline.',source:'JMA · Japan seasonal mean temperature'},\n {title:'Put the heat in perspective.',kicker:'FIVE WARMEST SUMMERS',body:'2026 ranked fifth since 1898. The national record remains 2025.',source:'JMA · Japan seasonal mean temperature'},\n {title:'Different places. Different heat.',kicker:'REGIONAL CONTRASTS',body:'A national mean brings very different regional summers into one number.',source:'JMA · Summer 2026 weather summary'},\n {title:'The west felt the pressure.',kicker:'WESTERN JAPAN',body:'Its third-warmest summer since 1946 included record mid- and late-July regional means.',source:'JMA · Summer 2026 analysis; July heat analysis'},\n {title:'The winds bent north.',kicker:'WHY IT WAS HOT · UPPER AIR',body:'The jet stream meandered north, allowing the Tibetan High to extend toward western Japan.',source:'JMA · Summer 2026 circulation analysis'},\n {title:'Sinking air warmed up.',kicker:'WHY IT WAS HOT · PRESSURE',body:'Beneath deep high pressure, descending air compressed and warmed.',source:'JMA · July heat analysis'},\n {title:'Sunshine. Then more warm air.',kicker:'WHY IT WAS HOT · NEAR THE SURFACE',body:'Clear skies strengthened solar heating. Warm air also flowed around the Pacific High into western Japan.',source:'JMA · July heat analysis'},\n {title:'Weather on a warmer baseline.',kicker:'THE LONGER VIEW',body:'Global warming raised the background temperature on which these weather patterns acted.',source:'JMA · Summer temperature series; summer 2026 analysis'},\n {title:'Extremes tell another story.',kicker:'DAYS REACHING 40°C',body:'The cumulative count reached 36 station-days in summer 2026, the most in the comparable record since 2010.',source:'JMA · September 2026 analysis; August 2026 heat release'},\n {title:'The ingredients added up.',kicker:'FROM BACKGROUND TO HEAT SPELL',body:'A warmer atmosphere and persistent weather patterns combined to intensify the heat.',source:'JMA · Summer 2026 circulation analysis'},\n {title:'A hot summer.\\nA warmer baseline.',kicker:'JAPAN · JUNE–AUGUST 2026',body:'Read the average. Look at the regions. Watch the extremes.',source:'Research: Japan Meteorological Agency · 2026 summer reports'}\n];\n// Fixed paper texture: no randomness or state dependent on playback order.\nconst paper=document.createElement('canvas');paper.width=W;paper.height=H;\nconst pg=paper.getContext('2d');pg.fillStyle=C.paper;pg.fillRect(0,0,W,H);\nfor(let i=0;i<23500;i++){const x=hash(i*4+1)*W,y=hash(i*4+2)*H;pg.strokeStyle=i%3?'rgba(87,74,52,.035)':'rgba(255,255,255,.22)';pg.lineWidth=.6;pg.beginPath();pg.moveTo(x,y);pg.lineTo(x+1+hash(i*4+3)*5,y+hash(i*4+4)*1.2);pg.stroke()}\nfunction text(s,x,y,size=36,color=C.ink,font='sans-serif',align='left'){ctx.fillStyle=color;ctx.font=`${size}px ${font}`;ctx.textAlign=align;ctx.textBaseline='alphabetic';ctx.fillText(s,x,y)}\nfunction wrap(s,x,y,maxWidth,size=36,color=C.ink,lineHeight=49,font='sans-serif'){ctx.font=`${size}px ${font}`;let line='',row=0;for(const word of s.split(' ')){const next=line?line+' '+word:word;if(ctx.measureText(next).width>maxWidth&&line){text(line,x,y+row*lineHeight,size,color,font);line=word;row++}else line=next}if(line)text(line,x,y+row*lineHeight,size,color,font)}\nfunction path(points,color=C.ink,width=2,progress=1,closed=false){\n if(points.length<2||progress<=0)return;const n=Math.max(1,Math.ceil((points.length-1)*clamp(progress)));\n const passes=[[-1.4,.55,C.cyan,.16],[1.3,-.55,C.red,.14],[0,0,color,1]];\n for(const [ox,oy,col,alpha] of passes){ctx.save();ctx.translate(ox,oy);ctx.globalAlpha*=alpha;ctx.strokeStyle=col;ctx.lineWidth=width;ctx.lineJoin='round';ctx.lineCap='round';ctx.beginPath();ctx.moveTo(points[0][0],points[0][1]);for(let i=1;i<=n;i++)ctx.lineTo(points[i][0],points[i][1]);if(closed&&progress>=1)ctx.closePath();ctx.stroke();ctx.restore()}\n}\nfunction line(x1,y1,x2,y2,color=C.ink,width=2,p=1,seed=1){const pts=[];for(let i=0;i<=30;i++){let q=i/30;let j=Math.sin(Math.PI*q)*(hash(i+seed*93)-.5)*2.1;pts.push([lerp(x1,x2,q)+j,lerp(y1,y2,q)+j])}path(pts,color,width,p)}\nfunction circle(x,y,r,color=C.ink,width=2,p=1,seed=1,fill=null){let pts=[];for(let i=0;i<=120;i++){const a=i/120*TAU,rr=r+Math.sin(a*7+seed)*1.3+Math.sin(a*13)*.7;pts.push([x+Math.cos(a)*rr,y+Math.sin(a)*rr])}if(fill){ctx.save();ctx.fillStyle=fill;ctx.beginPath();pts.forEach((v,i)=>i?ctx.lineTo(...v):ctx.moveTo(...v));ctx.closePath();ctx.fill();ctx.restore()}path(pts,color,width,p)}\nfunction polygon(pts,fill,color=C.ink,width=2){ctx.save();ctx.beginPath();pts.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.closePath();if(fill){ctx.fillStyle=fill;ctx.fill()}ctx.restore();path(pts,color,width,1,true)}\nfunction hatch(x,y,w,h,color=C.red,progress=1){ctx.save();ctx.beginPath();ctx.rect(x,y,w*clamp(progress),h);ctx.clip();for(let i=-h;i<w+h;i+=12)line(x+i,y+h,x+i+h,y,color,1,1,i+300);ctx.restore()}\nfunction arrow(x1,y1,x2,y2,color=C.red,p=1,width=3){line(x1,y1,x2,y2,color,width,p);if(p>.95){let a=Math.atan2(y2-y1,x2-x1);line(x2,y2,x2-21*Math.cos(a-.45),y2-21*Math.sin(a-.45),color,width);line(x2,y2,x2-21*Math.cos(a+.45),y2-21*Math.sin(a+.45),color,width)}}\nfunction sun(x,y,r,t,p=1){circle(x,y,r,C.red,2.5,p,3,'rgba(223,180,92,.23)');ctx.save();ctx.beginPath();ctx.arc(x,y,r-5,0,TAU);ctx.clip();hatch(x-r,y-r,2*r,2*r,C.orange,p);ctx.restore();for(let j=0;j<24;j++){const a=j/24*TAU+t*.017;line(x+Math.cos(a)*(r+20),y+Math.sin(a)*(r+20),x+Math.cos(a)*(r+43),y+Math.sin(a)*(r+43),C.red,1.8,p,j+1)}}\nfunction heat(x,y,w,t,count=7){for(let k=0;k<count;k++){let pts=[];for(let j=0;j<=55;j++){const q=j/55;pts.push([x+w*k/(count-1)+Math.sin(q*10-t*.7+k)*9,y-q*120])}path(pts,C.red,1.5)}}\nfunction islandMap(x,y,w,h,colors=[C.gold,C.orange,C.red,C.red],p=1){\n const shapes=[[[.69,.08],[.76,.12],[.79,.19],[.88,.23],[.78,.29],[.67,.25],[.65,.17]],[[.65,.31],[.70,.32],[.69,.39],[.63,.43],[.60,.51],[.53,.58],[.46,.60],[.39,.66],[.29,.69],[.28,.64],[.38,.59],[.45,.55],[.53,.49],[.58,.41],[.59,.35]],[[.34,.71],[.42,.70],[.46,.73],[.40,.77],[.32,.77]],[[.24,.70],[.28,.74],[.27,.82],[.23,.89],[.18,.84],[.18,.77]]];\n shapes.forEach((s,i)=>{ctx.save();ctx.globalAlpha*=p;const pts=s.map(v=>[x+v[0]*w,y+v[1]*h]);polygon(pts,colors[i],C.ink,2);ctx.restore()});\n}\nfunction ground(y=770){line(230,y,1690,y,C.ink,2);for(let i=0;i<65;i++){const x=230+i*22;line(x,y+8,x-12,y+20,C.muted,.8,1,i)}}\nfunction labelBox(s,x,y,w,color=C.ink){polygon([[x,y],[x+w,y-2],[x+w+1,y+70],[x-2,y+72]],'rgba(243,237,221,.94)',color,1.6);text(s,x+w/2,y+46,30,color,'sans-serif','center')}\nfunction enter(u,delay=0,length=2){return ease((u-delay)/length)}\nfunction sceneArt(i,u,t){\n const p=enter(u,0,3);\n switch(i){\n case 0:{\n  sun(1400,397,164,t,p);islandMap(900,390,800,430,[C.paper,C.paper,C.paper,C.paper],enter(u,1,3));\n  text('2026',115,637,236,C.red,'serif');line(128,680,770,680,C.ink,2,enter(u,2,4));\n  heat(1090,880,500,t,8);text('JUNE — AUGUST',125,745,32,C.muted);break;\n }\n case 1:{\n  text('+1.02°C',145,540,167,C.red,'serif');text('above the summer baseline',153,610,35);\n  const xx=1330,top=315,bottom=735,zero=685;line(xx,top,xx,bottom,C.ink,3,p);circle(xx,bottom+14,42,C.red,2,p,2,'rgba(188,71,53,.2)');\n  line(xx,zero,xx,zero-250*p,C.red,17,p);line(1090,zero,1570,zero,C.muted,1.6,p);text('1991–2020 mean',1550,zero+49,29,C.muted,'sans-serif','right');\n  for(let n=0;n<6;n++)line(xx-18,zero-n*65,xx+18,zero-n*65,C.ink,1.5,p);labelBox('SUMMER ANOMALY',1115,270,430);break;\n }\n case 2:{\n  const x0=430,x1=1590,y0=318,row=92,scale=(x1-x0)/2.5;\n  for(let tick=0;tick<=5;tick++){let x=x0+tick*.5*scale;line(x,y0-20,x,y0+row*4+55,C.muted,.6,p);text((tick*.5).toFixed(1),x,y0+row*4+105,27,C.muted,'sans-serif','center')}\n  DATA.forEach((d,j)=>{const y=y0+j*row,pr=enter(u,.7+j*.5,2.5),bw=d.value*scale*pr,col=d.year===2026?C.red:C.blue;text(String(d.year),310,y+35,37,col,'sans-serif','right');ctx.save();ctx.globalAlpha*=.16;ctx.fillStyle=col;ctx.fillRect(x0,y,bw,53);ctx.restore();hatch(x0,y,bw,53,col);line(x0,y+53,x0+bw,y+53,col,2);if(pr>.98)text('+'+d.value.toFixed(2)+'°C',x0+bw+22,y+37,34,col)});\n  text('Difference from the 1991–2020 summer mean (°C)',1000,898,28,C.muted,'sans-serif','center');break;\n }\n case 3:{\n  islandMap(520,250,970,580,['#dfb45c','#dc8953','#bc4735','#bc4735'],p);\n  labelBox('NORTH · much warmer',1160,310,550,C.red);line(1160,360,1245,378,C.red,1.5,p);\n  labelBox('EAST · warmer',1210,535,490,C.orange);line(1210,568,1117,559,C.orange,1.5,p);\n  labelBox('WEST · much warmer',210,590,540,C.red);line(750,625,915,647,C.red,1.5,p);\n  circle(660,798,13,C.cyan,2,p);labelBox('OKINAWA / AMAMI · near normal',795,758,840,C.cyan);\n  text('Regional categories relative to normal · schematic geography',220,880,27,C.muted);break;\n }\n case 4:{\n  circle(481,537,168,C.red,3,p,9,'rgba(220,137,83,.11)');text('3rd',481,583,139,C.red,'serif','center');text('warmest summer',481,770,34,C.ink,'sans-serif','center');\n  const months=['JULY','AUGUST'];months.forEach((m,j)=>{let x=940+j*340;text(m,x+125,337,31,C.muted,'sans-serif','center');for(let k=0;k<3;k++){const y=390+k*100;polygon([[x,y],[x+260,y],[x+260,y+77],[x,y+77]],'rgba(223,180,92,.08)',C.muted,1);if((j===0&&k>0)||(j===1&&k===2)){hatch(x+5,y+5,250,67,C.red,enter(u,2+k,2));text('RECORD',x+130,y+51,27,C.red,'sans-serif','center')}else text(['EARLY','MID','LATE'][k],x+130,y+51,27,C.muted,'sans-serif','center')}});\n  text('Regional seasonal ranking: since 1946',1050,807,29,C.muted,'sans-serif','center');break;\n }\n case 5:{\n  islandMap(820,410,650,330,[C.paper,C.paper,C.orange,C.orange],p);\n  let old=[],jet=[];for(let k=0;k<=160;k++){const q=k/160,x=240+q*1430;old.push([x,507+Math.sin(q*TAU)*29]);jet.push([x,405-Math.sin(q*Math.PI)*132+Math.sin(q*TAU*1.6)*24])}\n  ctx.save();ctx.setLineDash([12,15]);path(old,C.muted,1.4,p);ctx.restore();path(jet,C.blue,5,enter(u,1,4));\n  for(let k=0;k<9;k++){const q=((u*.035+k/9)%1),n=Math.min(159,Math.floor(q*160)),a=jet[n],b=jet[n+1];arrow(a[0]-18,a[1],b[0]+18,b[1],C.blue,1,2)}\n  arrow(800,500,800,365,C.red,enter(u,4,2));text('Northward meander',1040,312,36,C.blue);text('Reference path',280,570,28,C.muted);text('Tibetan High expands eastward',1110,758,35,C.red,'sans-serif','center');text('Atmospheric schematic · not a measured wind map',240,850,27,C.muted);break;\n }\n case 6:{\n  ground(787);const cx=960;for(let k=0;k<3;k++){let pts=[];for(let j=0;j<=100;j++){const a=Math.PI+j/100*Math.PI;pts.push([cx+Math.cos(a)*(570-k*94),750+Math.sin(a)*(390-k*54)])}path(pts,k===1?C.red:C.muted,k===1?2.8:1.4,p)}\n  text('H',cx,528,137,C.red,'serif','center');\n  for(let k=0;k<5;k++){const x=600+k*180;arrow(x,570,x,715,C.red,enter(u,2+k*.2,2));for(let n=0;n<4;n++){const q=((u*.12+n*.25+k*.07)%1);circle(x,580+q*150,lerp(12,7,q),C.orange,1.2)}}\n  text('DESCENT',330,500,31,C.muted);text('COMPRESSION',1460,667,31,C.red,'sans-serif','center');text('WARMING',960,853,41,C.red,'sans-serif','center');break;\n }\n case 7:{\n  sun(520,420,85,t,p);ground(785);for(let k=0;k<4;k++)arrow(440+k*56,545,500+k*56,715,C.orange,enter(u,1,3));\n  text('More solar heating',530,858,34,C.red,'sans-serif','center');\n  circle(1370,550,149,C.blue,2,p,6);text('H',1370,588,112,C.blue,'serif','center');text('PACIFIC HIGH',1370,756,29,C.blue,'sans-serif','center');\n  let pts=[];for(let n=0;n<=100;n++){let a=lerp(1.3,4.9,n/100);pts.push([1370+Math.cos(a)*225,540+Math.sin(a)*170])}path(pts,C.red,4,enter(u,3,4));arrow(1390,369,1280,338,C.red,enter(u,6,1));\n  text('Warm-air inflow',1400,858,34,C.red,'sans-serif','center');heat(790,760,230,t,5);break;\n }\n case 8:{\n  text('+1.41°C',155,545,154,C.red,'serif');text('per century',162,615,48,C.ink,'serif');text('Japan’s long-term summer trend',164,700,32,C.muted);\n  for(let k=0;k<8;k++){const r=55+k*24;circle(1390,545,r,k<4?C.cyan:C.red,k===7?2.8:1.2,p,k,null)}\n  sun(1390,545,69,t,p);for(let k=0;k<12;k++){let a=k/12*TAU+u*.018;let x=1390+Math.cos(a)*280,y=545+Math.sin(a)*240;line(x,y,x+Math.cos(a)*30,y+Math.sin(a)*30,k<5?C.blue:C.red,1.7,p,k)}\n  text('1898–2026 record',164,757,29,C.muted);text('Symbolic illustration of warming',1390,866,27,C.muted,'sans-serif','center');break;\n }\n case 9:{\n  text('36',330,530,195,C.red,'serif','center');text('station-days',330,594,39,C.ink,'sans-serif','center');text('at 40°C or above',330,651,33,C.red,'sans-serif','center');\n  const gx=830,gy=340;for(let n=0;n<36;n++){const x=gx+n%9*86,y=gy+Math.floor(n/9)*88;const a=enter(u,.8+n*.075,1);ctx.save();ctx.globalAlpha*=a;circle(x,y,24,C.red,1.5,1,n,'rgba(188,71,53,.12)');line(x-10,y+9,x+10,y-9,C.red,1.2)}\n  text('2025: 30 station-days',830,776,35,C.muted);text('One station reaching the threshold on one day = one station-day.',830,842,26,C.muted);text('Cumulative observations; locations may repeat.',830,881,26,C.muted);break;\n }\n case 10:{\n  const xs=[335,960,1585],labels=[['WARMER','BACKGROUND'],['PERSISTENT','HIGH PRESSURE'],['INTENSE','HEAT SPELLS']];\n  xs.forEach((x,k)=>{ctx.save();ctx.globalAlpha*=enter(u,k*2,2);circle(x,515,162,k===1?C.blue:C.red,2.4,1,k,'rgba(223,180,92,.07)');if(k===0){for(let j=0;j<4;j++)circle(x,515,50+j*19,j%2?C.red:C.cyan,1.1)}if(k===1){text('H',x,565,141,C.blue,'serif','center')}if(k===2){sun(x,515,78,t,1)}text(labels[k][0],x,758,32,C.ink,'sans-serif','center');text(labels[k][1],x,803,32,C.ink,'sans-serif','center');ctx.restore()});\n  arrow(540,515,745,515,C.ink,enter(u,2,2));arrow(1165,515,1370,515,C.ink,enter(u,4,2));break;\n }\n case 11:{\n  sun(1495,510,160,t,p);islandMap(1035,485,630,380,[C.paper,C.paper,C.paper,C.paper],p);\n  text('5th warmest',120,650,92,C.red,'serif');text('national summer since 1898',125,715,37,C.ink);line(125,767,885,767,C.ink,2,enter(u,2,4));\n  text('Average. Regions. Extremes.',125,838,38,C.muted,'serif');break;\n }\n }\n}\nfunction draw(t){\n t=clamp(t,0,DURATION);ctx.setTransform(1,0,0,1,0,0);ctx.globalAlpha=1;ctx.drawImage(paper,0,0);\n const i=Math.min(11,Math.floor(t/15)),u=t-i*15,s=scenes[i];\n const fadeIn=enter(u,0,.85),fadeOut=i===11?1:ease((15-u)/.7);\n ctx.save();ctx.globalAlpha=fadeIn*fadeOut;ctx.translate(0,14*(1-fadeIn));\n text(s.kicker,122,116,29,C.red);line(123,143,1790,143,C.muted,.9,1);\n if(i===0){text('Japan,',116,290,107,C.ink,'serif');text('under the sun.',116,402,107,C.ink,'serif')}\n else if(i===11){text('A hot summer.',117,282,92,C.ink,'serif');text('A warmer baseline.',117,385,92,C.ink,'serif')}\n else text(s.title,119,247,76,C.ink,'serif');\n sceneArt(i,u,t);\n const bodyY=i===0?900:945;\n wrap(s.body,124,bodyY,1640,34,C.ink,44);\n if(s.source)text(s.source,124,1024,25,C.muted);\n ctx.restore();\n // A short paper wipe bridges scenes without animating clip visibility.\n if(i<11&&u>14.5){const w=W*ease((u-14.5)/.5);ctx.drawImage(paper,0,0,w,H,0,0,w,H);line(w,0,w,H,C.muted,.6)}\n}\n\n/* ORIGINAL JAVASCRIPT SYNTHESIZER.\n   A deterministic 80 BPM score: 20 beats per scene, 12 scenes, exactly 180 s.\n   Rendered once into PCM. The audio element belongs to the host's media clock.\n   No AudioContext playback clock, timers, live sequencer or playback loop.\n   Edit motif/chords/timbre here to change the score.\n*/\nfunction synthesizeScore(){\n const sr=16000,seconds=180,samples=new Float32Array(sr*seconds),beat=.75;\n const hz=m=>440*Math.pow(2,(m-69)/12);\n functio