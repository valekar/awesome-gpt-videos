  "html": "<!doctype html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width,initial-scale=1'>\n<title>KOOKABUS-01 Enclosure</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000}body{font-family:Arial,Helvetica,sans-serif}#root{position:relative;width:100%;height:100%;background:#000;overflow:hidden}canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id='root' data-composition-id='main' data-width='1280' data-height='720' data-duration='10' data-fps='30'>\n<canvas id='film' class='clip' data-start='0' data-duration='10' width='1280' height='720' aria-label='Animated KOOKABUS-01 enclosure assembly, electrical interfaces and DIN-rail mounting'></canvas>\n</div>\n<script src='gsap.min.js'></script>\n<script>\n/*\nINDEPENDENT SAMPLED RECONSTRUCTION — editable procedural geometry.\n1280 x 720; 10 seconds; intended capture at 30 fps; silent.\nNo reference images, movies, CAD, external fonts or external assets are used.\nOnly dependency: the harness-provided local gsap.min.js.\n\nInferred staging, not recovered original scene boundaries:\n0–1: black reveal; exploded lid, PCB, four screws; board annotation.\n1–2: lid approaches; heat-set insert annotation.\n2–3: lid closes; screws rise; underside-fastening annotation.\n3–4: camera enlarges and centers the enclosure.\n4–5: two battery plugs and one load plug approach and connect.\n5–6: battery/load, LED and Qwiic callouts.\n6–7: mounting plate and rail enter beneath the wired enclosure.\n7–8: oblique mounting presentation and optional-clip callout.\n8–9: inferred hook, tilt and settle; TS35 callout.\n9–10: transition toward the supplied dark title state.\nThe final title placement, all interpolation and physical dimensions are approximations.\nThis source has not been rendered or visually validated.\n*/\n(() => {\n'use strict';\nconst W=1280,H=720,canvas=document.getElementById('film'),ctx=canvas.getContext('2d');\nconst PI=Math.PI;\nconst add=(a,b)=>a.map((v,i)=>v+b[i]);\nconst sub=(a,b)=>a.map((v,i)=>v-b[i]);\nconst mul=(a,k)=>a.map(v=>v*k);\nconst dot=(a,b)=>a[0]*b[0]+a[1]*b[1]+a[2]*b[2];\nconst cross=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];\nconst unit=a=>mul(a,1/(Math.hypot(...a)||1));\nconst mix=(a,b,t)=>a+(b-a)*t;\nconst clamp=x=>Math.max(0,Math.min(1,x));\nconst smooth=(a,b,t)=>{const u=clamp((t-a)/(b-a));return u*u*(3-2*u)};\nconst gate=(t,a,b,c,d)=>smooth(a,b,t)*(1-smooth(c,d,t));\nconst lerp3=(a,b,t)=>a.map((v,i)=>mix(v,b[i],t));\nconst COLORS={body:[35,44,47],lid:[64,75,80],inside:[18,27,29],rim:[49,60,64],yellow:[235,181,35],rib:[247,198,56],red:[184,8,19],black:[17,20,22],silver:[164,181,190],screw:[119,139,150],plate:[195,7,30],pcb:[160,177,144]};\nconst light=unit([-4,8,7]);\nlet polygons=[],camera,model={rx:0,rz:0,lift:0},useModel=true;\nfunction rotate(p){\n const cx=Math.cos(model.rx),sx=Math.sin(model.rx),cz=Math.cos(model.rz),sz=Math.sin(model.rz);\n const y=p[1]*cx-p[2]*sx,z=p[1]*sx+p[2]*cx;\n return [p[0]*cz-y*sz,p[0]*sz+y*cz,z];\n}\nfunction world(p){if(!useModel)return p.slice();const q=rotate(p);q[1]+=model.lift;return q}\nfunction worldNormal(n){return useModel?rotate(n):n.slice()}\nfunction average(ps){return mul(ps.reduce((a,p)=>add(a,p),[0,0,0]),1/ps.length)}\nfunction face(ps,color,normal,extra={}){\n const n=normal||unit(cross(sub(ps[1],ps[0]),sub(ps[2],ps[0])));\n const points=ps.map(world),center=average(points),nw=worldNormal(n);\n if(dot(nw,sub(camera.pos,center))<=0)return;\n polygons.push({points,center,normal:nw,color,depth:camera.distance-dot(center,camera.dir),...extra});\n}\nfunction outwardFace(ps,color,center,extra={}){\n let n=unit(cross(sub(ps[1],ps[0]),sub(ps[2],ps[0])));\n if(dot(n,sub(average(ps),center))<0)n=mul(n,-1);\n face(ps,color,n,extra);\n}\nfunction project(p){\n const z=camera.distance-dot(p,camera.dir),f=camera.scale*camera.distance/z;\n return [camera.cx+dot(p,camera.right)*f,camera.cy-dot(p,camera.up)*f,z];\n}\nfunction anchor(p){return project(world(p))}\nfunction roundedRing(w,d,r,y,segments=6){\n const out=[],hx=w/2,hz=d/2,centers=[[hx-r,hz-r],[-hx+r,hz-r],[-hx+r,-hz+r],[hx-r,-hz+r]];\n for(let c=0;c<4;c++)for(let j=0;j<=segments;j++){\n  const a=c*PI/2+j/segments*PI/2;\n  out.push([centers[c][0]+r*Math.cos(a),y,centers[c][1]+r*Math.sin(a)]);\n }\n return out;\n}\nfunction box(x,y,z,w,h,d,color,r=.08,b=.025){\n r=Math.min(r,w/2-.001,d/2-.001);b=Math.min(b,h/2-.001,r*.7);\n const rings=[roundedRing(w-2*b,d-2*b,Math.max(.006,r-b),y-h/2),roundedRing(w,d,r,y-h/2+b),roundedRing(w,d,r,y+h/2-b),roundedRing(w-2*b,d-2*b,Math.max(.006,r-b),y+h/2)];\n for(const ring of rings)for(const p of ring){p[0]+=x;p[2]+=z}\n const center=[x,y,z],n=rings[0].length;\n face(rings[0],color,[0,-1,0]);face(rings[3],color,[0,1,0]);\n for(let k=0;k<3;k++)for(let i=0;i<n;i++){\n  const j=(i+1)%n;\n  outwardFace([rings[k][i],rings[k][j],rings[k+1][j],rings[k+1][i]],color,center);\n }\n}\nfunction block(x,y,z,w,h,d,color){\n const X=w/2,Y=h/2,Z=d/2;\n const p=(a,b,c)=>[x+a*X,y+b*Y,z+c*Z];\n face([p(-1,-1,1),p(1,-1,1),p(1,1,1),p(-1,1,1)],color,[0,0,1]);\n face([p(1,-1,-1),p(-1,-1,-1),p(-1,1,-1),p(1,1,-1)],color,[0,0,-1]);\n face([p(1,-1,1),p(1,-1,-1),p(1,1,-1),p(1,1,1)],color,[1,0,0]);\n face([p(-1,-1,-1),p(-1,-1,1),p(-1,1,1),p(-1,1,-1)],color,[-1,0,0]);\n face([p(-1,1,1),p(1,1,1),p(1,1,-1),p(-1,1,-1)],color,[0,1,0]);\n face([p(-1,-1,-1),p(1,-1,-1),p(1,-1,1),p(-1,-1,1)],color,[0,-1,0]);\n}\nfunction shell(){\n const outer=[roundedRing(4.44,3.04,.18,-.8),roundedRing(4.6,3.2,.25,-.71),roundedRing(4.6,3.2,.25,.24)];\n const innerTop=roundedRing(4.31,2.91,.13,.24),innerBottom=roundedRing(4.31,2.91,.13,-.64),n=outer[0].length;\n for(let k=0;k<2;k++)for(let i=0;i<n;i++){\n  const j=(i+1)%n;outwardFace([outer[k][i],outer[k][j],outer[k+1][j],outer[k+1][i]],COLORS.body,[0,-.28,0]);\n }\n face(outer[0],COLORS.body,[0,-1,0]);face(innerBottom,COLORS.inside,[0,1,0]);\n for(let i=0;i<n;i++){\n  const j=(i+1)%n;\n  face([outer[2][i],outer[2][j],innerTop[j],innerTop[i]],COLORS.rim,[0,1,0]);\n  const middle=average([innerTop[i],innerTop[j]]),normal=unit([-middle[0],0,-middle[2]]);\n  face([innerTop[i],innerTop[j],innerBottom[j],innerBottom[i]],COLORS.inside,normal);\n }\n // Very restrained horizontal print lines, newly authored surface detail.\n for(let i=0;i<22;i++){\n  const y=-.69+i*.039;\n  face([[-2.02,y,1.601],[2.02,y,1.601],[2.02,y+.003,1.601],[-2.02,y+.003,1.601]],[112,130,136],[0,0,1],{opacity:.045});\n }\n}\nfunction cylinder(a,b,r,color,sides=12,r2=r){\n const axis=unit(sub(b,a)),helper=Math.abs(axis[1])>.9?[1,0,0]:[0,1,0],u=unit(cross(axis,helper)),v=cross(axis,u),A=[],B=[];\n for(let i=0;i<sides;i++){\n  const ang=i/sides*2*PI,rad=add(mul(u,Math.cos(ang)),mul(v,Math.sin(ang)));\n  A.push(add(a,mul(rad,r)));B.push(add(b,mul(rad,r2)));\n }\n face(A,color,mul(axis,-1));face(B,color,axis);\n for(let i=0;i<sides;i++){\n  const j=(i+1)%sides;\n  const n=unit(add(sub(A[i],a),sub(A[j],a)));\n  face([A[i],A[j],B[j],B[i]],color,n);\n }\n}\nfunction tube(points,r,color,sides=9){\n const rings=[];\n for(let i=0;i<points.length;i++){\n  const tangent=unit(sub(points[Math.min(i+1,points.length-1)],points[Math.max(0,i-1)]));\n  const ref=Math.abs(tangent[2])<.92?[0,0,1]:[0,1,0],u=unit(cross(tangent,ref)),v=cross(tangent,u);\n  rings.push(Array.from({length:sides},(_,j)=>add(points[i],mul(add(mul(u,Math.cos(j/sides*2*PI)),mul(v,Math.sin(j/sides*2*PI))),r))));\n }\n for(let k=0;k<rings.length-1;k++)for(let i=0;i<sides;i++){\n  const j=(i+1)%sides;\n  const n=unit(add(sub(rings[k][i],points[k]),sub(rings[k][j],points[k])));\n  face([rings[k][i],rings[k][j],rings[k+1][j],rings[k+1][i]],color,n,{specular:color===COLORS.red?24:30});\n }\n}\nfunction bezier(a,b,c,d,n=30){\n return Array.from({length:n+1},(_,i)=>{const t=i/n,s=1-t;return a.map((v,j)=>v*s*s*s+3*b[j]*s*s*t+3*c[j]*s*t*t+d[j]*t*t*t)});\n}\nfunction topTexture(){\n const c=document.createElement('canvas');c.width=1024;c.height=640;const g=c.getContext('2d');\n g.fillStyle='#182125';g.textBaseline='middle';g.textAlign='left';\n g.font='600 34px Arial,Helvetica,sans-serif';g.fillText('BATT A',105,75);\n g.font='600 34px Arial,Helvetica,sans-serif';g.fillText('A',163,200);g.fillText('B',163,426);\n g.textAlign='center';g.font='700 70px Arial,Helvetica,sans-serif';g.fillText('KOOKABUS-01',532,286);\n g.font='600 40px Arial,Helvetica,sans-serif';g.fillText('5S HOT-SWAP',533,352);\n g.font='600 34px Arial,Helvetica,sans-serif';g.fillText('BATT B',205,550);g.fillText('I2C',545,550);g.fillText('LOAD',827,550);\n return c;\n}\nfunction boardTexture(){\n const c=document.createElement('canvas');c.width=820;c.height=540;const g=c.getContext('2d');\n g.strokeStyle='rgba(82,112,71,.65)';g.lineWidth=3;\n for(let i=0;i<16;i++){\n  const x=50+i*46,y=65+(i%5)*77;\n  g.beginPath();g.moveTo(x,25);g.lineTo(x,y);g.lineTo(x+32,y+25);g.lineTo(x+32,510);g.stroke();\n }\n g.strokeStyle='rgba(202,207,154,.8)';g.lineWidth=2;\n for(let i=0;i<9;i++){g.beginPath();g.moveTo(25,45+i*57);g.lineTo(790,45+i*57);g.stroke()}\n g.fillStyle='#e1cd83';for(let i=0;i<38;i++)g.fillRect(35+(i*97)%748,40+(i*61)%455,9,9);\n return c;\n}\nconst lidInk=topTexture(),pcbInk=boardTexture();\nfunction textureFace(image,points){face(points,[255,255,255],[0,1,0],{texture:image})}\nfunction drawTriangle(img,s0,s1,s2,p0,p1,p2){\n const sx1=s1[0]-s0[0],sy1=s1[1]-s0[1],sx2=s2[0]-s0[0],sy2=s2[1]-s0[1],det=sx1*sy2-sx2*sy1;\n if(Math.abs(det)<1e-8)return;\n const px1=p1[0]-p0[0],py1=p1[1]-p0[1],px2=p2[0]-p0[0],py2=p2[1]-p0[1];\n const a=(px1*sy2-px2*sy1)/det,b=(py1*sy2-py2*sy1)/det,c=(px2*sx1-px1*sx2)/det,d=(py2*sx1-py1*sx2)/det;\n ctx.save();ctx.beginPath();ctx.moveTo(p0[0],p0[1]);ctx.lineTo(p1[0],p1[1]);ctx.lineTo(p2[0],p2[1]);ctx.closePath();ctx.clip();\n ctx.transform(a,b,c,d,p0[0]-a*s0[0]-c*s0[1],p0[1]-b*s0[0]-d*s0[1]);ctx.drawImage(img,0,0);ctx.restore();\n}\nfunction mappedTexture(image,points){\n const nx=8,ny=5;\n const get=(u,v)=>project(lerp3(lerp3(points[0],points[1],u),lerp3(points[3],points[2],u),v));\n for(let y=0;y<ny;y++)for(let x=0;x<nx;x++){\n  const u=x/nx,v=y/ny,U=(x+1)/nx,V=(y+1)/ny;\n  const a=get(u,v),b=get(U,v),c=get(U,V),d=get(u,V),A=[u*image.width,v*image.height],B=[U*image.width,v*image.height],C=[U*image.width,V*image.height],D=[u*image.width,V*image.height];\n  drawTriangle(image,A,B,C,a,b,c);drawTriangle(image,A,C,D,a,c,d);\n }\n}\nfunction renderGeometry(){\n polygons.sort((a,b)=>b.depth-a.depth);\n for(const f of polygons){\n  ctx.globalAlpha=f.opacity===undefined?1:f.opacity;\n  if(f.texture){mappedTexture(f.texture,f.points);continue}\n  const normal=unit(f.normal),view=unit(sub(camera.pos,f.center)),half=unit(add(light,view));\n  const diffuse=Math.max(0,dot(normal,light)),shine=Math.pow(Math.max(0,dot(normal,half)),30)*(f.specular===undefined?15:f.specular);\n  const shade=.36+.69*diffuse;\n  const col=f.color.map(v=>Math.round(Math.min(255,v*shade+shine)));\n  ctx.fillStyle='rgb('+col.join(',')+')';ctx.beginPath();\n  const ps=f.points.map(project);ctx.moveTo(ps[0][0],ps[0][1]);for(let i=1;i<ps.length;i++)ctx.lineTo(ps[i][0],ps[i][1]);ctx.closePath();ctx.fill();\n }\n ctx.globalAlpha=1;\n}\nfunction pcb(t){\n const lift=.48*(1-smooth(.43,1.2,t)),y=-.2+lift;\n box(0,y,0,4.14,.09,2.72,COLORS.pcb,.11,.015);\n textureFace(pcbInk,[[-2.01,y+.047,-1.29],[2.01,y+.047,-1.29],[2.01,y+.047,1.29],[-2.01,y+.047,1.29]]);\n // Four integral corner posts and board mounting pads.\n for(const x of [-1.87,1.87])for(const z of [-1.13,1.13]){\n  cylinder([x,-.63,z],[x,y+.065,z],.105,[47,57,58],12);\n  cylinder([x,y+.05,z],[x,y+.075,z],.13,[189,157,68],16);\n  cylinder([x,y+.075,z],[x,y+.08,z],.055,[36,46,40],12);\n }\n box(-.78,y+.23,.57,1.37,.38,.6,[215,154,54],.065,.025);\n box(-1.21,y+.16,-.19,.8,.26,.53,[223,163,65],.04,.015);\n box(-.69,y+.52,-.91,1.64,.86,.29,[232,170,32],.045,.015);\n for(let i=0;i<5;i