{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>KOOKABUS-01 Enclosure</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000}body{font-family:Arial,Helvetica,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden;background:#000}canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1280\" data-height=\"720\" data-duration=\"10\" data-fps=\"30\">\n<canvas id=\"film\" class=\"clip\" data-start=\"0\" data-duration=\"10\" width=\"1280\" height=\"720\" aria-label=\"KOOKABUS-01 enclosure assembly, connectors and DIN-rail mounting\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n/*\nIndependently authored sampled reconstruction; not recovered creator CAD/code.\nEditable procedural artwork. No reference images are used as output artwork.\nRuntime: 10 seconds, 1280 × 720, intended capture 30 fps, silent.\nDependency ledger: harness-provided local gsap.min.js only.\nAsset ledger: generated geometry and Canvas textures; generic system sans-serif.\nNo supplied font files are used.\n\nInferred reconstruction timing:\n0–1: reveal from black; populated board, elevated lid, four screws.\n1–2: lid descends and is seated by 2.000; heat-set insert annotation.\n2–3: four underside screws seat; enclosure closes; camera moves inward.\n3–4: centered product presentation; connector approach begins.\n4–5: two battery plugs and one load plug connect, each with two wires.\n5–6: static red A/yellow B indicators and paired Qwiic sockets; callouts.\n6–7: red mounting component and silver rail enter below the housing.\n7–8: oblique, visibly tilted mounting pose; optional clip annotation.\n8–9: inferred hook-and-snap settling into level rail-mounted presentation.\n9–10: left title lockup and illuminated product, readable at 9.850;\n        brief terminal fade interprets the untimed dark reference state.\n\nRevision notes:\nLid seating ends at 1.990. Camera poses and silhouette have been adjusted.\nFront wall has an actual procedural opening containing two separate sockets.\nRail geometry is subdivided for occlusion and kept below the red mount.\nEnding copy is taken from the supplied revision guidance.\nAll interpolation, dimensions and unobserved internal detail are inferred.\nThis source has not been rendered or visually reviewed.\n*/\n(() => {\n'use strict';\nconst W=1280,H=720,canvas=document.getElementById('film'),ctx=canvas.getContext('2d');\nconst PI=Math.PI;\nconst add=(a,b)=>a.map((v,i)=>v+b[i]);\nconst sub=(a,b)=>a.map((v,i)=>v-b[i]);\nconst mul=(a,k)=>a.map(v=>v*k);\nconst dot=(a,b)=>a[0]*b[0]+a[1]*b[1]+a[2]*b[2];\nconst cross=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];\nconst unit=a=>mul(a,1/(Math.hypot(...a)||1));\nconst mix=(a,b,t)=>a+(b-a)*t;\nconst clamp=x=>Math.max(0,Math.min(1,x));\nconst smooth=(a,b,t)=>{const u=clamp((t-a)/(b-a));return u*u*(3-2*u)};\nconst gate=(t,a,b,c,d)=>smooth(a,b,t)*(1-smooth(c,d,t));\nconst lerp3=(a,b,t)=>a.map((v,i)=>mix(v,b[i],t));\nconst COLORS={body:[39,48,51],lid:[65,76,81],inside:[18,27,29],rim:[52,63,67],yellow:[235,181,35],rib:[247,198,56],red:[184,8,19],black:[17,20,22],silver:[164,181,190],screw:[119,139,150],plate:[195,7,30],pcb:[160,177,144]};\nconst light=unit([-4,8,7]);\nlet polygons=[],camera,model={rx:0,rz:0,lift:0},useModel=true;\nfunction rotate(p){\n const cx=Math.cos(model.rx),sx=Math.sin(model.rx),cz=Math.cos(model.rz),sz=Math.sin(model.rz);\n const y=p[1]*cx-p[2]*sx,z=p[1]*sx+p[2]*cx;\n return [p[0]*cz-y*sz,p[0]*sz+y*cz,z];\n}\nfunction world(p){if(!useModel)return p.slice();const q=rotate(p);q[1]+=model.lift;return q}\nfunction worldNormal(n){return useModel?rotate(n):n.slice()}\nfunction average(ps){return mul(ps.reduce((a,p)=>add(a,p),[0,0,0]),1/ps.length)}\nfunction face(ps,color,normal,extra={}){\n const n=normal||unit(cross(sub(ps[1],ps[0]),sub(ps[2],ps[0])));\n const points=ps.map(world),center=average(points),nw=worldNormal(n);\n if(dot(nw,sub(camera.pos,center))<=0)return;\n polygons.push({points,center,normal:nw,color,depth:camera.distance-dot(center,camera.dir),...extra});\n}\nfunction outwardFace(ps,color,center,extra={}){\n let n=unit(cross(sub(ps[1],ps[0]),sub(ps[2],ps[0])));\n if(dot(n,sub(average(ps),center))<0)n=mul(n,-1);\n face(ps,color,n,extra);\n}\nfunction project(p){\n const z=camera.distance-dot(p,camera.dir),f=camera.scale*camera.distance/z;\n return [camera.cx+dot(p,camera.right)*f,camera.cy-dot(p,camera.up)*f,z];\n}\nfunction anchor(p){return project(world(p))}\nfunction roundedRing(w,d,r,y,segments=6){\n const out=[],hx=w/2,hz=d/2,centers=[[hx-r,hz-r],[-hx+r,hz-r],[-hx+r,-hz+r],[hx-r,-hz+r]];\n for(let c=0;c<4;c++)for(let j=0;j<=segments;j++){\n  const a=c*PI/2+j/segments*PI/2;\n  out.push([centers[c][0]+r*Math.cos(a),y,centers[c][1]+r*Math.sin(a)]);\n }\n return out;\n}\nfunction box(x,y,z,w,h,d,color,r=.08,b=.025){\n r=Math.max(.002,Math.min(r,w/2-.001,d/2-.001));b=Math.max(0,Math.min(b,h/2-.001,r*.7));\n const rings=[roundedRing(w-2*b,d-2*b,Math.max(.001,r-b),y-h/2),roundedRing(w,d,r,y-h/2+b),roundedRing(w,d,r,y+h/2-b),roundedRing(w-2*b,d-2*b,Math.max(.001,r-b),y+h/2)];\n for(const ring of rings)for(const p of ring){p[0]+=x;p[2]+=z}\n const center=[x,y,z],n=rings[0].length;\n face(rings[0],color,[0,-1,0]);face(rings[3],color,[0,1,0]);\n for(let k=0;k<3;k++)for(let i=0;i<n;i++){\n  const j=(i+1)%n;\n  outwardFace([rings[k][i],rings[k][j],rings[k+1][j],rings[k+1][i]],color,center);\n }\n}\nfunction block(x,y,z,w,h,d,color){\n const X=w/2,Y=h/2,Z=d/2,p=(a,b,c)=>[x+a*X,y+b*Y,z+c*Z];\n face([p(-1,-1,1),p(1,-1,1),p(1,1,1),p(-1,1,1)],color,[0,0,1]);\n face([p(1,-1,-1),p(-1,-1,-1),p(-1,1,-1),p(1,1,-1)],color,[0,0,-1]);\n face([p(1,-1,1),p(1,-1,-1),p(1,1,-1),p(1,1,1)],color,[1,0,0]);\n face([p(-1,-1,-1),p(-1,-1,1),p(-1,1,1),p(-1,1,-1)],color,[-1,0,0]);\n face([p(-1,1,1),p(1,1,1),p(1,1,-1),p(-1,1,-1)],color,[0,1,0]);\n face([p(-1,-1,-1),p(1,-1,-1),p(1,-1,1),p(-1,-1,1)],color,[0,-1,0]);\n}\nfunction frontRect(x0,x1,y0,y1,z,color,extra={}){\n face([[x0,y0,z],[x1,y0,z],[x1,y1,z],[x0,y1,z]],color,[0,0,1],extra);\n}\nfunction shell(){\n const outer=[roundedRing(4.44,3.04,.18,-.8),roundedRing(4.6,3.2,.25,-.71),roundedRing(4.6,3.2,.25,.24)];\n const innerTop=roundedRing(4.31,2.91,.13,.24),innerBottom=roundedRing(4.31,2.91,.13,-.64),n=outer[0].length;\n for(let k=0;k<2;k++)for(let i=0;i<n;i++){\n  const j=(i+1)%n;\n  // The straight front span is rebuilt around a real opening below.\n  if(i===6)continue;\n  outwardFace([outer[k][i],outer[k][j],outer[k+1][j],outer[k+1][i]],COLORS.body,[0,-.28,0]);\n }\n face(outer[0],COLORS.body,[0,-1,0]);face(innerBottom,COLORS.inside,[0,1,0]);\n for(let i=0;i<n;i++){\n  const j=(i+1)%n;\n  face([outer[2][i],outer[2][j],innerTop[j],innerTop[i]],COLORS.rim,[0,1,0]);\n  if(i===6)continue;\n  const middle=average([innerTop[i],innerTop[j]]),normal=unit([-middle[0],0,-middle[2]]);\n  face([innerTop[i],innerTop[j],innerBottom[j],innerBottom[i]],COLORS.inside,normal);\n }\n // Broad charcoal front face, four strips surrounding one shared recess.\n const z=1.6,L=-.66,R=.66,B=-.53,T=-.145;\n frontRect(-2.05,L,-.71,.24,z,COLORS.body);\n frontRect(R,2.05,-.71,.24,z,COLORS.body);\n frontRect(L,R,T,.24,z,COLORS.body);\n frontRect(L,R,-.71,B,z,COLORS.body);\n outwardFace([[-2.04,-.8,1.52],[2.04,-.8,1.52],[2.05,-.71,1.6],[-2.05,-.71,1.6]],COLORS.body,[0,-.3,0]);\n // Short bevels lead inward from the cutout, rather than painting sockets on the wall.\n face([[L,B,z],[R,B,z],[R-.035,B+.035,1.47],[L+.035,B+.035,1.47]],[55,66,65],[0,1,0]);\n face([[L,T,z],[L+.035,T-.035,1.47],[R-.035,T-.035,1.47],[R,T,z]],[12,20,21],[0,-1,0]);\n face([[L,B,z],[L+.035,B+.035,1.47],[L+.035,T-.035,1.47],[L,T,z]],[25,36,36],[1,0,0]);\n face([[R,B,z],[R,T,z],[R-.035,T-.035,1.47],[R-.035,B+.035,1.47]],[21,31,32],[-1,0,0]);\n // Subtle deterministic print lines avoid the opening.\n for(let i=0;i<22;i++){\n  const y=-.69+i*.039,extra={opacity:.035};\n  if(y>B&&y<T){frontRect(-2.02,L-.02,y,y+.002,1.601,[112,130,136],extra);frontRect(R+.02,2.02,y,y+.002,1.601,[112,130,136],extra)}\n  else frontRect(-2.02,2.02,y,y+.002,1.601,[112,130,136],extra);\n }\n}\nfunction cylinder(a,b,r,color,sides=12,r2=r){\n const axis=unit(sub(b,a)),helper=Math.abs(axis[1])>.9?[1,0,0]:[0,1,0],u=unit(cross(axis,helper)),v=cross(axis,u),A=[],B=[];\n for(let i=0;i<sides;i++){\n  const ang=i/sides*2*PI,rad=add(mul(u,Math.cos(ang)),mul(v,Math.sin(ang)));\n  A.push(add(a,mul(rad,r)));B.push(add(b,mul(rad,r2)));\n }\n face(A,color,mul(axis,-1));face(B,color,axis);\n for(let i=0;i<sides;i++){\n  const j=(i+1)%sides,n=unit(add(sub(A[i],a),sub(A[j],a)));\n  face([A[i],A[j],B[j],B[i]],color,n);\n }\n}\nfunction tube(points,r,color,sides=9){\n const rings=[];\n for(let i=0;i<points.length;i++){\n  const tangent=unit(sub(points[Math.min(i+1,points.length-1)],points[Math.max(0,i-1)]));\n  const ref=Math.abs(tangent[2])<.92?[0,0,1]:[0,1,0],u=unit(cross(tangent,ref)),v=cross(tangent,u);\n  rings.push(Array.from({length:sides},(_,j)=>add(points[i],mul(add(mul(u,Math.cos(j/sides*2*PI)),mul(v,Math.sin(j/sides*2*PI))),r))));\n }\n for(let k=0;k<rings.length-1;k++)for(let i=0;i<sides;i++){\n  const j=(i+1)%sides,n=unit(add(sub(rings[k][i],points[k]),sub(rings[k][j],points[k])));\n  face([rings[k][i],rings[k][j],rings[k+1][j],rings[k+1][i]],color,n,{specular:color===COLORS.red?24:30});\n }\n}\nfunction bezier(a,b,c,d,n=30){\n return Array.from({length:n+1},(_,i)=>{const t=i/n,s=1-t;return a.map((v,j)=>v*s*s*s+3*b[j]*s*s*t+3*c[j]*s*t*t+d[j]*t*t*t)});\n}\nfunction topTexture(){\n const c=document.createElement('canvas');c.width=1024;c.height=640;const g=c.getContext('2d');\n g.fillStyle='#1b2529';g.textBaseline='middle';g.textAlign='left';\n g.font='600 34px Arial,Helvetica,sans-serif';g.fillText('BATT A',105,75);g.fillText('A',163,200);g.fillText('B',163,426);\n g.textAlign='center';g.font='700 70px Arial,Helvetica,sans-serif';g.fillText('KOOKABUS-01',532,286);\n g.font='600 40px Arial,Helvetica,sans-serif';g.fillText('5S HOT-SWAP',533,352);\n g.font='600 34px Arial,Helvetica,sans-serif';g.fillText('BATT B',205,550);g.fillText('I2C',545,550);g.fillText('LOAD',827,550);\n return c;\n}\nfunction boardTexture(){\n const c=document.createElement('canvas');c.width=820;c.height=540;const g=c.getContext('2d');\n g.strokeStyle='rgba(82,112,71,.65)';g.lineWidth=3;\n for(let i=0;i<16;i++){\n  const x=50+i*46,y=65+(i%5)*77;\n  g.beginPath();g.moveTo(x,25);g.lineTo(x,y);g.lineTo(x+32,y+25);g.lineTo(x+32,510);g.stroke();\n }\n g.strokeStyle='rgba(202,207,154,.8)';g.lineWidth=2;\n for(let i=0;i<9;i++){g.beginPath();g.moveTo(25,45+i*57);g.lineTo(790,45+i*57);g.stroke()}\n g.fillStyle='#e1cd83';for(let i=0;i<38;i++)g.fillRect(35+(i*97)%748,40+(i*61)%455,9,9);\n return c;\n}\nconst lidInk=topTexture(),pcbInk=boardTexture();\nfunction textureFace(image,points){face(points,[255,255,255],[0,1,0],{texture:image})}\nfunction drawTriangle(img,s0,s1,s2,p0,p1,p2){\n const sx1=s1[0]-s0[0],sy1=s1[1]-s0[1],sx2=s2[0]-s0[0],sy2=s2[1]-s0[1],det=sx1*sy2-sx2*sy1;\n if(Math.abs(det)<1e-8)return;\n const px1=p1[0]-p0[0],py1=p1[1]-p0[1],px2=p2[0]-p0[0],py2=p2[1]-p0[1];\n const a=(px1*sy2-px2*sy1)/det,b=(py1*sy2-py2*sy1)/det,c=(px2*sx1-px1*sx2)/det,d=(py2*sx1-py1*sx2)/det;\n ctx.save();ctx.beginPath();ctx.moveTo(p0[0],p0[1]);ctx.lineTo(p1[0],p1[1]);ctx.lineTo(p2[0],p2[1]);ctx.closePath();ctx.clip();\n ctx.transform(a,b,c,d,p0[0]-a*s0[0]-c*s0[1],p0[1]-b*s0[0]-d*s0[1]);ctx.drawImage(img,0,0);ctx.restore();\n}\nfunction mappedTexture(image,points){\n const nx=8,ny=5;\n const get=(u,v)=>project(lerp3(lerp3(points[0],points[1],u),lerp3(points[3],points[2],u),v));\n for(let y=0;y<ny;y++)for(let x=0;x<nx;x++){\n  const u=x/nx,v=y/ny,U=(x+1)/nx,V=(y+1)/ny;\n  const a=get(u,v),b=get(U,