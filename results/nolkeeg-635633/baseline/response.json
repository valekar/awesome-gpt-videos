{
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AFTERIMAGE</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#080a0d}body{font-family:Arial,Helvetica,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden;background:#080a0d}canvas{position:absolute;inset:0;width:100%;height:100%;display:block}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"24\">\n<canvas id=\"art\" class=\"clip\" data-start=\"0\" data-duration=\"24\" width=\"1920\" height=\"1080\" aria-label=\"Afterimage: a metallic knot bends, fractures, becomes typography, and reforms.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n(() => {\n'use strict';\n// EDITABLE ART DIRECTION\nconst DESIGN={duration:24,width:1920,height:1080,orange:'#ff641f',cream:'#f1eee5',background:'#080a0d',segments:216,sides:14};\nconst canvas=document.getElementById('art');\nconst ctx=canvas.getContext('2d');\nconst W=DESIGN.width,H=DESIGN.height,PI=Math.PI,TAU=PI*2;\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst mix=(a,b,t)=>a+(b-a)*t;\nconst smooth=(a,b,t)=>{const x=clamp((t-a)/(b-a));return x*x*(3-2*x)};\nconst envelope=(t,a,b,inTime=.45,outTime=.45)=>smooth(a,a+inTime,t)*(1-smooth(b-outTime,b,t));\nconst hash=n=>{const v=Math.sin(n*127.1+311.7)*43758.5453123;return v-Math.floor(v)};\nconst norm=a=>{const l=Math.hypot(...a)||1;return a.map(v=>v/l)};\nconst cross=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];\nconst dot=(a,b)=>a[0]*b[0]+a[1]*b[1]+a[2]*b[2];\nconst font=s=>`900 ${s}px Arial, Helvetica, sans-serif`;\n\n// Static, reproducible grain and glyph targets. No external artwork or fonts.\nconst grain=document.createElement('canvas');grain.width=192;grain.height=108;\nconst gc=grain.getContext('2d');const noise=gc.createImageData(192,108);\nfor(let i=0;i<noise.data.length;i+=4){const v=Math.floor(hash(i/4)*255);noise.data[i]=v;noise.data[i+1]=v;noise.data[i+2]=v;noise.data[i+3]=255}gc.putImageData(noise,0,0);\nconst mask=document.createElement('canvas');mask.width=W;mask.height=H;\nconst mc=mask.getContext('2d',{willReadFrequently:true});\nfunction becomeType(c){c.save();c.translate(960,650);c.scale(1.15,1);c.font=font(260);c.textAlign='center';c.fillText('BECOME',0,0);c.restore()}\nmc.fillStyle='#fff';becomeType(mc);\nconst bitmap=mc.getImageData(0,0,W,H).data;\nconst targets=[];\nfor(let y=410;y<665;y+=9)for(let x=190;x<1730;x+=9)if(bitmap[(y*W+x)*4+3]>160)targets.push({x,y,id:targets.length});\n\nfunction rotate(v,ax,ay,az){\n let [x,y,z]=v;let c=Math.cos(ax),s=Math.sin(ax);[y,z]=[y*c-z*s,y*s+z*c];\n c=Math.cos(ay);s=Math.sin(ay);[x,z]=[x*c+z*s,-x*s+z*c];\n c=Math.cos(az);s=Math.sin(az);return[x*c-y*s,x*s+y*c,z];\n}\nfunction background(t){\n ctx.fillStyle=DESIGN.background;ctx.fillRect(0,0,W,H);\n const climax=envelope(t,8.8,16,1.2,1.7);\n const cx=mix(1110,1390,smooth(20,22,t));\n const halo=ctx.createRadialGradient(cx,510,0,cx,510,900);\n halo.addColorStop(0,`rgba(66,82,105,${.21-climax*.08})`);\n halo.addColorStop(.46,'rgba(19,28,42,.15)');halo.addColorStop(1,'rgba(0,0,0,0)');\n ctx.fillStyle=halo;ctx.fillRect(0,0,W,H);\n const amber=ctx.createRadialGradient(960,600,0,960,600,750);\n amber.addColorStop(0,`rgba(180,49,7,${.035+climax*.15})`);amber.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=amber;ctx.fillRect(0,0,W,H);\n ctx.save();ctx.globalAlpha=.17;\n for(let i=0;i<92;i++){\n  const x=hash(i+20)*W,y=hash(i+250)*H,r=.6+hash(i+500)*1.2;\n  ctx.fillStyle=i%6===0?DESIGN.orange:'#8192a5';ctx.fillRect(x,y,r,r);\n }\n ctx.restore();\n // Moving ellipses establish a continuous orbital space through every scene.\n ctx.save();ctx.translate(cx,550);ctx.rotate(-.35+.12*Math.sin(t*.25));\n const orbitAlpha=.13+envelope(t,5,12)*.12;\n for(let i=0;i<5;i++){\n  ctx.beginPath();ctx.ellipse(0,0,450+i*113,160+i*39,0,0,TAU);\n  ctx.strokeStyle=i===1?`rgba(255,100,31,${orbitAlpha})`:`rgba(116,140,162,${orbitAlpha*.38})`;\n  ctx.lineWidth=1;ctx.stroke();\n }\n ctx.restore();\n // Perspective streaks surge through the fracture instead of cutting scenes.\n const warp=envelope(t,10.3,15.8,.8,1.4);\n if(warp>0){ctx.save();ctx.globalAlpha=warp;\n  for(let i=0;i<100;i++){\n   const a=hash(i+40)*TAU,r=110+((hash(i+80)+t*.31)%1)**2*1300;\n   const len=(25+r*.18)*(1+warp),xx=Math.cos(a),yy=Math.sin(a)*.67;\n   const g=ctx.createLinearGradient(960+xx*r,540+yy*r,960+xx*(r+len),540+yy*(r+len));\n   g.addColorStop(0,'rgba(255,100,31,0)');g.addColorStop(1,i%4===0?'rgba(255,121,65,.7)':'rgba(173,195,215,.26)');\n   ctx.strokeStyle=g;ctx.lineWidth=i%9===0?2:1;ctx.beginPath();ctx.moveTo(960+xx*r,540+yy*r);ctx.lineTo(960+xx*(r+len),540+yy*(r+len));ctx.stroke();\n  }ctx.restore();\n }\n}\nfunction intro(t){\n const a=envelope(t,.45,4.5,.7,.6);if(a<=0)return;\n ctx.save();ctx.globalAlpha=a;ctx.translate(120,0);\n for(let line=0;line<2;line++){\n  const word=line?'IMPULSE.':'ONE';const start=.55+line*.13;\n  let x=0;ctx.font=font(112);ctx.textAlign='left';ctx.fillStyle=DESIGN.cream;\n  for(let i=0;i<word.length;i++){\n   const p=smooth(start+i*.035,start+.6+i*.035,t);\n   ctx.save();ctx.translate(x,231+line*116+(1-p)*90);ctx.scale(1,.25+.75*p);ctx.globalAlpha=a*p;ctx.fillText(word[i],0,0);ctx.restore();\n   x+=ctx.measureText(word[i]).width-4;\n  }\n }\n ctx.globalAlpha=a;ctx.fillStyle=DESIGN.orange;ctx.fillRect(0,392,410*smooth(.9,1.7,t),5);ctx.restore();\n}\nfunction kinetic(word,t,start,end,size,y){\n const a=envelope(t,start,end,.65,.65);if(a<=0)return;\n ctx.save();ctx.font=font(size);ctx.textAlign='left';\n const widths=[...word].map(c=>ctx.measureText(c).width-13);let x=(W-widths.reduce((s,v)=>s+v,0))/2;\n for(let i=0;i<word.length;i++){\n  const enter=smooth(start+i*.075,start+.65+i*.075,t);\n  const leave=smooth(end-.65+i*.035,end+i*.035,t);\n  const bend=Math.sin(i*.9+t*1.4)*19*a;\n  ctx.save();ctx.translate(x,y+(1-enter)*260-leave*180+bend);ctx.transform(1,0,.16*(1-enter)-.08*leave,1,0,0);\n  ctx.scale(1,.2+.8*enter);ctx.globalAlpha=a*enter*.88;\n  ctx.fillStyle=DESIGN.cream;ctx.fillText(word[i],0,0);ctx.restore();x+=widths[i];\n }\n ctx.restore();\n}\nfunction fractureType(t){\n const a=envelope(t,8.5,12.1,.55,.65);if(a<=0)return;\n const split=smooth(9,11.9,t);ctx.save();ctx.font=font(335);ctx.textAlign='center';\n for(let i=0;i<18;i++){\n  const yy=355+i*23;const shift=Math.sin(i*2.35+t*2.6)*split*(40+i*7);\n  ctx.save();ctx.beginPath();ctx.rect(0,yy,W,22);ctx.clip();\n  ctx.globalAlpha=a*.9;ctx.fillStyle=i%5===0?DESIGN.orange:DESIGN.cream;\n  ctx.fillText('BREAK',960+shift,718+(i%2?1:-1)*split*8);ctx.restore();\n }ctx.restore();\n}\nfunction curve(u,m){\n // A torus knot gradually opens into a spherical winding.\n const r=.78+.29*Math.cos(3*u);\n const knot=[r*Math.cos(2*u),r*Math.sin(2*u),.33*Math.sin(3*u)];\n const sphere=[Math.cos(u)*Math.cos(3*u)*1.05,Math.sin(u)*1.05,Math.cos(u)*Math.sin(3*u)*1.05];\n return knot.map((v,i)=>mix(v,sphere[i],m));\n}\nfunction sculpture(t){\n const exit=1-smooth(13.1,15.9,t),reenter=smooth(20,21.5,t);\n const alpha=Math.max(exit,reenter)*smooth(.05,1.2,t);if(alpha<.001)return;\n const final=smooth(19.8,21.8,t);\n const opening=smooth(0,2.4,t);\n const shape=smooth(4.5,7.8,t)*(1-smooth(20,22,t));\n const blast=smooth(8.9,11.7,t)*(1-smooth(19,21.5,t));\n const scale=mix(mix(100,390,opening),300,final)*(1+.07*Math.sin(t*1.2)*(1-final));\n const centerX=mix(mix(1230,960,smooth(3.2,5.6,t)),1385,final);\n const centerY=mix(566,535,final);\n const ax=.38+Math.sin(t*.39)*.3,ay=t*.36+.25*Math.sin(t*.3),az=-.25+.26*Math.sin(t*.51);\n const tube=mix(.009,.148,smooth(.5,2.2,t));\n const light=norm([-.5,-.8,-.6]);\n const project=v=>{const d=4.6/(4.6+v[2]);return{x:centerX+v[0]*scale*d,y:centerY+v[1]*scale*d,z:v[2],d}};\n const ring=[];const normals=[];\n for(let i=0;i<=DESIGN.segments;i++){\n  const u=i/DESIGN.segments*TAU;\n  const p=curve(u,shape),next=curve(u+.001,shape),prev=curve(u-.001,shape);\n  const tangent=norm(next.map((v,k)=>v-prev[k]));\n  const n=norm(cross(tangent,[0,0,1])),b=norm(cross(tangent,n));\n  const sector=Math.floor((i%DESIGN.segments)/12),ba=sector*2.399963;\n  const push=blast*(.3+hash(sector+22)*1.2);\n  const displacement=[Math.cos(ba)*push,Math.sin(ba)*push,Math.sin(ba*1.7)*push*1.3];\n  const row=[],nr=[];\n  for(let j=0;j<=DESIGN.sides;j++){\n   const v=j/DESIGN.sides*TAU+u*.55;\n   const normal=n.map((x,k)=>x*Math.cos(v)+b[k]*Math.sin(v));\n   const breathing=1+.045*Math.sin(u*9-t*2);\n   let pos=p.map((x,k)=>x+normal[k]*tube*breathing+displacement[k]);\n   pos=rotate(pos,ax,ay,az);row.push(project(pos));nr.push(rotate(normal,ax,ay,az));\n  }ring.push(row);normals.push(nr);\n }\n const faces=[];\n for(let i=0;i<DESIGN.segments;i++){\n  if(blast>.03&&i%12===11)continue;\n  for(let j=0;j<DESIGN.sides;j++){\n   const pts=[ring[i][j],ring[i+1][j],ring[i+1][j+1],ring[i][j+1]];\n   const n=normals[i][j];\n   const diffuse=Math.max(0,dot(n,light));\n   const reflection=Math.pow(.5+.5*Math.sin(n[0]*7+n[1]*4+n[2]*2),13);\n   const rim=Math.pow(1-Math.abs(n[2]),3);\n   const spec=Math.pow(diffuse,18);\n   const lum=clamp(.085+diffuse*.28+reflection*.65+spec*.9+rim*.2);\n   const copper=j>=10&&j<=12;\n   let color;\n   if(copper){const v=.28+lum*.72;color=`rgb(${Math.round(255*v)},${Math.round(39+126*lum)},${Math.round(13+73*lum)})`}\n   else{const v=Math.round(21+222*lum);color=`rgb(${v},${Math.min(255,v+5)},${Math.min(255,v+12)})`}\n   faces.push({pts,z:pts.reduce((s,p)=>s+p.z,0)/4,color,glint:spec});\n  }\n }\n faces.sort((a,b)=>b.z-a.z);\n ctx.save();ctx.globalAlpha=alpha;\n const shadow=ctx.createRadialGradient(centerX,890,5,centerX,890,470);\n shadow.addColorStop(0,'rgba(0,0,0,.55)');shadow.addColorStop(1,'rgba(0,0,0,0)');\n ctx.save();ctx.translate(0,730);ctx.scale(1,.18);ctx.fillStyle=shadow;ctx.fillRect(centerX-500,300,1000,1000);ctx.restore();\n for(const f of faces){ctx.beginPath();f.pts.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.closePath();ctx.fillStyle=f.color;ctx.fill();ctx.strokeStyle=f.color;ctx.lineWidth=.55;ctx.stroke()}\n // A moving filament traces the knot, then tears apart with its surface.\n ctx.globalCompositeOperation='screen';ctx.lineWidth=2;\n for(let i=0;i<DESIGN.segments;i++){\n  const hot=Math.pow(.5+.5*Math.cos(i/DESIGN.segments*TAU-t*2.1),28);\n  if(hot<.04||(blast>.03&&i%12===11))continue;\n  const a=ring[i][11],b=ring[i+1][11];ctx.strokeStyle=`rgba(255,164,88,${hot*.9})`;\n  ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();\n }\n ctx.restore();\n}\nfunction impulse(t){\n const a=envelope(t,0,2.1,.14,.65);if(a<=0)return;\n ctx.save();ctx.globalCompositeOperation='screen';\n const x=1230,y=566,r=95+60*smooth(0,1.6,t);\n for(let i=55;i>=0;i--){\n  const angle=t*4.2-i*.026,px=x+Math.cos(angle)*r,py=y+Math.sin(angle)*r*.54;\n  const fade=(1-i/56)*a;ctx.globalAlpha=fade;ctx.fillStyle=i===0?DESIGN.cream:DESIGN.orange;\n  ctx.beginPath();ctx.arc(px,py,i===0?7:2.5,0,TAU);ctx.fill();\n }\n ctx.restore();\n}\nfunction shockwaves(t){\n ctx.save();ctx.globalCompositeOperation='screen';\n for(let i=0;i<3;i++){\n  const p=clamp((t-(9.35+i*.28))/1.8);if(p<=0||p>=1)continue;\n  ctx.save();ctx.translate(960,540);ctx.rotate(-.3);ctx.scale(1,.64);\n  ctx.strokeStyle=`rgba(255,111,49,${(1-p)**2*.7})`;ctx.lineWidth=3*(1-p)+.5;\n  ctx.beginPath();ctx.arc(0,0,90+1250*(1-(1-p)**3),0,TAU);ctx.stroke();ctx.restore();\n }ctx.restore();\n}\nfunction become(t){\n const appear=smooth(12.1,13,t),gone=1-smooth(20.5,21.3,t);if(appear*gone<=0)return;\n const solid=envelope(t,16.4,20.05,.75,.55);\n if(solid>0){\n  ctx.save();ctx.globalAlpha=solid;\n  for(let i=12;i>0;i--){ctx.save();ctx.translate(i*.85,i*1.3);ctx.fillStyle=i>7?'#63250f':'#d54b18';becomeType(ctx);ctx.restore()}\n  ctx.fillStyle=DESIGN.cream;becomeType(ctx);\n  ctx.save();ctx.globalCompositeOperation='source-atop';ctx.restore();\n  ctx.restore();\n }\n ctx.save();ctx.globalCompositeOperation='screen';\n for(const p of targets){\n  const h=hash(p.id+12),a=hash(p.id+800)*TAU+t*.24;\n  const radial=180+hash(p.id+1400)*570;\n  const fromX=960+Math.cos(a)*radial,fromY=540+Math.sin(a*1.27)*radial*.68;\n  const form=smooth(12.75+h*.7,16.1+h*.7,t);\n  const release=smooth(19.45+h*.35,21.1+h*.25,t);\n  const bend=Math.sin(p.x*.007+t*2.3)*(1-form)*90;\n  let x=mix(fromX,p.x,form),y=mix(fromY,p.y+bend,form);\n  const toX=1385+Math.cos(a*3+t)*75*(1-release),toY=535+Math.sin(a*3+t)*75*(1-release);\n  x=mix(x,toX,release);y=mix(y,toY,release);\n  const alpha=appear*gone*(1-solid*.72)*(.45+h*.55);\n  ctx.globalAlpha=alpha;ctx.fillStyle=p.id%5===0?DESIGN.orange:DESIGN.cream;\n  const sz=(1.8+h*2.4)*(1+Math.sin(form*PI)*.4);\n  if(form>.07&&form<.94){\n   ctx.strokeStyle=p.id%5===0?'#ff641f':'#b9c8d7';ctx.lineWidth=1;\n   ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+(fromX-p.x)*.024*Math.sin(form*PI),y+(fromY-p.y)*.024*Math.sin(form*PI));ctx.stroke();\n  }\n  ctx.fillRect(x-sz/2,y-sz/2,sz,sz);\n }\n // A narrow highlight travels across the reconstructed letterforms.\n if(solid>.1){\n  ctx.save();ctx.globalAlpha=solid*.55;\n  const sweep=260+smooth(17,19.1,t)*1450;\n  ctx.beginPath();ctx.rect(sweep-8,370,16,320);ctx.clip();ctx.fillStyle='#fff';becomeType(ctx);ctx.restore();\n }\n ctx.restore();\n}\nfunction finalTitle(t){\n const a=smooth(20.2,21.4,t);if(a<=0)return;\n ctx.save();ctx.font=font(190);ctx.textAlign='left';\n const lines=['AFTER','IMAGE'];\n for(let l=0;l<2;l++){\n  let x=120;\n  for(let i=0;i<lines[l].length;i++){\n   const p=smooth(20.25+l*.12+i*.055,21.1+l*.12+i*.055,t);\n   ctx.save();ctx.globalAlpha=p;ctx.translate(x,495+l*189+(1-p)*90);ctx.scale(1,.5+.5*p);\n   ctx.fillStyle=l===0?DESIGN.cream:DESIGN.orange;ctx.fillText(lines[l][i],0,0);ctx.restore();\n   x+=ctx.measureText(lines[l][i]).width-9;\n  }\n }\n // The underline expands from the title and becomes the sculpture's orbit.\n ctx.globalAlpha=a*.7;ctx.fillStyle=DESIGN.cream;ctx.fillRect(127,734,425*smooth(21,22,t),3);ctx.restore();\n}\nfunction finish(t){\n ctx.save();ctx.globalAlpha=.024;ctx.drawImage(grain,0,0,W,H);ctx.restore();\n const vignette=ctx.createRadialGradient(960,540,370,960,540,1150);\n vignette.addColorStop(0,'rgba(0,0,0,0)');vignette.addColorStop(1,'rgba(0,0,0,.55)');ctx.fillStyle=vignette;ctx.fillRect(0,0,W,H);\n const fade=smooth(23.55,24,t);if(fade){ctx.fillStyle=`rgba(8,10,13,${fade})`;ctx.fillRect(0,0,W,H)}\n}\nfunction draw(t){\n ctx.setTransform(1,0,0,1,0,0);ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';\n background(t);\n intro(t);\n kinetic('BEND',t,4.15,8.8,370,723);\n fractureType(t);\n shockwaves(t);\n sculpture(t);\n impulse(t);\n become(t);\n finalTitle(t);\n finish(t);\n}\nconst playhead={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{t:DESIGN.duration,duration:DESIGN.duration,ease:'none',onUpdate:()=>draw(playhead.t)},0);\ndraw(0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\n})();\n</script>\n</body>\n</html>",
