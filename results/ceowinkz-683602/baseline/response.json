{
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Winkz Enterprises — Wholesale Partnership</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#11131b}body{font-family:Arial,Helvetica,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden;background:#11131b;color:#f6f4ec;isolation:isolate;--lime:#d8ff5f;--paper:#f6f4ec;--orange:#ff784f}.clip{position:absolute;inset:0;width:100%;height:100%}.scene{padding:82px 108px;opacity:0}.brand{display:flex;align-items:center;gap:20px;font-size:31px;font-weight:700;letter-spacing:-1px}.mark{width:58px;height:58px;flex:none}.eyebrow{font-size:25px;letter-spacing:3px;text-transform:uppercase;font-weight:700}.mask{overflow:hidden;padding-bottom:12px}.line{display:block}h1,h2,p{margin:0}h1,h2{letter-spacing:-8px;font-weight:800;line-height:.98}.lime{color:var(--lime)}.background{overflow:hidden}.grid{position:absolute;inset:-160px;background-image:linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);background-size:120px 120px;transform:rotate(-12deg);opacity:.7}.orbital{position:absolute;right:-390px;top:-390px;width:1250px;height:1250px;border:2px solid #d8ff5f30;border-radius:50%}.orbital:before,.orbital:after{content:'';position:absolute;border:2px solid #d8ff5f20;inset:100px;border-radius:50%}.orbital:after{inset:200px}.orbital-dot{position:absolute;left:174px;top:174px;width:32px;height:32px;border-radius:50%;background:var(--lime)}.wash{position:absolute;width:700px;height:700px;right:-80px;bottom:-400px;border-radius:50%;background:#ff784f12;filter:blur(60px)}#s1{opacity:1}.hero-copy{position:absolute;left:108px;top:290px;z-index:2}.hero-copy h1{font-size:151px}.hero-sub{font-size:35px;margin-top:36px;letter-spacing:-.8px;color:#c0c1c8}.hero-art{position:absolute;width:570px;height:570px;right:83px;top:252px;transform-style:preserve-3d}.hero-tile{position:absolute;inset:28px;border-radius:64px;box-shadow:0 35px 90px #0005}.hero-tile.back{background:var(--orange);transform:translate(35px,30px) rotate(13deg)}.hero-tile.front{background:var(--lime);display:grid;place-items:center;transform:rotate(-8deg);border:2px solid #ffffff50}.hero-tile svg{width:330px;height:330px}.small-ring{position:absolute;right:42px;top:-30px;width:126px;height:126px;border:24px solid var(--paper);border-radius:50%}.hero-rule{position:absolute;left:110px;bottom:111px;width:650px;height:3px;background:#ffffff20;transform-origin:left}.hero-rule:after{content:'';position:absolute;left:0;top:0;height:3px;width:145px;background:var(--lime)}#s2{background:var(--paper);color:#11131b}.section-top{display:flex;justify-content:space-between;align-items:center}.section-top .eyebrow{color:#62635e;font-size:24px;letter-spacing:2px}.s2-title{position:absolute;top:244px;left:108px;font-size:115px;max-width:1600px}.cards{position:absolute;left:108px;right:108px;top:521px;display:grid;grid-template-columns:repeat(3,1fr);gap:25px;perspective:1500px}.card{height:351px;border:2px solid #11131b;border-radius:28px;padding:33px 34px;background:#eeece4;transform-origin:50% 100%;position:relative;overflow:hidden}.card:nth-child(2){background:#d8ff5f}.card:nth-child(3){background:#11131b;color:#f6f4ec}.card-icon{width:74px;height:74px;margin-bottom:42px}.card h3{font-size:41px;line-height:1.05;letter-spacing:-1.7px;margin:0 0 17px}.card p{font-size:29px;line-height:1.2;opacity:.72;letter-spacing:-.6px}.card .corner{position:absolute;right:27px;top:24px;font-size:34px;opacity:.5}.s2-foot{position:absolute;bottom:89px;left:110px;font-size:27px;color:#62635e}#s3{background:#11131b}.s3-title{position:absolute;top:235px;left:108px;font-size:116px;max-width:1600px}.process{position:absolute;left:108px;right:108px;top:583px;height:280px}.connector{position:absolute;left:50px;right:50px;top:56px;height:3px;background:#ffffff22}.connector-fill{height:100%;width:100%;background:var(--lime);transform:scaleX(0);transform-origin:left}.steps{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:72px}.step-number{width:116px;height:116px;display:grid;place-items:center;border-radius:50%;background:#11131b;border:3px solid var(--lime);font-size:36px;font-weight:700;color:var(--lime)}.step h3{font-size:56px;letter-spacing:-2.8px;margin:28px 0 13px}.step p{font-size:29px;color:#b7b9c3;line-height:1.25}.step:last-child .step-number{background:var(--lime);color:#11131b}.arrowhead{position:absolute;right:0;top:36px;color:var(--lime);font-size:50px;line-height:1}.portal{position:absolute;left:960px;top:540px;width:10px;height:10px;margin:-5px;border-radius:50%;background:var(--lime);transform:scale(0)}#s4{background:var(--lime);color:#11131b}.final-heading{position:absolute;left:108px;top:266px;font-size:169px;letter-spacing:-9px;line-height:.94}.final-bottom{position:absolute;left:110px;right:110px;bottom:112px;display:flex;align-items:center;justify-content:space-between;gap:40px}.final-sub{font-size:36px;line-height:1.25;letter-spacing:-1px;max-width:1000px}.cta-icon{width:150px;height:150px;border:3px solid #11131b;border-radius:50%;display:grid;place-items:center;flex:none}.cta-icon svg{width:77px;height:77px}.final-arc{position:absolute;right:-255px;top:220px;width:800px;height:800px;border:70px solid #11131b;border-radius:50%;opacity:.065}.final-line{position:absolute;left:110px;right:110px;bottom:300px;height:3px;background:#11131b;transform-origin:left}.final-brand{font-size:37px;gap:24px}.final-brand .mark{width:69px;height:69px}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"15\">\n <div class=\"clip background\" data-start=\"0\" data-duration=\"15\" aria-hidden=\"true\">\n  <div class=\"grid\"></div><div class=\"orbital\"><div class=\"orbital-dot\"></div></div><div class=\"wash\"></div>\n </div>\n <section id=\"s1\" class=\"clip scene\" data-start=\"0\" data-duration=\"15\">\n  <div class=\"brand intro-brand\"><svg class=\"mark\" viewBox=\"0 0 64 64\" aria-hidden=\"true\"><rect width=\"64\" height=\"64\" rx=\"16\" fill=\"#d8ff5f\"/><path d=\"M12 20l9 25h8l5-14 5 14h8l7-25H43l-3 14-5-14h-6l-5 14-3-14z\" fill=\"#11131b\"/></svg><span>Winkz Enterprises</span></div>\n  <div class=\"hero-copy\"><h1><div class=\"mask\"><span class=\"line hero-line\">Your brand.</span></div><div class=\"mask\"><span class=\"line hero-line lime\">Our next</span></div><div class=\"mask\"><span class=\"line hero-line lime\">partnership.</span></div></h1><p class=\"hero-sub\">Let’s talk Amazon wholesale.</p></div>\n  <div class=\"hero-art\" aria-hidden=\"true\"><div class=\"hero-tile back\"></div><div class=\"hero-tile front\"><svg viewBox=\"0 0 300 300\"><path d=\"M26 79l47 141h42l34-84 34 84h43l49-141h-54l-22 80-30-80h-39l-31 80-22-80z\" fill=\"#11131b\"/></svg></div><div class=\"small-ring\"></div></div>\n  <div class=\"hero-rule\" aria-hidden=\"true\"></div>\n </section>\n <section id=\"s2\" class=\"clip scene\" data-start=\"0\" data-duration=\"15\">\n  <div class=\"section-top\"><div class=\"brand\"><svg class=\"mark\" viewBox=\"0 0 64 64\" aria-hidden=\"true\"><rect width=\"64\" height=\"64\" rx=\"16\" fill=\"#11131b\"/><path d=\"M12 20l9 25h8l5-14 5 14h8l7-25H43l-3 14-5-14h-6l-5 14-3-14z\" fill=\"#d8ff5f\"/></svg><span>Winkz Enterprises</span></div><span class=\"eyebrow\">A proposed partnership</span></div>\n  <h2 class=\"s2-title\">Your brand comes first.</h2>\n  <div class=\"cards\">\n   <article class=\"card\"><span class=\"corner\">↗</span><svg class=\"card-icon\" viewBox=\"0 0 80 80\" fill=\"none\" aria-hidden=\"true\"><path d=\"M40 7l26 10v22c0 16-13 27-26 34C27 66 14 55 14 39V17L40 7z\" stroke=\"currentColor\" stroke-width=\"4\"/><path d=\"M27 39l9 9 19-21\" stroke=\"currentColor\" stroke-width=\"5\"/></svg><h3>Brand guidelines</h3><p>Set the standards.</p></article>\n   <article class=\"card\"><span class=\"corner\">↗</span><svg class=\"card-icon\" viewBox=\"0 0 80 80\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"24\" height=\"24\" rx=\"4\"/><rect x=\"47\" y=\"9\" width=\"24\" height=\"24\" rx=\"4\"/><rect x=\"9\" y=\"47\" width=\"24\" height=\"24\" rx=\"4\"/><path d=\"M47 59l8 8 17-22\"/></svg><h3>Approved assortment</h3><p>Choose the products.</p></article>\n   <article class=\"card\"><span class=\"corner\">↗</span><svg class=\"card-icon\" viewBox=\"0 0 80 80\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4\" aria-hidden=\"true\"><rect x=\"16\" y=\"8\" width=\"48\" height=\"64\" rx=\"7\"/><path d=\"M27 24h26M27 36h26M27 48h14M44 58l7 7 15-17\"/></svg><h3>Wholesale terms</h3><p>Agree the framework.</p></article>\n  </div>\n  <p class=\"s2-foot\">Your standards set the plan.</p>\n </section>\n <section id=\"s3\" class=\"clip scene\" data-start=\"0\" data-duration=\"15\">\n  <div class=\"brand process-brand\"><svg class=\"mark\" viewBox=\"0 0 64 64\" aria-hidden=\"true\"><rect width=\"64\" height=\"64\" rx=\"16\" fill=\"#d8ff5f\"/><path d=\"M12 20l9 25h8l5-14 5 14h8l7-25H43l-3 14-5-14h-6l-5 14-3-14z\" fill=\"#11131b\"/></svg><span>Winkz Enterprises</span></div>\n  <h2 class=\"s3-title\"><div class=\"mask\"><span class=\"line process-line\">Let’s turn alignment</span></div><div class=\"mask\"><span class=\"line process-line lime\">into action.</span></div></h2>\n  <div class=\"process\"><div class=\"connector\"><div class=\"connector-fill\"></div></div><div class=\"steps\"><article class=\"step\"><div class=\"step-number\">01</div><h3>Align</h3><p>Your brand priorities</p></article><article class=\"step\"><div class=\"step-number\">02</div><h3>Agree</h3><p>Products &amp; wholesale terms</p></article><article class=\"step\"><div class=\"step-number\">03</div><h3>Plan</h3><p>An Amazon wholesale launch</p></article></div><div class=\"arrowhead\" aria-hidden=\"true\">→</div></div>\n  <div class=\"portal\" aria-hidden=\"true\"></div>\n </section>\n <section id=\"s4\" class=\"clip scene\" data-start=\"0\" data-duration=\"15\">\n  <div class=\"final-arc\" aria-hidden=\"true\"></div>\n  <div class=\"brand final-brand\"><svg class=\"mark\" viewBox=\"0 0 64 64\" aria-hidden=\"true\"><rect width=\"64\" height=\"64\" rx=\"16\" fill=\"#11131b\"/><path d=\"M12 20l9 25h8l5-14 5 14h8l7-25H43l-3 14-5-14h-6l-5 14-3-14z\" fill=\"#d8ff5f\"/></svg><span>Winkz Enterprises</span></div>\n  <h2 class=\"final-heading\"><div class=\"mask\"><span class=\"line final-word\">Let’s talk</span></div><div class=\"mask\"><span class=\"line final-word\">wholesale.</span></div></h2>\n  <div class=\"final-line\" aria-hidden=\"true\"></div>\n  <div class=\"final-bottom\"><p class=\"final-sub\">Your brand. A shared plan.<br>Let’s explore your Amazon wholesale partnership.</p><div class=\"cta-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 80 80\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\"><path d=\"M15 65L65 15M18 15h47v47\"/></svg></div></div>\n </section>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n// Editable scene timing, in seconds. One deterministic, paused composition timeline.\nconst tl = gsap.timeline({paused:true});\nconst ease = 'power3.out';\n// Persistent atmosphere.\ntl.fromTo('.grid',{x:0,y:0},{x:-70,y:35,duration:15,ease:'none'},0);\ntl.fromTo('.orbital',{rotation:0},{rotation:105,duration:15,ease:'none'},0);\n// Opening: brand, oversized typography, then a dimensional monogram.\ntl.fromTo('.intro-brand',{opacity:0,y:-24},{opacity:1,y:0,duration:.55,ease},0);\ntl.fromTo('.hero-line',{yPercent:115},{yPercent:0,duration:.72,stagger:.11,ease},.17);\ntl.fromTo('.hero-sub',{opacity:0,y:24},{opacity:1,y:0,duration:.55,ease},.83);\ntl.fromTo('.hero-art',{opacity:0,x:210,rotation:24,scale:.72},{opacity:1,x:0,rotation:0,scale:1,duration:1,ease:'back.out(1.1)'},.25);\ntl.fromTo('.small-ring',{scale:0,rotation:-90},{scale:1,rotation:0,duration:.65,ease:'back.out(1.7)'},.87);\ntl.fromTo('.hero-rule',{scaleX:0},{scaleX:1,duration:.7,ease},.7);\ntl.to('.hero-art',{y:-16,rotation:3,duration:1.25,ease:'sine.inOut'},1.5);\ntl.to('.hero-copy',{y:-55,opacity:0,duration:.34,ease:'power2.in'},2.8);\ntl.to('.hero-art',{x:140,rotation:-15,opacity:0,duration:.4,ease:'power2.in'},2.8);\n// The light scene arrives as a clean upward wipe.\ntl.fromTo('#s2',{opacity:1,y:1080},{opacity:1,y:0,duration:.58,ease:'power3.inOut',immediateRender:false},3.05);\ntl.set('#s1',{opacity:0},3.64);\ntl.fromTo('.s2-title',{y:50,opacity:0},{y:0,opacity:1,duration:.58,ease,immediateRender:false},3.45);\ntl.fromTo('.card',{y:165,rotationX:30,opacity:0},{y:0,rotationX:0,opacity:1,duration:.7,stagger:.17,ease,immediateRender:false},3.85);\ntl.fromTo('.s2-foot',{opacity:0,y:15},{opacity:1,y:0,duration:.45,ease,immediateRender:false},4.85);\ntl.to('.card:nth-child(2)',{y:-14,duration:.45,ease:'sine.inOut'},5.35);\ntl.to('.card:nth-child(2)',{y:0,duration:.45,ease:'sine.inOut'},5.8);\n// Dark planning scene slides across, carrying the eye along the process.\ntl.fromTo('#s3',{opacity:1,x:1920},{opacity:1,x:0,duration:.58,ease:'power3.inOut',immediateRender:false},6.65);\ntl.set('#s2',{opacity:0},7.24);\ntl.fromTo('.process-line',{yPercent:115},{yPercent:0,duration:.65,stagger:.12,ease,immediateRender:false},7.02);\ntl.fromTo('.step',{opacity:0,y:50},{opacity:1,y:0,duration:.55,stagger:.35,ease,immediateRender:false},7.6);\ntl.to('.connector-fill',{scaleX:1,duration:1.25,ease:'power1.inOut'},7.9);\ntl.fromTo('.arrowhead',{opacity:0,x:-25},{opacity:1,x:0,duration:.4,ease,immediateRender:false},8.95);\ntl.to('.step:last-child .step-number',{scale:1.12,duration:.25,ease:'power2.out'},9.45);\ntl.to('.step:last-child .step-number',{scale:1,duration:.3,ease:'power2.inOut'},9.7);\n// Full-frame lime expansion hands off to the closing invitation.\ntl.to('.portal',{scale:250,duration:.7,ease:'power3.inOut'},10.65);\ntl.set('#s4',{opacity:1},11.34);\ntl.set('#s3',{opacity:0},11.35);\ntl.fromTo('.final-brand',{y:-20,opacity:0},{y:0,opacity:1,duration:.5,ease,immediateRender:false},11.4);\ntl.fromTo('.final-word',{yPercent:115},{yPercent:0,duration:.72,stagger:.13,ease,immediateRender:false},11.45);\ntl.fromTo('.final-line',{scaleX:0},{scaleX:1,duration:.75,ease,immediateRender:false},11.95);\ntl.fromTo('.final-sub',{y:30,opacity:0},{y:0,opacity:1,duration:.6,ease,immediateRender:false},12.2);\ntl.fromTo('.cta-icon',{scale:.5,rotation:-45,opacity:0},{scale:1,rotation:0,opacity:1,duration:.7,ease:'back.out(1.4)',immediateRender:false},12.25);\ntl.fromTo('.final-arc',{rotation:-20,scale:.8},{rotation:0,scale:1,duration:2.9,ease:'power1.out',immediateRender:false},11.35);\n// Explicit end hold preserves the complete fifteen-second composition.\ntl.to({}, {duration:.75},14.25);\nwindow.__timelines = window.__timelines || {};\nwindow.__timelines['main'] = tl;\n</script>\n</body>\n</html>",
