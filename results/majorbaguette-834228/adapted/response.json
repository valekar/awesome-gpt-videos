{
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Brieform — Presentation</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#191914}#root{position:relative;width:100%;height:100%;overflow:hidden}canvas{position:absolute;inset:0;width:100%;height:100%;display:block}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1280\" data-height=\"720\" data-duration=\"30\" data-fps=\"30\">\n<canvas id=\"artwork\" class=\"clip\" data-start=\"0\" data-duration=\"30\" width=\"1280\" height=\"720\" aria-label=\"Thirty-second Brieform presentation: ask in chat, share a form, and read the answers.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n/*\nEditable adaptation reconstructed with new Canvas artwork from the supplied samples.\n1280 × 720; 30 seconds; intended output rate: 30 fps; silent.\nGeneric system fonts approximate the unidentified reference typography.\nLogo geometry, subsecond timing and easing remain inferred.\n\nTimed reconstruction:\n0–3: question and answer reveal; lime emphasis; return to background.\n3.35–11.95: client intake request; sequential create/publish tools; live link.\n11.75–18.90: public form, progressive values, then submission confirmation.\n18.85–24.98: summary request, response tool and accumulating three-item summary.\n25.45–30: Brieform lockup, promise, compatibility and website; final hold.\n\nFocused revisions: horizontal olive glow; slightly raised opening answer with\nmore highlight padding; larger chat-message typography; advanced request,\nemail and budget entry; fully bright form by 12 seconds; no focus at 16;\ndelayed summary caption; earlier summary request and second bullet;\nlighter closing tagline and narrower website lettering.\n\nDependencies: harness-supplied local gsap.min.js only.\nNo supplied image is embedded. No font, audio or network asset is requested.\nNo render, technical check or matched-time visual review is claimed.\n*/\n(() => {\n'use strict';\nconst canvas=document.getElementById('artwork');\nconst c=canvas.getContext('2d');\nconst W=1280,H=720;\nconst C={bg:'#191914',lime:'#d4ff37',white:'#f7f7ef',muted:'#95958b',panel:'#23221d',edge:'#34332c',bubble:'#2b2a24',paper:'#f5f6f0',ink:'#1d1c17'};\nconst COPY={\n request:'Create a client intake form: name, email, budget and project details. Then publish it.',\n summary:'Summarize the responses so far.',\n name:'Léa Martin',email:'lea@studionord.fr',budget:'$5k to $10k',\n details:'A new site for our design studio, live before March.'\n};\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst progress=(t,a,b)=>clamp((t-a)/(b-a));\nconst smooth=v=>v*v*(3-2*v);\nconst fade=(t,a,b,d,e)=>smooth(progress(t,a,b))*(1-smooth(progress(t,d,e)));\nconst typed=(s,t,a,b)=>s.slice(0,Math.floor(progress(t,a,b)*s.length));\nfunction font(size,weight=400,family='sans-serif'){\n c.font=weight+' '+size+'px '+family;c.textAlign='left';c.textBaseline='alphabetic';\n}\nfunction text(s,x,y,size=20,color=C.white,weight=400,family='sans-serif'){\n font(size,weight,family);c.fillStyle=color;c.fillText(s,x,y);\n}\nfunction rounded(x,y,w,h,r=8){\n r=Math.max(0,Math.min(r,w/2,h/2));c.beginPath();c.moveTo(x+r,y);c.lineTo(x+w-r,y);c.quadraticCurveTo(x+w,y,x+w,y+r);c.lineTo(x+w,y+h-r);c.quadraticCurveTo(x+w,y+h,x+w-r,y+h);c.lineTo(x+r,y+h);c.quadraticCurveTo(x,y+h,x,y+h-r);c.lineTo(x,y+r);c.quadraticCurveTo(x,y,x+r,y);c.closePath();\n}\nfunction box(x,y,w,h,r,fill,stroke=null,line=1){\n rounded(x,y,w,h,r);if(fill){c.fillStyle=fill;c.fill();}if(stroke){c.strokeStyle=stroke;c.lineWidth=line;c.stroke();}\n}\nfunction layer(alpha,fn){if(alpha<=0)return;c.save();c.globalAlpha*=clamp(alpha);fn();c.restore();}\nfunction centered(s,y,size,color,weight=400,family='sans-serif'){\n font(size,weight,family);const w=c.measureText(s).width;text(s,(W-w)/2,y,size,color,weight,family);\n}\nfunction mixed(parts,y,size=27,weight=400){\n font(size,weight);const widths=parts.map(p=>c.measureText(p.text).width);let x=(W-widths.reduce((a,b)=>a+b,0))/2;\n parts.forEach((p,i)=>{text(p.text,x,y,size,p.color||C.white,weight);x+=widths[i];});\n}\nfunction tracked(s,x,y,size,color,spacing=1.5){\n font(size,400,'monospace');c.fillStyle=color;for(const ch of s){c.fillText(ch,x,y);x+=c.measureText(ch).width+spacing;}\n}\nfunction step(number,label){\n font(18,400,'monospace');const labelWidth=c.measureText(label).width+(label.length-1)*1.5;\n const x=(W-(40+12+labelWidth))/2;\n box(x,41,40,28,4,C.lime);text(number,x+7,61,17,C.ink,700,'monospace');\n tracked(label,x+52,61,18,C.muted,1.5);\n}\nfunction background(){\n c.fillStyle=C.bg;c.fillRect(0,0,W,H);\n c.save();\n c.translate(640,350);c.scale(1,.42);\n const glow=c.createRadialGradient(0,0,0,0,0,540);\n glow.addColorStop(0,'rgba(122,128,45,0.075)');\n glow.addColorStop(.48,'rgba(112,119,40,0.035)');\n glow.addColorStop(.82,'rgba(99,106,37,0.008)');\n glow.addColorStop(1,'rgba(99,106,37,0)');\n c.fillStyle=glow;c.fillRect(-540,-540,1080,1080);\n c.restore();\n}\nfunction opening(t){\n const a=fade(t,.25,.85,2.45,2.98);\n layer(a,()=>{\n centered('Need a form?',322,72,'#a4a49a',700);\n const left='Just ',right='ask your AI.',baseline=449;font(92,700);\n const lw=c.measureText(left).width,rw=c.measureText(right).width,x=(W-lw-rw)/2;\n text(left+right,x,baseline,92,'#74746a',700);\n const emphasis=smooth(progress(t,1.25,1.82));\n layer(emphasis,()=>{\n text(left,x,baseline,92,C.white,700);\n box(x+lw-3,369,rw+8,104,4,C.lime);\n text(right,x+lw,baseline,92,'#11120b',700);\n });\n });\n}\nfunction chatShell(){\n c.save();c.shadowColor='rgba(0,0,0,.48)';c.shadowBlur=40;c.shadowOffsetY=22;\n box(220,150,840,420,18,C.panel);c.restore();\n box(220,150,840,420,18,null,C.edge,1);\n c.strokeStyle='#34332c';c.lineWidth=1;c.beginPath();c.moveTo(221,193);c.lineTo(1059,193);c.stroke();\n ['#c67572','#b8a357','#709c6c'].forEach((color,i)=>{c.beginPath();c.arc(245+i*17,172,4.5,0,Math.PI*2);c.fillStyle=color;c.fill();});\n text('Your AI chat',310,177,13,'#a3a298');\n font(11,400,'monospace');const labels=[['MCP · ',C.muted],['brieform','#bdce70'],[' connected',C.muted]];\n const width=labels.reduce((n,p)=>n+c.measureText(p[0]).width,0);let x=1038-width;\n labels.forEach(p=>{text(p[0],x,177,11,p[1],400,'monospace');x+=c.measureText(p[0]).width;});\n}\nfunction wrap(s,maxWidth,size=20){\n font(size);const words=s.split(' '),lines=[];let line='';\n for(const word of words){const next=line?line+' '+word:word;if(line&&c.measureText(next).width>maxWidth){lines.push(line);line=word;}else line=next;}\n if(line)lines.push(line);return lines;\n}\nfunction prompt(s){\n if(!s)return;\n const size=21,lineHeight=29,lines=wrap(s,548,size);font(size);\n const w=Math.min(580,Math.max(105,...lines.map(l=>c.measureText(l).width+32)));\n const h=lines.length*lineHeight+22,x=1030-w,y=218;\n box(x,y,w,h,11,C.bubble,'#333229',1);\n lines.forEach((line,i)=>text(line,x+16,y+30+i*lineHeight,size,C.white));\n}\nfunction tick(x,y,r=8){\n c.beginPath();c.arc(x,y,r,0,Math.PI*2);c.fillStyle=C.lime;c.fill();\n c.beginPath();c.moveTo(x-r*.42,y);c.lineTo(x-r*.05,y+r*.31);c.lineTo(x+r*.46,y-r*.33);c.strokeStyle='#292c15';c.lineWidth=1.6;c.lineCap='round';c.lineJoin='round';c.stroke();\n}\nfunction tool(name,y,t,appear,complete){\n layer(smooth(progress(t,appear,appear+.22)),()=>{\n if(t>=complete)tick(260,y-5,8);\n else{c.beginPath();c.arc(260,y-5,7,0,Math.PI*2);c.strokeStyle='#a1af5b';c.lineWidth=1.5;c.stroke();c.beginPath();c.arc(260,y-5,2,0,Math.PI*2);c.fillStyle=C.lime;c.fill();}\n text('brieform · '+name,278,y,14,'#b2b1a5',400,'monospace');\n });\n}\nfunction chatCreate(t){\n layer(fade(t,3.35,3.8,11.60,11.95),()=>{\n step('01','ASK IN CHAT');chatShell();\n prompt(typed(COPY.request,t,3.30,5.45));\n tool('create_form',340,t,6.55,7.48);tool('publish_form',377,t,7.48,8.35);\n layer(smooth(progress(t,8.40,8.70)),()=>text('Done. Your form is live at its own link:',250,423,20,C.white));\n layer(smooth(progress(t,8.65,8.95)),()=>{\n const label='brieform.app/f/client-intake';font(17,400,'monospace');const width=c.measureText(label).width+49;\n box(250,442,width,49,9,'#25251c','#a4b456',1.5);\n text('↗',263,474,19,C.white);text(label,286,474,17,C.white,400,'monospace');\n });\n mixed([{text:'Describe it. Brieform '},{text:'builds and publishes it.',color:C.lime}],670);\n });\n}\nfunction browserShell(){\n c.save();c.shadowColor='rgba(0,0,0,.48)';c.shadowBlur=42;c.shadowOffsetY=23;\n box(270,117,740,486,20,C.paper);c.restore();\n box(270,117,740,486,20,null,'#d5d6d0',1);\n box(286,125,708,29,4,'#ffffff','#e6e7e1',1);\n text('brieform.app/f/client-intake',298,144,13,'#787a70',400,'monospace');\n c.fillStyle='rgba(0,0,0,.025)';c.fillRect(271,157,738,6);\n}\nfunction field(label,value,x,y,w,h,focus,t){\n text(label,x,y-12,16,'#3c3e35');\n box(x,y,w,h,7,'#ffffff',focus?'#25261f':'#d7d9d1',focus?1.6:1.1);\n text(value,x+14,y+26,16,'#25271f');\n if(focus&&Math.floor(t*2.4)%2===0){\n font(16);const caretX=x+14+c.measureText(value).width;\n c.fillStyle='#25271f';c.fillRect(caretX+1,y+10,1.4,21);\n }\n}\nfunction success(t){\n const a=smooth(progress(t,16.63,16.90));\n layer(a,()=>{\n c.beginPath();c.arc(640,335,32,0,Math.PI*2);c.fillStyle=C.ink;c.fill();\n c.beginPath();c.moveTo(630,336);c.lineTo(638,343);c.lineTo(651,326);c.strokeStyle=C.lime;c.lineWidth=3;c.lineCap='round';c.lineJoin='round';c.stroke();\n centered('Thanks, we got it.',414,32,C.ink,700);\n centered('We will get back to you within two days.',450,18,'#84867b');\n });\n}\nfunction publicForm(t){\n layer(fade(t,11.75,11.98,18.55,18.90),()=>{\n step('02','SHARE THE LINK');browserShell();\n layer(1-smooth(progress(t,16.50,16.68)),()=>{\n text('Client intake',330,218,32,C.ink,700);\n const focus=t<12.60?'name':t<13.30?'email':t<14.35?'budget':t<15.95?'details':null;\n field('Name',typed(COPY.name,t,12.05,12.60),330,267,300,38,focus==='name',t);\n field('Email',typed(COPY.email,t,12.60,13.22),648,267,301,38,focus==='email',t);\n field('Budget',typed(COPY.budget,t,13.30,14.05),330,346,619,38,focus==='budget',t);\n field('Project details',typed(COPY.details,t,14.35,15.80),330,426,619,70,focus==='details',t);\n box(330,514,109,43,7,C.ink);text('Submit',357,542,16,'#ffffff',700);\n });\n success(t);\n layer(smooth(progress(t,12.05,12.55)),()=>mixed([\n {text:'A normal web page. The people filling it in '},\n {text:'never see an AI.',color:C.lime}\n ],670,27));\n });\n}\nfunction summaryBullet(parts,y,alpha){\n layer(alpha,()=>{\n c.beginPath();c.arc(256,y-6,2.6,0,Math.PI*2);c.fillStyle=C.lime;c.fill();\n let x=270;font(20);\n parts.forEach(p=>{text(p.text,x,y,20,p.color||C.white);x+=c.measureText(p.text).width;});\n });\n}\nfunction chatRead(t){\n layer(fade(t,18.85,19.08,24.55,24.98),()=>{\n step('03','READ THE ANSWERS');chatShell();\n prompt(typed(COPY.summary,t,18.45,19.55));\n tool('get_responses',310,t,20.45,20.90);\n layer(smooth(progress(t,21.45,21.80)),()=>text('You have 8 responses this week:',250,357,20,C.white));\n summaryBullet([{text:'Most budgets fall between $5k and $10k.'}],397,smooth(progress(t,21.68,22.00)));\n summaryBullet([{text:'5 of 8',color:C.lime},{text:' want a site redesign.'}],435,smooth(progress(t,21.85,22.35)));\n summaryBullet([{text:'Call first: '},{text:'Studio Nord',color:C.lime},{text:', launch before March.'}],473,smooth(progress(t,22.42,22.95)));\n layer(smooth(progress(t,19.25,19.65)),()=>mixed([\n {text:'The answers come back '},{text:'in the same thread.',color:C.lime}\n ],670));\n });\n}\nfunction brandIcon(x,y,size){\n box(x,y,size,size,3,'#050604');\n c.save();c.translate(x,y);c.scale(size/74,size/74);\n c.beginPath();c.moveTo(10,24);c.lineTo(65,9);c.quadraticCurveTo(69,8,67,14);c.lineTo(51,64);c.quadraticCurveTo(27,62,13,40);c.quadraticCurveTo(7,30,10,24);c.closePath();c.fillStyle='#ffffff';c.fill();c.restore();\n}\nfunction closing(t){\n layer(smooth(progress(t,25.45,25.92)),()=>{\n brandIcon(462,215,74);text('Brieform',554,275,64,C.white,700);\n const before='Forms your AI builds, publishes, and ',last='reads.',weight=500;\n font(42,weight);let size=42;\n const initialWidth=c.measureText(before+last).width;\n if(initialWidth>838)size*=838/initialWidth;\n font(size,weight);const bw=c.measureText(before).width,lw=c.measureText(last).width,x=(W-bw-lw)/2;\n text(before+last,x,360,size,C.white,weight);\n layer(smooth(progress(t,26.35,26.85)),()=>{\n box(x+bw-4,360-size*.88,lw+10,size*1.12,5,C.lime);\n text(last,x+bw,360,size,'#101209',weight);\n });\n layer(smooth(progress(t,26.40,26.95)),()=>centered('Works with Claude, ChatGPT, Cursor and any MCP client.',418,20,C.muted));\n layer(smooth(progress(t,26.70,27.85)),()=>{\n box(472,461,200,49,12,C.lime);\n const website='brieform.app';font(24,700,'monospace');\n const websiteWidth=c.measureText(website).width;\n c.save();c.translate(572,494);c.scale(.92,1);\n text(website,-websiteWidth/2,0,24,'#12150b',700,'monospace');\n c.restore();\n text('Free to start',688,494,22,C.muted);\n });\n });\n}\nfunction draw(t){\n c.setTransform(1,0,0,1,0,0);c.globalAlpha=1;c.globalCompositeOperation='source-over';\n c.shadowColor='transparent';c.shadowBlur=0;c.shadowOffsetX=0;c.shadowOffsetY=0;\n c.lineWidth=1;c.lineCap='butt';c.lineJoin='miter';c.clearRect(0,0,W,H);\n background();opening(t);chatCreate(t);publicForm(t);chatRead(t);closing(t);\n}\nconst playhead={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{t:30,duration:30,ease:'none',onUpdate:()=>draw(playhead.t)},0);\ndraw(0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\n})();\n</script>\n</body>\n</html>",
