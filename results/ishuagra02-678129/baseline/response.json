{
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Particle Beach</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#040917;font-family:system-ui,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden;background:#040917}canvas{position:absolute;inset:0;width:100%;height:100%}.controls{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:18px;padding:12px 20px;border:1px solid #c9eaff26;border-radius:16px;background:#071020c9;color:#e9eee9;white-space:nowrap}.controls button{appearance:none;border:0;background:none;color:#a9b7c8;font:500 22px system-ui,sans-serif;padding:5px 3px;cursor:pointer}.controls button[data-active=\"true\"]{color:#ffe5b1}.controls button:focus-visible{outline:2px solid #ffe5b1;outline-offset:4px}.controls input{width:140px;accent-color:#ffd3a0;cursor:pointer}.controls output{font-size:24px;font-variant-numeric:tabular-nums;min-width:68px}.controls input:focus-visible{outline:2px solid #ffe5b1}\n</style>\n<script src=\"gsap.min.js\"></script>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"804\" data-duration=\"60\" aria-label=\"An animated particle illustration of Santa Monica Beach, moving from sunrise through night\">\n<canvas id=\"beach\" class=\"clip\" data-start=\"0\" data-duration=\"60\" width=\"1920\" height=\"804\" aria-label=\"Glowing ocean, busy beach, palm trees and a distant pier with a turning Ferris wheel\"></canvas>\n<nav class=\"controls clip\" data-start=\"0\" data-duration=\"60\" aria-label=\"Explore the simulated time of day\">\n<button type=\"button\" data-time=\"0\">Dawn</button><button type=\"button\" data-time=\"20\">Noon</button><button type=\"button\" data-time=\"40\">Sunset</button><button type=\"button\" data-time=\"56\">Night</button>\n<input id=\"scrub\" type=\"range\" min=\"0\" max=\"60\" step=\"0.01\" value=\"0\" aria-label=\"Time of day\"><output id=\"hour\">06:00</output>\n</nav>\n</div>\n<script>\n'use strict';\n/* EDITABLE SCENE: meters are illustrative, not survey measurements.\n   All geometry is original procedural point artwork. No external artwork.\n   One deterministic minute maps to a simulated 06:00–24:00 day. */\nconst SCENE={width:1920,height:804,duration:60,seed:73119,sandPoints:23500,waterPoints:17500,people:88,umbrellas:28};\nconst W=SCENE.width,H=SCENE.height,TAU=Math.PI*2;\nconst canvas=document.getElementById('beach'),ctx=canvas.getContext('2d',{alpha:false});\nconst scrub=document.getElementById('scrub'),hour=document.getElementById('hour');\nconst buttons=Array.from(document.querySelectorAll('[data-time]'));\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst mix=(a,b,u)=>a+(b-a)*u;\nconst smooth=v=>{v=clamp(v);return v*v*(3-2*v)};\nconst fract=v=>v-Math.floor(v);\nfunction noise(i){return fract(Math.sin(i*127.1+311.7)*43758.5453123)}\nlet seed=SCENE.seed;\nfunction rand(){seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296}\nfunction shore(z){return -12+z*.045+Math.sin(z*.014)*1.1}\nconst sand=[],water=[],objects=[],palms=[],umbrellas=[],people=[],stars=[],clouds=[];\n// Point records: world position, palette entry, physical size, stable variation.\nfunction add(list,x,y,z,c=6,r=.027,n=rand()){list.push({x,y,z,c,r,n})}\nfunction line(list,a,b,c=6,step=.14,r=.028){\n const d=Math.hypot(b[0]-a[0],b[1]-a[1],b[2]-a[2]);\n const count=Math.max(2,Math.ceil(d/step));\n for(let i=0;i<=count;i++){const u=i/count;add(list,mix(a[0],b[0],u),mix(a[1],b[1],u),mix(a[2],b[2],u),c,r)}\n}\nfunction boxEdges(list,x,y,z,sx,sy,sz,c){\n const p=[];for(let i=0;i<8;i++)p.push([x+(i&1?sx:0),y+(i&2?sy:0),z+(i&4?sz:0)]);\n for(let i=0;i<8;i++)for(const bit of [1,2,4])if(!(i&bit))line(list,p[i],p[i|bit],c,.1,.035);\n}\nfor(let i=0;i<SCENE.sandPoints;i++){\n const z=-7+Math.pow(rand(),1.6)*350;\n add(sand,shore(z)+rand()*102,.018+rand()*.025,z,0,.014+rand()*.021);\n}\nfor(let i=0;i<SCENE.waterPoints;i++){\n const z=-12+Math.pow(rand(),1.25)*530;\n add(water,shore(z)-rand()*250,0,z,1,.018+rand()*.03);\n}\n// Point-sampled coast: a quiet backdrop rather than a solid silhouette.\nfor(let i=0;i<4100;i++){\n const x=6+rand()*225,z=290+rand()*160;\n const h=4+12*Math.pow(.5+.5*Math.sin(x*.035),2);\n add(objects,x,rand()*h,z,7,.035);\n}\n// Pier deck, railings and piles.\nfor(let x=-84;x<=-8;x+=.48)for(let z=80;z<=91;z+=.48)add(objects,x,3.1+rand()*.035,z,9,.027);\nfor(let x=-82;x<=-9;x+=4.7){\n for(const z of [80.5,90.5]){\n  line(objects,[x,-1,z],[x,4.35,z],9,.1,.047);\n  line(objects,[x-.3,-.3,z],[x+2.6,3.1,z],9,.16,.034);\n }\n}\nfor(const z of [80,91]){\n line(objects,[-84,4.3,z],[-8,4.3,z],6,.12,.032);\n line(objects,[-84,3.7,z],[-8,3.7,z],9,.15,.025);\n}\n// The wheel itself is rebuilt analytically each frame below.\nfor(const z of [84.4,88.6]){\n line(objects,[-48,3.2,z],[-42,15.2,z],6,.09,.045);\n line(objects,[-36,3.2,z],[-42,15.2,z],6,.09,.045);\n}\n// An invented coaster gesture references the pier's amusement-park character.\nfor(let i=0;i<600;i++){\n const u=i/599,x=-32+u*23,y=5.1+Math.pow(Math.sin(u*Math.PI*2.6),2)*5.2,z=85+Math.sin(u*TAU)*2;\n add(objects,x,y,z,10,.035);\n add(objects,x,y+.24,z+.38,3,.026);\n if(i%43===0)line(objects,[x,3.15,z],[x,y,z],9,.13,.025);\n}\n// Small pier pavilions, expressed only as dotted outlines.\nfor(const x of [-71,-60,-24]){\n boxEdges(objects,x,3.15,82.5,5,3,5,9);\n line(objects,[x-.7,6.2,82],[x+2.5,7.7,85],3,.09,.035);\n line(objects,[x+2.5,7.7,85],[x+5.7,6.2,88],3,.09,.035);\n line(objects,[x-.7,6.2,82],[x+5.7,6.2,82],3,.09,.035);\n}\n// Lifeguard tower: elevated cabin, striped roof, stilts and a ramp.\nboxEdges(objects,13,2.1,37,3.7,2.6,3.2,5);\nfor(const x of [13,16.7])for(const z of [37,40.2])line(objects,[x,0,z],[x,2.1,z],6,.09,.04);\nfor(let i=0;i<700;i++){\n const x=12.5+rand()*4.7,z=36.5+rand()*4.2;\n add(objects,x,4.8+.45*(1-Math.abs(x-14.85)/2.35),z,i%3?5:6,.027);\n}\nline(objects,[13,2.15,37],[9,0,30],6,.1,.035);\nline(objects,[16.7,2.15,37],[12.7,0,30],6,.1,.035);\nfor(let k=0;k<18;k++)line(objects,[mix(9,13,k/18),k/18*2.15,mix(30,37,k/18)],[mix(12.7,16.7,k/18),k/18*2.15,mix(30,37,k/18)],9,.13,.025);\n// Beach umbrellas and their point-woven towels.\nfor(let i=0;i<SCENE.umbrellas;i++){\n const z=11+rand()*175,x=shore(z)+12+rand()*55;\n const u={x,z,r:1.4+rand()*.65,h:2.1+rand()*.6,c:[3,4,5,6,8,10][i%6],phase:rand()*TAU};\n if(i===0){u.x=27;u.z=13;u.r=2.35;u.h=2.7;u.c=4}\n umbrellas.push(u);\n line(objects,[u.x,0,u.z],[u.x,u.h,u.z],6,.09,.03);\n for(let j=0;j<270;j++){\n  const a=rand()*TAU,r=Math.sqrt(rand())*u.r;\n  const wedge=Math.floor(a/(TAU/8));\n  add(objects,u.x+Math.cos(a)*r,u.h-.57*Math.pow(r/u.r,1.7),u.z+Math.sin(a)*r,wedge%2?u.c:6,.029);\n }\n for(let j=0;j<80;j++)add(objects,x-1+rand()*2.7,.035,z+1.1+rand()*2.6,u.c,.023);\n}\n// Palm silhouettes are dimensional bundles of specks with curved fronds.\nfor(const p of [[37,12,12],[44,38,11],[36,81,10],[51,125,13],[67,180,12]]){\n const [x,z,h]=p,topx=x-2.7;\n for(let i=0;i<600;i++){\n  const u=rand(),a=rand()*TAU,r=.2+rand()*.1;\n  add(objects,x-2.7*u*u+Math.cos(a)*r,h*u,z+Math.sin(a)*r,9,.034);\n }\n for(let k=0;k<10;k++){\n  const a=k*TAU/10+.3;\n  for(let j=0;j<210;j++){\n   const u=rand(),s=(rand()-.5)*.9*u;\n   const reach=5.4*u;\n   const px=topx+Math.cos(a)*reach+Math.cos(a+Math.PI/2)*s;\n   const pz=z+Math.sin(a)*reach+Math.sin(a+Math.PI/2)*s;\n   add(objects,px,h+Math.sin(u*Math.PI)*1.5-u*u*2.5,pz,7,.03+rand()*.02);\n  }\n }\n palms.push({x,z,h});\n}\n// Volleyball court and a porous point net.\nfor(const x of [20,30])line(objects,[x,0,54],[x,2.8,54],6,.09,.035);\nfor(let y=1.65;y<=2.8;y+=.16)line(objects,[20,y,54],[30,y,54],6,.2,.018);\nfor(let x=20;x<=30;x+=.25)line(objects,[x,1.65,54],[x,2.8,54],6,.17,.016);\nfor(const z of [46,62])line(objects,[19,.025,z],[31,.025,z],6,.19,.022);\nfor(const x of [19,31])line(objects,[x,.025,46],[x,.025,62],6,.19,.022);\n// Beachgoers have stable positions and individual analytic walk cycles.\nfor(let i=0;i<SCENE.people;i++){\n const z=9+Math.pow(rand(),1.35)*215;\n const swimmer=i>=72;\n people.push({x:shore(z)+(swimmer?-3-rand()*15:3+rand()*59),z,phase:rand()*TAU,speed:.12+rand()*.18,dx:1+rand()*3,dz:1+rand()*5,height:.84+rand()*.27,c:[3,4,5,6,8,10][i%6],swimmer,ribbon:i<24});\n}\nObject.assign(people[0],{x:7,z:13,dx:8,dz:2,speed:.27,phase:.8,height:1.16,c:4,ribbon:true});\nObject.assign(people[1],{x:1,z:29,dx:3,dz:5,speed:.22,phase:2,height:1.08,c:5,ribbon:true});\nObject.assign(people[2],{x:23,z:47,dx:1,dz:1,speed:.24,height:1.1,c:3});\nObject.assign(people[3],{x:27,z:60,dx:1,dz:1,speed:.3,height:1.1,c:5});\nfor(let i=0;i<650;i++)stars.push({x:rand()*W,y:rand()*H*.58,r:.5+rand()*1.1,p:rand()*TAU});\nfor(let i=0;i<2200;i++){\n const band=Math.floor(rand()*5),u=rand();\n clouds.push({x:u*W,y:55+band*41+Math.sin(u*6+band)*20+(rand()-.5)*13,n:rand(),band});\n}\nobjects.sort((a,b)=>b.z-a.z);\nconst palettes=[\n {t:0,top:[6,15,34],bottom:[58,44,58],colors:[[188,144,111],[67,130,151],[145,204,208],[255,186,116],[246,131,143],[106,217,214],[239,220,189],[98,158,143],[160,151,222],[167,126,105],[243,143,110]]},\n {t:20,top:[8,28,49],bottom:[47,94,111],colors:[[224,201,151],[65,165,188],[192,240,229],[255,205,119],[251,149,162],[109,232,219],[245,239,209],[122,191,151],[177,172,240],[192,167,129],[250,154,104]]},\n {t:40,top:[18,16,40],bottom:[116,57,69],colors:[[232,158,109],[81,133,171],[209,199,210],[255,193,112],[255,135,169],[115,217,216],[255,222,178],[133,162,137],[184,147,233],[212,142,107],[255,156,103]]},\n {t:50,top:[3,7,23],bottom:[17,23,48],colors:[[100,119,147],[47,108,149],[113,202,224],[255,188,105],[244,122,187],[102,224,231],[197,215,230],[77,131,135],[169,142,239],[149,134,147],[255,155,108]]},\n {t:60,top:[2,5,18],bottom:[10,18,37],colors:[[82,103,131],[40,91,134],[104,188,218],[255,185,108],[243,119,183],[91,205,222],[180,203,223],[67,118,127],[156,135,226],[127,119,139],[249,150,104]]}\n];\nlet P=[],camera={},tick=0,night=0,horizon=280;\nfunction rgb(c){return 'rgb('+c.map(v=>Math.round(v)).join(',')+')'}\nfunction paletteAt(t){\n let k=0;while(k<palettes.length-2&&t>palettes[k+1].t)k++;\n const a=palettes[k],b=palettes[k+1],u=smooth((t-a.t)/(b.t-a.t));\n const lerp=(x,y)=>x.map((v,i)=>mix(v,y[i],u));\n return {top:lerp(a.top,b.top),bottom:lerp(a.bottom,b.bottom),colors:a.colors.map((v,i)=>lerp(v,b.colors[i]))};\n}\nfunction cameraAt(t){\n const x=22+2.5*Math.sin(t*.045),y=11.6+.6*Math.sin(t*.06),z=-26+3.5*Math.sin(t*.037);\n const tx=-8+3*Math.sin(t*.025),ty=2,tz=105;\n const dx=tx-x,dy=ty-y,dz=tz-z,l=Math.hypot(dx,dy,dz);\n const fx=dx/l,fy=dy/l,fz=dz/l,rl=Math.hypot(fx,fz),rx=fz/rl,rz=-fx/rl;\n camera={x,y,z,fx,fy,fz,rx,rz,ux:fy*rz,uy:fz*rx-fx*rz,uz:-fy*rx,f:1120};\n horizon=H*.5+camera.f*fy/Math.max(.01,Math.hypot(fx,fz));\n}\nfunction project(x,y,z){\n const c=camera,dx=x-c.x,dy=y-c.y,dz=z-c.z;\n const d=dx*c.fx+dy*c.fy+dz*c.fz;if(d<3)return null;\n return {x:W*.5+c.f*(dx*c.rx+dz*c.rz)/d,y:H*.5-c.f*(dx*c.ux+dy*c.uy+dz*c.uz)/d,s:c.f/d,d};\n}\nfunction speck(x,y,z,c,r=.025,n=.5,a=1,glow=false){\n const p=project(x,y,z);if(!p||p.x< -12||p.x>W+12||p.y< -12||p.y>H+12)return;\n const size=clamp(.55+p.s*r,.65,4.7),fade=clamp(1-p.d/740,.22,1);\n ctx.fillStyle=P[c];ctx.globalAlpha=clamp(a*fade*(.4+n*.55));\n ctx.fillRect(p.x-size*.5,p.y-size*.5,size,size);\n if(glow||n>.967){ctx.globalAlpha=a*fade*.055;const q=size*4.5;ctx.fillRect(p.x-q*.5,p.y-q*.5,q,q)}\n}\nfunction screenDot(x,y,r,color,a){ctx.fillStyle=color;ctx.globalAlpha=a;ctx.fillRect(x-r*.5,y-r*.5,r,r)}\nfunction sampledSegment(a,b,c,size=.03,alpha=1,salt=1){\n const length=Math.hypot(b[0]-a[0],b[1]-a[1],b[2]-a[2]);\n const n=Math.max(7,Math.ceil(length*25));\n for(let j=0;j<=n;j++){\n  const u=j/n,ph=j*2.399+salt;\n  speck(mix(a[0],b[0],u)+Math.cos(ph)*.045,mix(a[1],b[1],u),mix(a[2],b[2],u)+Math.sin(ph)*.045,c,size,noise(j+salt),alpha);\n }\n}\nfunction pose(a,t){\n const q=t*a.speed+a.phase;\n return {x:a.x+Math.sin(q)*a.dx,z:a.z+Math.sin(q*.81)*a.dz,g:t*(a.ribbon?7:4.4)+a.phase};\n}\nfunction drawRibbons(a,t,index){\n // Three braided point-streams retain a finite, continuously fading history.\n for(let strand=0;strand<3;strand++)for(let j=1;j<120;j++){\n  const u=j/119,old=pose(a,t-u*3.7),curl=u*TAU*1.8+t*.8+index;\n  const w=Math.sin(u*Math.PI)*(.18+strand*.09);\n  speck(old.x+Math.sin(curl+strand*2.1)*w,.45+Math.sin(curl*.7+strand)*w+u*.13,old.z+Math.cos(curl+strand)*w,strand===1?6:a.c,.019,noise(j+index*121),(1-u)*.62,true);\n }\n}\nfunction drawPerson(a,t,index){\n const p=pose(a,t),h=a.height;\n if(a.swimmer){\n  const y=.28+.07*Math.sin(t*1.6+index);\n  for(let j=0;j<27;j++){const q=j*2.399,u=(j+.5)/27;const rr=Math.sqrt(1-Math.pow(u*2-1,2))*.14;\n   speck(p.x+Math.cos(q)*rr,y+u*.29,p.z+Math.sin(q)*rr,6,.028,noise(j+index));}\n  sampledSegment([p.x-.5,y-.08,p.z],[p.x+.5,y-.05,p.z+.12*Math.sin(t*2+index)],a.c,.025,.75,index);\n  return;\n }\n const bounce=.035*Math.sin(p.g*2),hip=.84*h+bounce,shoulder=1.33*h+bounce;\n const stride=Math.sin(p.g)*(a.ribbon?.36:.24)*h;\n for(let j=0;j<65;j++){\n  const u=j/64,angle=j*2.399;\n  speck(p.x+Math.cos(angle)*(.16-.025*u)*h,hip+(shoulder-hip)*u,p.z+Math.sin(angle)*.115*h,a.c,.026,noise(index*67+j));\n }\n sampledSegment([p.x-.11*h,hip,p.z],[p.x-.14*h,.08,p.z+stride],6,.027,1,index+8);\n sampledSegment([p.x+.11*h,hip,p.z],[p.x+.15*h,.08,p.z-stride],6,.027,1,index+18);\n const ar=stride*.85;\n sampledSegment([p.x-.18*h,shoulder,p.z],[p.x-.28*h,.95*h,p.z-ar],a.c,.028,1,index+28);\n sampledSegment([p.x+.18*h,shoulder,p.z],[p.x+.3*h,1.04*h,p.z+ar],a.c,.028,1,index+38);\n for(let j=0;j<44;j++){\n  const v=1-2*(j+.5)/44,a0=j*2.399,r=Math.sqrt(1-v*v)*.145*h;\n  speck(p.x+Math.cos(a0)*r,1.59*h+bounce+v*.16*h,p.z+Math.sin(a0)*r,6,.026,noise(index*97+j));\n }\n // A few luminous footprints reinforce the beach plane and travel direction.\n if(a.ribbon)for(let j=0;j<10;j++){\n  const old=pose(a,t-j*.21),side=j%2?1:-1;\n  speck(old.x+side*.13,.025,old.z,a.c,.025,.6,(1-j/10)*.3);\n }\n}\nfunction wheel(t){\n const cx=-42,cy=15.2,cz=86.5,R=11.65,rot=t*.085;\n const light=.58+night*.42;\n for(let i=0;i<960;i++){\n  const a=i/960*TAU;\n  for(const rr of [R,R-.38])speck(cx+Math.cos(a)*rr,cy+Math.sin(a)*rr,cz,3,.038,.75,light,true);\n }\n for(let k=0;k<16;k++){\n  const a=k/16*TAU+rot,co=Math.cos(a),si=Math.sin(a);\n  for(let j=0;j<88;j++){\n   const r=R*j/87;\n   speck(cx+co*r,cy+si*r,cz,k%3===0?4:3,.028,.7,light,j%9===0);\n  }\n  const x=cx+co*R,y=cy+si*R;\n  // Gondolas remain upright while their attachment points turn.\n  for(let j=0;j<32;j++){\n   const u=j/31;\n   speck(x-.55+u*1.1,y-.8,cz-.15,k%2?5:4,.035,.8,1,true);\n   speck(x-.55,y-.8+u*.7,cz-.15,6,.026,.7,1);\n   speck(x+.55,y-.8+u*.7,cz-.15,6,.026,.7,1);\n  }\n }\n for(let i=0;i<150;i++){\n  const a=i*2.399,r=Math.sqrt((i+.5)/150)*.48;\n  speck(cx+Math.cos(a)*r,cy+Math.sin(a)*r,cz-.1,6,.04,.8,1,true);\n }\n // Little pier lamps wake up as dusk falls.\n for(let x=-80;x<-8;x+=4.7){\n  speck(x,4.55,80,3,.11,.9,.25+night*.75,true);\n  speck(x,4.55,91,3,.1,.9,.25+night*.75,true);\n }\n}\nfunction sky(t,pal){\n const gradient=ctx.createLinearGradient(0,0,0,H);\n gradient.addColorStop(0,rgb(pal.top));gradient.addColorStop(.48,rgb(pal.bottom));gradient.addColorStop(1,rgb(pal.top));\n ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';ctx.fillStyle=gradient;ctx.fillRect(0,0,W,H);\n const sunset=Math.exp(-Math.pow((t-39)/7,2));\n const sx=1480-1140*clamp(t/40),sy=horizon-215*Math.sin(Math.PI*clamp(t/40))+(t>40?(t-40)*10:0);\n const sunA=1-smooth((t-40)/4);\n const glow=ctx.createRadialGradient(sx,sy,0,sx,sy,320);\n glow.addColorStop(0,'rgba(255,173,113,'+(.12*sunA)+')');glow.addColorStop(1,'rgba(255,173,113,0)');\n ctx.fillStyle=glow;ctx.fillRect(0,0,W,H);\n ctx.globalCompositeOperation='lighter';\n for(const c 