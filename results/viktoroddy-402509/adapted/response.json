,rx=7+rand(i,14)*27;c.save();c.translate(x,y);c.rotate(rand(i,15)*6.28);ellipse(c,0,0,rx,rx*.3,['#314a2a','#46633b','#728057','#1b3b28','#829561'][i%5]);path(c,[[-rx,0],[rx,0]],'#8e9f6b',.7);c.restore()}rr(c,158,35,124,236,55,'#999879','#bdb896',4);rr(c,177,53,85,209,42,'#16251e','#c5b88d',7);rr(c,194,67,49,195,23,'#bdc8a7');path(c,[[170,274],[129,290],[307,290],[270,274]],'#afb09a',10);uiNav(c,'Urban Jungle',true);txt(c,'UNLEASH THE',22,121,34,'#f1f1d9',700);txt(c,'JUNGLE POWER',22,155,34,'#f1f1d9',700);micro(c,22,247,109,5,'#e4e6cf')}\nfunction wave(c){c.fillStyle='#08090a';c.fillRect(0,0,440,290);uiNav(c,'Agent Wave',true);for(let j=38;j>=0;j--){const a=j/38;const g=c.createLinearGradient(0,70,0,218);g.addColorStop(0,'#fcfcfc');g.addColorStop(.4,'#bbbfc0');g.addColorStop(1,'#1d2023');c.strokeStyle=g;c.lineWidth=3;c.beginPath();for(let x=0;x<=440;x+=5){let y=124+Math.sin(x/65+a*1.9)*30+(a-.5)*67;(x?c.lineTo(x,y):c.moveTo(x,y))}c.stroke()}txt(c,'Think beyond your',220,226,13,'#fff',500,'center');txt(c,'workflow limits.',220,243,13,'#fff',500,'center');cardButton(c,'Discover',184,257,true,72)}\nfunction space(c,mars=false){const g=c.createLinearGradient(0,0,0,290);g.addColorStop(0,mars?'#db9e78':'#020711');g.addColorStop(.55,mars?'#b86642':'#06172b');g.addColorStop(1,mars?'#613c2c':'#154465');c.fillStyle=g;c.fillRect(0,0,440,290);for(let i=0;i<75;i++)ellipse(c,rand(i,23)*440,rand(i,24)*225,.3+rand(i,25),.3+rand(i,25),mars?'#edc4a550':'#c6e5ff');if(mars){for(let j=0;j<9;j++){c.fillStyle=j%2?'#75422d':'#8e4a30';c.beginPath();c.moveTo(0,180+j*10);for(let x=0;x<=440;x+=12)c.lineTo(x,174+j*11+Math.sin(x*.024+j)*8+rand(x,j)*10);c.lineTo(440,290);c.lineTo(0,290);c.fill()}ellipse(c,293,219,44,12,'#402b24');rr(c,183,76,83,124,24,'#0b1520');const gg=c.createLinearGradient(0,99,0,200);gg.addColorStop(0,'#accbd1');gg.addColorStop(1,'#345f79');rr(c,185,100,79,97,12,gg);for(let i=0;i<20;i++)path(c,[[186,115+i*4],[210,102+i*4],[263,124+i*3]],'#dfebec70',3);txt(c,'67°',220,258,17,'#fff',300,'center')}else{const pg=c.createRadialGradient(215,267,20,220,280,190);pg.addColorStop(0,'#3e6f9a');pg.addColorStop(.7,'#153a64');pg.addColorStop(1,'#69b8e3');ellipse(c,220,335,196,176,pg,'#9ac9e8',2);c.save();c.beginPath();c.ellipse(220,335,196,176,0,0,Math.PI*2);c.clip();for(let i=0;i<60;i++){c.save();c.translate(52+rand(i,19)*343,168+rand(i,20)*141);c.rotate(rand(i,18)*5);ellipse(c,0,0,10+rand(i,16)*37,2+rand(i,17)*8,i%2?'#c6dfd8a0':'#779f83');c.restore()}c.restore();txt(c,'EARTH',220,105,37,'#eee',400,'center','Georgia, serif');txt(c,'A world of possibilities',220,125,8,'#bfc8d5',400,'center')}uiNav(c,mars?'MARS':'Space planet',!mars)}\nfunction fashion(c){c.fillStyle='#f2f1e9';c.fillRect(0,0,440,290);uiNav(c,'Orla.');txt(c,'Every piece starts with what',18,111,12,'#444',400);txt(c,'already exists: deadstock,',18,127,12,'#444',400);txt(c,'recycled denim and organic',18,143,12,'#444',400);txt(c,'hemp, dyed by hand and',18,159,12,'#444',400);txt(c,'finished in our atelier.',18,175,12,'#444',400);c.save();c.translate(302,55);ellipse(c,0,16,11,16,'#c6a292');ellipse(c,-3,9,13,13,'#41342e');c.fillStyle='#dfd6d0';c.beginPath();c.moveTo(-10,33);c.lineTo(12,32);c.lineTo(23,74);c.lineTo(15,111);c.lineTo(28,190);c.lineTo(9,199);c.lineTo(-2,126);c.lineTo(-12,198);c.lineTo(-30,193);c.lineTo(-21,111);c.lineTo(-22,73);c.closePath();c.fill();path(c,[[-12,40],[-36,81],[-48,70]],'#c9a391',7);path(c,[[11,43],[34,63],[15,84]],'#c9a391',7);path(c,[[-3,58],[3,102],[-10,177]],'#bcb2ac',2);c.restore();micro(c,355,227,63,4,'#666');txt(c,'Shop the collection',18,269,8,'#333',500)}\nfunction winged(c){c.fillStyle='#dddfdd';c.fillRect(0,0,440,290);txt(c,'OBSIDIAN',220,45,52,'#363a35',400,'center','Georgia, serif');for(let side of [-1,1]){c.save();c.translate(219,174);c.scale(side,1);for(let i=0;i<17;i++){c.save();c.rotate(-.8+i*.049);const x=37+i*5,y=-10+i*3;ellipse(c,x,y,85-i*2.7,8,'#f2f1e8','#acb3ad',.6);c.restore()}c.restore()}const hair=c.createLinearGradient(170,0,280,0);hai