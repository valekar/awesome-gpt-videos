  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>MotionSites — 1M and counting.</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000}body{font-family:Arial,Helvetica,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden;background:#000}.clip{position:absolute;inset:0;width:100%;height:100%}canvas{display:block;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1280\" data-height=\"720\" data-duration=\"54.3\" data-fps=\"30\">\n<canvas id=\"film\" class=\"clip\" data-start=\"0\" data-duration=\"54.3\" width=\"1280\" height=\"720\" aria-label=\"MotionSites launch celebration: one million monthly visitors eight months after launch.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n'use strict';\n/* Independently authored adapted reconstruction.\n   All miniature websites, illustrations, logo geometry, motion paths and particles\n   below are procedural approximations inferred from the supplied visual evidence.\n   Generic system typography approximates the unidentified reference fonts.\n   No source frame is used as artwork. No audio is included.\n   Edit SCENES, ART, galleryItems and the illustration functions to revise the film. */\nconst W=1280,H=720,DURATION=54.3;\nconst canvas=document.getElementById('film'),ctx=canvas.getContext('2d');\nconst palette={peach:'#f4baa9',pink:'#e487cb',violet:'#9678ee',white:'#f8f8f7',gray:'#a6a5aa'};\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,p)=>a+(b-a)*p;\nconst smooth=p=>{p=clamp(p);return p*p*(3-2*p)};\nconst easeOut=p=>1-Math.pow(1-clamp(p),3);\nconst fract=v=>v-Math.floor(v);\nconst rand=(i,s=0)=>fract(Math.sin(i*127.1+s*311.7)*43758.5453123);\nfunction rr(c,x,y,w,h,r,fill,stroke,lw=1){c.beginPath();c.roundRect(x,y,w,h,r);if(fill){c.fillStyle=fill;c.fill()}if(stroke){c.lineWidth=lw;c.strokeStyle=stroke;c.stroke()}}\nfunction ellipse(c,x,y,rx,ry,fill,stroke,lw=1){c.beginPath();c.ellipse(x,y,Math.max(.01,rx),Math.max(.01,ry),0,0,Math.PI*2);if(fill){c.fillStyle=fill;c.fill()}if(stroke){c.strokeStyle=stroke;c.lineWidth=lw;c.stroke()}}\nfunction path(c,pts,col,w=1,close=false){c.beginPath();pts.forEach((p,i)=>i?c.lineTo(p[0],p[1]):c.moveTo(p[0],p[1]));if(close)c.closePath();c.strokeStyle=col;c.lineWidth=w;c.stroke()}\nfunction txt(c,s,x,y,size=24,col='#fff',weight=400,align='left',family='Arial, Helvetica, sans-serif'){c.font=weight+' '+size+'px '+family;c.textAlign=align;c.textBaseline='alphabetic';c.fillStyle=col;c.fillText(s,x,y)}\nfunction grad(c,x1,y1,x2,y2,stops=[[0,palette.peach],[.42,palette.pink],[1,palette.violet]]){const g=c.createLinearGradient(x1,y1,x2,y2);stops.forEach(v=>g.addColorStop(v[0],v[1]));return g}\nfunction gradientText(c,s,x,y,size,weight=200,align='center',width=700){txt(c,s,x,y,size,grad(c,x-width/2,y,x+width/2,y),weight,align)}\nfunction micro(c,x,y,w,rows=4,col='#888',seed=0){for(let i=0;i<rows;i++){c.fillStyle=col;c.globalAlpha*=.96;c.fillRect(x,y+i*5,w*(.55+rand(i,seed)*.45),1.6)}}\nfunction reveal(c,p,fn,blur=12,dy=14){p=easeOut(p);if(p<=0)return;c.save();c.globalAlpha*=p;c.translate(0,(1-p)*dy);c.filter='blur('+((1-p)*blur).toFixed(2)+'px)';fn();c.restore()}\nfunction pill(c,s,x,y,w=180,h=28,size=12){rr(c,x-w/2,y,w,h,h/2,'#101010','#79635b',1);ellipse(c,x-w/2+14,y+h/2,2,2,'#dc998d');txt(c,s,x+4,y+h*.68,size,'#eee',700,'center')}\nfunction mark(c,x,y,size){c.save();c.translate(x,y);c.scale(size/100,size/100);c.lineCap='round';c.lineJoin='round';c.strokeStyle=grad(c,2,20,91,78);c.lineWidth=17;c.beginPath();c.moveTo(13,75);c.lineTo(24,20);c.bezierCurveTo(26,10,36,12,33,24);c.lineTo(18,69);c.bezierCurveTo(14,82,26,83,35,69);c.lineTo(68,20);c.bezierCurveTo(77,7,86,11,82,28);c.lineTo(75,76);c.stroke();c.restore()}\nfunction logo(c,cx,top,width=540,progress=1){c.save();c.font='700 98px Arial, Helvetica, sans-serif';const natural=122+c.measureText('motionsites').width,sc=width/natural;c.translate(cx-width/2,top);c.scale(sc,sc);c.beginPath();c.rect(-30,-30,(natural+60)*clamp(progress),155);c.clip();mark(c,0,-2,100);txt(c,'motionsites',122,82,98,'#fafafa',700);c.restore()}\nfunction uiNav(c,name,dark=false){const col=dark?'#e8e8e8':'#252525';txt(c,name,18,25,15,col,700);txt(c,'Design     Explore     About',420,24,6,dark?'#bbb':'#555',400,'right');rr(c,365,34,55,13,7,dark?'#f6f6f6':'#171717');txt(c,'Explore',392,43,6,dark?'#222':'#fff',400,'center')}\nfunction cardButton(c,s,x,y,dark=false,w=76){rr(c,x,y,w,18,10,dark?'#eee':'#171717');txt(c,s,x+w/2,y+12,7,dark?'#111':'#fff',600,'center')}\nfunction car(c,engine=false){const g=c.createLinearGradient(0,0,0,290);g.addColorStop(0,'#7999aa');g.addColorStop(1,'#a8c1cf');c.fillStyle=g;c.fillRect(0,0,440,290);uiNav(c,'Veyra Electric');rr(c,20,57,400,184,2,null,'#d9e7ed',.8);txt(c,'Electric. Inside out.',30,73,10,'#dce8ed',400);ellipse(c,230,219,170,14,'#59717c');if(engine){c.save();c.translate(115,97);const mg=c.createLinearGradient(0,0,200,130);mg.addColorStop(0,'#d3dadd');mg.addColorStop(.4,'#59636a');mg.addColorStop(1,'#e9eeee');rr(c,23,15,155,98,20,mg,'#36444d',2);for(let i=0;i<8;i++){ellipse(c,45+i*15,66,29,47,null,i%2?'#455057':'#e8ecee',5);path(c,[[35+i*16,21],[57+i*16,12],[73+i*16,79]],'#acb7bd',4)}ellipse(c,166,69,47,43,'#6b7c84','#d3e0e7',6);ellipse(c,166,69,25,25,'#28383e','#c3d4db',4);for(let i=0;i<8;i++){const a=i*Math.PI/4;path(c,[[166+Math.cos(a)*27,69+Math.sin(a)*27],[166+Math.cos(a)*38,69+Math.sin(a)*38]],'#dbe1e3',3)}c.restore()}else{for(const x of [123,334]){ellipse(c,x,209,31,34,'#26323a');ellipse(c,x,209,20,24,'#a9b9c1');for(let i=0;i<10;i++){let a=i*Math.PI/5;path(c,[[x,209],[x+Math.cos(a)*19,209+Math.sin(a)*23]],'#45525b',2)}}const body=c.createLinearGradient(0,130,0,210);body.addColorStop(0,'#fff');body.addColorStop(.5,'#d7e3e7');body.addColorStop(.