{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Inference in Motion</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#080b0d}body{font-family:Arial,Helvetica,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden;background:#080b0d}.clip{position:absolute;inset:0;width:100%;height:100%}canvas{display:block;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"18\">\n<div class=\"clip\" data-start=\"0\" data-duration=\"18\"><canvas id=\"art\" width=\"1920\" height=\"1080\" role=\"img\" aria-label=\"An abstract startup film about inference, with kinetic typography, flowing tokens and luminous computation paths.\"></canvas></div>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n/* Editable creative settings. All visual states are reconstructed from time. */\nconst CONFIG={width:1920,height:1080,duration:18,ink:'#080b0d',paper:'#f3f5ef',mint:'#baff69',violet:'#ab9cff'};\nconst BEATS=[\n {start:0,end:3.6,lines:['Ideas move','fast.']},\n {start:3.6,end:7.2,lines:['Inference.','In motion.']},\n {start:7.2,end:11,lines:['From prompt.','To possibility.']},\n {start:11,end:14.4,lines:['Less waiting.','More building.']},\n {start:14.4,end:18,lines:['Make room','for what’s next.']}\n];\nconst canvas=document.getElementById('art'),ctx=canvas.getContext('2d');\nconst W=CONFIG.width,H=CONFIG.height,TAU=Math.PI*2;\nconst clamp=(n,a=0,b=1)=>Math.max(a,Math.min(b,n));\nconst smooth=n=>{n=clamp(n);return n*n*(3-2*n)};\nconst out=n=>1-Math.pow(1-clamp(n),4);\nconst mix=(a,b,n)=>a+(b-a)*n;\nconst fract=n=>n-Math.floor(n);\nfunction rounded(x,y,w,h,r=20){ctx.beginPath();ctx.roundRect(x,y,w,h,r)}\nfunction line(x1,y1,x2,y2,color,width=1){ctx.strokeStyle=color;ctx.lineWidth=width;ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke()}\nfunction label(text,x,y,size,color=CONFIG.paper,align='left',weight=700){ctx.fillStyle=color;ctx.font=weight+' '+size+'px Arial, Helvetica, sans-serif';ctx.textAlign=align;ctx.textBaseline='alphabetic';ctx.fillText(text,x,y)}\nfunction glow(x,y,r,color){const g=ctx.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,color);g.addColorStop(1,'transparent');ctx.fillStyle=g;ctx.fillRect(x-r,y-r,r*2,r*2)}\nfunction pill(x,y,w,h,color,alpha=1){ctx.save();ctx.globalAlpha*=alpha;rounded(x,y,w,h,h/2);ctx.fillStyle=color;ctx.fill();ctx.restore()}\nfunction backdrop(t){\n ctx.fillStyle=CONFIG.ink;ctx.fillRect(0,0,W,H);\n glow(1480+70*Math.sin(t*.35),550,850,'rgba(142,180,113,.075)');\n ctx.save();ctx.globalAlpha=.12;\n for(let i=0;i<17;i++){const x=120+i*112;line(x,0,x,H,'#607065',1)}\n for(let i=0;i<10;i++)line(0,50+i*112,W,50+i*112,'#607065',1);\n ctx.restore();\n}\nfunction sceneAlpha(t,b,i){const enter=i===0?1:smooth((t-b.start)/.32);const leave=i===BEATS.length-1?1:1-smooth((t-(b.end-.32))/.32);return enter*leave}\nfunction headline(lines,x,y,size,u,accentIndex=1){\n lines.forEach((text,i)=>{\n  const p=out((u-i*.11)/.72);\n  ctx.save();ctx.beginPath();ctx.rect(x-8,y+i*size*1.05-size,1700,size*1.15);ctx.clip();\n  label(text,x,y+i*size*1.05+(1-p)*size,size,i===accentIndex?CONFIG.mint:CONFIG.paper);\n  ctx.restore();\n });\n}\nfunction ring(x,y,r,color,width=2,start=0,end=TAU){ctx.strokeStyle=color;ctx.lineWidth=width;ctx.beginPath();ctx.arc(x,y,r,start,end);ctx.stroke()}\nfunction opening(u,t){\n const p=out(u/.8);\n ctx.save();ctx.translate(1360,530);ctx.rotate(-.16+u*.055);\n for(let lane=0;lane<7;lane++){\n  const yy=(lane-3)*78;\n  line(-120,yy,590,yy,'rgba(186,255,105,.13)',2);\n  for(let j=0;j<4;j++){\n   const phase=fract(j/4+u*(.18+lane*.014));\n   const x=-290+phase*1050;\n   const width=48+((lane*31+j*19)%100);\n   pill(x,yy-20,width,40,(lane+j)%5===0?CONFIG.violet:CONFIG.mint,p*(.25+.75*Math.sin(phase*Math.PI)));\n  }\n }\n ctx.restore();\n headline(BEATS[0].lines,132,432,170,u);\n const a=smooth((u-.65)/.45);ctx.save();ctx.globalAlpha=a;\n label('Give them somewhere to go.',140,764,40,'#a6afa5','left',400);\n ctx.restore();\n line(140,856,140+420*out((u-.4)/1.2),856,CONFIG.mint,5);\n}\nfunction motion(u,t){\n const reveal=out(u/.8);\n ctx.save();ctx.translate(1395,548);ctx.scale(reveal,reveal);\n for(let i=0;i<4;i++){\n  ctx.save();ctx.rotate(u*.18+i*.63);\n  ctx.strokeStyle=i%2?CONFIG.violet:CONFIG.mint;ctx.globalAlpha=.34+i*.12;ctx.lineWidth=2+i*.6;\n  ctx.beginPath();ctx.ellipse(0,0,330-i*32,116+i*34,0,0,TAU);ctx.stroke();\n  const a=u*(.9+i*.2)+i*1.9;\n  const x=Math.cos(a)*(330-i*32),y=Math.sin(a)*(116+i*34);\n  glow(x,y,40,'rgba(186,255,105,.3)');pill(x-9,y-9,18,18,CONFIG.paper);\n  ctx.restore();\n }\n rounded(-92,-92,184,184,38);ctx.fillStyle=CONFIG.mint;ctx.fill();\n for(let k=0;k<3;k++)pill(-47,-38+k*29,94-(k===1?26:0),13,CONFIG.ink);\n ctx.restore();\n headline(BEATS[1].lines,132,440,158,u);\n ctx.save();ctx.globalAlpha=smooth((u-.75)/.5);label('Turn intent into momentum.',140,766,40,'#a6afa5','left',400);ctx.restore();\n}\nfunction transformation(u,t){\n headline(BEATS[2].lines,132,238,112,u);\n const left=260,right=1660,cy=714;\n const enter=out((u-.3)/.7);\n ctx.save();ctx.globalAlpha=enter;\n for(let lane=0;lane<5;lane++){\n  const sy=cy+(lane-2)*53,ey=cy+(lane-2)*77;\n  ctx.strokeStyle='rgba(186,255,105,.24)';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(left,sy);ctx.bezierCurveTo(640,sy,685,cy,960,cy);ctx.bezierCurveTo(1230,cy,1250,ey,right,ey);ctx.stroke();\n  for(let j=0;j<5;j++){\n   const q=fract(u*.27+j/5+lane*.075);\n   let x,y;\n   if(q<.5){const z=q*2;x=mix(left,960,z);y=mix(sy,cy,smooth(z))}\n   else{const z=(q-.5)*2;x=mix(960,right,z);y=mix(cy,ey,smooth(z))}\n   pill(x-19,y-7,38,14,lane%2?CONFIG.violet:CONFIG.mint,.25+.75*Math.sin(q*Math.PI));\n  }\n }\n glow(960,cy,220,'rgba(186,255,105,.16)');\n ctx.save();ctx.translate(960,cy);ctx.rotate(Math.PI/4);rounded(-66,-66,132,132,20);ctx.fillStyle=CONFIG.mint;ctx.fill();rounded(-34,-34,68,68,10);ctx.fillStyle=CONFIG.ink;ctx.fill();ctx.restore();\n rounded(132,cy-116,230,232,28);ctx.fillStyle='#101813';ctx.fill();ctx.strokeStyle='#3a493b';ctx.lineWidth=2;ctx.stroke();\n for(let k=0;k<4;k++)pill(170,cy-66+k*39,72+(k*47)%90,13,k===0?CONFIG.mint:'#536250');\n rounded(1544,cy-164,244,328,28);ctx.fillStyle='#151c19';ctx.fill();ctx.strokeStyle='#536250';ctx.stroke();\n ctx.save();ctx.beginPath();ctx.rect(1564,cy-140,204,280);ctx.clip();\n for(let k=0;k<8;k++){const bh=55+((k*59)%164);rounded(1572+k*25,cy+115-bh,17,bh,8);ctx.fillStyle=k%3===0?CONFIG.violet:CONFIG.mint;ctx.fill()}\n ctx.restore();ctx.restore();\n}\nfunction building(u,t){\n const p=out(u/.7);\n ctx.save();ctx.translate(1430,645);ctx.rotate(-.13);\n for(let row=3;row>=0;row--)for(let col=0;col<3;col++){\n  const delay=(3-row)*.10+col*.06;\n  const e=out((u-delay)/.7);\n  const x=(col-1)*128+(3-row)*22,y=(row-2)*124+(1-e)*340;\n  ctx.save();ctx.globalAlpha=e;\n  rounded(x-49,y-49,98,98,20);ctx.fillStyle=(col+row)%4===0?CONFIG.violet:((col+row)%3===0?CONFIG.mint:'#233326');ctx.fill();\n  ctx.strokeStyle='rgba(224,255,208,.18)';ctx.lineWidth=2;ctx.stroke();\n  if((col+row)%3===0){line(x-17,y,x+17,y,CONFIG.ink,5);line(x,y-17,x,y+17,CONFIG.ink,5)}\n  ctx.restore();\n }\n ctx.restore();\n headline(BEATS[3].lines,132,424,142,u);\n ctx.save();ctx.globalAlpha=smooth((u-.7)/.5);label('Keep the ideas coming.',140,760,40,'#a6afa5','left',400);ctx.restore();\n}\nfunction ending(u,t){\n const p=out(u/.8);\n ctx.save();ctx.translate(960,290);ctx.scale(p,p);\n ring(0,0,86,'rgba(186,255,105,.18)',2);\n ring(0,0,86,CONFIG.mint,6,-Math.PI/2,-Math.PI/2+TAU*clamp(u/1.2));\n ctx.save();ctx.rotate(-.15+u*.08);pill(-40,-13,80,26,CONFIG.mint);pill(-13,-40,26,80,CONFIG.mint);ctx.restore();ctx.restore();\n ctx.save();ctx.textAlign='center';\n BEATS[4].lines.forEach((text,i)=>{const e=out((u-i*.12)/.8);ctx.save();ctx.globalAlpha=e;label(text,960,558+i*146+(1-e)*90,136,i?CONFIG.mint:CONFIG.paper,'center');ctx.restore()});\n ctx.globalAlpha=smooth((u-.9)/.6);label('Inference, in motion.',960,873,42,'#a6afa5','center',400);ctx.restore();\n}\nconst scenes=[opening,motion,transformation,building,ending];\nfunction draw(t){\n ctx.setTransform(1,0,0,1,0,0);ctx.globalAlpha=1;ctx.clearRect(0,0,W,H);backdrop(t);\n BEATS.forEach((b,i)=>{const a=sceneAlpha(t,b,i);if(a<=0)return;ctx.save();ctx.globalAlpha=a;scenes[i](Math.max(0,t-b.start),t);ctx.restore()});\n /* Short, deterministic light wipes connect the five beats. */\n for(let i=1;i<BEATS.length;i++){\n  const q=(t-(BEATS[i].start-.18))/.48;\n  if(q>0&&q<1){const x=-380+(W+760)*smooth(q);ctx.save();ctx.globalAlpha=Math.sin(q*Math.PI)*.24;ctx.transform(1,0,-.24,1,0,0);const g=ctx.createLinearGradient(x-120,0,x+240,0);g.addColorStop(0,'transparent');g.addColorStop(.5,CONFIG.mint);g.addColorStop(1,'transparent');ctx.fillStyle=g;ctx.fillRect(x-120,0,360,H);ctx.restore()}\n }\n}\nconst playhead={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{t:CONFIG.duration,duration:CONFIG.duration,ease:'none',onUpdate:()=>draw(playhead.t)},0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\ndraw(0);\n</script>\n</body>\n</html>","width":1920,"height":1080,"duration_seconds":18,"assumptions":["Chose an 18-second, 16:9 abstract startup promo because no runtime or aspect ratio was supplied.","Used original, unbranded campaign copy, charcoal backgrounds, mint and violet graphics, and generic system typography.","No product-specific features, measurements or brand identity were assumed; the film is silent."],"missing_inputs":[],"summary":"Editable five-beat inference promo with kinetic typography, flowing tokens and abstract computation graphics. Uses one paused GSAP timeline; not rendered or visually reviewed."}