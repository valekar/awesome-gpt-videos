{
  "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Token bucket rate limiter</title>\n<style>\nhtml,body{margin:0;width:100%;height:100%;overflow:hidden;background:#080f10}\n#root{position:relative;width:100%;height:100%;overflow:hidden}\ncanvas{display:block;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1080\" data-height=\"1080\" data-duration=\"18\" data-fps=\"30\">\n<canvas id=\"art\" class=\"clip\" data-start=\"0\" data-duration=\"18\" width=\"1080\" height=\"1080\" aria-label=\"Token bucket rate limiter: capacity ten, refill two tokens per second\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n'use strict';\n/*\nSampled reconstruction of the supplied @ParkerRex reference; not recovered source.\nTimed brief: fixed square dashboard throughout. Steady traffic 0–2.40s;\nburst 2.40–3.30s; empty-bucket refusals 3.30–6.40s; recovery 6.40–11.70s;\namber conclusion and completed chart 11.70–18s. Caption boundaries are inferred.\nNo camera moves, entrances, exits, or audio. Final second continues the sampled hold.\nCanvas draws all artwork; local harness GSAP supplies deterministic seek time only.\nGeneric monospace with width adjustment approximates the unidentified reference font.\nRequests 4 and 11–14, fractional refill arithmetic, and accent timing are inferred.\nGreen outlines follow the next empty slot during depletion, except the one-token\nsample state; no pulse animation is added. Recovery uses a narrow partial blue strip.\nCoincident refill/request events are consolidated before plotting, avoiding artificial\nzero-duration spikes. All intermediate chart-event timing remains a reconstruction.\nDependencies: harness-provided gsap.min.js. No images, fonts, or other assets used.\nThis source has not been rendered or visually validated.\n*/\nconst canvas=document.getElementById('art');\nconst ctx=canvas.getContext('2d');\nconst C={bg:'#080f10',text:'#c8d2d7',muted:'#626a6f',blue:'#55a2ff',green:'#4bb366',red:'#ef514b',amber:'#d1a329',outline:'#777f82',slot:'#273033'};\nconst CAPACITY=10,REFILL=2,SIMULATION_END=12,EPS=1e-8;\n// Inferred unreadable events: #4=2.40, #11=3.02, #12=3.10, #13=3.15, #14=3.27.\nconst requests=[0.50,1.30,1.90,2.40,2.47,2.58,2.64,2.76,2.83,2.90,3.02,3.10,3.15,3.27,3.33,3.42,3.53,3.60,3.78,3.90,4.08,4.23,4.35,4.56,4.70,4.88,5.06,5.17,5.42,5.65,5.90,6.18,7.60];\nconst whole=n=>Math.max(0,Math.min(CAPACITY,Math.floor(n+EPS)));\nfunction stateAt(time){\n const end=Math.max(0,Math.min(SIMULATION_END,time));\n let balance=CAPACITY,previous=0;\n const rows=[],events=[[0,CAPACITY]];\n function refillUntil(until){\n  const initial=balance;\n  for(let level=whole(initial)+1;level<=CAPACITY;level++){\n   const crossing=previous+(level-initial)/REFILL;\n   if(crossing>until+EPS)break;\n   events.push([crossing,level]);\n  }\n  balance=Math.min(CAPACITY,initial+REFILL*(until-previous));\n  previous=until;\n }\n for(let i=0;i<requests.length;i++){\n  const at=requests[i];\n  if(at>end+EPS)break;\n  refillUntil(at);\n  const taken=balance+EPS>=1;\n  if(taken)balance=Math.max(0,balance-1);\n  const left=whole(balance);\n  events.push([at,left]);\n  rows.push({at,id:i+1,taken,left});\n }\n refillUntil(end);\n events.push([end,whole(balance)]);\n // Keep the final state at each timestamp, eliminating instantaneous round trips.\n const merged=[];\n for(const event of events){\n  const last=merged[merged.length-1];\n  if(last&&Math.abs(last[0]-event[0])<EPS)last[1]=event[1];\n  else merged.push(event.slice());\n }\n const points=[[0,CAPACITY]];\n let level=CAPACITY;\n for(const event of merged){\n  if(event[1]!==level){\n   points.push([event[0],level],[event[0],event[1]]);\n   level=event[1];\n  }\n }\n points.push([end,level]);\n return {time:end,balance,count:whole(balance),rows,points};\n}\nfunction text(str,x,y,size,color,align='left',widthScale=0.93){\n ctx.save();\n ctx.translate(x,y);ctx.scale(widthScale,1);\n ctx.fillStyle=color;ctx.font=size+'px monospace';\n ctx.textAlign=align;ctx.textBaseline='alphabetic';\n ctx.fillText(str,0,0);ctx.restore();\n}\nfunction line(x1,y1,x2,y2,color,width=1){\n ctx.strokeStyle=color;ctx.lineWidth=width;\n ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();\n}\nfunction zero(x,baseline,color){\n ctx.strokeStyle=color;ctx.lineWidth=11;ctx.lineCap='butt';\n ctx.beginPath();ctx.ellipse(x+45,baseline-55,31,51,0,0,Math.PI*2);ctx.stroke();\n ctx.beginPath();ctx.moveTo(x+20,baseline-14);ctx.lineTo(x+70,baseline-97);ctx.stroke();\n}\nfunction countLabel(value){\n const x=415,y=318,color=value===0?C.red:C.text;\n if(value===10){text('1',x,y,150,color,'left',1);zero(x+90,y,color);}\n else if(value===0)zero(x,y,color);\n else text(String(value),x,y,150,color,'left',1);\n text('/ 10 tokens',x+(value===10?180:90)+12,y,32,C.muted);\n}\nfunction captionAt(t){\n if(t<2.40)return ['steady traffic, refill keeps the bucket full',C.text];\n if(t<3.30)return ['a burst spends the saved tokens',C.text];\n if(t<6.40)return ['empty: requests refused until a token refills',C.text];\n if(t<11.70)return ['traffic eases, refill at 2/s catches up',C.text];\n return ['capacity sets the burst, refill rate sets the limit',C.amber];\n}\nfunction draw(time){\n const t=Math.max(0,Math.min(18,time));\n ctx.setTransform(1,0,0,1,0,0);\n ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';\n ctx.setLineDash([]);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';\n ctx.shadowBlur=0;ctx.shadowColor='transparent';ctx.shadowOffsetX=0;ctx.shadowOffsetY=0;\n ctx.clearRect(0,0,1080,1080);\n ctx.fillStyle=C.bg;ctx.fillRect(0,0,1080,1080);\n const endHold=t>=11.70;\n const s=stateAt(endHold?SIMULATION_END:t);\n const empty=s.count===0;\n\n // Open-topped vessel and ten token slots, filled from the bottom.\n ctx.strokeStyle=empty?'#874b47':C.outline;ctx.lineWidth=1.5;\n ctx.beginPath();ctx.moveTo(95.5,176);ctx.lineTo(95.5,622);\n ctx.lineTo(324.5,622);ctx.lineTo(324.5,176);ctx.stroke();\n for(let bottom=0;bottom<10;bottom++){\n  const y=572-bottom*42;\n  ctx.strokeStyle=C.slot;ctx.lineWidth=0.8;\n  ctx.strokeRect(112.5,y+0.5,195,33);\n  if(bottom<s.count){ctx.fillStyle=C.blue;ctx.fillRect(112,y,196,34);}\n }\n if(s.count<10){\n  const nextY=572-s.count*42;\n  // State-based accent reconstruction; durations between samples are unresolved.\n  if(t>=1.90&&t<6.40&&s.count!==1){\n   ctx.strokeStyle='#38764a';ctx.lineWidth=1.25;\n   ctx.strokeRect(112.5,nextY+0.5,195,33);\n  }\n  // Approximately five pixels at the observed 9s balance of 5.2 tokens.\n  if(t>=6.40&&!endHold){\n   const fraction=Math.max(0,Math.min(1,s.balance-s.count));\n   const height=Math.min(7,fraction*26);\n   if(height>EPS){\n    ctx.fillStyle=C.blue;ctx.fillRect(112,nextY+34-height,196,height);\n   }\n  }\n }\n\n // Twelve-second chart, consolidated integer staircase and request ticks.\n const px=seconds=>112+seconds/SIMULATION_END*908;\n const py=value=>900-value*20;\n ctx.setLineDash([4,6]);line(112,700,1020,700,'#283338',0.8);\n ctx.setLineDash([]);line(112,900.5,1020,900.5,C.outline,1);\n ctx.strokeStyle=C.blue;ctx.lineWidth=1.7;ctx.beginPath();\n s.points.forEach((p,i)=>{if(i===0)ctx.moveTo(px(p[0]),py(p[1]));else ctx.lineTo(px(p[0]),py(p[1]));});\n ctx.stroke();\n for(const row of s.rows)line(px(row.at),922,px(row.at),952,row.taken?C.green:C.red,1.8);\n if(!endHold)line(px(s.time),688,px(s.time),952,'#828d92',0.8);\n\n // Small text is narrowed while retaining its established positions and sizes.\n text('token bucket, capacity 10, refill 2/s',60,66,28,C.text);\n text('opus 5.5 drew this',1020,66,28,C.muted,'right');\n const caption=captionAt(t);\n text(caption[0],60,136,32,caption[1],'left',0.97);\n countLabel(s.count);\n s.rows.slice(-6).forEach((row,i)=>{\n  const y=404+i*42;\n  text(row.at.toFixed(2)+'s',419,y,28,C.muted);\n  text('req '+String(row.id).padStart(2,' '),548,y,28,C.text);\n  text(row.taken?'taken':'refused',692,y,28,row.taken?C.green:C.red);\n  text(row.left+' left',925,y,28,C.muted);\n });\n text('10',96,708,26,C.muted,'right');\n text('0',96,908,26,C.muted,'right');\n text('0s',112,994,26,C.muted);\n text('12s',1020,994,26,C.muted,'right');\n text('@ParkerRex midweek update',60,1047,28,C.muted);\n}\nconst playhead={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{t:18,duration:18,ease:'none',onUpdate:()=>draw(playhead.t)},0);\ndraw(0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\n</script>\n</body>\n</html>",
  "width": 1080,
  "height": 1080,
  "duration_seconds": 18,
  "assumptions": [
