{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Token bucket rate limiter</title>\n<style>\nhtml,body{margin:0;width:100%;height:100%;overflow:hidden;background:#080f10}\n#root{position:relative;width:100%;height:100%;overflow:hidden}\ncanvas{display:block;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1080\" data-height=\"1080\" data-duration=\"18\" data-fps=\"30\">\n<canvas id=\"art\" class=\"clip\" data-start=\"0\" data-duration=\"18\" width=\"1080\" height=\"1080\" aria-label=\"Animated explanation of a token bucket rate limiter with capacity ten and refill rate two tokens per second\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n'use strict';\n/*\nInferred reconstruction of @ParkerRex's supplied reference, not recovered source.\nFixed camera and dashboard throughout, 1080 square, 18 seconds, silent.\n0–2.40: steady traffic. 2.40–3.30: burst. 3.30–6.40: depletion.\n6.40–11.70: recovery. 11.70–18: amber conclusion and completed graph.\nCaption boundaries and requests 4 and 11–14 are inferred between samples.\nCanvas alone draws the artwork; harness-provided GSAP only supplies seek time.\nGeneric monospace approximates the unknown typeface; large zero is drawn manually.\nNo reference images, external assets or supplied font files are used.\n*/\nconst canvas=document.getElementById('art');\nconst ctx=canvas.getContext('2d');\nconst C={bg:'#080f10',text:'#c8d2d7',muted:'#626a6f',blue:'#55a2ff',green:'#4bb366',red:'#ef4f54',amber:'#cda92f',outline:'#777f82',slot:'#30393b'};\nconst CAPACITY=10, REFILL=2, SIMULATION_END=12;\n// Inferred request times: #4=2.40, #11=3.02, #12=3.10, #13=3.15, #14=3.27.\nconst requests=[0.50,1.30,1.90,2.40,2.47,2.58,2.64,2.76,2.83,2.90,3.02,3.10,3.15,3.27,3.33,3.42,3.53,3.60,3.78,3.90,4.08,4.23,4.35,4.56,4.70,4.88,5.06,5.17,5.42,5.65,5.90,6.18,7.60];\nconst EPS=1e-8;\nconst whole=n=>Math.max(0,Math.min(CAPACITY,Math.floor(n+EPS)));\n\n// Rebuild all balances, log rows and staircase vertices from time on every call.\nfunction stateAt(time){\n const end=Math.max(0,Math.min(SIMULATION_END,time));\n let balance=CAPACITY,previous=0;\n const rows=[],points=[[0,CAPACITY]];\n function refillUntil(until){\n  const initial=balance;\n  for(let level=whole(initial)+1;level<=CAPACITY;level++){\n   const crossing=previous+(level-initial)/REFILL;\n   if(crossing>until+EPS)break;\n   points.push([crossing,level-1],[crossing,level]);\n  }\n  balance=Math.min(CAPACITY,initial+REFILL*(until-previous));\n  previous=until;\n }\n for(let i=0;i<requests.length;i++){\n  const at=requests[i];\n  if(at>end+EPS)break;\n  refillUntil(at);\n  const before=whole(balance),taken=balance+EPS>=1;\n  if(taken)balance=Math.max(0,balance-1);\n  const left=whole(balance);\n  points.push([at,before],[at,left]);\n  rows.push({at,id:i+1,taken,left});\n }\n refillUntil(end);\n points.push([end,whole(balance)]);\n return {time:end,balance,count:whole(balance),rows,points};\n}\nfunction text(str,x,y,size,color,align='left'){\n ctx.fillStyle=color;\n ctx.font=size+'px monospace';\n ctx.textAlign=align;\n ctx.textBaseline='alphabetic';\n ctx.fillText(str,x,y);\n}\nfunction line(x1,y1,x2,y2,color,width=1){\n ctx.strokeStyle=color;ctx.lineWidth=width;\n ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();\n}\nfunction zero(x,baseline,color){\n ctx.strokeStyle=color;ctx.lineWidth=11;ctx.lineCap='butt';\n ctx.beginPath();ctx.ellipse(x+45,baseline-55,31,51,0,0,Math.PI*2);ctx.stroke();\n ctx.beginPath();ctx.moveTo(x+20,baseline-14);ctx.lineTo(x+70,baseline-97);ctx.stroke();\n}\nfunction countLabel(value){\n const x=415,y=318,color=value===0?C.red:C.text;\n if(value===10){text('1',x,y,150,color);zero(x+90,y,color);}\n else if(value===0)zero(x,y,color);\n else text(String(value),x,y,150,color);\n text('/ 10 tokens',x+(value===10?180:90)+12,y,32,C.muted);\n}\nfunction captionAt(t){\n if(t<2.40)return ['steady traffic, refill keeps the bucket full',C.text];\n if(t<3.30)return ['a burst spends the saved tokens',C.text];\n if(t<6.40)return ['empty: requests refused until a token refills',C.text];\n if(t<11.70)return ['traffic eases, refill at 2/s catches up',C.text];\n return ['capacity sets the burst, refill rate sets the limit',C.amber];\n}\nfunction draw(t){\n ctx.setTransform(1,0,0,1,0,0);\n ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';\n ctx.setLineDash([]);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';\n ctx.shadowBlur=0;ctx.shadowColor='transparent';\n ctx.clearRect(0,0,1080,1080);\n ctx.fillStyle=C.bg;ctx.fillRect(0,0,1080,1080);\n const endHold=t>=11.70;\n const s=stateAt(endHold?SIMULATION_END:t);\n const empty=s.count===0;\n\n // Open-topped vessel and ten bottom-up token slots.\n ctx.strokeStyle=empty?'#87474b':C.outline;\n ctx.lineWidth=1.5;ctx.beginPath();\n ctx.moveTo(95.5,176);ctx.lineTo(95.5,622);ctx.lineTo(324.5,622);ctx.lineTo(324.5,176);ctx.stroke();\n for(let bottom=0;bottom<10;bottom++){\n  const y=572-bottom*42;\n  ctx.strokeStyle=C.slot;ctx.lineWidth=0.8;ctx.strokeRect(112.5,y+0.5,195,33);\n  if(bottom<s.count){ctx.fillStyle=C.blue;ctx.fillRect(112,y,196,34);}\n }\n // Small fractional boundary accent: inferred from the thin sampled slot fills.\n const fraction=s.balance-s.count;\n if(s.count<10&&fraction>EPS){\n  const y=572-s.count*42;\n  const h=Math.min(4,fraction*4);\n  ctx.fillStyle=empty?'#214730':'#263c55';\n  ctx.fillRect(112,y+34-h,196,h);\n }\n\n // Fixed twelve-second chart, integer staircase and accepted/refused ticks.\n const chart={x:112,y:700,w:908,h:200};\n const px=seconds=>chart.x+seconds/SIMULATION_END*chart.w;\n const py=value=>900-value*20;\n ctx.setLineDash([4,6]);\n line(chart.x,700,1020,700,'#283338',0.8);\n ctx.setLineDash([]);\n line(chart.x,900.5,1020,900.5,C.outline,1);\n ctx.strokeStyle=C.blue;ctx.lineWidth=1.7;ctx.beginPath();\n s.points.forEach((p,i)=>{if(i===0)ctx.moveTo(px(p[0]),py(p[1]));else ctx.lineTo(px(p[0]),py(p[1]));});\n ctx.stroke();\n for(const row of s.rows)line(px(row.at),922,px(row.at),952,row.taken?C.green:C.red,1.8);\n if(!endHold)line(px(s.time),688,px(s.time),952,'#828d92',0.8);\n\n // All typography stays stationary while its content updates.\n text('token bucket, capacity 10, refill 2/s',60,66,28,C.text);\n text('opus 5.5 drew this',1020,66,28,C.muted,'right');\n const caption=captionAt(t);text(caption[0],60,136,32,caption[1]);\n countLabel(s.count);\n const latest=s.rows.slice(-6);\n latest.forEach((row,i)=>{\n  const y=404+i*42;\n  text(row.at.toFixed(2)+'s',419,y,28,C.muted);\n  text('req '+String(row.id).padStart(2,' '),548,y,28,C.text);\n  text(row.taken?'taken':'refused',692,y,28,row.taken?C.green:C.red);\n  text(row.left+' left',925,y,28,C.muted);\n });\n text('10',96,708,26,C.muted,'right');\n text('0',96,908,26,C.muted,'right');\n text('0s',112,994,26,C.muted);\n text('12s',1020,994,26,C.muted,'right');\n text('@ParkerRex midweek update',60,1047,28,C.muted);\n}\nconst playhead={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{t:18,duration:18,ease:'none',onUpdate:()=>draw(playhead.t)},0);\ndraw(0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\n</script>\n</body>\n</html>","width":1080,"height":1080,"duration_seconds":18,"assumptions":["Reconstruction uses the supplied frames and brief; source has not been rendered or visually validated.","Continuous refill at two tokens per second reproduces the sampled live counts and visible request outcomes.","Unreadable request times are inferred: request 4 at 2.40s; requests 11–14 at 3.02s, 3.10s, 3.15s and 3.27s.","Caption changes at 2.40s, 3.30s, 6.40s and 11.70s, instantaneous history updates and fractional slot accents are inferred.","The completed dashboard holds through 18s. Output declares 30 fps and contains no audio.","Generic monospace and manually drawn large slashed zeros approximate the unknown typography. GSAP is used only for the required harness timeline; artwork uses Canvas exclusively."],"missing_inputs":[],"summary":"Editable 18-second Canvas reconstruction with deterministic token arithmetic, request history, staircase chart and concluding hold. Preserves reference text and attribution; rendering and matched-time review remain unperformed."}