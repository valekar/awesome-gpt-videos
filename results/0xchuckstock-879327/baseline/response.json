{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Squadron Assault</title>\n<style>\n*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#030712;font-family:Arial,Helvetica,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden;background:#030712}canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block}canvas:focus{outline:none}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"42\">\n<canvas id=\"game\" class=\"clip\" data-start=\"0\" data-duration=\"42\" width=\"1920\" height=\"1080\" tabindex=\"0\" aria-label=\"Squadron Assault. Local cooperative space battle. Enter plays or restarts. Pilot one uses WASD and Space. Pilot two uses IJKL and right Shift. Both pilots fly automatically until their controls are used.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n(()=>{\n'use strict';\nconst W=1920,H=1080,D=42,cv=document.getElementById('game'),g=cv.getContext('2d');\nconst clock={t:0},events=[];\nconst C={cyan:'#76edff',orange:'#ffb779',red:'#ff7864',white:'#e6f2ff',muted:'#839aad'};\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst mix=(a,b,p)=>a+(b-a)*p;\nconst smooth=(a,b,t)=>{const p=clamp((t-a)/(b-a),0,1);return p*p*(3-2*p)};\nconst hash=n=>{const v=Math.sin(n*127.1+311.7)*43758.5453;return v-Math.floor(v)};\nconst V=(x,y,z)=>({x,y,z});\nconst add=(a,b)=>V(a.x+b.x,a.y+b.y,a.z+b.z);\nconst sub=(a,b)=>V(a.x-b.x,a.y-b.y,a.z-b.z);\nconst mul=(a,s)=>V(a.x*s,a.y*s,a.z*s);\nconst dot=(a,b)=>a.x*b.x+a.y*b.y+a.z*b.z;\nconst cross=(a,b)=>V(a.y*b.z-a.z*b.y,a.z*b.x-a.x*b.z,a.x*b.y-a.y*b.x);\nconst norm=a=>mul(a,1/(Math.hypot(a.x,a.y,a.z)||1));\nconst lerp3=(a,b,p)=>add(a,mul(sub(b,a),p));\nfunction camera(t){\n const p=smooth(0,36,t),escape=smooth(36,42,t);\n const pos=V(480-250*p+480*escape,570-190*p+200*escape,-650+600*p-100*escape);\n const f=norm(sub(V(0,30,1550),pos)),r=norm(cross(f,V(0,1,0))),u=norm(cross(r,f));\n return {pos,f,r,u};\n}\nfunction project(p,c){const v=sub(p,c.pos),z=dot(v,c.f);return {x:W/2+dot(v,c.r)*1070/Math.max(z,1),y:H/2-dot(v,c.u)*1070/Math.max(z,1),z};}\nfunction local(c,x,y,z){return add(c.pos,add(mul(c.r,x),add(mul(c.u,y),mul(c.f,z))))}\nconst components=[\n {name:'PORT SHIELD',short:'SHIELD 01',p:V(-205,240,2030),unlock:6},\n {name:'STARBOARD SHIELD',short:'SHIELD 02',p:V(205,240,2030),unlock:14},\n {name:'COMMAND BRIDGE',short:'BRIDGE',p:V(0,175,2030),unlock:22},\n {name:'REACTOR ARRAY',short:'REACTOR',p:V(0,26,1300),unlock:30}\n];\nconst enemies=Array.from({length:24},(_,id)=>({id,spawn:3+Math.floor(id/8)*10+(id%8)*.47,side:id%2?1:-1,phase:hash(id+40)*6.28}));\nfunction enemyPosition(e,t,c){const age=t-e.spawn;return local(c,e.side*(280+110*Math.sin(age*.7+e.phase)),100+140*Math.sin(age*.95+e.phase),2050-age*300)}\nfunction shipPosition(i,p,c,t){return local(c,(i?108:-108)+p.x*80,-112-p.y*52+Math.sin(t*1.4+i)*3,390)}\nfunction simulate(t){\n const hp=[36,36,36,36],dead=[null,null,null,null],killed={},kills=[],shots=[],sparks=[];\n const pilots=[{x:0,y:0,manual:false,hull:100,aim:null},{x:0,y:0,manual:false,hull:100,aim:null}];\n const held={};let ei=0;\n const steps=Math.floor(t*30);\n for(let n=0;n<=steps;n++){\n  const ts=n/30,c=camera(ts);let active=hp.findIndex(v=>v>0);\n  while(ei<events.length&&events[ei].t<=ts){const e=events[ei++];held[e.k]=e.d;if(e.d){const ix=['KeyI','KeyJ','KeyK','KeyL','ShiftRight'].includes(e.k)?1:0;pilots[ix].manual=true;}}\n  for(let i=0;i<2;i++){\n   const p=pilots[i],keys=i?['KeyJ','KeyL','KeyI','KeyK','ShiftRight']:['KeyA','KeyD','KeyW','KeyS','Space'];\n   if(p.manual){p.x=clamp(p.x+((held[keys[1]]?1:0)-(held[keys[0]]?1:0))*.025,-1,1);p.y=clamp(p.y+((held[keys[3]]?1:0)-(held[keys[2]]?1:0))*.025,-1,1);}\n   else {p.x=Math.sin(ts*.6+i)*.15;p.y=Math.cos(ts*.7+i)*.12;}\n   let aim;\n   if(!p.manual&&active>=0){const q=project(components[active].p,c);aim={x:q.x+(i?8:-8),y:q.y};}\n   else aim={x:W*.5+p.x*W*.32,y:H*.48+p.y*H*.29};\n   p.aim=aim;\n   if(n%14!==i*7||ts<3||active<0||p.hull<=0)continue;\n   if(p.manual&&!held[keys[4]])continue;\n   const from=shipPosition(i,p,c,ts);let to=local(c,(aim.x-W/2)*1.8,-(aim.y-H/2)*1.8,1926),hit=-1,enemyHit=null;\n   if(!p.manual&&ts>=components[active].unlock){hit=active;to=components[active].p;}\n   if(p.manual){\n    for(const e of enemies){const age=ts-e.spawn;if(age<0||age>5.2||killed[e.id]!=null)continue;const wp=enemyPosition(e,ts,c),q=project(wp,c);if(Math.hypot(q.x-aim.x,q.y-aim.y)<58){enemyHit=e;to=wp;break;}}\n    if(!enemyHit)for(let j=0;j<4;j++){const q=project(components[j].p,c);if(hp[j]>0&&ts>=components[j].unlock&&Math.hypot(q.x-aim.x,q.y-aim.y)<75){hit=j;to=components[j].p;break;}}\n   }\n   if(enemyHit){killed[enemyHit.id]=ts;kills.push({t:ts,p:to,small:true});}\n   if(hit>=0){hp[hit]=Math.max(0,hp[hit]-1.5);if(hp[hit]===0){dead[hit]=ts;kills.push({t:ts,p:to,small:false});}else if(ts>t-.3)sparks.push({t:ts,p:to});}\n   if(ts>t-.32)shots.push({t:ts,from,to,i});\n  }\n  if(n>0&&n%81===0){for(let i=0;i<2;i++){const p=pilots[i],danger=Math.sin(ts*.9+i);if(Math.abs(p.x-danger)<.3&&hp.some(v=>v>0))p.hull=Math.max(0,p.hull-4);}}\n }\n const active=hp.findIndex(v=>v>0);\n return {hp,dead,killed,kills,shots,sparks,pilots,active,won:active<0,score:dead.filter(x=>x!==null).length*250+Object.keys(killed).length*50};\n}\nlet faces=[];\nfunction face(v,color,stroke='#60788b',alpha=1){faces.push({v,color,stroke,alpha})}\nfunction box(x,y,z,w,h,d,color='#334653'){\n const a=V(x-w/2,y,z-d/2),b=V(x+w/2,y,z-d/2),c=V(x+w/2,y,z+d/2),d0=V(x-w/2,y,z+d/2);\n const A=add(a,V(0,h,0)),B=add(b,V(0,h,0)),C0=add(c,V(0,h,0)),E=add(d0,V(0,h,0));\n face([a,b,B,A],'#182936');face([b,c,C0,B],'#263c4b');face([c,d0,E,C0],'#20313e');face([d0,a,A,E],'#3e5360');face([A,B,C0,E],color);\n}\nfunction dome(x,y,z,r,broken){\n for(let lat=0;lat<4;lat++)for(let k=0;k<12;k++){\n  const a=lat*Math.PI/8,b=(lat+1)*Math.PI/8,q=k*Math.PI/6,s=(k+1)*Math.PI/6;\n  const p=(u,v)=>V(x+Math.cos(u)*Math.cos(v)*r,y+Math.sin(u)*r,z+Math.cos(u)*Math.sin(v)*r);\n  face([p(a,q),p(a,s),p(b,s),p(b,q)],broken?'#192731':(k%3?'#6e8998':'#a4bdc7'),broken?'#293844':'#b0c9d3');\n }\n}\nfunction destroyer(s,t){\n const nose=V(0,0,300),l=V(-720,0,2300),r=V(720,0,2300),n0=V(0,-120,300),l0=V(-720,-150,2300),r0=V(720,-150,2300);\n face([nose,l,r],'#3e5564','#9ab5c7');face([nose,n0,l0,l],'#243846');face([nose,r,r0,n0],'#182c3b');face([l,l0,r0,r],'#172938');face([n0,r0,l0],'#101e2b');\n face([V(0,1,325),V(-45,1,2200),V(45,1,2200)],'#607787','#9eb0bc');\n for(let j=0;j<13;j++){\n  const z=520+j*130,width=(z-300)/2000*720;\n  for(const side of [-1,1]){\n   const x=side*width*.55;\n   box(x,2,z,width*.69,5,88,j%3?'#425a6a':'#526b79');\n   if(j>3)box(side*width*.84,9,z,20,8,65,'#253b4a');\n  }\n }\n for(let j=0;j<8;j++){const z=880+j*166,w=(z-300)/2000*720;for(const side of [-1,1]){box(side*w*.76,10,z,38,20,48,'#58717f');box(side*w*.76,31,z-12,9,7,65,'#859dab');}}\n box(0,5,1770,285,35,480,'#506c7d');box(0,40,1940,165,88,270,'#637d8b');box(0,128,2020,590,62,145,s.hp[2]<=0?'#243744':'#738d9b');\n box(0,190,2020,400,12,88,'#7e96a4');\n dome(-205,202,2030,42,s.hp[0]<=0);dome(205,202,2030,42,s.hp[1]<=0);\n box(0,5,1300,142,18,178,s.hp[3]<=0?'#172632':'#1a3b4a');\n for(let j=0;j<5;j++)box(0,24,1240+j*28,95,3,9,s.hp[3]<=0?'#253d46':'#68d0da');\n for(let j=0;j<15;j++){\n  const z=900+j*85,w=(z-300)/2000*720;\n  for(const side of [-1,1])box(side*w*.96,-37,z,5,8,28,'#91e5ec');\n }\n}\nfunction xwing(pos,c,scale,roll,color){\n const point=(x,y,z)=>{const X=x*Math.cos(roll)-y*Math.sin(roll),Y=x*Math.sin(roll)+y*Math.cos(roll);return add(pos,add(mul(c.r,X*scale),add(mul(c.u,Y*scale),mul(c.f,z*scale))))};\n const f=(a,col,edge='#8798a9')=>face(a.map(v=>point(...v)),col,edge);\n f([[-8,-6,-53],[8,-6,-53],[4,-3,88],[-4,-3,88]],'#768b9b');\n f([[-8,-6,-53],[-7,10,-18],[0,5,88],[-4,-3,88]],'#e1e9e9');\n f([[8,-6,-53],[7,10,-18],[0,5,88],[4,-3,88]],'#9eafb7');\n f([[-7,10,-18],[7,10,-18],[4,6,26],[-4,6,26]],'#203f58','#b7d5df');\n for(const side of [-1,1])for(const up of [-1,1]){\n  f([[side*8,up*6,-30],[side*73,up*26,-43],[side*76,up*27,-13],[side*10,up*7,8]],up>0?'#d7e0df':'#718797');\n  f([[side*30,up*14,-35],[side*59,up*23,-40],[side*60,up*23,-32],[side*31,up*14,-27]],color,color);\n  f([[side*70,up*24,-60],[side*76,up*24,-60],[side*76,up*24,30],[side*72,up*24,34]],'#d3e4e9');\n  f([[side*13,up*7,-59],[side*24,up*7,-59],[side*24,up*7,-9],[side*13,up*7,-9]],'#9aabb3');\n }\n return [-1,1].flatMap(side=>[-1,1].map(up=>point(side*18,up*8,-60)));\n}\nfunction tie(pos,c,phase){\n const r=add(mul(c.r,Math.cos(phase)),mul(c.u,Math.sin(phase))),u=add(mul(c.u,Math.cos(phase)),mul(c.r,-Math.sin(phase)));\n const p=(x,y,z)=>add(pos,add(mul(r,x),add(mul(u,y),mul(c.f,z))));\n for(const side of [-1,1]){\n  face([p(side*30,-46,-6),p(side*30,-30,15),p(side*30,30,15),p(side*30,46,-6),p(side*30,29,-20),p(side*30,-29,-20)],'#111d2b','#7292a8');\n  face([p(side*29,-40,-5),p(side*29,-26,10),p(side*29,26,10),p(side*29,40,-5)],'#233a4b','#40677e');\n  face([p(0,-3,-3),p(side*30,-3,-3),p(side*30,3,3),p(0,3,3)],'#9baeba');\n }\n face([p(-11,-10,-9),p(11,-10,-9),p(14,7,-9),p(0,15,-9),p(-14,7,-9)],'#617b90','#aac5d4');\n face([p(-7,-6,-11),p(7,-6,-11),p(9,4,-11),p(0,10,-11),p(-9,4,-11)],'#07131e','#7795b1');\n}\nfunction paintFaces(c){\n const list=faces.map(f=>({...f,q:f.v.map(v=>project(v,c))})).filter(f=>f.q.every(p=>p.z>15));\n list.sort((a,b)=>b.q.reduce((s,p)=>s+p.z,0)/b.q.length-a.q.reduce((s,p)=>s+p.z,0)/a.q.length);\n for(const f of list){g.globalAlpha=f.alpha;g.beginPath();f.q.forEach((p,i)=>i?g.lineTo(p.x,p.y):g.moveTo(p.x,p.y));g.closePath();g.fillStyle=f.color;g.fill();g.lineWidth=.9;g.strokeStyle=f.stroke;g.stroke();}g.globalAlpha=1;\n}\nfunction line(a,b,col,width=2,alpha=1){g.globalAlpha=alpha;g.strokeStyle=col;g.lineWidth=width;g.beginPath();g.moveTo(a.x,a.y);g.lineTo(b.x,b.y);g.stroke();g.globalAlpha=1;}\nfunction glow(x,y,r,col,alpha=1){g.save();g.globalAlpha=alpha;const d=g.createRadialGradient(x,y,0,x,y,r);d.addColorStop(0,col);d.addColorStop(.16,col);d.addColorStop(1,'transparent');g.fillStyle=d;g.fillRect(x-r,y-r,r*2,r*2);g.restore();}\nfunction text(str,x,y,size,col=C.white,align='left',weight=400){g.fillStyle=col;g.font=weight+' '+size+'px Arial, Helvetica, sans-serif';g.textAlign=align;g.textBaseline='middle';g.fillText(str,x,y);}\nfunction panel(x,y,w,h){g.fillStyle='rgba(5,17,29,.84)';g.fillRect(x,y,w,h);g.strokeStyle='rgba(133,193,217,.25)';g.lineWidth=1;g.strokeRect(x+.5,y+.5,w-1,h-1);}\nfunction background(t){\n const sky=g.createLinearGradient(0,0,W,H);sky.addColorStop(0,'#040b19');sky.addColorStop(.6,'#071426');sky.addColorStop(1,'#19142e');g.fillStyle=sky;g.fillRect(0,0,W,H);\n glow(1420,280,740,'#172549',.7);glow(210,650,620,'#0b3045',.55);\n for(let i=0;i<460;i++){const z=.25+hash(i+900)*.75,x=(hash(i+12)*2200-t*(1+z*3)+2200)%2200-140,y=hash(i+510)*1080;g.globalAlpha=.25+hash(i+71)*.6;g.fillStyle=i%9?'#c0d6ea':'#85c5fa';g.fillRect(x,y,z*2.3,z*2.3);}g.globalAlpha=1;\n const px=1655-t*1.5,py=194,r=290;const planet=g.createRadialGradient(px-105,py-100,15,px,py,r);planet.addColorStop(0,'#42516e');planet.addColorStop(.65,'#192c48');planet.addColorStop(1,'#081222');g.fillStyle=planet;g.beginPath();g.arc(px,py,r,0,Math.PI*2);g.fill();g.strokeStyle='rgba(115,171,215,.24)';g.lineWidth=3;g.stroke();\n g.save();g.beginPath();g.arc(px,py,r,0,Math.PI*2);g.clip();for(let i=0;i<12;i++){g.strokeStyle='rgba(112,142,173,.06)';g.lineWidth=12+i%3*5;g.beginPath();g.ellipse(px-30,py-180+i*37,310,22,-.35,0,6.283);g.stroke();}g.restore();\n}\nfunction explosion(p,age,c,small=false){\n if(age<0||age>3.5)return;const q=project(p,c);if(q.z<10)return;const k=1070/q.z,fade=1-smooth(.35,3.5,age),size=(small?32:100)*k;\n glow(q.x,q.y,size*(.4+age*1.7),'#ff7945',fade*.8);glow(q.x,q.y,size*.5,'#fff0ae',fade);\n g.save();g.globalCompositeOperation='screen';\n for(let j=0;j<(small?14:38);j++){const a=hash(j+52)*6.283,speed=(30+hash(j+66)*120)*k,dist=speed*age;const x=q.x+Math.cos(a)*dist,y=q.y+Math.sin(a)*dist+age*age*12*k;line({x,y},{x:x-Math.cos(a)*14*k,y:y-Math.sin(a)*14*k},j%3?'#ffa36c':'#fff3bd',Math.max(1,3*k),fade);}\n g.strokeStyle='rgba(255,192,125,'+fade*.5+')';g.lineWidth=2;g.beginPath();g.ellipse(q.x,q.y,size*age*2.4,size*age*.75,0,0,6.283);g.stroke();g.restore();\n}\nfunction reticle(x,y,col,scale=1){const a=18*scale,b=29*scale;for(const sx of [-1,1])for(const sy of [-1,1]){line({x:x+sx*a,y:y+sy*b},{x:x+sx*b,y:y+sy*b},col,2);line({x:x+sx*b,y:y+sy*b},{x:x+sx*b,y:y+sy*a},col,2);}line({x:x-5,y},{x:x+5,y},col,1.5);line({x,y:y-5},{x,y:y+5},col,1.5);}\nfunction hud(s,t,c){\n const top=g.createLinearGradient(0,0,0,245);top.addColorStop(0,'rgba(2,9,19,.94)');top.addColorStop(1,'rgba(2,9,19,0)');g.fillStyle=top;g.fillRect(0,0,W,245);\n text('SQUADRON',55,53,32,C.white,'left',700);text('ASSAULT',257,53,32,C.cyan,'left',400);\n line({x:55,y:84},{x:1865,y:84},'#315268',1,.7);\n text('LOCAL CO-OP',1865,41,24,C.cyan,'right',700);text('2 PILOTS  /  2 AI WINGMEN',1865,69,19,C.muted,'right');\n const names=['PORT SHIELD','STARBOARD SHIELD','COMMAND BRIDGE','REACTOR ARRAY'];\n const x0=55,gap=14,cw=442;\n for(let i=0;i<4;i++){\n  const x=x0+i*(cw+gap),done=s.hp[i]<=0,active=s.active===i,col=done?'#6bc7b2':active?C.cyan:'#7790a3';\n  panel(x,108,cw,79);g.fillStyle=col;g.fillRect(x,108,3,79);\n  text(String(i+1).padStart(2,'0'),x+21,134,19,col,'left',700);text(names[i],x+60,134,21,col,'left',700);\n  text(done?'DISABLED':active?(t<components[i].unlock?'ACQUIRING':'TARGET LOCK'):'SHIELDED',x+cw-19,164,16,col,'right',700);\n  g.fillStyle='#233b49';g.fillRect(x+20,158,200,6);g.fillStyle=col;g.fillRect(x+20,158,200*s.hp[i]/36,6);\n }\n if(s.active>=0&&t>3){\n  for(let i=0;i<4;i++)if(s.hp[i]>0){const q=project(components[i].p,c);if(q.z<0)continue;const active=s.active===i;g.globalAlpha=active?1:.36;reticle(q.x,q.y,active?C.cyan:'#8ba6b7',active?1.5:1);if(active){text(components[i].short,q.x+57,q.y-24,20,C.cyan,'left',700);text(Math.ceil(s.hp[i]/36*100)+'% INTEGRITY',q.x+57,q.y+2,17,'#b2c7d5');}g.globalAlpha=1;}\n }\n for(let i=0;i<2;i++){\n  const p=s.pilots[i],col=i?C.orange:C.cyan,x=i?1470:55;\n  panel(x,895,395,132);g.fillStyle=col;g.fillRect(x,895,4,132);\n  text('P'+(i+1)+'  '+(i?'GOLD LEADER':'RED LEADER'),x+22,922,24,col,'left',700);\n  text(p.manual?'MANUAL':'AUTO FLIGHT',x+372,922,16,col,'right',700);\n  text('HULL',x+22,957,17,C.muted);g.fillStyle='#263b4b';g.fillRect(x+82,951,234,9);g.fillStyle=col;g.fillRect(x+82,951,234*p.hull/100,9);text(p.hull+'%',x+372,957,18,C.white,'right');\n  text(i?'I J K L  MOVE   /   RIGHT SHIFT  FIRE':'W A S D  MOVE   /   SPACE  FIRE',x+22,996,18,'#b1c3d0');\n  if(p.manual&&s.active>=0)reticle(p.aim.x,p.aim.y,col,.7);\n }\n const complete=s.dead.filter(v=>v!==null).length;\n text(s.won?'ALL COMPONENTS DISABLED':s.active<2?'DESTROY THE SHIELD GENERATORS':s.active===2?'DISABLE THE COMMAND BRIDGE':'STRIKE THE REACTOR ARRAY',960,951,23,C.white,'center',700);\n for(let i=0;i<4;i++){g.fillStyle=i<complete?C.cyan:'#254052';g.fillRect(670+i*147,984,135,5);}\n text(complete+' / 4 OBJECTIVES',670,1013,17,C.muted);text('WAVE '+Math.min(3,Math.max(1,1+Math.floor((t-3)/10)))+' / 3',1245,1013,17,C.muted,'right');\n text('ENTER  PLAY / RESTART',960,1051,16,'#7892a5','center');\n if(t<3.7){const opacity=smooth(.15,.8,t)*(1-smooth(2.8,3.7,t));g.save();g.globalAlpha=opacity;text('BREAK THE SHIELD.',960,345,72,C.white,'center',700);text('Four critical targets. One squadron.',960,407,29,'#a7c7db','center');text('AUTOPILOT DEMO  ·  USE EITHER PILOT’S CONTROLS TO JOIN',960,454,19,C.cyan,'center');g.restore();}\n if(s.won){const last=Math.max(...s.dead),a=smooth(last+.4,last+1.3,t);g.save();g.globalAlpha=a;panel(475,345,970,245);g.fillStyle=C.cyan;g.fillRect(475,345,970,3);text('MISSION COMPLETE',960,393,22,C.cyan,'center',700);text('DESTROYER DISABLED',960,455,55,C.white,'center',700);text('4 / 4 COMPONENTS  ·  SQUADRON EXTRACTING',960,516,23,'#a9c8d9','center');g.restore();}\n else if(t>40){g.save();g.globalAlpha=smooth(40,41,t);panel(575,360,770,180);text('ASSAULT WINDOW CLOSED',960,415,42,C.white,'center',700);text(complete+' / 4 COMPONENTS DISABLED  ·  ENTER TO RETRY',960,478,22,C.cyan,'center');g.restore();}\n}\nfunction render(t){\n const s=simulate(t),c=camera(t);g.setTransform(1,0,0,1,0,0);g.globalAlpha=1;g.globalCompositeOperation='source-over';background(t);faces=[];destroyer(s,t);\n for(const e of enemies){const age=t-e.spawn;if(age<0||age>5.2||s.killed[e.id]!=null)continue;tie(enemyPosition(e,t,c),c,Math.sin(age*.8+e.phase)*.22);}\n const engines=[];\n for(let i=0;i<2;i++)engines.push(...xwing(shipPosition(i,s.pilots[i],c,t),c,.84,-s.pilots[i].x*.24,i?'#d39a58':'#b84e4b'));\n for(let i=0;i<2;i++)engines.push(...xwing(local(c,(i?1:-1)*(330+20*Math.sin(t)),50+20*Math.sin(t*.6+i),920+40*Math.cos(t*.6+i)),c,.75,Math.sin(t*.5+i)*.13,i?'#d39a58':'#b84e4b'));\n paintFaces(c);\n for(const p of engines){const q=project(p,c);glow(q.x,q.y,Math.max(7,1070/q.z*8),'#ff8dba',.85);}\n // Shield energy is removed by the first two objective hits.\n for(let i=0;i<2;i++)if(s.hp[i]>0){const q=project(components[i].p,c),r=55*1070/q.z;glow(q.x,q.y,r*1.7,'#3cc5f0',.25);g.strokeStyle='rgba(125,228,255,.45)';g.lineWidth=1.5;g.beginPath();g.ellipse(q.x,q.y,r,r*.65,-.13,0,6.283);g.stroke();}\n for(const b of s.shots){const age=t-b.t,p=clamp(age/.23,0,1),a=project(lerp3(b.from,b.to,Math.max(0,p-.18)),c),z=project(lerp3(b.from,b.to,p),c);if(p<1){line(a,z,b.i?'#ffc58d':'#ff756a',5,1);line(a,z,'#fff3db',1.6,1);glow(z.x,z.y,15,b.i?'#ffb275':'#ff5c67',.7);}}\n // Destroyer batteries launch deterministic green bolts toward the squadron.\n for(let j=0;j<8;j++){\n  const period=2.25,phase=t-j*.27,cycle=Math.floor(phase/period),age=phase-cycle*period;if(phase<0||age>.85||s.won)continue;\n  const z=1000+(j%4)*240,w=(z-300)/2000*720,origin=V((j%2?1:-1)*w*.76,42,z),dest=local(c,Math.sin(cycle*2.1+j)*270,-100,150);\n  const p=age/.85,a=project(lerp3(origin,dest,Math.max(0,p-.09)),c),b=project(lerp3(origin,dest,p),c);if(a.z>10&&b.z>10){line(a,b,'#8cff88',3,1);glow(b.x,b.y,8,'#7aff80',.7);}\n }\n for(const e of enemies){const age=t-e.spawn;if(age>=2&&age<4.5&&s.killed[e.id]==null){const f=(age-2)%1.1;if(f<.35){const origin=enemyPosition(e,t-f,c),dest=local(c,e.side*80,-100,260),p=f/.35;line(project(lerp3(origin,dest,Math.max(0,p-.12)),c),project(lerp3(origin,dest,p),c),'#92ff9a',3,.9);}}\n  if(age>5.2&&age<6.7&&s.killed[e.id]==null)explosion(enemyPosition(e,e.spawn+5.2,camera(e.spawn+5.2)),age-5.2,c,true);\n }\n for(const k of s.kills)explosion(k.p,t-k.t,c,k.small);\n for(const p of s.sparks){const q=project(p.p,c);glow(q.x,q.y,25,'#fff1b2',1-(t-p.t)/.3);}\n for(let i=0;i<4;i++)if(s.dead[i]!=null){const age=t-s.dead[i],q=project(components[i].p,c);if(age>.3){glow(q.x,q.y,34,'#ff6c38',.45+.15*Math.sin(age*7));for(let j=0;j<7;j++){const drift=(age*.13+j*.19)%1;g.fillStyle='rgba(18,25,34,'+(.32*(1-drift))+')';g.beginPath();g.arc(q.x+Math.sin(j*4)*14+drift*30,q.y-drift*140,14+drift*42,0,6.283);g.fill();}}}\n const vignette=g.createRadialGradient(960,520,300,960,520,1110);vignette.addColorStop(0,'transparent');vignette.addColorStop(1,'rgba(0,3,11,.64)');g.fillStyle=vignette;g.fillRect(0,0,W,H);\n hud(s,t,c);\n}\nconst tl=gsap.timeline({paused:true});\ntl.to(clock,{t:D,duration:D,ease:'none',onUpdate:()=>render(clock.t)},0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=tl;\nconst controls=new Set(['KeyW','KeyA','KeyS','KeyD','Space','KeyI','KeyJ','KeyK','KeyL','ShiftRight']);\nconst physical=new Set();\nfunction input(e,down){\n if(e.code==='Enter'&&down&&!e.repeat){e.preventDefault();events.length=0;physical.clear();tl.restart();return;}\n if(!controls.has(e.code))return;e.preventDefault();\n if(down&&physical.has(e.code))return;\n if(down)physical.add(e.code);else physical.delete(e.code);\n // An edit after seeking replaces subsequent input history.\n while(events.length&&events[events.length-1].t>clock.t)events.pop();\n events.push({t:clock.t,k:e.code,d:down});render(clock.t);\n}\nwindow.addEventListener('keydown',e=>input(e,true));window.addEventListener('keyup',e=>input(e,false));\nwindow.addEventListener('blur',()=>{for(const k of physical)events.push({t:clock.t,k,d:false});physical.clear();});\nrender(0);\n})();\n</script>\n</body>\n</html>","width":1920,"height":1080,"duration_seconds":42,"assumptions":["Chosen format: 1920×1080, 42 seconds, with a deterministic automatic battle demonstration.","Multiplayer is implemented as two-player local keyboard co-op, with two additional AI wingmen. Online networking requires a separate service and is not included.","Enter starts or restarts the single timeline. WASD/Space and IJKL/right Shift independently give each human pilot control during playback.","All spacecraft, environments, effects and interface artwork are procedural Canvas geometry; no external assets or fonts are required beyond the supplied gsap.min.js.","The requested spacecraft designs reference Star Wars. No licensed franchise artwork is included; franchise permission and distribution rights are not established.","This source has not been rendered or visually reviewed."],"missing_inputs":[],"summary":"Editable 3D-projected space assault with local co-op, four destructible objectives, mounted batteries, TIE waves and automatic demonstration playback."}