{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Opus 5.5 — A Mind in Motion</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#121212}#root{position:relative;width:100%;height:100%;overflow:hidden}canvas{display:block;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"10\">\n<canvas id=\"art\" class=\"clip\" data-start=\"0\" data-duration=\"10\" width=\"1920\" height=\"1080\" aria-label=\"An abstract kinetic portrait of Opus 5.5, moving from a question through broken patterns into new possibilities.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n/* Editable creative controls. Every frame is computed exclusively from time. */\nconst DESIGN={paper:'#F3F0E7',ink:'#151515',orange:'#FF4C24',blue:'#254BFF',width:1920,height:1080};\nconst COPY={title:'OPUS',version:'5.5',question:['WHAT','IF?'],questionCaption:'FOLLOW THE QUESTION.',pattern:['BREAK','THE PATTERN.'],possibility:['FIND THE','POSSIBILITY.'],ending:'LET’S MAKE SOMETHING.'};\nconst STARTS=[0,1.9,3.8,5.9,8.0],WIPE=.28;\nconst canvas=document.getElementById('art'),ctx=canvas.getContext('2d');\nconst W=DESIGN.width,H=DESIGN.height,TAU=Math.PI*2;\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,p)=>a+(b-a)*p;\nconst out=p=>1-Math.pow(1-clamp(p),3);\nconst smooth=p=>{p=clamp(p);return p*p*(3-2*p)};\nconst pop=p=>{p=clamp(p);return 1+2.70158*Math.pow(p-1,3)+1.70158*Math.pow(p-1,2)};\nfunction bg(color){ctx.fillStyle=color;ctx.fillRect(0,0,W,H)}\nfunction circle(x,y,r,color){if(r<=0)return;ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fillStyle=color;ctx.fill()}\nfunction text(s,x,y,size,color,options={}){ctx.save();ctx.font=`${options.weight||900} ${size}px ${options.family||'Arial, Helvetica, sans-serif'}`;ctx.textAlign=options.align||'center';ctx.textBaseline='middle';ctx.fillStyle=color;if(options.stroke){ctx.lineWidth=options.stroke;ctx.strokeStyle=color;ctx.strokeText(s,x,y)}else ctx.fillText(s,x,y);ctx.restore()}\nfunction fit(s,size,maxWidth){ctx.save();ctx.font=`900 ${size}px Arial, Helvetica, sans-serif`;let n=size*Math.min(1,maxWidth/ctx.measureText(s).width);ctx.restore();return n}\nfunction arc(x,y,r,a,b,color,width){ctx.beginPath();ctx.arc(x,y,r,a,b);ctx.strokeStyle=color;ctx.lineWidth=width;ctx.stroke()}\nfunction line(x1,y1,x2,y2,color,width){ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.strokeStyle=color;ctx.lineWidth=width;ctx.stroke()}\nfunction opening(t){\n bg(DESIGN.ink);\n const aperture=out(t/.48)*1220;\n ctx.save();ctx.beginPath();ctx.arc(960,540,Math.max(.01,aperture),0,TAU);ctx.clip();bg(DESIGN.paper);\n const ring=out((t-.1)/.65);\n ctx.save();ctx.translate(960,520);ctx.rotate(-.3+t*.3);\n for(let i=0;i<4;i++){let a=i*TAU/4;arc(0,0,430*ring,a,a+1.16,DESIGN.ink,2);circle(Math.cos(a+1.16)*430*ring,Math.sin(a+1.16)*430*ring,9,DESIGN.orange)}\n ctx.restore();\n const letters=COPY.title.split(''),positions=[641,852,1062,1273];\n letters.forEach((letter,i)=>{let e=pop((t-.16-i*.065)/.55);ctx.save();ctx.translate(positions[i],475+(1-e)*350);ctx.rotate((1-e)*(.16-i*.09));text(letter,0,0,300,DESIGN.ink);ctx.restore()});\n const v=out((t-.5)/.5);ctx.save();ctx.translate(960,730+(1-v)*90);ctx.scale(v||.001,v||.001);text(COPY.version,0,0,172,DESIGN.orange);ctx.restore();\n let a=t*2.4-.8;circle(960+Math.cos(a)*430,520+Math.sin(a)*430,19,DESIGN.orange);\n ctx.restore();\n if(t<.16)circle(960,540,9+out(t/.16)*12,DESIGN.orange);\n}\nfunction question(t){\n bg(DESIGN.orange);\n const enter=out(t/.52);\n ctx.save();ctx.translate(520,500);ctx.scale(enter||.001,enter||.001);ctx.rotate(-.12+.035*Math.sin(t*3));\n for(let i=0;i<5;i++)arc(0,0,205+i*40,-1.9+t*(.45+i*.035),1.8+t*(.45+i*.035),i%2?DESIGN.paper:DESIGN.ink,i===2?5:2);\n text('?',0,13,455,DESIGN.ink);\n ctx.restore();\n const size=238;\n COPY.question.forEach((s,i)=>{let e=out((t-.15-i*.10)/.45);ctx.save();ctx.beginPath();ctx.rect(935,230+i*230,850,250);ctx.clip();text(s,1308+(1-e)*550,360+i*230,size,DESIGN.paper);ctx.restore()});\n const reveal=out((t-.4)/.6);line(945,740,945+730*reveal,740,DESIGN.ink,5);\n ctx.save();ctx.globalAlpha=out((t-.55)/.35);text(COPY.questionCaption,960,903,60,DESIGN.ink);ctx.restore();\n const a=-2.2+t*2.7;circle(520+Math.cos(a)*325,500+Math.sin(a)*325,23,DESIGN.paper);\n for(let i=0;i<3;i++){let phase=t*1.1+i*.24;let x=810+((phase%1)*1100);let y=142+Math.sin(phase*TAU)*38;circle(x,y,6+i*2,DESIGN.ink)}\n}\nfunction slicedText(s,y,size,t,delay){\n let fs=fit(s,size,1680),e=out((t-delay)/.65),bands=10,top=y-fs*.64,bandH=fs*1.35/bands;\n for(let j=0;j<bands;j++){\n ctx.save();ctx.beginPath();ctx.rect(0,top+j*bandH,W,bandH+.8);ctx.clip();\n let shift=(1-e)*(j%2?1:-1)*(280+50*Math.sin(j*1.7));\n text(s,960+shift,y,fs,DESIGN.paper);ctx.restore();\n }\n}\nfunction pattern(t){\n bg(DESIGN.blue);\n const burst=out((t-.18)/1.25);\n for(let row=0;row<7;row++)for(let col=0;col<13;col++){\n const k=row*13+col,x=col*160,y=row*170;\n const vx=x-960,vy=y-540;\n ctx.save();ctx.translate(x+vx*burst*.13,y+vy*burst*.13);ctx.rotate(Math.sin(k*2.31)*burst*.75);\n ctx.globalAlpha=.22*(1-burst*.55);ctx.strokeStyle=DESIGN.paper;ctx.lineWidth=2;ctx.strokeRect(-48,-48,96,96);ctx.restore();\n }\n let impact=1+.045*Math.sin(t*17)*Math.exp(-t*3);\n ctx.save();ctx.translate(960,540);ctx.scale(impact,impact);ctx.translate(-960,-540);\n slicedText(COPY.pattern[0],386,300,t,.08);slicedText(COPY.pattern[1],674,222,t,.23);ctx.restore();\n let lineE=out((t-.65)/.45);\n ctx.save();ctx.translate(960,815);ctx.rotate(-.045);ctx.fillStyle=DESIGN.orange;ctx.fillRect(-790*lineE,-13,1580*lineE,26);ctx.restore();\n for(let i=0;i<8;i++){let a=i*TAU/8+.2,dist=260+burst*660;ctx.save();ctx.translate(960+Math.cos(a)*dist,540+Math.sin(a)*dist);ctx.rotate(a+t*(i%2?1:-1));ctx.fillStyle=DESIGN.orange;ctx.fillRect(-10,-35,20,70);ctx.restore()}\n}\nfunction possibility(t){\n bg(DESIGN.paper);\n const e=out(t/.55),spread=lerp(430,210,smooth((t-.25)/1.5));\n ctx.save();ctx.beginPath();ctx.rect(0,325,W,440);ctx.clip();\n for(let i=0;i<25;i++){\n let n=(i-12)/12,osc=Math.sin(t*1.8+i*.18)*24;\n ctx.beginPath();ctx.moveTo(-120,540+n*spread*1.6+osc);\n ctx.bezierCurveTo(500,540+n*spread,650,540-n*spread*.7,960,540+n*24);\n ctx.bezierCurveTo(1280,540+n*spread*.7,1420,540-n*spread,2040,540-n*spread*1.5-osc);\n ctx.lineWidth=i%6===0?13:3;ctx.strokeStyle=i%6===0?DESIGN.orange:(i%3===0?DESIGN.blue:DESIGN.ink);ctx.globalAlpha=e;ctx.stroke();\n }\n ctx.restore();\n ctx.save();ctx.translate(960,540);ctx.rotate(t*.22);let r=104*pop((t-.15)/.65);circle(0,0,r,DESIGN.orange);circle(0,0,r*.5,DESIGN.paper);ctx.fillStyle=DESIGN.ink;ctx.fillRect(-8,-r-21,16,42);ctx.fillRect(-8,r-21,16,42);ctx.restore();\n let titleE=out((t-.04)/.48);text(COPY.possibility[0],960,222+(1-titleE)*75,145,DESIGN.ink);\n let bottomE=out((t-.2)/.55);text(COPY.possibility[1],960,862+(1-bottomE)*110,fit(COPY.possibility[1],204,1660),DESIGN.ink);\n const u=clamp((t-.2)/1.8);circle(lerp(-100,2020,u),540+Math.sin(u*TAU)*100,17,DESIGN.blue);\n}\nfunction finale(t){\n bg(DESIGN.ink);\n const enter=out(t/.6),settle=smooth((t-.4)/1.3);\n ctx.save();ctx.translate(960,505);ctx.rotate(-.4+t*.2);\n for(let i=0;i<36;i++){\n const a=i*TAU/36,r=lerp(800,435,enter)+Math.sin(i*1.8+t*2)*lerp(40,4,settle);\n ctx.save();ctx.rotate(a);ctx.translate(r,0);ctx.rotate((1-enter)*i*.14);\n ctx.fillStyle=i%6===0?DESIGN.orange:(i%6===3?DESIGN.blue:DESIGN.paper);\n const length=i%3===0?56:25;ctx.fillRect(-length/2,-4,length,8);ctx.restore();\n }\n ctx.restore();\n ctx.save();ctx.translate(960,475);let s=lerp(.7,1,pop(t/.65));ctx.scale(s,s);ctx.globalAlpha=enter;text(COPY.title,0,-55,286,DESIGN.paper);text(COPY.version,0,164,168,DESIGN.orange);ctx.restore();\n const e=out((t-.55)/.55);ctx.save();ctx.beginPath();ctx.rect(150,847,1620,110);ctx.clip();text(COPY.ending,960,900+(1-e)*120,62,DESIGN.paper);ctx.restore();\n let a=-.6+t*1.1;circle(960+Math.cos(a)*435,505+Math.sin(a)*435,16,DESIGN.orange);\n}\nconst SCENES=[opening,question,pattern,possibility,finale];\nfunction renderScene(i,t){ctx.save();SCENES[i](Math.max(0,t-STARTS[i]+(i?WIPE:0)));ctx.restore()}\nfunction draw(t){\n t=clamp(t,0,10);ctx.setTransform(1,0,0,1,0,0);ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';ctx.clearRect(0,0,W,H);\n let i=0;for(let j=1;j<STARTS.length;j++)if(t>=STARTS[j])i=j;\n renderScene(i,t);\n if(i<SCENES.length-1&&t>STARTS[i+1]-WIPE){\n const p=smooth((t-(STARTS[i+1]-WIPE))/WIPE),edge=lerp(W+650,-650,p);\n ctx.save();ctx.beginPath();ctx.moveTo(edge+360,-10);ctx.lineTo(W+1000,-10);ctx.lineTo(W+1000,H+10);ctx.lineTo(edge-360,H+10);ctx.closePath();ctx.clip();renderScene(i+1,t);ctx.restore();\n }\n}\nconst playhead={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{t:10,duration:10,ease:'none',onUpdate:()=>draw(playhead.t)},0);\ndraw(0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\n</script>\n</body>\n</html>","width":1920,"height":1080,"duration_seconds":10,"assumptions":["Chose a 1920×1080 landscape format and a silent, five-beat kinetic portrait with ivory, ink, vermilion and electric blue.","“Opus 5.5” is treated as the requested artistic persona; the animation makes no verified product, capability or model-identity claims.","Artwork is procedural Canvas with generic system fonts. No external assets, factual research or asset licenses are required; GSAP is supplied by the harness.","This source has not been rendered or visually reviewed."],"missing_inputs":[],"summary":"A complete editable 10-second animation: expanding typography, orbital questions, fractured patterns, flowing possibilities and a bold Opus 5.5 finale."}