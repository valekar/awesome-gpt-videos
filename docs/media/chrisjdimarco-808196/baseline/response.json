{
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>The Public — A Civic Motion Manifesto</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#162edb}body{font-family:Arial,Helvetica,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden}canvas{position:absolute;inset:0;width:100%;height:100%;display:block}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"60\">\n<canvas id=\"art\" class=\"clip\" data-start=\"0\" data-duration=\"60\" width=\"1920\" height=\"1080\" role=\"img\" aria-label=\"A sixty-second civic motion manifesto about informed citizens, corruption, Adam Smith's warning about collusion, and democratic accountability.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n/* EDITABLE SETTINGS: scene timings, colors and copy. All drawings are procedural.\n   Artwork is recomputed from absolute time; there are no independent clocks. */\nconst W=1920,H=1080;\nconst P={blue:'#162edb',paper:'#f3efdf',ink:'#17191b',green:'#d7ff52',red:'#f44836',orange:'#ff713d'};\nconst COPY={\n opener:['A FREE','SOCIETY','NEEDS YOU.'],\n information:['INFORMATION','IS CIVIC POWER.'],\n concentration:['POWER LOVES','TO CONCENTRATE.'],\n corruption:['WHEN MONEY','BUYS THE RULES,'],\n smith:['the conversation ends','in a conspiracy','against the public'],\n markets:['MARKETS SHOULD','SERVE SOCIETY.'],\n authoritarianism:['FASCISM THRIVES','WHEN SCRUTINY','IS SILENCED.'],\n actions:[['QUESTION.','Ask who benefits.'],['VERIFY.','Check the evidence.'],['PARTICIPATE.','Defend a free press.'],['VOTE.','Make power answer.']],\n closing:['STAY INFORMED.','KEEP POWER','ACCOUNTABLE.']\n};\nconst starts=[0,6,12,18,24,31,37,44,51];\nconst lengths=[6,6,6,6,7,6,7,7,9];\nconst canvas=document.getElementById('art');\nconst c=canvas.getContext('2d');\nconst TAU=Math.PI*2;\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,p)=>a+(b-a)*p;\nconst ease=v=>1-Math.pow(1-clamp(v),3);\nconst smooth=v=>{v=clamp(v);return v*v*(3-2*v)};\nconst enter=(t,delay=0,d=.7)=>ease((t-delay)/d);\nconst hash=n=>{let z=Math.sin(n*127.1+311.7)*43758.5453;return z-Math.floor(z)};\nfunction rect(x,y,w,h,color){c.fillStyle=color;c.fillRect(x,y,w,h)}\nfunction line(x,y,a,b,color,width=3){c.beginPath();c.moveTo(x,y);c.lineTo(a,b);c.strokeStyle=color;c.lineWidth=width;c.stroke()}\nfunction circle(x,y,r,fill,stroke=null,lw=2){if(r<=0)return;c.beginPath();c.arc(x,y,r,0,TAU);if(fill){c.fillStyle=fill;c.fill()}if(stroke){c.strokeStyle=stroke;c.lineWidth=lw;c.stroke()}}\nfunction text(s,x,y,size,color=P.ink,weight=900,align='left',family='Arial, Helvetica, sans-serif'){\n c.font=weight+' '+size+'px '+family;c.textAlign=align;c.textBaseline='alphabetic';c.fillStyle=color;c.fillText(s,x,y);\n}\nfunction rise(s,x,y,size,color,t,delay=0,align='left',weight=900){\n const p=enter(t,delay);c.save();c.globalAlpha=p;c.beginPath();c.rect(0,y-size-8,W,size+24);c.clip();text(s,x,y+(1-p)*size*1.2,size,color,weight,align);c.restore();\n}\nfunction stack(lines,x,y,size,gap,color,t,delay=0,align='left'){\n lines.forEach((s,i)=>rise(s,x,y+i*gap,size,color,t,delay+i*.13,align));\n}\nfunction arrow(x1,y1,x2,y2,color,width=6,head=20){\n line(x1,y1,x2,y2,color,width);let a=Math.atan2(y2-y1,x2-x1);c.beginPath();c.moveTo(x2,y2);c.lineTo(x2-head*Math.cos(a-.5),y2-head*Math.sin(a-.5));c.lineTo(x2-head*Math.cos(a+.5),y2-head*Math.sin(a+.5));c.closePath();c.fillStyle=color;c.fill();\n}\nfunction grid(color,alpha=.12,step=90){c.save();c.globalAlpha=alpha;for(let x=0;x<=W;x+=step)line(x,0,x,H,color,1);for(let y=0;y<=H;y+=step)line(0,y,W,y,color,1);c.restore()}\nfunction dots(color,alpha=.15){c.save();c.globalAlpha=alpha;for(let y=20;y<H;y+=30)for(let x=20;x<W;x+=30)circle(x,y,1.25,color);c.restore()}\nfunction grain(t,color=P.ink,alpha=.045){\n c.save();c.globalAlpha=alpha;const phase=Math.floor(t*8);for(let i=0;i<750;i++){const x=hash(i*3+phase*.017)*W,y=hash(i*3+1+phase*.023)*H;rect(x,y,1+hash(i+19)*3,1,color)}c.restore();\n}\nfunction eye(x,y,w,h,t,color,irisColor,bg){\n c.save();c.translate(x,y);const open=.92+.08*Math.sin(t*1.5);c.scale(1,open);\n c.beginPath();c.moveTo(-w/2,0);c.bezierCurveTo(-w*.24,-h*.74,w*.24,-h*.74,w/2,0);c.bezierCurveTo(w*.24,h*.74,-w*.24,h*.74,-w/2,0);c.closePath();c.fillStyle=color;c.fill();\n c.save();c.clip();const px=Math.sin(t*.65)*w*.045;circle(px,0,h*.42,irisColor);circle(px,0,h*.18,bg);circle(px-h*.09,-h*.13,h*.055,color);c.restore();c.restore();\n}\nfunction orbit(x,y,r,t,color,count=12){\n c.save();c.strokeStyle=color;c.lineWidth=2;c.beginPath();c.arc(x,y,r,0,TAU);c.stroke();\n for(let i=0;i<count;i++){let a=TAU*i/count+t*.11;circle(x+Math.cos(a)*r,y+Math.sin(a)*r,7+(i%3)*3,color)}c.restore();\n}\nfunction pill(s,x,y,w,color,ink,t,d=0){let p=enter(t,d);c.save();c.globalAlpha=p;c.translate((1-p)*-100,0);rect(x,y,w,74,color);text(s,x+25,y+50,37,ink,800);c.restore()}\nfunction scene0(t){\n rect(0,0,W,H,P.blue);dots(P.paper,.15);\n const intro=enter(t,0,1);c.save();c.translate(1430,545);c.rotate(-.14+t*.025);c.scale(intro,intro);\n for(let i=0;i<28;i++){const a=TAU*i/28;let r=355+15*Math.sin(i*2+t);line(Math.cos(a)*r,Math.sin(a)*r,Math.cos(a)*(r+45),Math.sin(a)*(r+45),P.green,5)}c.restore();\n stack(COPY.opener,110,270,132,145,P.paper,t,.1);\n c.save();c.translate(1430,545);c.rotate(-.14);c.scale(intro,intro);eye(0,0,760,400,t,P.paper,P.green,P.blue);c.restore();\n rise('Democracy begins with an informed public.',115,940,43,P.paper,t,1.3,'left',500);\n const p=enter(t,2.3,1.2);line(115,982,115+1650*p,982,P.green,6);\n}\nfunction newspaper(x,y,w,h,angle,title,t,i){\n let p=enter(t,.55+i*.18,.8);c.save();c.translate(x+w/2,y+h/2+(1-p)*300);c.rotate(angle*(.5+.5*p));c.globalAlpha=p;\n rect(-w/2+14,-h/2+18,w,h,P.ink);rect(-w/2,-h/2,w,h,P.paper);c.strokeStyle=P.ink;c.lineWidth=3;c.strokeRect(-w/2,-h/2,w,h);\n text(title,-w/2+32,-h/2+73,46,P.ink,900);line(-w/2+32,-h/2+100,w/2-32,-h/2+100,P.ink,5);\n if(i===0){circle(0,35,82,P.blue);text('?',0,74,111,P.paper,900,'center')}\n if(i===1){c.strokeStyle=P.blue;c.lineWidth=17;c.beginPath();c.moveTo(-92,30);c.lineTo(-25,94);c.lineTo(106,-62);c.stroke()}\n if(i===2){for(let j=0;j<3;j++){rect(-w/2+35,-35+j*54,w-70,25,j===1?P.blue:P.ink);circle(w/2-60,-23+j*54,7,P.paper)}}\n for(let k=0;k<2;k++)line(-w/2+32,h/2-60+k*15,w/2-32-(k%2)*65,h/2-60+k*15,P.ink,4);\n c.restore();\n}\nfunction scene1(t){\n rect(0,0,W,H,P.paper);grid(P.ink,.07,90);\n stack(COPY.information,110,195,110,120,P.ink,t,.03);\n rise('A headline is a starting point. Evidence is the test.',115,408,40,P.blue,t,.6,'left',600);\n newspaper(125,520,500,390,-.05,'QUESTION',t,0);\n newspaper(710,520,500,390,.035,'CHECK',t,1);\n newspaper(1295,520,500,390,-.025,'COMPARE',t,2);\n const q=enter(t,1.3);c.save();c.globalAlpha=q;arrow(630,715,694,715,P.red,7,20);arrow(1215,715,1279,715,P.red,7,20);c.restore();\n}\nfunction scene2(t){\n rect(0,0,W,H,P.ink);grid(P.green,.075,100);\n const pull=smooth((t-1.2)/3.5),hx=1380,hy=585;\n for(let i=0;i<32;i++){\n  let a=i*2.39996,r=210+hash(i+81)*245;\n  let ox=hx+Math.cos(a)*r,oy=hy+Math.sin(a)*r;\n  let x=lerp(ox,hx+(ox-hx)*.28,pull),y=lerp(oy,hy+(oy-hy)*.28,pull);\n  c.save();c.globalAlpha=.25+.4*enter(t,.25+i*.015);line(ox,oy,hx,hy,P.green,2);c.restore();\n  circle(x,y,(10+hash(i+12)*12)*enter(t,i*.015),P.green);\n }\n const rr=75+pull*80;circle(hx,hy,rr,P.green);eye(hx,hy,rr*1.5,rr*.75,t,P.ink,P.paper,P.green);\n orbit(hx,hy,375,t,P.green,8);\n stack(COPY.concentration,110,185,103,118,P.paper,t,.1);\n rise('Who checks the center?',115,815,55,P.green,t,1.1);\n rise('Concentrated power demands public scrutiny.',115,904,37,P.paper,t,1.5,'left',500);\n}\nfunction circuitToken(t,phase){\n const u=((t*.17+phase)%1+1)%1;const x0=450,x1=1470,y0=467,y1=843;let x,y;\n if(u<.38){x=lerp(x0,x1,u/.38);y=y0}else if(u<.5){x=x1;y=lerp(y0,y1,(u-.38)/.12)}else if(u<.88){x=lerp(x1,x0,(u-.5)/.38);y=y1}else{x=x0;y=lerp(y1,y0,(u-.88)/.12)}\n circle(x,y,17,P.paper,P.ink,4);\n}\nfunction scene3(t){\n rect(0,0,W,H,P.orange);dots(P.ink,.11);\n stack(COPY.corruption,110,183,111,123,P.ink,t,.1);\n let p=enter(t,.35);c.save();c.globalAlpha=p;\n c.strokeStyle=P.ink;c.lineWidth=7;c.strokeRect(450,467,1020,376);\n for(let i=0;i<8;i++)circuitToken(t,i/8);\n c.restore();\n [{x:190,label:'PRIVATE GAIN',delay:.6},{x:1030,label:'PUBLIC OFFICE',delay:.85}].forEach(o=>{\n  const q=enter(t,o.delay);c.save();c.translate(o.x,535+(1-q)*130);c.globalAlpha=q;\n  rect(12,15,700,225,P.ink);rect(0,0,700,225,P.paper);text(o.label,350,133,62,P.ink,900,'center');c.restore();\n });\n c.save();c.globalAlpha=enter(t,1.35);circle(960,647,63,P.ink);text('↔',960,670,70,P.paper,700,'center');c.restore();\n rise('THE PUBLIC PAYS.',110,980,87,P.ink,t,1.6);\n}\nfunction book(t){\n c.save();c.translate(1535,525);c.rotate(-.13+.02*Math.sin(t));const p=enter(t,.6,1);c.scale(p,p);\n for(let i=8;i>=0;i--)rect(-170+i*6,-235-i*3,335,470,P.ink);\n rect(-170,-235,335,470,P.blue);rect(-148,-235,9,470,P.paper);\n for(let i=0;i<6;i++)line(-110,-110+i*45,105-(i%2)*35,-110+i*45,P.paper,5);\n circle(-12,-175,22,P.green);rect(-110,175,200,9,P.green);c.restore();\n}\nfunction scene4(t){\n rect(0,0,W,H,P.paper);\n rect(111,100,76*enter(t),8,P.red);\n rise('ADAM SMITH',110,185,53,P.ink,t,.1);\n rise('The Wealth of Nations',110,239,34,P.ink,t,.3,'left',500);\n text('“',92,445,240,P.red,700,'left','Georgia, serif');\n COPY.smith.forEach((s,i)=>{\n  let p=enter(t,.8+i*.35,1);c.save();c.globalAlpha=p;c.translate((1-p)*60,0);\n  text(s,125,440+i*116,94,P.ink,600,'left','Georgia, serif');c.restore();\n });\n const underline=enter(t,2.5,1);rect(125,710,1060*underline,15,P.red);\n book(t);\n rise('A warning about collusion against the public.',125,853,41,P.ink,t,3,'left',500);\n rise('Commerce needs scrutiny.',125,933,53,P.blue,t,3.4);\n}\nfunction gear(x,y,r,t){\n c.save();c.translate(x,y);c.rotate(t*.2);c.fillStyle=P.ink;\n c.beginPath();for(let i=0;i<72;i++){let a=TAU*i/72,rr=(i%6===0||i%6===5)?r*.82:r;c.lineTo(Math.cos(a)*rr,Math.sin(a)*rr)}c.closePath();c.fill();circle(0,0,r*.66,P.green);circle(0,0,r*.47,null,P.ink,3);\n for(let i=0;i<8;i++){let a=i*TAU/8;circle(Math.cos(a)*r*.56,Math.sin(a)*r*.56,9,P.ink)}c.restore();\n}\nfunction scene5(t){\n rect(0,0,W,H,P.green);grid(P.ink,.09,95);\n stack(COPY.markets,110,195,109,122,P.ink,t,.1);\n pill('OPEN COMPETITION',115,470,660,P.ink,P.green,t,.6);\n pill('HONEST INSTITUTIONS',115,575,715,P.ink,P.green,t,.8);\n pill('PUBLIC ACCOUNTABILITY',115,680,805,P.ink,P.green,t,1);\n const p=enter(t,.3,1.1);c.save();c.translate(1420,590);c.scale(p,p);gear(0,0,270,t);eye(0,0,300,156,t,P.ink,P.paper,P.green);c.restore();\n rise('Prosperity without privilege.',115,956,65,P.ink,t,1.8);\n}\nfunction scene6(t){\n rect(0,0,W,H,P.ink);\n const squeeze=smooth(t/3),release=smooth((t-5.45)/1.2);\n const amount=squeeze*(1-release);\n for(let i=0;i<12;i++){\n  const x=i*170-30;let bh=(76+hash(i+340)*135)*amount;\n  rect(x,0,110,bh,P.red);rect(x,H-bh,110,bh,P.red);\n }\n rect(0,0,74+amount*55,H,P.red);rect(W-74-amount*55,0,74+amount*55,H,P.red);\n c.save();c.globalAlpha=.12;for(let i=0;i<8;i++)line(200+i*220,225,200+i*220,855,P.paper,3);c.restore();\n const size=102;\n stack(COPY.authoritarianism,W/2,405,size,120,P.paper,t,.25,'center');\n let p=enter(t,1.4);rect(960-490*p,724,980*p,13,P.red);\n rise('No leader is above accountability.',960,845,44,P.paper,t,2,'center',500);\n if(release>0){c.save();c.globalAlpha=release;for(let i=0;i<20;i++){let a=TAU*i/20,r=600+release*260;line(960+Math.cos(a)*r*.55,540+Math.sin(a)*r*.55,960+Math.cos(a)*r,540+Math.sin(a)*r,P.green,8)}c.restore()}\n}\nfunction community(t,x,y,r,color,bg){\n const points=[];for(let i=0;i<24;i++){\n  let a=TAU*i/24+t*.045,rr=r*(.8+.16*Math.sin(i*1.9));\n  points.push({x:x+Math.cos(a)*rr,y:y+Math.sin(a)*rr});\n }\n c.save();c.globalAlpha=.23;for(let i=0;i<24;i++){\n  for(let k=1;k<=2;k++){const b=points[(i+k*5)%24];line(points[i].x,points[i].y,b.x,b.y,color,2)}\n }c.restore();\n points.forEach((p,i)=>{\n  let q=enter(t,.3+i*.025,.7);circle(p.x,p.y,23*q,color);circle(p.x,p.y,8*q,bg);\n });\n eye(x,y,410,210,t,color,bg,color);\n}\nfunction scene7(t){\n rect(0,0,W,H,P.paper);dots(P.blue,.1);\n COPY.actions.forEach((o,i)=>{\n  const y=215+i*205;\n  rise(o[0],110,y,101,i%2?P.ink:P.blue,t,.15+i*.24);\n  rise(o[1],115,y+59,36,P.ink,t,.45+i*.24,'left',500);\n });\n let p=enter(t,.3,1);c.save();c.translate(1420,545);c.scale(p,p);community(t,0,0,350,P.blue,P.paper);c.restore();\n const a=enter(t,2.2,1.4);c.save();c.globalAlpha=a;orbit(1420,545,413,t,P.blue,6);c.restore();\n}\nfunction scene8(t){\n const tt=Math.min(t,6.6);rect(0,0,W,H,P.blue);\n c.save();c.globalAlpha=.17;\n for(let i=0;i<40;i++){\n  const a=i*TAU/40+tt*.025;\n  line(960+Math.cos(a)*580,540+Math.sin(a)*580,960+Math.cos(a)*1000,540+Math.sin(a)*1000,P.paper,2);\n }\n c.restore();\n const p=enter(tt,.05,1);c.save();c.translate(960,186);c.scale(p,p);eye(0,0,260,132,tt,P.paper,P.green,P.blue);c.restore();\n COPY.closing.forEach((s,i)=>rise(s,960,420+i*133,119,P.paper,tt,.45+i*.16,'center'));\n let u=enter(tt,1.6,1.1);rect(960-645*u,752,1290*u,12,P.green);\n rise('Freedom is a public responsibility.',960,875,47,P.paper,tt,2,'center',500);\n const final=enter(tt,3.4,1.2);for(let i=0;i<13;i++){\n  let x=960+(i-6)*58;circle(x,958,8*final,P.green);\n }\n}\nconst renderers=[scene0,scene1,scene2,scene3,scene4,scene5,scene6,scene7,scene8];\nfunction renderScene(i,t){c.save();renderers[i](Math.max(0,t));c.restore()}\nfunction draw(time){\n const t=clamp(time,0,60);c.setTransform(1,0,0,1,0,0);c.globalAlpha=1;c.globalCompositeOperation='source-over';c.clearRect(0,0,W,H);\n let i=0;for(let k=1;k<starts.length;k++)if(t>=starts[k])i=k;\n const local=t-starts[i];\n if(i>0&&local<.52){\n  renderScene(i-1,lengths[i-1]);\n  const p=ease(local/.52);const edge=lerp(-340,W+340,p);\n  c.save();c.beginPath();c.moveTo(0,0);c.lineTo(edge+180,0);c.lineTo(edge-180,H);c.lineTo(0,H);c.closePath();c.clip();renderScene(i,local);c.restore();\n  c.save();c.strokeStyle=i%2?P.red:P.green;c.lineWidth=18;c.beginPath();c.moveTo(edge+180,0);c.lineTo(edge-180,H);c.stroke();c.restore();\n }else renderScene(i,local);\n grain(Math.min(t,57.6),i===2||i===6?P.paper:P.ink,.035);\n}\nconst playhead={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{t:60,duration:60,ease:'none',onUpdate:()=>draw(playhead.t)},0);\ndraw(0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\n</script>\n</body>\n</html>",
