  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>White Russian</title>\n<style>\n@font-face{font-family:RecipeHand;src:url('Caveat.ttf') format('truetype');font-style:normal;font-weight:400;font-display:block}\nhtml,body{margin:0;width:100%;height:100%;overflow:hidden;background:#f6f1e7}\n#root{position:relative;width:100%;height:100%;overflow:hidden}\ncanvas{display:block;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1280\" data-height=\"720\" data-duration=\"30\">\n<canvas id=\"recipe\" class=\"clip\" data-start=\"0\" data-duration=\"30\" width=\"1280\" height=\"720\" aria-label=\"A silent illustrated White Russian recipe: a cold glass, three ice cubes, 1½ oz vodka, ¾ oz coffee liqueur, ¾ oz cream, and an optional stir.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n/* EDITABLE RECONSTRUCTION — REVISION 3\n   1280 × 720; 30 seconds; silent; static camera.\n   Newly assembled Canvas artwork. No reference pixels appear in the output.\n   Evidence: supplied reconstruction brief, previous source and decoded t=28 image.\n   Right sidebar, checklist, instructions, containers, counters and pour intervals\n   are retained from revision 2. Material corrections are inferred approximations.\n   Final stage coordinates: liquid top 365; cream interface 418; liquid bottom 585.\n   Final ice centers: (418,385), (477,378), (541,389).\n   Final straw: approximately (403,198) to (511,572).\n   Asset ledger: explicitly supplied Caveat.ttf; harness-provided gsap.min.js;\n   procedural Canvas illustration and deterministic paper texture.\n   Caveat approximates the unknown reference handwriting.\n   Requested authoring target: gpt-6.1-sol / high. No execution metadata is inferred.\n   No rendered MP4, poster, technical check or visual validation is claimed.\n   Sequence: 0–3 cold glass; 3–7 ice; 7–13 vodka; 13–18 coffee;\n   18–23 cream; 23–28 straw/stir; 28–30 finished cocktail and closing.\n*/\nconst creatorInput='Render a recipe motion graphic animation using JavaScript or HTML (whatever you think will produce the best result) to show the full recipe for a White Russian from start to finish, empty glass to completed cocktail. Explainer video style, showing the ingredients and measurements as they go into the glass. It should be a 30s video.';\nconst canvas=document.getElementById('recipe');\nconst ctx=canvas.getContext('2d');\nconst W=1280,H=720;\nconst C={paper:'#f6f1e7',sidebar:'#eadbc6',ink:'#493625',soft:'#948574',rule:'#c8baa6',blue:'#d9e6e6',coffee:'#392017',cream:'#f4eddb',tan:'#ad744c'};\nconst recipe={vodka:1.5,coffee:.75,cream:.75,ice:3};\nconst timings={ice:[3,7],vodka:[7,13],coffee:[13,18],cream:[18,23],stir:[23,28],finish:[28,30]};\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst progress=(t,a,b)=>clamp((t-a)/(b-a));\nconst smooth=v=>{v=clamp(v);return v*v*(3-2*v)};\nconst lerp=(a,b,p)=>a+(b-a)*p;\nconst hash=n=>{const q=Math.sin(n*127.1+311.7)*43758.5453;return q-Math.floor(q)};\nconst paper=document.createElement('canvas');paper.width=W;paper.height=H;\nconst pc=paper.getContext('2d');\npc.fillStyle=C.paper;pc.fillRect(0,0,W,H);\npc.fillStyle=C.sidebar;pc.fillRect(855,0,425,H);\nconst seam=pc.createLinearGradient(855,0,883,0);\nseam.addColorStop(0,'rgba(87,63,34,.13)');seam.addColorStop(1,'rgba(87,63,34,0)');\npc.fillStyle=seam;pc.fillRect(855,0,28,H);\nfor(let i=0;i<5400;i++){\n const x=hash(i+1)*W,y=hash(i+8000)*H;\n pc.fillStyle=i%3?'rgba(108,83,49,.022)':'rgba(255,255,255,.13)';\n pc.fillRect(x,y,hash(i+24)*1.2+.2,.6);\n}\nfunction path(points,close=false){ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));if(close)ctx.closePath()}\nfunction pencil(points,width=1,color=C.ink,close=false){\n ctx.save();ctx.strokeStyle=color;ctx.lineWidth=width;ctx.lineJoin='round';ctx.lineCap='round';\n path(points,close);ctx.stroke();ctx.globalAlpha*=.22;ctx.translate(.65,-.45);\n path(points.map((p,i)=>[p[0]+Math.sin(i*2.7)*.65,p[1]+Math.cos(i*1.9)*.5]),close);\n ctx.lineWidth=width*.6;ctx.stroke();ctx.restore();\n}\nfunction text(str,x,y,size=22,options={}){\n ctx.save();ctx.fillStyle=options.color||C.ink;\n ctx.globalAlpha*=options.alpha===undefined?1:options.alpha;\n ctx.textAlign=options.align||'left';\n ctx.font=size+'px '+(options.family||'RecipeHand, cursive');\n ctx.fillText(str,x,y);ctx.restore();\n}\nfunction tracked(str,x,y,size=10,spacing=2,color=C.soft){\n ctx.save();ctx.fillStyle=color;ctx.font=size+'px monospace';\n for(const ch of str){ctx.fillText(ch,x,y);x+=ctx.measureText(ch).width+spacing}\n ctx.restore();\n}\nfunction oval(x,y,rx,ry,color,width=1){ctx.save();ctx.strokeStyle=color;ctx.lineWidth=width;ctx.beginPath();ctx.ellipse(x,y,rx,ry,0,0,Math.PI*2);ctx.stroke();ctx.restore()}\nfunction quarterAmount(value,fraction){\n const n=fraction>=.999?Math.round(value*4):Math.floor(value*fraction*4+1e-7);\n const whole=Math.floor(n/4),f=['','¼','½','¾'][n%4];\n return n===0?'0':(whole?String(whole):'')+f;\n}\nfunction amount(str,x,y,unit='oz'){\n text(str,x,y,94);\n ctx.save();ctx.font='94px RecipeHand, cursive';const width=ctx.measureText(str).width;ctx.restore();\n text(unit,x+width+8,y-1,34);\n}\nfunction checklist(t){\n const fade=smooth(progress(t,.4,1.6));ctx.save();ctx.globalAlpha=fade;\n tracked('CLASSIC · ROCKS GLASS · SERVES 1',905,89,11,2.05,'#8b765e');\n text('White',904,184,94);text('Russian',936,263,94);\n pencil([[902,288],[1000,283],[1104,282],[1195,280],[1232,277]],1.65);\n const rows=[['2–4','ice cubes',7,3],['1½ oz','vodka',13,7],['¾ oz','coffee liqueur',18,13],['¾ oz','cream or milk',23,18]];\n rows.forEach((r,i)=>{\n  const y=377+i*67,done=t>=r[2],active=t>=r[3]&&t<r[2];\n  oval(917,y-12,13.3,13.7,done||active?C.ink:C.soft,1.55);\n  if(done)pencil([[909,y-13],[916,y-5],[933,y-30]],3.1,C.tan);\n  if(active){pencil([[867,y-12],[891,y-12]],2.5,C.tan);pencil([[883,y-19],[891,y-12],[883,y-5]],2.5,C.tan)}\n  const alpha=done||active?1:.54;\n  text(r[0],946,y,40,{alpha});\n  text(r[1],1054,y,38,{alpha});\n });\n tracked('BUILD OVER ICE · FLOAT THE CREAM',905,669,10,1.95,'#947e66');\n ctx.restore();\n pencil([[855,0],[855,234],[855,475],[855,720]],.75,'#baaa94');\n}\nfunction progressBar(t,v,c,m){\n const segments=[\n  {x:50,w:119,label:'ICE',p:progress(t,3,7)},\n  {x:182,w:166,label:'VODKA',p:v},\n  {x:361,w:165,label:'COFFEE',p:c},\n  {x:539,w:165,label:'CREAM',p:m},\n  {x:717,w:90,label:'SERVE',p:progress(t,23,28)}\n ];\n segments.forEach((s,i)=>{\n  pencil([[s.x,52],[s.x+s.w,52]],3.2,'#ddd2c0');\n  if(s.p>0)pencil([[s.x,52],[s.x+s.w*s.p,52]],3.2,'#a36c44');\n  tracked(s.label,s.x,77,10,1.6,t>=[3,7,13,18,23][i]?'#9a6b49':'#b6aa9b');\n });\n}\nfunction instructions(t,v,c,m){\n let start=0,end=3,title='Start with a cold glass',step='',kind='opening';\n if(t>=3&&t<7){start=3;end=7;title='Fill with ice';step='STEP 1 / 5';kind='ice'}\n else if(t>=7&&t<13){start=7;end=13;title='Pour the vodka';step='STEP 2 / 5';kind='vodka'}\n else if(t>=13&&t<18){start=13;end=18;title='Add coffee liqueur';step='STEP 3 / 5';kind='coffee'}\n else if(t>=18&&t<23){start=18;end=23;title='Float the cream';step='STEP 4 / 5';kind='cream'}\n else if(t>=23&&t<28){start=23;end=28;title='Straw in, stir to taste';step='STEP 5 / 5';kind='stir'}\n if(t>=28)return;\n const alpha=(start===0?1:smooth(progress(t,start,start+.28)))*(1-smooth(progress(t,end-.22,end)));\n ctx.save();ctx.globalAlpha=alpha;\n tracked(step||'AN EVERYDAY CLASSIC',51,210,12,2.1,'#a16f4b');\n text(title,50,258,kind==='stir'?40:44);\n if(kind==='opening'){\n  tracked('ROCKS GLASS · 8–10 OZ',51,348,12,1.3);\n  text('an old fashioned glass works',50,387,28,{color:C.soft});\n }\n if(kind==='ice'){\n  const count=[4.25,5.05,5.85].filter(x=>t>=x).length;\n  amount(String(count),51,366,'cubes');\n  text('keeps glass cool as you build',50,433,27,{color:C.soft});\n  text('big cubes melt slower',50,464,27,{color:C.soft});\n }\n if(kind==='vodka'){\n  amount(quarterAmount(recipe.vodka,v),51,366);\n  tracked(Math.round(recipe.vodka*v*29.5735)+' ML',51,405,12,1.8);\n  text('straight over the ice',50,443,29,{color:C.soft});\n }\n if(kind==='coffee'){\n  amount(quarterAmount(recipe.coffee,c),51,366);\n  const shown=parseQuarter(quarterAmount(recipe.coffee,c));\n  tracked(Math.round(shown*29.5735)+' ML',51,405,12,1.8);\n  text('Kahlúa or similar',50,443,29,{color:C.soft});\n }\n if(kind==='cream'){\n  amount(quarterAmount(recipe.cream,m),51,366);\n  tracked(Math.round(parseQuarter(quarterAmount(recipe.cream,m))*29.5735)+' ML',51,405,12,1.8);\n  text('heavy cream or whole milk',50,443,27,{color:C.soft});\n }\n if(kind==='stir'){\n  amount('3',51,366);\n  tracked('TOTAL / FINISHED POUR',51,405,11,1.4);\n  text('serve as-is for layers',50,443,28,{color:C.soft});\n  text('or stir if preferred',50,476,28,{color:C.soft});\n }\n ctx.restore();\n}\nfunction parseQuarter(str){\n const fractions={'¼':.25,'½':.5,'¾':.75};let total=0;\n for(const ch of str){if(fractions[ch])total+=fractions[ch];else if(ch>='0'&&ch<='9')total+=Number(ch)}\n return total;\n}\n/* Illustration coordinates are retained so existing vessel motion is unchanged.\n   Main-stage position is x=362+(localX-805)*238/226, y=localY+12. */\nfunction illustrationSpace(){ctx.translate(362,12);ctx.scale(238/226,1);ctx.translate(-805,0)}\nfunction glassInterior(){path([[813,294],[1023,294],[1009,573],[826,573]],true)}\nconst liquid={bottom:573,vodkaHeight:120,coffeeHeight:48,creamHeight:52};\nconst cubeData=[\n {x:858.1765,y:545,a:-.12,size:55,offset:20,start:3.25,end:4.25,seed:11},\n {x:914.2017,y:540,a:.25,size:58,offset:13,start:4.05,end:5.05,seed:23},\n {x:974.9748,y:548,a:.16,size:55,offset:24,start:4.85,end:5.85,seed:37}\n];\nfunction roundedCube(s,variation=0){\n const r=7.5,l=-s+variation,rr=s,b=-s,bb=s-1;\n ctx.beginPath();ctx.moveTo(l+r,b+1);\n ctx.lineTo(rr-r,b+2);ctx.quadraticCurveTo(rr+1,b+3,rr, b+r);\n ctx.lineTo(rr-1,bb-r);ctx.quadraticCurveTo(rr-1,bb+1,rr-r-1,bb);\n ctx.lineTo(l+r,bb+1);ctx.quadraticCurveTo(l-1,bb,l,bb-r);\n ctx.lineTo(l-1,b+r+1);ctx.quadraticCurveTo(l-1,b+2,l+r,b+1);ctx.closePath();\n}\nfunction cubes(t,top,h){\n cubeData.forEach((d,i)=>{\n  if(t<d.start)return;\n  const p=progress(t,d.start,d.end),falling=p<1;\n  let y=lerp(133+i*9,d.y,p*p),a=lerp(d.a-.4,d.a,p);\n  if(!falling){\n   const age=t-d.end;\n   const bounce=age<.45?-Math.sin(age/.45*Math.PI)*9*(1-age/.45):0;\n   /* A cube rests on the floor until the surface supports its displaced volume.\n      It then follows the rising surface, preserving its individual immersion. */\n   const surfaceCenter=top+d.offset;\n   y=Math.min(d.y,surfaceCenter)+bounce;\n   a=d.a+Math.sin(clamp(age,0,1)*Math.PI)*.055;\n  }\n  ctx.save();ctx.translate(d.x,y);ctx.rotate(a);\n  const s=d.size/2;\n  roundedCube(s,(i-1)*.7);\n  const ice=ctx.createLinearGradient(-s,-s,s,s);\n  ice.addColorStop(0,'rgba(232,243,242,.42)');\n  ice.addColorStop(.45,'rgba(247,245,230,.21)');\n  ice.addColorStop(1,'rgba(205,225,224,.16)');\n  ctx.fillStyle=ice;ctx.fill();\n  ctx.lineWidth=1.25;ctx.strokeStyle='rgba(114,133,128,.64)';ctx.stroke();\n  ctx.save();ctx.translate(.7,-.45);roundedCube(s-.3,(i-1)*.7);\n  ctx.lineWidth=.55;ctx.strokeStyle='rgba(83,104,99,.24)';ctx.stroke();ctx.restore();\n  pencil([[-s+5,s-8],[-s+3,-s+11],[-s+10,-s+4],[s-10,-s+4]],1,'rgba(255,255,249,.67)');\n  pencil([[s-6,s-13],[s-10,s-5],[s-18,s-4]],.7,'rgba(141,154,145,.42)');\n  ctx.beginPath();ctx.moveTo(-s+8,-s+9);ctx.quadraticCurveTo(0,-s+5,s-8,-s+10);\n  ctx.strokeStyle='rgba(255,255,250,.5)';ctx.lineWidth=2.1;ctx.stroke();\n  if(h>0&&!falling){\n   const waterline=top-y;\n   ctx.save();roundedCube(s);ctx.clip();\n   ctx.fillStyle='rgba(255,248,224,.07)';ctx.fillRect(-s,waterline,d.size,d.size*2);\n   ctx.restore();\n  }\n  ctx.restore();\n });\n}\n/* Every plume has a distinct trajectory, width, depth and set of soft lobes.\n   Radial gradients provide feathered edges without temporal accumulation. */\nconst cloudData=[\n {x:854,y:449,rx:34,ry:17,delay:.06,travel:2.45,phase:.3,tone:0},\n {x:900,y:478,rx:44,ry:22,delay:.32,travel:2.8,phase:1.7,tone:1},\n {x:963,y:487,rx:32,ry:28,delay:.71,travel:2.5,phase:3.2,tone:0},\n {x:879,y:527,rx:47,ry:20,delay:.95,travel:3.4,phase:4.6,tone:1},\n {x:934,y:544,rx:42,ry:23,delay:1.26,travel:3.05,phase:2.4,tone:0},\n {x:989,y:526,rx:27,ry:18,delay:1.57,travel:2.65,phase:5.1,tone:1},\n {x:853,y:488,rx:27,ry:13,delay:1.94,travel:2.8,phase:3.8,tone:0},\n {x:933,y:433,rx:41,ry:16,delay:2.2,travel:2.7,phase:6.0,tone:1}\n];\nfunction softCloud(x,y,rx,ry,rotation,rgb,alpha){\n ctx.save();ctx.translate(x,y);ctx.rotate(rotation);ctx.scale(rx,ry);\n const g=ctx.createRadialGradient(-.17,-.16,.03,0,0,1);\n g.addColorStop(0,'rgba('+rgb+','+alpha+')');\n g.addColorStop(.38,'rgba('+rgb+','+(alpha*.9)+')');\n g.addColorStop(.7,'rgba('+rgb+','+(alpha*.48)+')');\n g.addColorStop(1,'rgba('+rgb+',0)');\n ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,1,0,Math.PI*2);ctx.fill();ctx.restore();\n}\nfunction creamWisps(t,top,bottom,creamP,stirP){\n if(creamP<=0)return;\n ctx.save();glassInterior();ctx.clip();\n const age=Math.max(0,Math.min(t,27.5)-19.05);\n const stirTime=progress(t,24.15,27.4);\n const swirl=smooth(stirTime);\n const interfaceY=top+53*creamP;\n cloudData.forEach((d,i)=>{\n  const u=smooth((age-d.delay)/d.travel);if(u<=0)return;\n  const spread=.23+.77*u;\n  let x=lerp(972,d.x,u),y=lerp(interfaceY+5,d.y,u);\n  const theta=swirl*(.62+i*.052),cx=918,cy=493;\n  const ox=x-cx,oy=y-cy;\n  x=cx+ox*Math.cos(theta)-oy*Math.sin(theta)*.72;\n  y=cy+ox*Math.sin(theta)*.35+oy*Math.cos(theta);\n  x+=Math.sin(stirTime*Math.PI*2+d.phase)*13*stirP;\n  y+=Math.cos(stirTime*Math.PI*2+d.phase)*6*stirP;\n  const rx=d.rx*spread*(1+.27*stirP),ry=d.ry*spread*(1+.19*stirP);\n  const tint=d.tone?'216,191,152':'244,228,197';\n  const alpha=(.3+.13*stirP)