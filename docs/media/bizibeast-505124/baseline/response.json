{
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Bento — Your next move</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#171916}body{font-family:Arial,Helvetica,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden}canvas{display:block;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1920\" data-height=\"1080\" data-duration=\"40\">\n<canvas id=\"art\" class=\"clip\" data-start=\"0\" data-duration=\"40\" width=\"1920\" height=\"1080\" role=\"img\" aria-label=\"Bento motion graphic: creator pages, AI-assisted content, social scheduling, automated conversations, and a creator store.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n/* EDITABLE CREATIVE SETTINGS. All artwork is original procedural geometry.\n   Feature names are grounded in https://bento.surf/.\n   These illustrations are conceptual diagrams, not product screenshots.\n   Scene boundaries: 0, 4.5, 9.5, 14.5, 19.5, 24.5, 29.5, 34.5, 40.\n*/\nconst SETTINGS={width:1920,height:1080,duration:40};\nconst C={paper:'#F4F2E9',ink:'#171916',lime:'#D8FE4F',blue:'#3D4CFF',coral:'#FF7956',white:'#FFFFFF'};\nconst COPY={brand:'bento.surf',opening:['Big ideas.','Meet your Bento.'],home:['A home for','your whole','world.'],create:['Ideas in.','Content out.'],schedule:['Make room for','what’s next.'],conversation:['Keep the','conversation','going.'],sell:'Make it your business.',connected:['One creator','operating','system.'],final:'Build your Bento.'};\nconst canvas=document.getElementById('art');\nconst ctx=canvas.getContext('2d');\nconst TAU=Math.PI*2;\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));\nconst mix=(a,b,p)=>a+(b-a)*p;\nconst out=p=>1-Math.pow(1-clamp(p),3);\nconst smooth=p=>{p=clamp(p);return p*p*(3-2*p)};\nconst pop=p=>{p=clamp(p);return 1+2.70158*Math.pow(p-1,3)+1.70158*Math.pow(p-1,2)};\nconst at=(t,start,duration=.7)=>out((t-start)/duration);\nfunction saved(fn){ctx.save();fn();ctx.restore()}\nfunction box(x,y,w,h,r,fill,stroke=null,lw=3){ctx.beginPath();ctx.roundRect(x,y,w,h,Math.max(0,Math.min(r,w/2,h/2)));if(fill){ctx.fillStyle=fill;ctx.fill()}if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=lw;ctx.stroke()}}\nfunction circle(x,y,r,fill,stroke=null,lw=3){ctx.beginPath();ctx.arc(x,y,Math.max(.01,r),0,TAU);if(fill){ctx.fillStyle=fill;ctx.fill()}if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=lw;ctx.stroke()}}\nfunction text(str,x,y,size=64,color=C.ink,weight=700,align='left'){ctx.font=weight+' '+size+'px Arial, Helvetica, sans-serif';ctx.textBaseline='middle';ctx.textAlign=align;ctx.fillStyle=color;ctx.fillText(str,x,y)}\nfunction line(points,color=C.ink,width=5){ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));ctx.strokeStyle=color;ctx.lineWidth=width;ctx.lineCap='round';ctx.lineJoin='round';ctx.stroke()}\nfunction arrow(x,y,len,color=C.ink,width=7){line([[x,y],[x+len,y]],color,width);line([[x+len-22,y-22],[x+len,y],[x+len-22,y+22]],color,width)}\nfunction background(color,grid=false){ctx.fillStyle=color;ctx.fillRect(0,0,1920,1080);if(grid)saved(()=>{ctx.globalAlpha=.055;for(let x=0;x<1920;x+=80)line([[x,0],[x,1080]],C.ink,1);for(let y=0;y<1080;y+=80)line([[0,y],[1920,y]],C.ink,1)})}\nfunction pill(str,x,y,w,fill=C.ink,color=C.paper,size=38){box(x,y,w,76,38,fill);text(str,x+w/2,y+38,size,color,600,'center')}\nfunction rosette(x,y,r,color,rotation=0,teeth=12){saved(()=>{ctx.translate(x,y);ctx.rotate(rotation);ctx.beginPath();for(let i=0;i<teeth*2;i++){const a=i*Math.PI/teeth;const rr=i%2?r*.78:r;const xx=Math.cos(a)*rr,yy=Math.sin(a)*rr;i?ctx.lineTo(xx,yy):ctx.moveTo(xx,yy)}ctx.closePath();ctx.fillStyle=color;ctx.fill()})}\nfunction motif(x,y,size,t,colors=[C.lime,C.blue,C.coral,C.paper],gap=10){saved(()=>{ctx.translate(x,y);const cell=(size-gap)/2;for(let i=0;i<4;i++){const xx=(i%2)*(cell+gap)-size/2;const yy=Math.floor(i/2)*(cell+gap)-size/2;box(xx,yy,cell,cell,cell*.22,colors[i]);if(i===1){ctx.strokeStyle=C.paper;ctx.lineWidth=cell*.09;ctx.beginPath();ctx.arc(xx+cell*.5,yy+cell*.5,cell*.25,-Math.PI/2,Math.PI/2);ctx.stroke()}if(i===2)arrow(xx+cell*.25,yy+cell*.5,cell*.5,C.ink,Math.max(3,cell*.07))}})}\nfunction icon(name,x,y,s,color=C.ink){saved(()=>{ctx.translate(x,y);ctx.scale(s/100,s/100);ctx.strokeStyle=color;ctx.fillStyle=color;ctx.lineWidth=6;ctx.lineCap='round';ctx.lineJoin='round';if(name==='play'){ctx.beginPath();ctx.moveTo(-22,-33);ctx.lineTo(33,0);ctx.lineTo(-22,33);ctx.closePath();ctx.fill()}else if(name==='link'){saved(()=>{ctx.rotate(-.6);box(-44,-17,59,34,17,null,color,6);box(-15,-17,59,34,17,null,color,6);line([[-18,0],[18,0]],color,6)})}else if(name==='calendar'){box(-39,-32,78,72,12,null,color,6);line([[-39,-9],[39,-9]],color,6);line([[-20,-42],[-20,-23]],color,6);line([[20,-42],[20,-23]],color,6);circle(-16,14,5,color);circle(14,14,5,color)}else if(name==='file'){box(-31,-42,62,84,7,null,color,6);line([[-16,-15],[16,-15]],color,6);line([[-16,3],[16,3]],color,6);line([[-16,21],[5,21]],color,6)}else if(name==='people'){circle(-18,-20,14,null,color,6);circle(22,-14,11,null,color,6);ctx.beginPath();ctx.arc(-18,26,27,Math.PI,0);ctx.stroke();ctx.beginPath();ctx.arc(25,29,19,Math.PI,0);ctx.stroke()}else if(name==='chat'){box(-40,-31,80,57,14,null,color,6);line([[-20,26],[-29,44],[0,26]],color,6);circle(-18,-3,4,color);circle(0,-3,4,color);circle(18,-3,4,color)}else if(name==='check'){line([[-31,0],[-8,24],[35,-27]],color,8)}else if(name==='store'){box(-34,-9,68,53,7,null,color,6);line([[-42,-10],[-28,-38],[28,-38],[42,-10],[-42,-10]],color,6);line([[-11,44],[-11,13],[12,13],[12,44]],color,6)}else if(name==='spark'){for(let i=0;i<4;i++){const a=i*Math.PI/2;line([[Math.cos(a)*13,Math.sin(a)*13],[Math.cos(a)*43,Math.sin(a)*43]],color,7)}ctx.rotate(Math.PI/4);for(let i=0;i<4;i++){const a=i*Math.PI/2;line([[Math.cos(a)*12,Math.sin(a)*12],[Math.cos(a)*28,Math.sin(a)*28]],color,5)}}else{box(-35,-35,28,28,6,color);box(7,-35,28,28,6,color);box(-35,7,28,28,6,color);box(7,7,28,28,6,color)}})}\nfunction title(lines,x,y,size,color,t,start=0,leading=1.03){lines.forEach((str,i)=>{const p=at(t,start+i*.13,.65);saved(()=>{ctx.beginPath();ctx.rect(x-10,y+i*size*leading-size*.55,1700,size*1.15);ctx.clip();text(str,x,y+i*size*leading+(1-p)*size*1.2,size,color,750)})})}\nfunction fly(t,start,x,y,rotation,fn){const p=pop((t-start)/.85);saved(()=>{ctx.translate(x,y+(1-p)*410);ctx.rotate(rotation*(1-p));ctx.scale(Math.max(.01,.74+.26*p),Math.max(.01,.74+.26*p));ctx.globalAlpha=clamp((t-start)/.2);fn()})}\nfunction bezier(x1,y1,x2,y2,color,width=5){ctx.beginPath();ctx.moveTo(x1,y1);ctx.bezierCurveTo((x1+x2)/2,y1,(x1+x2)/2,y2,x2,y2);ctx.strokeStyle=color;ctx.lineWidth=width;ctx.stroke()}\nfunction orbitDot(t,phase,x1,y1,x2,y2,color){const p=((t*.36+phase)%1+1)%1;const q=smooth(p);circle(mix(x1,x2,q),mix(y1,y2,q),11,color)}\n\nfunction opening(t){\n background(C.paper,true);\n const phase=smooth((t-1.8)/.65);\n saved(()=>{ctx.translate(960,470-100*phase);ctx.scale(1-.3*phase,1-.3*phase);const word=COPY.brand;ctx.font='800 268px Arial';const widths=[...word].map(ch=>ctx.measureText(ch).width);let x=-widths.reduce((a,b)=>a+b,0)/2;[...word].forEach((ch,i)=>{const p=pop((t-i*.045)/.85);saved(()=>{ctx.translate(x+widths[i]/2,(1-p)*-420);ctx.rotate((1-p)*(i%2?.35:-.35));text(ch,0,0,268,C.ink,800,'center')});x+=widths[i]})});\n const spread=1-phase*.5;\n rosette(220,235,92*(.6+.4*at(t,.1)),C.blue,t*.35);\n saved(()=>{ctx.translate(1695,265);ctx.rotate(-.25+t*.14);box(-87,-87,174,174,34,C.coral);icon('spark',0,0,100,C.ink)});\n saved(()=>{ctx.translate(1540+90*spread,805);ctx.rotate(-.2+t*.1);box(-130,-78,260,156,78,C.lime);arrow(-66,0,130,C.ink,10)});\n circle(265,835,65,C.lime);\n saved(()=>{ctx.globalAlpha=phase;const p=at(t,2.0,.7);text(COPY.opening[0],960,600+(1-p)*100,113,C.ink,750,'center');text(COPY.opening[1],960,731+(1-p)*100,113,C.ink,750,'center')});\n if(t<1.9){const p=at(t,.75,.6)*(1-smooth((t-1.5)/.4));saved(()=>{ctx.globalAlpha=p;line([[390,650],[1530,650]],C.ink,3);text('Your next move starts here.',960,734,52,C.ink,500,'center')})}\n}\n\nfunction home(t){\n background(C.lime);\n title(COPY.home,120,270,123,C.ink,t,.05,1.06);\n saved(()=>{ctx.globalAlpha=at(t,.9);text('Your creator page.',125,765,48,C.ink,500);arrow(125,870,420,C.ink,9)});\n const tiles=[{x:1130,y:345,w:400,h:390,c:C.blue,l:'Your work',i:'spark'},{x:1510,y:255,w:310,h:210,c:C.paper,l:'Links',i:'link'},{x:1510,y:550,w:310,h:350,c:C.coral,l:'Bookings',i:'calendar'},{x:1130,y:800,w:400,h:240,c:C.paper,l:'Your store',i:'store'}];\n tiles.forEach((a,i)=>fly(t,.12+i*.13,a.x,a.y,i%2?.2:-.15,()=>{box(-a.w/2,-a.h/2,a.w,a.h,38,a.c);const color=a.c===C.blue?C.paper:C.ink;icon(a.i,0,-a.h*.09,i===0?135:82,color);text(a.l,0,a.h*.32,i===0?46:40,color,650,'center');if(i===0){saved(()=>{ctx.globalAlpha=.15;for(let n=0;n<4;n++){ctx.beginPath();ctx.arc(0,-42,95+n*23,0,TAU);ctx.strokeStyle=C.paper;ctx.lineWidth=2;ctx.stroke()}})}}));\n saved(()=>{ctx.globalAlpha=at(t,1.7);ctx.translate(1680,865);ctx.rotate(.12);circle(0,0,78,C.ink);icon('link',0,0,78,C.lime)});\n}\n\nfunction create(t){\n background(C.ink);\n title(COPY.create,120,205,132,C.paper,t,.05,1.06);\n saved(()=>{ctx.globalAlpha=at(t,.55);text('AI drafts. You review.',125,512,49,C.lime,500)});\n const p=at(t,.3);\n saved(()=>{ctx.globalAlpha=p;box(120,670,425,155,35,C.paper);icon('spark',187,747,62,C.ink);text('Your idea',260,747,53,C.ink,650);bezier(550,747,742,747,C.paper,5);circle(750,747,70,C.blue);icon('spark',750,747,72,C.paper)});\n const cards=[{x:920,y:475,c:C.coral,l:'Instagram'},{x:1210,y:425,c:C.lime,l:'LinkedIn'},{x:1500,y:475,c:C.paper,l:'X'}];\n cards.forEach((a,i)=>{const f=at(t,.75+i*.18);saved(()=>{ctx.globalAlpha=f;bezier(825,747,a.x+125,a.y+210,'#74776D',3)});fly(t,.8+i*.18,a.x+125,a.y+185,(i-1)*.12,()=>{box(-125,-185,250,370,29,a.c);ctx.beginPath();ctx.roundRect(-105,-165,210,225,18);ctx.clip();for(let k=0;k<7;k++){saved(()=>{ctx.translate(0,-50);ctx.rotate(k*.24+t*.12+i);box(-128,-16,256,32,16,k%2?C.blue:C.ink)})}});saved(()=>{ctx.globalAlpha=f;text(a.l,a.x+125,a.y+300,37,C.ink,700,'center');line([[a.x+29,a.y+335],[a.x+150,a.y+335]],C.ink,6)})});\n if(t>2.3){const p=at(t,2.3);saved(()=>{ctx.globalAlpha=p;box(1235,900,475,85,42,C.lime);icon('check',1297,942,39,C.ink);text('Ready for review',1493,942,36,C.ink,650,'center')})}\n}\n\nfunction schedule(t){\n background(C.blue);\n title(COPY.schedule,120,155,113,C.paper,t,.06,1.03);\n saved(()=>{ctx.globalAlpha=at(t,.55);pill('Social scheduling',1310,175,490,C.lime,C.ink,39)});\n const gx=120,gy=430,gw=1680,gh=490,cw=336;\n saved(()=>{ctx.globalAlpha=at(t,.35);box(gx,gy,gw,gh,32,C.paper);['MON','TUE','WED','THU','FRI'].forEach((d,i)=>{text(d,gx+cw*i+38,gy+57,37,C.ink,600);if(i)line([[gx+cw*i,gy+105],[gx+cw*i,gy+gh-25]],'#D3D5CB',2)});line([[gx+25,gy+105],[gx+gw-25,gy+105]],'#D3D5CB',2)});\n const posts=[{i:0,y:145,c:C.lime,l:'Post',icon:'file'},{i:1,y:252,c:C.coral,l:'Reel',icon:'play'},{i:2,y:145,c:C.blue,l:'Post',icon:'file'},{i:3,y:252,c:C.lime,l:'Reel',icon:'play'},{i:4,y:145,c:C.coral,l:'Launch',icon:'spark'}];\n posts.forEach((a,i)=>{const p=pop((t-.65-i*.16)/.85);saved(()=>{ctx.translate(gx+a.i*cw+cw/2,gy+a.y+65+(1-p)*550);ctx.rotate((1-p)*(i%2?.45:-.45));box(-141,-65,282,130,25,a.c);const col=a.c===C.blue?C.paper:C.ink;icon(a.icon,-86,0,42,col);text(a.l,-39,0,42,col,650)})});\n const progress=at(t,1.5,2.3);saved(()=>{ctx.globalAlpha=at(t,1.5);line([[145,986],[1775,986]],C.paper,3);circle(mix(145,1775,progress),986,15,C.lime)});\n}\n\nfunction conversations(t){\n background(C.paper,true);\n title(COPY.conversation,120,260,112,C.ink,t,.05,1.08);\n saved(()=>{ctx.globalAlpha=at(t,.8);pill('DM automation',120,765,430,C.ink,C.paper,39)});\n const steps=[{x:1190,y:230,w:470,h:150,c:C.blue,l:'Comment',i:'chat'},{x:1455,y:480,w:470,h:150,c:C.lime,l:'Auto DM',i:'chat'},{x:1190,y:740,w:470,h:150,c:C.coral,l:'Email',i:'file'}];\n saved(()=>{ctx.globalAlpha=at(t,.5);bezier(1190,305,1455,405,C.ink,4);bezier(1455,555,1190,665,C.ink,4);for(let i=0;i<3;i++){orbitDot(t,i/3,1190,305,1455,405,C.blue);orbitDot(t,i/3,1455,555,1190,665,C.blue)}});\n steps.forEach((a,i)=>fly(t,.35+i*.35,a.x,a.y,i%2?-.12:.12,()=>{box(-a.w/2,-a.h/2,a.w,a.h,35,a.c);const col=a.c===C.blue?C.paper:C.ink;icon(a.i,-a.w/2+75,0,58,col);text(a.l,-a.w/2+131,0,56,col,650)}));\n const p=at(t,2);saved(()=>{ctx.globalAlpha=p;ctx.translate(1645,840);ctx.rotate(-.12);rosette(0,0,95,C.lime,t*.15);icon('check',0,0,72,C.ink)});\n}\n\nfunction monetise(t){\n background(C.coral);\n title([COPY.sell],120,170,112,C.ink,t,.05);\n const offers=[{l:['Digital','products'],i:'file',c:C.paper},{l:['Online','courses'],i:'play',c:C.blue},{l:['Coaching','& bookings'],i:'calendar',c:C.lime},{l:['Member-','ships'],i:'people',c:C.ink}];\n offers.forEach((a,i)=>{const p=pop((t-.3-i*.16)/.85);const yy=640+(1-p)*680+Math.sin(t*1.2+i)*8;saved(()=>{ctx.translate(120+i*429+195,yy);ctx.rotate((1-p)*(i%2?.25:-.25));box(-195,-270,390,540,42,a.c);const col=a.c===C.ink||a.c===C.blue?C.paper:C.ink;circle(0,-100,104,null,col,3);icon(a.i,0,-100,102,col);text(a.l[0],0,105,47,col,650,'center');text(a.l[1],0,164,47,col,650,'center');arrow(-35,226,70,col,5)})});\n}\n\nfunction connected(t){\n background(C.ink);\n title(COPY.connected,120,245,118,C.paper,t,.08,1.08);\n saved(()=>{ctx.globalAlpha=at(t,.9);text('Your business, connected.',125,755,47,C.lime,500)});\n const grid=[['link','Page',C.paper],['spark','Create',C.lime],['calendar','Schedule',C.blue],['chat','Auto DMs',C.coral],['grid','Bento',C.lime],['store','Store',C.paper],['play','Courses',C.blue],['people','Community',C.paper],['file','Email',C.coral]];\n grid.forEach((a,i)=>{const col=i%3,row=Math.floor(i/3),p=pop((t-.3-i*.065)/1.05);let x=1110+col*238,y=274+row*238;const dx=(col-1)*280,dy=(row-1)*280;saved(()=>{ctx.translate(x+(1-p)*dx,y+(1-p)*dy);ctx.rotate((1-p)*(i%2?.6:-.6));ctx.scale(.8+.2*p,.8+.2*p);box(-110,-110,220,220,31,a[2]);const color=a[2]===C.blue?C.paper:C.ink;icon(a[0],0,-24,88,color);text(a[1],0,72,a[1].length>8?29:34,color,650,'center')})});\n const end=smooth((t-3.85)/.9);if(end>0)saved(()=>{ctx.globalAlpha=end;circle(1348,512,112*end,C.lime);icon('grid',1348,512,100*end,C.ink)});\n}\n\nfunction finale(t){\n background(C.ink);\n const transition=smooth((t-1.75)/.75);\n if(transition<1)saved(()=>{ctx.globalAlpha=1-transition;const words=['CREATE.','GROW.','MONETISE.'];const colors=[C.lime,C.paper,C.coral];words.forEach((w,i)=>{const p=at(t,i*.16,.7);const direction=i%2?-1:1;const x=960+direction*(1-p)*1500+direction*Math.sin(t*.65)*30;text(w,x,265+i*255,i===2?218:260,colors[i],800,'center')})});\n if(transition>0)saved(()=>{ctx.globalAlpha=transition;const p=out((t-1.8)/1.0);saved(()=>{ctx.translate(960,244+(1-p)*90);ctx.rotate((1-p)*-.4);motif(0,0,162,t,[C.lime,C.blue,C.coral,C.paper],9)});text(COPY.brand,960,520+(1-p)*100,258,C.paper,800,'center');text(COPY.final,960,738+(1-p)*75,78,C.lime,600,'center');text('Create. Grow. Monetise.',960,866+(1-p)*60,47,C.paper,500,'center')});\n}\n\nconst SCENES=[\n {start:0,end:4.5,draw:opening},\n {start:4.5,end:9.5,draw:home},\n {start:9.5,end:14.5,draw:create},\n {start:14.5,end:19.5,draw:schedule},\n {start:19.5,end:24.5,draw:conversations},\n {start:24.5,end:29.5,draw:monetise},\n {start:29.5,end:34.5,draw:connected},\n {start:34.5,end:40,draw:finale}\n];\nfunction renderScene(scene,t){saved(()=>scene.draw(t))}\nfunction draw(time){\n const t=clamp(time,0,40);ctx.setTransform(1,0,0,1,0,0);ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';ctx.clearRect(0,0,1920,1080);\n let index=SCENES.findIndex(s=>t>=s.start&&t<s.end);if(index<0)index=SCENES.length-1;\n const s=SCENES[index],local=t-s.start;\n if(index>0&&local<.6){const prev=SCENES[index-1];renderScene(prev,prev.end-prev.start-.001);const p=smooth(local/.6);const edge=mix(-480,2400,p);saved(()=>{ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(edge+230,0);ctx.lineTo(edge-230,1080);ctx.lineTo(0,1080);ctx.closePath();ctx.clip();renderScene(s,local)});saved(()=>{ctx.beginPath();ctx.moveTo(edge+230,0);ctx.lineTo(edge+263,0);ctx.lineTo(edge-197,1080);ctx.lineTo(edge-230,1080);ctx.closePath();ctx.fillStyle=C.lime;ctx.fill()})}\n else renderScene(s,local);\n}\nconst playhead={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{t:SETTINGS.duration,duration:SETTINGS.duration,ease:'none',onUpdate:()=>draw(playhead.t)},0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\ndraw(0);\n</script>\n</body>\n</html>",
