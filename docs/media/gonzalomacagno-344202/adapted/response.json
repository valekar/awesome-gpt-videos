{
  "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Primavera Sound ’26</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#bf9fe6}#root{position:relative;width:100%;height:100%;overflow:hidden}.clip{position:absolute;inset:0;width:100%;height:100%}svg{display:block;width:100%;height:100%;overflow:hidden}text{fill:#19132f;font-family:sans-serif}.heavy{font-weight:900;letter-spacing:-3px}.billing{font-weight:700}.tracked{font-weight:800;letter-spacing:4px}.reveal{opacity:0}\n</style>\n<script src=\"gsap.min.js\"></script>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"720\" data-height=\"1280\" data-duration=\"10\" data-fps=\"30\">\n<svg id=\"festival-artwork\" class=\"clip\" data-start=\"0\" data-duration=\"10\" viewBox=\"0 0 720 1280\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Reel de Primavera Sound ’26, Buenos Aires\">\n<defs>\n <linearGradient id=\"background\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop stop-color=\"#bfa0e7\"/><stop offset=\".53\" stop-color=\"#dbb8e9\"/><stop offset=\"1\" stop-color=\"#f3d0e3\"/></linearGradient>\n <linearGradient id=\"cool\" gradientUnits=\"userSpaceOnUse\" x1=\"110\" y1=\"170\" x2=\"640\" y2=\"800\"><stop stop-color=\"#8f9cf6\"/><stop offset=\".48\" stop-color=\"#8876f1\"/><stop offset=\"1\" stop-color=\"#c18bd2\"/></linearGradient>\n <linearGradient id=\"cross\" gradientUnits=\"userSpaceOnUse\" x1=\"0\" y1=\"240\" x2=\"720\" y2=\"200\"><stop stop-color=\"#92a5f5\"/><stop offset=\"1\" stop-color=\"#ae84ee\"/></linearGradient>\n <linearGradient id=\"warm\" gradientUnits=\"userSpaceOnUse\" x1=\"40\" y1=\"1130\" x2=\"570\" y2=\"820\"><stop stop-color=\"#ec89b8\"/><stop offset=\".5\" stop-color=\"#f09593\"/><stop offset=\"1\" stop-color=\"#f19a66\"/></linearGradient>\n</defs>\n<rect id=\"pastel-background\" width=\"720\" height=\"1280\" fill=\"url(#background)\"/>\n<g id=\"ribbons\" class=\"reveal\" data-layout-allow-overflow=\"true\" fill=\"none\" stroke-linecap=\"butt\" stroke-linejoin=\"round\">\n <path id=\"cool-loop\" d=\"M 752 166 C 735 41 598 39 475 78 C 348 116 226 151 224 250 C 220 347 292 470 352 603 C 377 660 407 718 367 747 C 322 776 171 775 61 863 C 14 901 -23 940 -64 986\" stroke=\"url(#cool)\" stroke-width=\"65\"/>\n <path id=\"crossing-ribbon\" d=\"M -58 252 C 58 231 158 300 250 369 C 354 448 414 400 512 323 C 591 262 653 200 756 174\" stroke=\"url(#cross)\" stroke-width=\"47\"/>\n <path id=\"warm-arch\" d=\"M 107 1337 C 32 1211 28 1099 70 997 C 115 888 213 819 329 784 C 422 755 474 765 518 824 C 567 890 585 971 649 1034 C 689 1074 726 1102 772 1123\" stroke=\"url(#warm)\" stroke-width=\"51\"/>\n</g>\n<g id=\"opening\" class=\"reveal\">\n <text id=\"opening-primavera\" class=\"heavy\" x=\"46\" y=\"599\" font-size=\"98\" textLength=\"634\" lengthAdjust=\"spacingAndGlyphs\">PRIMAVERA</text>\n <text id=\"opening-sound\" class=\"heavy\" x=\"87\" y=\"689\" font-size=\"98\" textLength=\"383\" lengthAdjust=\"spacingAndGlyphs\">SOUND</text>\n <text id=\"opening-year\" x=\"480\" y=\"689\" font-size=\"98\" font-weight=\"900\" letter-spacing=\"-5\" style=\"fill:#7252cd\" textLength=\"157\" lengthAdjust=\"spacingAndGlyphs\">’26</text>\n <text id=\"opening-venue\" class=\"tracked\" x=\"360\" y=\"754\" font-size=\"30\" text-anchor=\"middle\" textLength=\"610\" lengthAdjust=\"spacingAndGlyphs\">BUENOS AIRES · CLUB CIUDAD</text>\n</g>\n<g id=\"saturday\" class=\"reveal\">\n <g id=\"satBanner\">\n  <rect x=\"47\" y=\"240\" width=\"626\" height=\"10\" fill=\"#8264ee\"/>\n  <rect x=\"47\" y=\"250\" width=\"626\" height=\"9\" fill=\"#f5a15c\"/>\n  <rect x=\"47\" y=\"259\" width=\"626\" height=\"10\" fill=\"#ed90b5\"/>\n  <rect x=\"47\" y=\"269\" width=\"626\" height=\"9\" fill=\"#99adf6\"/>\n  <rect x=\"47\" y=\"278\" width=\"626\" height=\"60\" fill=\"#fffafd\"/>\n  <text id=\"saturday-date\" x=\"360\" y=\"319\" font-size=\"33\" font-weight=\"900\" letter-spacing=\"2\" text-anchor=\"middle\">SÁBADO 28 NOV</text>\n </g>\n <text id=\"gorillaz\" class=\"heavy reveal\" data-layout-allow-overflow=\"true\" x=\"360\" y=\"459\" font-size=\"108\" text-anchor=\"middle\" textLength=\"573\" lengthAdjust=\"spacingAndGlyphs\">GORILLAZ</text>\n <text id=\"yung\" class=\"billing reveal\" x=\"360\" y=\"531\" font-size=\"53\" letter-spacing=\"-2\" text-anchor=\"middle\">Yung Lean</text>\n <g id=\"saturday-billing\" class=\"billing\" text-anchor=\"middle\">\n  <text id=\"sat1\" class=\"reveal\" x=\"360\" y=\"603\" font-size=\"32\" data-fit-width=\"607\">CMAT · Danny L Harle · Nation of Language</text>\n  <text id=\"sat2\" class=\"reveal\" x=\"360\" y=\"645\" font-size=\"31\" data-fit-width=\"607\">Cara Delevingne · Ecco2k · Marlina Bertoldi</text>\n  <text id=\"sat3\" class=\"reveal\" x=\"360\" y=\"686\" font-size=\"30\" data-fit-width=\"586\">Jaime Sin Tierra · John Talabot · Juliana Gattas</text>\n  <text id=\"sat4\" class=\"reveal\" x=\"360\" y=\"724\" font-size=\"26\" data-fit-width=\"594\">Los Thuthanaka · Metrika · Model/Actriz · Nick León</text>\n  <text id=\"sat5\" class=\"reveal\" x=\"360\" y=\"759\" font-size=\"25\" data-fit-width=\"558\">Ambik · Babelade · Chechi de Marcos · LISA SCHA</text>\n  <text id=\"sat6\" class=\"reveal\" x=\"360\" y=\"792\" font-size=\"24\" data-fit-width=\"468\">María Wolff · El Nota · winanda johansen</text>\n </g>\n</g>\n<g id=\"sunday\" class=\"reveal\">\n <g id=\"sunBanner\">\n  <rect x=\"47\" y=\"240\" width=\"593\" height=\"10\" fill=\"#8264ee\"/>\n  <rect x=\"47\" y=\"250\" width=\"593\" height=\"9\" fill=\"#f5a15c\"/>\n  <rect x=\"47\" y=\"259\" width=\"593\" height=\"10\" fill=\"#ed90b5\"/>\n  <rect x=\"47\" y=\"269\" width=\"593\" height=\"9\" fill=\"#99adf6\"/>\n  <rect x=\"47\" y=\"278\" width=\"593\" height=\"60\" fill=\"#fffafd\"/>\n  <text id=\"sunday-date\" x=\"343.5\" y=\"319\" font-size=\"33\" font-weight=\"900\" letter-spacing=\"2\" text-anchor=\"middle\">DOMINGO 29 NOV</text>\n </g>\n <text id=\"strokes\" class=\"heavy reveal\" x=\"360\" y=\"444\" font-size=\"87\" text-anchor=\"middle\" textLength=\"642\" lengthAdjust=\"spacingAndGlyphs\">THE STROKES</text>\n <text id=\"sun1\" class=\"billing reveal\" x=\"360\" y=\"513\" font-size=\"49\" letter-spacing=\"-2\" text-anchor=\"middle\" data-fit-width=\"500\">FKA twigs · Lily Allen</text>\n <g id=\"sunday-billing\" class=\"billing\" text-anchor=\"middle\">\n  <text id=\"sun2\" class=\"reveal\" x=\"360\" y=\"590\" font-size=\"32\" data-fit-width=\"456\">Courtney Barnett · underscores</text>\n  <text id=\"sun3\" class=\"reveal\" x=\"360\" y=\"634\" font-size=\"29\" data-fit-width=\"570\">Juana Molina · Santiago Motorizado · Smerz</text>\n  <text id=\"sun4\" class=\"reveal\" x=\"360\" y=\"674\" font-size=\"29\" data-fit-width=\"431\">Juana Aguirre · Machine Girl</text>\n  <text id=\"sun5\" class=\"reveal\" x=\"360\" y=\"713\" font-size=\"26\" data-fit-width=\"564\">Mannequin Pussy · Sophia Stel · This Is Lorelei</text>\n  <text id=\"sun6\" class=\"reveal\" x=\"360\" y=\"749\" font-size=\"25\" data-fit-width=\"558\">Candelabro · Fin del Mundo · Pizza · sunlid · Yeyo</text>\n </g>\n</g>\n<g id=\"closing\" class=\"reveal\">\n <g id=\"closingBrand\">\n  <text id=\"closing-primavera\" class=\"heavy\" x=\"68\" y=\"466\" font-size=\"91\" textLength=\"588\" lengthAdjust=\"spacingAndGlyphs\">PRIMAVERA</text>\n  <text id=\"closing-sound\" class=\"heavy\" x=\"106\" y=\"550\" font-size=\"91\" textLength=\"355\" lengthAdjust=\"spacingAndGlyphs\">SOUND</text>\n  <text id=\"closing-year\" x=\"474\" y=\"550\" font-size=\"91\" font-weight=\"900\" letter-spacing=\"-5\" style=\"fill:#7252cd\" textLength=\"145\" lengthAdjust=\"spacingAndGlyphs\">’26</text>\n </g>\n <g id=\"closingRules\" class=\"reveal\">\n  <rect x=\"106\" y=\"594\" width=\"508\" height=\"8\" fill=\"#8264ee\"/>\n  <rect x=\"106\" y=\"602\" width=\"508\" height=\"8\" fill=\"#f5a15c\"/>\n  <rect x=\"106\" y=\"610\" width=\"508\" height=\"8\" fill=\"#ed90b5\"/>\n  <rect x=\"106\" y=\"618\" width=\"508\" height=\"8\" fill=\"#99adf6\"/>\n </g>\n <text id=\"finalDates\" class=\"heavy reveal\" x=\"360\" y=\"709\" font-size=\"62\" text-anchor=\"middle\" textLength=\"407\" lengthAdjust=\"spacingAndGlyphs\">28 &amp; 29 NOV</text>\n <text id=\"finalVenue\" class=\"tracked reveal\" x=\"360\" y=\"755\" font-size=\"29\" text-anchor=\"middle\" textLength=\"574\" lengthAdjust=\"spacingAndGlyphs\">CLUB CIUDAD · BUENOS AIRES</text>\n <g id=\"cta\" class=\"reveal\">\n  <rect id=\"cta-pill\" x=\"117\" y=\"806\" width=\"486\" height=\"83\" rx=\"41.5\" fill=\"#1b163b\"/>\n  <text id=\"cta-label\" x=\"360\" y=\"860\" font-size=\"36\" font-weight=\"800\" text-anchor=\"middle\" style=\"fill:#fff\" textLength=\"390\" lengthAdjust=\"spacingAndGlyphs\">Conseguí tu entrada →</text>\n </g>\n</g>\n</svg>\n</div>\n<script>\n(function(){\n 'use strict';\n // Fit actual glyph advances before constructing SVG animation transforms.\n // Artist rows deliberately avoid textLength so measured and painted widths agree.\n document.querySelectorAll('[data-fit-width]').forEach(function(node){\n  const originalSize=Number(node.getAttribute('font-size'));\n  const targetWidth=Number(node.getAttribute('data-fit-width'));\n  const naturalWidth=node.getComputedTextLength();\n  if(naturalWidth>0){\n   node.setAttribute('font-size',String(originalSize*Math.min(1,(targetWidth-2)/naturalWidth)));\n  }\n });\n // Transitions retain the previous source's inferred choreography.\n const tl=gsap.timeline({paused:true});\n const durationState={end:0};\n tl.to(durationState,{end:1,duration:10,ease:'none'},0);\n tl.fromTo('#ribbons',{opacity:0,y:120},{opacity:1,y:0,duration:.72,ease:'power2.out'},.13);\n tl.fromTo('#opening',{opacity:0,y:35},{opacity:1,y:0,duration:.42,ease:'power2.out'},.43);\n tl.to('#opening',{opacity:0,y:-22,duration:.23,ease:'power2.in'},1.43);\n tl.to('#ribbons',{opacity:.25,duration:.28,ease:'power1.inOut'},1.55);\n tl.fromTo('#saturday',{opacity:0,y:10},{opacity:1,y:0,duration:.23,ease:'power2.out'},1.72);\n tl.fromTo('#gorillaz',{opacity:0,scale:1.62,svgOrigin:'360 418'},{opacity:.4,scale:1.62,duration:.12,ease:'none'},1.88);\n tl.to('#gorillaz',{opacity:1,scale:1,duration:.66,ease:'power3.out'},2.03);\n function enter(selector,time,duration,offset){\n  tl.fromTo(selector,{opacity:0,y:offset===undefined?14:offset},{opacity:1,y:0,duration:duration||.26,ease:'power2.out'},time);\n }\n enter('#yung',2.52,.28);\n enter('#sat1',2.70,.28);\n enter('#sat2',2.80,.28);\n enter('#sat3',2.96,.32);\n enter('#sat4',3.32,.28);\n enter('#sat5',3.48,.28);\n enter('#sat6',3.64,.28);\n tl.to('#saturday',{opacity:0,y:-17,duration:.22,ease:'power2.in'},4.53);\n tl.fromTo('#sunday',{opacity:0,y:12},{opacity:1,y:0,duration:.23,ease:'power2.out'},4.76);\n enter('#strokes',5.24,.35,22);\n enter('#sun1',5.42,.30);\n enter('#sun2',5.60,.28);\n enter('#sun3',5.73,.25);\n enter('#sun4',6.24,.28);\n enter('#sun5',6.40,.28);\n enter('#sun6',6.56,.28);\n tl.to('#sunday',{opacity:0,y:-18,duration:.22,ease:'power2.in'},7.48);\n tl.to('#ribbons',{opacity:1,duration:.30,ease:'power1.inOut'},7.62);\n tl.fromTo('#closing',{opacity:0,y:25},{opacity:1,y:0,duration:.28,ease:'power2.out'},7.70);\n tl.fromTo('#closingRules',{opacity:0,scaleX:.5,svgOrigin:'360 610'},{opacity:1,scaleX:1,duration:.30,ease:'power2.out'},8.13);\n enter('#finalDates',8.34,.25,16);\n enter('#finalVenue',8.46,.25,12);\n tl.fromTo('#cta',{opacity:0,y:17,scale:.96,svgOrigin:'360 847.5'},{opacity:1,y:0,scale:1,duration:.32,ease:'power3.out'},8.62);\n // Inferred final hold, through the complete ten-second composition.\n tl.pause(0);\n window.__timelines=window.__timelines||{};\n window.__timelines['main']=tl;\n})();\n</script>\n</body>\n</html>",
