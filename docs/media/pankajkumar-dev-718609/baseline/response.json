{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Break the Frame</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#e9e5dc}body{font-family:Arial,Helvetica,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden;background:#e9e5dc}.clip{position:absolute;inset:0;width:100%;height:100%}canvas{display:block;width:100%;height:100%;object-fit:contain}\n</style>\n</head>\n<body>\n<div id=\"root\" data-composition-id=\"main\" data-width=\"1440\" data-height=\"1080\" data-duration=\"12\">\n<canvas id=\"art\" class=\"clip\" data-start=\"0\" data-duration=\"12\" width=\"1440\" height=\"1080\" aria-label=\"A sculpted typographic poster bends forward, shatters its black frame and floats free.\"></canvas>\n</div>\n<script src=\"gsap.min.js\"></script>\n<script>\n'use strict';\n// Editable art direction. All artwork is generated locally from these values.\nconst DESIGN={width:1440,height:1080,duration:12,paperWidth:580,paperHeight:760,paper:'#f5efdf',ink:'#191b19',accent:'#f04425',background:'#e9e5dc'};\nconst canvas=document.getElementById('art');\nconst ctx=canvas.getContext('2d');\nconst texture=document.createElement('canvas');\ntexture.width=1160;texture.height=1520;\nconst pctx=texture.getContext('2d');\npctx.scale(2,2);\n\nfunction makePoster(){\n const g=pctx.createLinearGradient(0,0,580,760);\n g.addColorStop(0,'#fcf6e6');g.addColorStop(0.6,DESIGN.paper);g.addColorStop(1,'#e9dfca');\n pctx.fillStyle=g;pctx.fillRect(0,0,580,760);\n pctx.fillStyle=DESIGN.accent;\n pctx.beginPath();pctx.arc(400,473,244,0,Math.PI*2);pctx.fill();\n // Oversized, deliberately cropped circular geometry belongs to the poster.\n pctx.save();pctx.translate(400,473);\n for(let i=0;i<23;i++){\n  const a=(i/23)*Math.PI*2;\n  pctx.save();pctx.rotate(a);pctx.fillStyle=DESIGN.paper;\n  pctx.fillRect(188,-2.1,58,4.2);pctx.restore();\n }\n pctx.restore();\n pctx.strokeStyle=DESIGN.ink;pctx.lineWidth=2;\n pctx.beginPath();pctx.moveTo(38,47);pctx.lineTo(542,47);pctx.stroke();\n pctx.fillStyle=DESIGN.ink;pctx.textBaseline='alphabetic';\n pctx.font='900 119px Arial, Helvetica, sans-serif';\n pctx.fillText('BREAK',31,181,518);\n pctx.font='900 119px Arial, Helvetica, sans-serif';\n pctx.fillText('THE',31,301,515);\n pctx.save();pctx.translate(31,431);pctx.scale(0.91,1);\n pctx.font='900 119px Arial, Helvetica, sans-serif';pctx.fillText('FRAME',0,0);pctx.restore();\n // An offset arrow points beyond the printed edge before the paper escapes.\n pctx.save();pctx.translate(119,540);pctx.rotate(-Math.PI/4);\n pctx.fillStyle=DESIGN.ink;pctx.fillRect(-19,-2,38,136);\n pctx.beginPath();pctx.moveTo(0,-75);pctx.lineTo(73,0);pctx.lineTo(-73,0);pctx.closePath();pctx.fill();pctx.restore();\n pctx.fillStyle=DESIGN.ink;pctx.font='700 27px Arial, Helvetica, sans-serif';\n pctx.fillText('NOTHING STAYS',38,685);pctx.fillText('INSIDE.',38,719);\n pctx.lineWidth=2;pctx.beginPath();pctx.moveTo(38,737);pctx.lineTo(542,737);pctx.stroke();\n}\nmakePoster();\n\nconst clamp=(x,a=0,b=1)=>Math.max(a,Math.min(b,x));\nconst smooth=(a,b,t)=>{const x=clamp((t-a)/(b-a));return x*x*(3-2*x);};\nconst mix=(a,b,x)=>a+(b-a)*x;\nconst TAU=Math.PI*2;\n\n// The frame is eight physical sections. Their destinations are authored, not random.\nconst rails=[\n {x:-163,y:-408,w:326,h:38,dx:-275,dy:-195,r:-0.73},\n {x:163,y:-408,w:326,h:38,dx:265,dy:-185,r:0.64},\n {x:-163,y:408,w:326,h:38,dx:-230,dy:203,r:0.52},\n {x:163,y:408,w:326,h:38,dx:285,dy:230,r:-0.59},\n {x:-308,y:-204,w:38,h:408,dx:-285,dy:-10,r:-0.42},\n {x:-308,y:204,w:38,h:408,dx:-310,dy:135,r:0.52},\n {x:308,y:-204,w:38,h:408,dx:320,dy:-30,r:0.47},\n {x:308,y:204,w:38,h:408,dx:295,dy:155,r:-0.57}\n];\nconst chips=[\n [-304,-403,-378,-206,17,9,2.3], [302,-402,407,-280,13,8,-2.8],\n [-306,20,-425,-60,24,8,-3.1], [307,-2,438,12,19,10,3.7],\n [-301,402,-320,283,18,7,2.6], [300,403,397,303,12,9,-3.3],\n [10,-407,126,-333,12,5,4.2], [-5,406,-94,364,20,6,-2.1]\n];\n\nfunction railShape(w,h,broken){\n ctx.beginPath();\n if(w>h){\n  ctx.moveTo(-w/2,-h/2);ctx.lineTo(w/2,-h/2);\n  ctx.lineTo(w/2-4*broken,-5);ctx.lineTo(w/2+7*broken,3);\n  ctx.lineTo(w/2-3*broken,h/2);ctx.lineTo(-w/2,h/2);\n }else{\n  ctx.moveTo(-w/2,-h/2);ctx.lineTo(w/2,-h/2);\n  ctx.lineTo(w/2,h/2);ctx.lineTo(5,h/2-6*broken);\n  ctx.lineTo(-4,h/2+6*broken);ctx.lineTo(-w/2,h/2);\n }\n ctx.closePath();\n}\n\nfunction drawFrame(t,shake){\n const f=smooth(3.48,6.5,t),travel=1-Math.pow(1-f,2.6);\n ctx.save();ctx.translate(720+shake,531);\n for(let i=0;i<rails.length;i++){\n  const r=rails[i];\n  ctx.save();ctx.translate(r.x+r.dx*travel,r.y+r.dy*travel+35*f*f);\n  ctx.rotate(r.r*travel);\n  ctx.shadowColor='rgba(28,24,18,0.24)';ctx.shadowBlur=13+14*f;ctx.shadowOffsetX=7;ctx.shadowOffsetY=13+18*f;\n  railShape(r.w,r.h,smooth(3.36,3.55,t));ctx.fillStyle='#242623';ctx.fill();\n  ctx.shadowColor='transparent';\n  const grad=ctx.createLinearGradient(-r.w/2,-r.h/2,r.w/2,r.h/2);\n  grad.addColorStop(0,'#55574f');grad.addColorStop(.17,'#373a33');grad.addColorStop(.33,'#1b1d1a');grad.addColorStop(.9,'#252722');grad.addColorStop(1,'#10120f');\n  railShape(r.w,r.h,smooth(3.36,3.55,t));ctx.fillStyle=grad;ctx.fill();\n  ctx.strokeStyle='rgba(236,228,208,0.25)';ctx.lineWidth=1;\n  ctx.beginPath();ctx.moveTo(-r.w/2+3,-r.h/2+2);ctx.lineTo(r.w/2-3,-r.h/2+2);ctx.stroke();\n  ctx.restore();\n }\n ctx.restore();\n}\n\nfunction point(u,v,t){\n const load=smooth(1.0,3.4,t),release=smooth(3.45,4.6,t),flight=smooth(3.45,6.55,t);\n const flutter=smooth(3.45,3.8,t)*(1-smooth(5.3,8.7,t));\n const corner=Math.pow(u,3)*Math.pow(1-v,2);\n const curl=112*smooth(2.05,3.4,t)*(1-smooth(5.25,7.4,t));\n let x=(u-.5)*DESIGN.paperWidth-corner*curl*.35;\n let y=(v-.5)*DESIGN.paperHeight+corner*curl*.24;\n let z=10+112*flight+52*Math.sin(flight*Math.PI);\n z+=116*load*(1-release)*Math.sin(Math.PI*u)*Math.sin(Math.PI*v);\n z+=corner*curl;\n z+=flutter*26*Math.sin(v*7.5-t*7.2)*Math.pow(Math.abs(u-.5)*2,2);\n z+=flutter*12*Math.sin(u*6+t*5)*Math.sin(Math.PI*v);\n const rx=.18*Math.sin(flight*Math.PI)-.025*flight;\n const ry=-.29*Math.sin(flight*Math.PI)-.065*flight;\n const settle=t>6.55?Math.exp(-(t-6.55)*1.6)*Math.sin((t-6.55)*5)*.016:0;\n const rz=-.115*flight+settle;\n let qy=y*Math.cos(rx)-z*Math.sin(rx),qz=y*Math.sin(rx)+z*Math.cos(rx);y=qy;z=qz;\n let qx=x*Math.cos(ry)+z*Math.sin(ry);qz=-x*Math.sin(ry)+z*Math.cos(ry);x=qx;z=qz;\n qx=x*Math.cos(rz)-y*Math.sin(rz);qy=x*Math.sin(rz)+y*Math.cos(rz);x=qx;y=qy;\n const perspective=1320/(1320-z);\n return {x:720+32*flight+x*perspective,y:531-13*flight+y*perspective,z:z};\n}\n\nfunction outline(t){\n ctx.beginPath();\n for(let i=0;i<=18;i++){const p=point(i/18,0,t);i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y);}\n for(let i=1;i<=24;i++){const p=point(1,i/24,t);ctx.lineTo(p.x,p.y);}\n for(let i=17;i>=0;i--){const p=point(i/18,1,t);ctx.lineTo(p.x,p.y);}\n for(let i=23;i>=0;i--){const p=point(0,i/24,t);ctx.lineTo(p.x,p.y);}\n ctx.closePath();\n}\n\nfunction triangle(a,b,c,sa,sb,sc,shade){\n // Affine texture mapping on a deterministic paper mesh.\n const det=sa.x*(sb.y-sc.y)+sb.x*(sc.y-sa.y)+sc.x*(sa.y-sb.y);\n if(Math.abs(det)<.001)return;\n const ax=(a.x*(sb.y-sc.y)+b.x*(sc.y-sa.y)+c.x*(sa.y-sb.y))/det;\n const bx=(a.y*(sb.y-sc.y)+b.y*(sc.y-sa.y)+c.y*(sa.y-sb.y))/det;\n const cx=(a.x*(sc.x-sb.x)+b.x*(sa.x-sc.x)+c.x*(sb.x-sa.x))/det;\n const dx=(a.y*(sc.x-sb.x)+b.y*(sa.x-sc.x)+c.y*(sb.x-sa.x))/det;\n const ex=(a.x*(sb.x*sc.y-sc.x*sb.y)+b.x*(sc.x*sa.y-sa.x*sc.y)+c.x*(sa.x*sb.y-sb.x*sa.y))/det;\n const fx=(a.y*(sb.x*sc.y-sc.x*sb.y)+b.y*(sc.x*sa.y-sa.x*sc.y)+c.y*(sa.x*sb.y-sb.x*sa.y))/det;\n const mx=(a.x+b.x+c.x)/3,my=(a.y+b.y+c.y)/3;\n const grow=p=>{const vx=p.x-mx,vy=p.y-my,len=Math.hypot(vx,vy)||1;return {x:p.x+.42*vx/len,y:p.y+.42*vy/len};};\n const aa=grow(a),bb=grow(b),cc=grow(c);\n ctx.save();ctx.beginPath();ctx.moveTo(aa.x,aa.y);ctx.lineTo(bb.x,bb.y);ctx.lineTo(cc.x,cc.y);ctx.closePath();ctx.clip();\n ctx.transform(ax,bx,cx,dx,ex,fx);ctx.drawImage(texture,0,0);\n if(shade>0){ctx.fillStyle='rgba(48,29,14,'+shade+')';ctx.fillRect(0,0,texture.width,texture.height);}\n ctx.restore();\n}\n\nfunction drawPaper(t){\n const lift=smooth(3.45,6.55,t);\n ctx.save();ctx.translate(5+12*lift,12+24*lift);\n ctx.shadowColor='rgba(38,28,17,0.30)';ctx.shadowBlur=22+38*lift;\n outline(t);ctx.fillStyle='rgba(45,32,19,0.19)';ctx.fill();ctx.restore();\n outline(t);ctx.fillStyle=DESIGN.paper;ctx.fill();\n const cols=14,rows=20,grid=[];\n for(let j=0;j<=rows;j++){\n  const row=[];for(let i=0;i<=cols;i++)row.push(point(i/cols,j/rows,t));grid.push(row);\n }\n // Clip to the outside contour so expanded texture triangles leave a clean edge.\n ctx.save();outline(t);ctx.clip();\n for(let j=0;j<rows;j++)for(let i=0;i<cols;i++){\n  const a=grid[j][i],b=grid[j][i+1],c=grid[j+1][i+1],d=grid[j+1][i];\n  const x=i/cols*texture.width,y=j/rows*texture.height;\n  const xx=(i+1)/cols*texture.width,yy=(j+1)/rows*texture.height;\n  const shade=clamp(((d.z-a.z)+(c.z-b.z))/75,0,.15);\n  triangle(a,b,c,{x:x,y:y},{x:xx,y:y},{x:xx,y:yy},shade);\n  triangle(a,c,d,{x:x,y:y},{x:xx,y:yy},{x:x,y:yy},shade);\n }\n ctx.restore();\n outline(t);ctx.strokeStyle='rgba(255,252,237,.72)';ctx.lineWidth=1.25;ctx.stroke();\n}\n\nfunction drawChips(t){\n const f=smooth(3.48,5.9,t);if(f<=0)return;\n const alpha=1-smooth(6.4,8.3,t);\n ctx.save();ctx.globalAlpha=alpha;\n for(let i=0;i<chips.length;i++){\n  const c=chips[i],q=1-Math.pow(1-f,2);\n  ctx.save();ctx.translate(720+c[0]+c[2]*q,531+c[1]+c[3]*q+85*f*f);\n  ctx.rotate(c[6]*q);ctx.fillStyle=i%3===0?'#d9c8a3':'#292c25';\n  ctx.beginPath();ctx.moveTo(-c[4]/2,-c[5]/2);ctx.lineTo(c[4]/2,-c[5]/3);ctx.lineTo(c[4]/4,c[5]/2);ctx.lineTo(-c[4]/2,c[5]/3);ctx.closePath();ctx.fill();ctx.restore();\n }\n ctx.restore();\n}\n\n// Every visible state is reconstructed from composition time. There is no playback clock.\nfunction draw(t){\n ctx.setTransform(1,0,0,1,0,0);ctx.globalAlpha=1;ctx.shadowColor='transparent';ctx.clearRect(0,0,1440,1080);\n const bg=ctx.createRadialGradient(660,420,50,720,540,960);\n bg.addColorStop(0,'#faf7ef');bg.addColorStop(.6,DESIGN.background);bg.addColorStop(1,'#d9d4c9');\n ctx.fillStyle=bg;ctx.fillRect(0,0,1440,1080);\n // Soft pools of light ground the object without adding scenery or labels.\n const glow=smooth(2.1,3.5,t)*(1-smooth(5.6,8,t));\n const warm=ctx.createRadialGradient(760,565,30,760,565,530);\n warm.addColorStop(0,'rgba(240,68,37,'+(glow*.13)+')');warm.addColorStop(1,'rgba(240,68,37,0)');\n ctx.fillStyle=warm;ctx.fillRect(0,0,1440,1080);\n const shadow=ctx.createRadialGradient(744,988,5,744,988,360);\n shadow.addColorStop(0,'rgba(57,44,28,.16)');shadow.addColorStop(1,'rgba(57,44,28,0)');\n ctx.save();ctx.translate(0,741);ctx.scale(1,.25);ctx.fillStyle=shadow;ctx.fillRect(200,700,1100,600);ctx.restore();\n const shake=smooth(2.4,3.4,t)*(1-smooth(3.45,3.9,t))*Math.sin(t*48)*1.7;\n // The subtle backing board is exposed as the sheet peels forward.\n const escape=smooth(3.45,5.8,t);\n ctx.save();ctx.translate(720+shake,531);\n ctx.fillStyle='#c8c0ae';ctx.fillRect(-291,-381,582,762);\n const well=ctx.createLinearGradient(-290,-380,290,380);well.addColorStop(0,'#c2bba9');well.addColorStop(1,'#ddd5c3');\n ctx.globalAlpha=escape;ctx.fillStyle=well;ctx.fillRect(-291,-381,582,762);ctx.restore();\n // The board travels out with the broken frame, revealing the wall.\n if(escape>0){ctx.save();ctx.globalAlpha=escape;ctx.fillStyle=bg;ctx.fillRect(428,149,584,764);ctx.restore();}\n drawFrame(t,shake);\n drawPaper(t);\n drawChips(t);\n}\n\nconst playhead={t:0};\nconst timeline=gsap.timeline({paused:true});\ntimeline.to(playhead,{t:DESIGN.duration,duration:DESIGN.duration,ease:'none',onUpdate:()=>draw(playhead.t)},0);\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines['main']=timeline;\ndraw(0);\n</script>\n</body>\n</html>","width":1440,"height":1080,"duration_seconds":12,"assumptions":["Creative choice: a silent, 12-second, 4:3 animation featuring an original typographic poster reading “BREAK THE FRAME.”","The paper bulges, curls forward and escapes as its frame fractures; the final composition holds through the ending.","Artwork uses Canvas and generic system fonts. No external assets or third-party artwork are used; no asset license gaps are known.","The harness supplies gsap.min.js locally. This source has not been rendered or visually reviewed."],"missing_inputs":[],"summary":"An editable poster bends into depth, bursts through its black frame and settles freely above the scattered pieces."}